+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <array>
+namespace mission {
+// SPEC_PEDS, 00457c81: explicit objective-0x19 destination only. Units are
+// original pixels (1/64 map cell), sampled once per 25Hz mission update.
+struct PedMotion {
+    int objective=0x19,state=3,mode=8,action=8,current=0,desired=4;
+    std::optional<std::array<int,2>> destination;
+    bool removed=false;
+    unsigned int killer=0; // engine ID; zero projects original -1
+    // Attack objectives (00456770): target +86 (engine ID), delay byte +68, weapon cooldown +64,
+    // act 0x10 while a shot is in progress.
+    unsigned int attackTarget=0;
+    int attackDelay=0,attackCooldown=0;
+    bool attacking=false;
+    // Flee (state 1): threat +86 (engine ID), update counter +0x88 (0..4), heading +0xa8 in radians.
+    unsigned int fleeFrom=0;
+    int fleeCounter=0;
+    double fleeHeading=0;
+    void send(int x,int y) {destination=std::array<int,2>{{x,y}};objective=0x19;state=4;mode=8;action=2;}
+    int speedFor(double x,double y) {
+        if(!destination || state!=4) return current=0;
+        const auto d=std::max(std::floor(std::abs((*destination)[0]-x)),std::floor(std::abs((*destination)[1]-y)));
+        if(d<8) {destination.reset();state=3;mode=8;action=8;return current=0;}
+        return current=d<12?2:desired;
+    }
+    void stand(int kind) {destination.reset();objective=0x19;state=3;mode=8;action=kind==4?2:8;current=kind==4?1:0;}
+};
+}
