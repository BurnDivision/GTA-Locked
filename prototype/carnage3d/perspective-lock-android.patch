+#pragma once
+#include "../mission/GameEconomy.h"
+#include <algorithm>
+#include <array>
+#include <functional>
+#include <optional>
+#include <vector>
+namespace gta { namespace police {
+struct Cell {int x=0,y=0,z=0;}; // executable XY/layer, not engine XYZ
+struct Classification {int level=0,response=0;};
+enum class Action {None, ArrestRespawn, DeathRespawn, GameOver};
+struct Record {
+    int crime=0,response=0,delay=0,type=1,phase=0;
+};
+struct Unit {int id=-1,state=1; Cell position; int group=-1;};
+struct Group {int status=-1,record=-1; bool flag5=false,flag6=false; std::vector<int> members;};
+struct Assignment {int group=-1,unit=-1;};
+// Spec 004601a0: Chebyshev/stable rank; rank0 is NEVER attempted.
+std::optional<Cell> rankedRespawn(Cell from,std::vector<Cell> bases,
+    const std::function<std::optional<Cell>(Cell)>& scan);
+std::vector<int> roadblockOffsets(int roadWidth);
+struct Roadblock {
+    bool active=false; int timer=0;
+    bool activate(int level,bool vehicleTarget,bool enabled,int activeCount);
+    bool update(bool anyLevelAbove2,bool nearbyVehicle);
+};
+class PoliceSystem {
+public:
+    PoliceSystem(GameEconomy& economy,std::size_t participants);
+    void reset();
+    Classification classify(int owner,int section,bool forceZero=false);
+    // Original ownership/witness/duplicate gates MUST already have accepted this event.
+    bool acceptedCrime(int owner,int crime);
+    // 0045ddc0: caller proves occupied driver-seat takeover; 004136c0 vehicle gates.
+    bool occupiedDriverTakeover(int owner,int model,int section);
+    // Caller proves original ownership, active vehicle, crime2 speed and witness-link gates.
+    // linkedWitness means vehicle+0xb8 resolves to a vehicle with field+4 == 3.
+    bool vehicleCrime(int owner,int entity,int model,int crime,int section,bool linkedWitness);
+    // Caller proves human pedestrian ownership (+0x1c low byte ==1).
+    bool pedestrianCrime(int owner,int crime,int section);
+    // 00473ea0/00473ef0: four script-selected slots; countdown is a byte.
+    bool queueCrime(int slot,int type,int entity,int crime,unsigned char countdown);
+    void updateCrimeQueue(const std::function<void(int,int,int)>& dispatch);
+    bool beginDeath(int owner,bool representation2);
+    // Caller proves captured state9 and live officer/target, not a guessed proximity test.
+    bool beginArrest(int owner,bool provenCapture);
+    Action updatePlayer(int owner); // one original update, no seconds conversion
+    void respawned(int owner);
+    bool gameOver(int owner) const;
+    bool clearInventory(int owner) const;
+    bool waiting(int owner) const;
+    Record& record(int owner) {return records_.at(owner);}
+    Group& group(int index) {return groups_.at(index);}
+    const std::vector<Assignment>& pending() const {return pending_;}
+    bool allocate(int owner,Cell target,std::vector<Unit>& units);
+    bool completeAssignment(int group,int unit);
+    void release(int owner,std::vector<Unit>& units);
+    // Natural decay, requested-count derivation, capture entry/radius and steering U.
+private:
+    enum class Phase {Alive,Arrest1,Arrest2,Death,Respawn,Terminal};
+    struct Player {Phase phase=Phase::Alive; int updates=0,deadline=100; bool clear=true;};
+    struct QueuedCrime {int type=-1,entity=-1,crime=-1,status=0; unsigned char countdown=255;};
+    std::array<QueuedCrime,4> queue_{};
+    GameEconomy& economy_;
+    std::vector<Player> players_;
+    std::vector<Record> records_;
+    std::array<Group,4> groups_;
+    std::vector<Assignment> pending_;
+};
+}}
diff --git a/src/reperspective/CameraHeading.h b/src/reperspective/CameraHeading.h
new file mode 100644
index 0000000..9cfbe1e
--- /dev/null
+++ b/src/reperspective/CameraHeading.h
@@ -0,0 +1,143 @@
+#pragma once
+
+// GTA Classic Reperspective: camera heading helpers.
+// Engine independent (plain floats, <cmath> only) so they can be unit tested natively
+// and reused by other top-down engines. Angles are radians in the world X/Z plane,
+// direction vector = (cos a, sin a).
+
+#include <cmath>
+
+namespace reperspective
+{
+    constexpr float kPi = 3.14159265358979f;
+    constexpr float kTwoPi = 6.28318530717959f;
+
+    // wrap angle to [-pi, pi)
+    inline float WrapPi(float a)
+    {
+        a = std::fmod(a + kPi, kTwoPi);
+        if (a < 0.0f) a += kTwoPi;
+        return a - kPi;
+    }
+
+    // shortest signed rotation from -> to, in [-pi, pi)
+    inline float AngleDelta(float from, float to)
+    {
+        return WrapPi(to - from);
+    }
+
+    // Frame-rate independent exponential approach along the shortest arc.
+    // timeConstant <= 0: instant. maxRate (radians/second) <= 0: unlimited.
+    inline float SmoothAngle(float current, float target, float dt, float timeConstant, float maxRate = 0.0f)
+    {
+        const float delta = AngleDelta(current, target);
+        float step = delta;
+        if (timeConstant > 0.0f && dt >= 0.0f)
+        {
+            step = delta * (1.0f - std::exp(-dt / timeConstant));
+        }
+        if (maxRate > 0.0f && dt >= 0.0f)
+        {
+            const float limit = maxRate * dt;
+            if (step > limit) step = limit;
+            else if (step < -limit) step = -limit;
+        }
+        return WrapPi(current + step);
+    }
+
+    // Camera rotation smoothing presets. The value is the time to cover 90% of a step change
+    // (settle time); the exponential time constant is settle / ln(10).
+    enum class Smoothing { Instant, Fast, Smooth };
+
+    inline float SmoothingSettleTime(Smoothing s)
+    {
+        switch (s)
+        {
+            case Smoothing::Instant: return 0.0f;
+            case Smoothing::Fast: return 0.125f;
+            case Smoothing::Smooth: return 0.25f;
+        }
+        return 0.125f;
+    }
+
+    inline float SmoothingTimeConstant(Smoothing s)
+    {
+        return SmoothingSettleTime(s) / 2.302585f;
+    }
+
+    // Persistent travel heading for on-foot movement with free (twin-stick) input.
+    // - holds while standing still or moving slowly (no oscillation when stationary);
+    // - travel that stays on one side of the heading (beyond the deadband) for commitTime makes the
+    //   heading follow it: sharp turns and steadily curving runs both rotate the view, while brief
+    //   wiggles and rapid side-to-side input (which keeps switching sides) don't;
+    // - small adjustments (within deadband) are followed only slowly.
+    struct TravelHeadingTracker
+    {
+        // parameters
+        float mMinSpeed = 0.6f; // meters per second; slower movement holds the heading
+        float mDeadband = 0.20f; // radians (~11 degrees)
+        float mCommitTime = 0.25f; // seconds a new direction must persist
+        float mFollowTime = 0.12f; // time constant once committed (seconds)
+        float mDriftTime = 0.8f; // time constant for small adjustments (seconds)
+
+        // state
+        float mHeading = 0.0f;
+        bool mValid = false;
+        int mCandidateSide = 0; // side of the heading the travel direction is on (+1 / -1)
+        float mCandidateTime = 0.0f;
+        bool mFollowing = false; // committed to a new direction, catching up with it
+
+        void Reset(float heading)
+        {
+            mHeading = WrapPi(heading);
+            mValid = true;
+            mCandidateSide = 0;
+            mCandidateTime = 0.0f;
+            mFollowing = false;
+        }
+
+        // velocityX / velocityY: world velocity (meters per second)
+        void Update(float velocityX, float velocityY, float dt)
+        {
+            const float speed = std::sqrt(velocityX * velocityX + velocityY * velocityY);
+            if (speed < mMinSpeed)
+            {
+                mCandidateTime = 0.0f;
+                return;
+            }
+            const float direction = std::atan2(velocityY, velocityX);
+            if (!mValid)
+            {
+                Reset(direction);
+                return;
+            }
+            const float offset = AngleDelta(mHeading, direction);
+            if (mFollowing)
+            {
+                // finish catching up with a committed direction at the follow rate
+                mHeading = SmoothAngle(mHeading, direction, dt, mFollowTime);
+                if (std::fabs(AngleDelta(mHeading, direction)) < 0.02f) mFollowing = false;
+                mCandidateTime = 0.0f;
+                return;
+            }
+            if (std::fabs(offset) <= mDeadband)
+            {
+                mHeading = SmoothAngle(mHeading, direction, dt, mDriftTime);
+                mCandidateTime = 0.0f;
+                return;
+            }
+            const int side = (offset > 0.0f) ? 1 : -1;
+            if (side != mCandidateSide)
+            {
+                mCandidateSide = side;
+                mCandidateTime = 0.0f;
+            }
+            mCandidateTime += dt;
+            if (mCandidateTime >= mCommitTime)
+            {
+                mFollowing = true;
+                mHeading = SmoothAngle(mHeading, direction, dt, mFollowTime);
+            }
+        }
+    };
+} // namespace reperspective
diff --git a/src/reperspective/TwinStick.h b/src/reperspective/TwinStick.h
new file mode 100644
index 0000000..525ee21
--- /dev/null
+++ b/src/reperspective/TwinStick.h
@@ -0,0 +1,195 @@
+#pragma once
+
+// GTA Classic Reperspective: twin-stick input mapping.
+// Engine independent (plain floats) so it can be unit tested natively and reused.
+//
+// Three separate directions are produced: movement (where the character travels), facing
+// (where the character body points) and aim (where the weapon points). The camera heading
+// is not decided here; see CameraHeading.h.
+//
+// Screen conventions: stick x grows to the right, stick y grows downwards (SDL / GLFW).
+// World conventions: X/Z plane, direction vector (cos a, sin a).
+
+#include "CameraHeading.h"
+
+namespace reperspective
+{
+    struct Vec2
+    {
+        float x = 0.0f;
+        float y = 0.0f;
+    };
+
+    inline Vec2 MakeVec2(float x, float y) { Vec2 v; v.x = x; v.y = y; return v; }
+    inline float Length(const Vec2& v) { return std::sqrt(v.x * v.x + v.y * v.y); }
+    inline Vec2 Scale(const Vec2& v, float s) { return MakeVec2(v.x * s, v.y * s); }
+    inline Vec2 Normalize(const Vec2& v)
+    {
+        const float len = Length(v);
+        return (len > 1e-6f) ? Scale(v, 1.0f / len) : MakeVec2(0.0f, 0.0f);
+    }
+    inline float Heading(const Vec2& v) { return std::atan2(v.y, v.x); }
+    inline Vec2 FromHeading(float a) { return MakeVec2(std::cos(a), std::sin(a)); }
+
+    // world-space directions of the screen's up and right
+    struct ScreenBasis
+    {
+        Vec2 mUp = MakeVec2(0.0f, -1.0f);
+        Vec2 mRight = MakeVec2(1.0f, 0.0f);
+    };
+
+    // basis for a top-down camera whose screen-up points along heading
+    // (right = up rotated by +90 degrees in the X/Z plane, as the follow camera builds it)
+    inline ScreenBasis BasisFromHeading(float heading)
+    {
+        ScreenBasis b;
+        b.mUp = FromHeading(heading);
+        b.mRight = MakeVec2(-b.mUp.y, b.mUp.x);
+        return b;
+    }
+
+    // stick (x right, y down) -> world direction (not normalized)
+    inline Vec2 ScreenToWorld(const ScreenBasis& basis, const Vec2& stick)
+    {
+        return MakeVec2(basis.mRight.x * stick.x - basis.mUp.x * stick.y,
+                        basis.mRight.y * stick.x - basis.mUp.y * stick.y);
+    }
+
+    // radial dead zone, magnitude rescaled to 0..1 beyond it
+    inline Vec2 ApplyDeadZone(const Vec2& stick, float deadZone)
+    {
+        const float len = Length(stick);
+        if (len <= deadZone || len < 1e-6f)
+            return MakeVec2(0.0f, 0.0f);
+        float amount = (len - deadZone) / (1.0f - deadZone);
+        if (amount > 1.0f) amount = 1.0f;
+        return Scale(stick, amount / len);
+    }
+
+    // Holding a stick keeps the screen->world mapping it started with, so a camera that
+    // rotates meanwhile cannot turn a held "right" into a circle. The mapping is taken again
+    // when the stick is released or turned to a clearly new direction.
+    struct InputFrameLatch
+    {
+        float mRelatchAngle = 0.6f; // radians (~35 degrees)
+
+        bool mActive = false;
+        ScreenBasis mBasis;
+        float mStickHeading = 0.0f;
+
+        ScreenBasis Update(const Vec2& stick, const ScreenBasis& current)
+        {
+            if (Length(stick) < 1e-6f)
+            {
+                mActive = false;
+                return current;
+            }
+            const float stickHeading = Heading(stick);
+            if (!mActive || std::fabs(AngleDelta(mStickHeading, stickHeading)) > mRelatchAngle)
+            {
+                mActive = true;
+                mBasis = current;
+                mStickHeading = stickHeading;
+            }
+            return mBasis;
+        }
+
+        void Reset() { mActive = false; }
+    };
+
+    struct TwinStickConfig
+    {
+        float mMoveDeadZone = 0.25f;
+        float mRunThreshold = 0.7f; // raw stick deflection above which the character runs
+        float mAimDeadZone = 0.3f;
+        bool mAutoFire = true; // fire when the aim stick is pushed past mAutoFireThreshold
+        float mAutoFireThreshold = 0.6f; // raw stick deflection
+    };
+
+    struct TwinStickOutput
+    {
+        bool mMoving = false;
+        Vec2 mMoveDirection; // unit, world
+        bool mRun = false;
+
+        bool mAiming = false;
+        Vec2 mAimDirection; // unit, world
+
+        bool mHasFacing = false;
+        Vec2 mFacingDirection; // unit, world: aim while aiming, otherwise movement
+
+        bool mFire = false;
+    };
+
+    // moveStick / aimStick: raw sticks (x right, y down). The aim may instead come as a world
+    // direction (mouse): pass aimWorldValid = true and aimWorld.
+    inline TwinStickOutput EvaluateTwinStick(const Vec2& moveStick, const ScreenBasis& moveBasis,
+        const Vec2& aimStick, const ScreenBasis& aimBasis, bool aimWorldValid, const Vec2& aimWorld,
+        bool manualFire, const TwinStickConfig& config)
+    {
+        TwinStickOutput out;
+
+        const float moveRaw = Length(moveStick);
+        const Vec2 move = ApplyDeadZone(moveStick, config.mMoveDeadZone);
+        if (Length(move) > 0.0f)
+        {
+            const Vec2 world = Normalize(ScreenToWorld(moveBasis, move));
+            if (Length(world) > 0.0f)
+            {
+                out.mMoving = true;
+                out.mMoveDirection = world;
+                out.mRun = (moveRaw > config.mRunThreshold);
+            }
+        }
+
+        const float aimRaw = Length(aimStick);
+        if (aimWorldValid)
+        {
+            const Vec2 world = Normalize(aimWorld);
+            if (Length(world) > 0.0f)
+            {
+                out.mAiming = true;
+                out.mAimDirection = world;
+            }
+        }
+        else if (aimRaw > config.mAimDeadZone)
+        {
+            const Vec2 world = Normalize(ScreenToWorld(aimBasis, aimStick));
+            if (Length(world) > 0.0f)
+            {
+                out.mAiming = true;
+                out.mAimDirection = world;
+            }
+        }
+
+        if (out.mAiming)
+        {
+            out.mHasFacing = true;
+            out.mFacingDirection = out.mAimDirection;
+        }
+        else if (out.mMoving)
+        {
+            out.mHasFacing = true;
+            out.mFacingDirection = out.mMoveDirection;
+        }
+
+        out.mFire = manualFire;
+        if (config.mAutoFire && !aimWorldValid && aimRaw >= config.mAutoFireThreshold)
+        {
+            out.mFire = true;
+        }
+        return out;
+    }
+
+    // Combat-focused mode: the right stick's x turns the aim (and with it the camera) at up to
+    // turnRate radians per second; returns the new aim heading.
+    inline float CombatTurnAim(float aimHeading, float stickX, float deadZone, float turnRate, float dt)
+    {
+        const float mag = std::fabs(stickX);
+        if (mag <= deadZone)
+            return aimHeading;
+        const float amount = (mag - deadZone) / (1.0f - deadZone);
+        // stick right turns clockwise on screen = towards the screen's right = +angle (see BasisFromHeading)
+        return WrapPi(aimHeading + (stickX > 0.0f ? 1.0f : -1.0f) * amount * turnRate * dt);
+    }
+} // namespace reperspective
