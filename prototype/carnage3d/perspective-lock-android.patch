+    }
+    if(token=="MESSAGE_BRIEF" || token=="BRIEF" || token=="P_BRIEF" || token=="P_BRIEF_TIMED" ||
+       token=="MOBILE_BRIEF" || token=="SPEECH_BRIEF" || token=="FRENZY_BRIEF" ||
+       token=="ARMEDMESS" || token=="DISARMMESS") {
