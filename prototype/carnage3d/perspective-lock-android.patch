+// game view area inside the screen for the requested aspect ratio (r_aspect), centered;
+// the rest of the screen is left as black bars
+static Rect ComputeGameViewArea(const Point& screenResolution)
+{
+    Rect area { 0, 0, screenResolution.x, screenResolution.y };
+    float targetAspect = 0.0f;
+    if (gCvarGraphicsAspect.mValue == "16:9") targetAspect = 16.0f / 9.0f;
+    else if (gCvarGraphicsAspect.mValue == "4:3") targetAspect = 4.0f / 3.0f;
+    else if (gCvarGraphicsAspect.mValue == "auto" && screenResolution.y > 0)
+    {
+        // nearest of 4:3 and 16:9 to the screen shape (e.g. foldable: unfolded -> 4:3, folded -> 16:9)
+        const float screenAspectAuto = (screenResolution.x * 1.0f) / screenResolution.y;
+        const float distTo43 = fabsf(logf(screenAspectAuto / (4.0f / 3.0f)));
+        const float distTo169 = fabsf(logf(screenAspectAuto / (16.0f / 9.0f)));
+        targetAspect = (distTo43 <= distTo169) ? (4.0f / 3.0f) : (16.0f / 9.0f);
+    }
+    if (targetAspect <= 0.0f || screenResolution.x <= 0 || screenResolution.y <= 0)
+        return area; // fill
+
+    const float screenAspect = (screenResolution.x * 1.0f) / screenResolution.y;
+    if (screenAspect > targetAspect + 0.001f) // wider than target: pillarbox
+    {
+        area.w = static_cast<int>(screenResolution.y * targetAspect + 0.5f);
+        area.x = (screenResolution.x - area.w) / 2;
+    }
+    else if (screenAspect < targetAspect - 0.001f) // taller than target: letterbox
+    {
+        area.h = static_cast<int>(screenResolution.x / targetAspect + 0.5f);
+        area.y = (screenResolution.y - area.h) / 2;
+        if (screenResolution.y > screenResolution.x)
+        {
+            // portrait: keep only a small bar above the view, leave the space below it for touch controls
+            const int topMargin = static_cast<int>(0.12f * screenResolution.x);
+            area.y = std::min(area.y, topMargin);
+        }
+    }
+    return area;
+}
