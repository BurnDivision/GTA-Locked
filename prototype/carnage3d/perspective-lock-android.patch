+void InputActionsMapping::RebuildGamepadActions()
+{
+    ::memset(mGpButtonActions, 0, sizeof(mGpButtonActions));
+    for (int i = 1; i < eInputAction_COUNT; ++i)
+    {
+        const auto button = mActionToKeys[i].mGpButton;
+        if (button > eGamepadButton_null && button < eGamepadButton_COUNT)
+            mGpButtonActions[button].mActions[GetInputActionsGroup(static_cast<eInputAction>(i))] = static_cast<eInputAction>(i);
+    }
+}
+
+bool InputActionsMapping::AssignGamepadButton(eInputAction action, eGamepadButton button)
+{
+    if (action <= eInputAction_null || action >= eInputAction_COUNT ||
+        button <= eGamepadButton_null || button >= eGamepadButton_COUNT) return false;
+    std::array<eGamepadButton,eInputAction_COUNT> buttons{};
+    std::array<eInputActionsGroup,eInputAction_COUNT> groups{};
+    for (int i = 1; i < eInputAction_COUNT; ++i)
+    {
+        buttons[i] = mActionToKeys[i].mGpButton;
+        groups[i] = GetInputActionsGroup(static_cast<eInputAction>(i));
+    }
+    if (!controls::assign(buttons, groups, action, button)) return false;
+    for (int i = 1; i < eInputAction_COUNT; ++i) mActionToKeys[i].mGpButton = buttons[i];
+    RebuildGamepadActions();
+    return true;
+}
+
+void InputActionsMapping::RestoreGamepadButtons(const InputActionsMapping& defaults)
+{
+    std::array<eGamepadButton,eInputAction_COUNT> buttons{}, original{};
+    for (int i = 1; i < eInputAction_COUNT; ++i) original[i] = defaults.mActionToKeys[i].mGpButton;
+    controls::restore(buttons, original);
+    for (int i = 1; i < eInputAction_COUNT; ++i) mActionToKeys[i].mGpButton = buttons[i];
+    RebuildGamepadActions();
+}
