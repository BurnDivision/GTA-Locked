+        std::vector<Vehicle*> doomedCars;
+        for(auto* existing:gGameObjectsManager.mVehiclesList) {
+            if(existing->IsMarkedForDeletion()) continue;
+            const auto& at=existing->mTransform.mPosition;
+            if(!std::isfinite(at.x) || !std::isfinite(at.y) || !std::isfinite(at.z)) return WorldResult::Hold;
+            // (box.z-1) and the query z (cellZ*64-1 pixels) share a 64-pixel layer.
+            if(static_cast<int>(std::floor((MAP_LAYERS_COUNT*64-1-Convert::MetersToMapUnits(at.y)*64-1e-3)/64))!=z-1) continue;
+            const auto cx=std::llround(Convert::MetersToMapUnits(at.x)*pickup::cell);
+            const auto cy=std::llround(Convert::MetersToMapUnits(at.z)*pickup::cell);
+            const int cw=Convert::MetersToPixels(existing->mCarInfo->mDimensions.x)/2;
+            const int cd=Convert::MetersToPixels(existing->mCarInfo->mDimensions.z)/2;
+            const int ca=static_cast<int>(std::lround((90-existing->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+            const auto shape=pickup::box(cx,cy,0,cw,cd,ca);
+            bool touches=false;
+            for(const auto& point:shape.p) for(const auto& cell:cells)
+                if(point.x>=0 && point.y>=0 && point.x/pickup::cell==cell.first && point.y/pickup::cell==cell.second) touches=true;
+            if(!touches) continue;
+            const int other=static_cast<int>(existing->mCarInfo->mModelID);
+            if(other==0x2f) continue; // 00435e80 never collects the model car
+            if(other==4 || other==5 || other==0xf || other==0x10 || other==0x20 || other==0x2a) continue;
