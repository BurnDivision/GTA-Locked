new file mode 100755
index 0000000..74369a5
--- /dev/null
+++ b/src/BlastRules.h
@@ -0,0 +1,22 @@
+#pragma once
+// Blast damage of the original explosion (gta.exe 00425ca0, reached from 00425170).
+// Offsets are target minus blast centre in original pixels (64 per block);
+// layers are original cell layers (larger = lower).
+namespace blast {
+enum class PedEffect { None, Burn, Kill };
+// Living peds no more than one layer above the blast: inside a 61 px box.
+// Any axis beyond 35 px: set alight and lose 10 health; otherwise killed.
+inline PedEffect ped(int dx, int dy, int pedLayer, int blastLayer)
+{
+    if (pedLayer < blastLayer - 1) return PedEffect::None;
+    if (dx <= -0x3d || dy <= -0x3d || dx >= 0x3d || dy >= 0x3d) return PedEffect::None;
+    if (dx < -0x23 || dy < -0x23 || dx > 0x23 || dy > 0x23) return PedEffect::Burn;
+    return PedEffect::Kill;
+}
+// Cars inside a 65 px box take full damage and explode after carDelayTicks
+// updates (car+0x114 = 10). Model 0x25 instead gains tankDamage while below tankLimit.
+inline bool car(int dx, int dy) { return dx > -0x41 && dy > -0x41 && dx < 0x41 && dy < 0x41; }
+constexpr int carDelayTicks = 10, tankModel = 0x25, tankDamage = 4, tankLimit = 0x61;
+// Original pixel height of an engine height in blocks (street level: 2.0 -> 255).
+inline int layerOf(float blocksUp) { return static_cast<int>(383.0f - blocksUp * 64.0f + 0.5f) >> 6; }
+}
