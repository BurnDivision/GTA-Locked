+        // argument0. D's nonzero variants and other models are not recovered.
+        if(model!=18 || static_cast<std::int16_t>(i.D)!=0 ||
+           !gGameMap.IsLoaded()) return WorldResult::Unresolved;
+        const int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(position->x)));
+        const int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(position->z)));
+        const int z=static_cast<int>(std::floor(Convert::MetersToMapUnits(position->y)));
