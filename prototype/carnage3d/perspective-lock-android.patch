@@ -0,0 +1,38 @@
+#pragma once
+
+// Rules read from gta.exe, SHA256 recorded in evidence/input-sha256.txt.
+// Track numbers here are zero based; file names are one based.
+namespace original_audio {
+inline const char* trackFile(int track) {
+    static const char* const files[] = {
+        "MUSIC/Track1.wav", "MUSIC/Track2.wav", "MUSIC/Track3.wav",
+        "MUSIC/Track4.wav", "MUSIC/Track5.wav", "MUSIC/Track6.wav",
+        "MUSIC/Track7.wav", "MUSIC/Track8.wav", "MUSIC/Track9.wav", "MUSIC/Track10.wav"
+    }; // 004ab2e8, stride 0x108; 0040c700 clamps invalid indices to 0.
+    return track >= 0 && track < 10 ? files[track] : nullptr;
+}
+struct Radio {
+    unsigned char choice[9] = {};
+    int track(int category) const {
+        static const int tracks[9][3] = {
+            {6,3,2}, {4,0,1}, {1,3,2}, {0,1,4}, {3,6,4},
+            {2,0,6}, {5,5,5}, {7,7,7}, {8,8,8}
+        }; // 004ab270..004ab2db. No speculative category 9 table read.
+        return category >= 0 && category < 9 ? tracks[category][choice[category]] : -1;
+    }
+    int next(int category) {
+        // 0040d140: categories 6,7,8 and on-foot category 10 cannot switch.
+        if (category >= 0 && category < 6) choice[category] = (choice[category]+1)%3;
+        return track(category);
+    }
+};
+inline float volumeGain(int volume) {
+    static const int values[] = {0,18,36,54,73,91,109,127}; // 004ab048/004ab050
+    return values[volume < 0 ? 0 : volume > 7 ? 7 : volume] / 127.0f;
+}
+inline unsigned int hornSample(unsigned char horn) { return 58 + horn/10; }
+inline unsigned int hornRate(unsigned char horn, unsigned int baseRate) {
+    return baseRate + (horn%10)*512; // 00402690 at 004029xx: SDT rate + remainder*0x200
+}
+inline bool musicDrained(bool eof, unsigned int queued) { return eof && queued == 0; }
+}
