+    if(!mReady)gConsole.LogMessage(eLogMessage_Warning,"Original front-end assets or mission catalog missing; cannot start menu");
+}
+void MainMenuGamestate::OnGamestateLeave() {
+    if(mTexture)gGraphicsDevice.DestroyTexture(mTexture);
+    mTexture=nullptr;mReady=false;
+}
+void MainMenuGamestate::QueueChapterResult(int chapter,int score,bool success) {
+    mPendingPlayer=mMenu.profiles.selected;
+    mPendingChapter=chapter;mPendingScore=score;mPendingSuccess=success;
+}
+void MainMenuGamestate::SaveProfiles() {
+    gCvarFrontendProfiles.mValue=mMenu.profiles.encode();
+    if(!mProfileWritable || !frontend::saveProfiles(gFiles.mWorkingDirectoryPath+"/PLAYER_A.DAT",mMenu.profiles))
+        gConsole.LogMessage(eLogMessage_Warning,"Could not save player profiles; prior file preserved");
+    if(!gSystem.SaveConfiguration())gConsole.LogMessage(eLogMessage_Warning,"Could not save profile preferences");
+}
+void MainMenuGamestate::Act(frontend::Action a) {
+    if(!mReady)return;
+    if(a==frontend::Action::Accept && mMenu.page==frontend::Page::Cities) {if(mMenu.profiles.unlocked(mMenu.city*2+mMenu.chapter)){SaveProfiles();mStartPending=true;}return;}
+    if(a==frontend::Action::Accept && mMenu.page==frontend::Page::Quit) {mQuitPending=true;return;}
+    const bool save=mMenu.page==frontend::Page::Options && a==frontend::Action::Accept;
+    const auto previous=mMenu.page;
+    const auto previousProfiles=mMenu.profiles.encode();
+    mMenu.act(a);
+    if(previousProfiles!=mMenu.profiles.encode())SaveProfiles();
+    if(mMenu.page==frontend::Page::Quit && previous!=mMenu.page)mCreditsElapsed=0;
+    if(mMenu.exitRequested)mQuitPending=true;
+    if(save) {
+        gCvarSoundsVolume.mValue=mMenu.options[0];gCvarMusicVolume.mValue=mMenu.options[1];
+        gCvarTextSpeed.mValue=mMenu.options[2];
+        gCvarTransparencyEffects.mValue=mMenu.options[4];
+        gCvarGameMusicMode.mValue=mMenu.options[3]?eGameMusicMode_Constant:eGameMusicMode_Radio;
+        gAudioManager.InitSoundsAndMusicGainValue();
+        if(gAudioManager.mMusicAudioSource)
+            gAudioManager.mMusicAudioSource->SetGain(gAudioManager.mMusicGain);
+        gSystem.SaveConfiguration();
+    }
+}
+void MainMenuGamestate::OnGamestateFrame() {
+    if(mQuitPending) {mQuitPending=false;gSystem.QuitRequest();return;}
+    // State transitions happen here, outside input dispatch and drawing.
+    if(mStartPending) {
+        mStartPending=false;
+        const std::string map=mMaps[mMenu.city*2+mMenu.chapter];
+        gCvarMapname.mValue=map;gCvarMapname.ClearModified();
+        gCarnageGame.mGameplayGamestate.mStartSection=mMenu.section();
+        if(!gCarnageGame.StartScenario(map)) {
+            gCarnageGame.SetCurrentGamestate(this);
+            gConsole.LogMessage(eLogMessage_Warning,"Selected chapter failed to start");
+        }
+        return;
+    }
+    if(!mReady)return;
+    mElapsed+=gTimeManager.mGameFrameDelta;
+    Blit(mFrame,mLogos[int(mElapsed/0.083f)%8],0);
+    Blit(mFrame,mLower[mMenu.page==frontend::Page::Cities?1:0],168);
+    const int anim=int(mElapsed*25)%13+1;
+    auto cursor=[&](int x,int y){mKey.draw(mFrame,std::string(1,char(anim)),x,y);};
+    if(mMenu.page==frontend::Page::Main) {
+        mFrame.blit(mBadges[0],20,390);mFrame.blit(mBadges[1],556,390);
+        mHead.draw(mFrame,Text("Play"),196,216);
+        mHead.draw(mFrame,Text("Options"),196,216+mHead.height);
+        cursor(116,200+mMenu.row*mHead.height);
+        Center(mText,mFrame,Text("esc-key")+": "+Text("Quit"),480-mText.height);
+    } else if(mMenu.page==frontend::Page::Profiles || mMenu.page==frontend::Page::Name || mMenu.page==frontend::Page::Reset) {
+        // 00429f60: portrait and name-panel geometry, no replacement art.
+        const auto& profile=mMenu.profiles.players[mMenu.profiles.selected];
+        mFrame.blit(mPortraits[mMenu.profiles.selected],268,192);
+        mFrame.blit(mNamePanel,228,342);
+        const auto name=mMenu.page==frontend::Page::Name?mMenu.nameEntry:profile.name;
+        mText.draw(mFrame,name,319-mText.measure(name)/2,356);
+        if(mMenu.page==frontend::Page::Profiles) {
+            if(int(mElapsed*25)%8<4) {
+                mText.draw(mFrame,"<",319-90-2*mText.measure("<"),356);
+                mText.draw(mFrame,">",319+90+mText.measure(">"),356);
+            }
+            mMiss.draw(mFrame,Text("del-key")+": "+Text("rename"),440,400);
+            mMiss.draw(mFrame,Text("r-key")+": "+Text("Reset"),440,400+mMiss.height);
+        } else if(mMenu.page==frontend::Page::Reset) {
+            mHead.draw(mFrame,Text("Cancel"),80,216);
+            mHead.draw(mFrame,Text("Reset"),80,216+mHead.height);
+            cursor(0,200+mMenu.row*mHead.height);
+        }
+        mText.draw(mFrame,Text("esc-key")+": "+Text("Cancel"),0,480-mText.height);
+        const auto accept=Text("rtn-key")+": "+Text(mMenu.page==frontend::Page::Name?"save":"Play");
+        mText.draw(mFrame,accept,640-mText.measure(accept),480-mText.height);
+        // 00429df0: show only the selected profile's unlocked chapter scores.
+        int y=202;
+        mText.draw(mFrame,Text("scores"),414-mText.measure(Text("scores"))/2,y);
+        for(int c=0;c<6;++c)if(profile.scores[c]>=0) {
+            y+=12;
+            mMiss.draw(mFrame,Text("mission"+std::to_string(c<2?1+c:c<4?102+c-2:202+c-4)),414,y);
+            const auto value=std::to_string(profile.scores[c]);
+            mMiss.draw(mFrame,value,414+128+std::max(0,72-mMiss.measure(value)),y);
+        }
+    } else if(mMenu.page==frontend::Page::Cities) {
+        // 00427fc0: three public enemies for the selected chapter, low at bottom.
+        const auto title=Text("high-scores");
+        mText.draw(mFrame,title,440+(184-mText.measure(title))/2,130);
+        const auto& table=mMenu.profiles.highScores[mMenu.city*2+mMenu.chapter];
+        for(int rank=0;rank<3;++rank)if(table[rank].score) {
+            const int y=178-rank*12;
+            mMiss.draw(mFrame,table[rank].name,440,y);
+            const auto value=std::to_string(table[rank].score);
+            mMiss.draw(mFrame,value,552+std::max(0,72-mMiss.measure(value)),y);
+        }
+        // FUN_004277c0: city order maps to icon fonts 4,1,3.
+        const int xs[]={470,80,368},ys[]={242,230,338},dx[]={20,8,0};
+        for(int i=0;i<=mMenu.lastCity();++i) {
+            mCity[i].draw(mFrame,std::string(1,char(int(mElapsed*25)%int(mCity[i].glyphs.size())+1)),xs[i],ys[i]);
+            int y=ys[i]+mCity[i].height;
+            const std::string name=Text("city"+std::to_string(i));
+            mText.draw(mFrame,name,xs[i]-mText.measure(name)/2,y);
+            if(i==mMenu.city) {
+                y+=mText.height;
+                for(int j=0;j<=mMenu.lastChapter();++j) {
+                    const int section=(i==0?1:i==1?102:202)+j;
+                    const std::string title=std::to_string(j+1)+": "+Text("mission"+std::to_string(section));
+                    mMiss.draw(mFrame,title,xs[i]+dx[i]-mMiss.measure(title)/2,y+j*mMiss.height);
+                }
+                cursor(xs[i]+dx[i]-69,y+mMenu.chapter*mMiss.height-32);
+            }
+        }
+        mText.draw(mFrame,Text("esc-key")+": "+Text("Cancel"),0,480-mText.height);
+        const auto s=Text("rtn-key")+": "+Text("Play");
+        mText.draw(mFrame,s,640-mText.measure(s),480-mText.height);
+    } else if(mMenu.page==frontend::Page::Options) {
+        Center(mHead,mFrame,Text("Options"),176);
+        const char* keys[]={"Sound","Music","Text","music-mode","trans-effects"};
+        for(int i=0;i<5;++i) {
+            const auto value=i<2 ? (mMenu.options[i]?std::to_string(mMenu.options[i]):Text("Off")) :
+                i==2 ? Text(mMenu.options[i]==1?"Slow":mMenu.options[i]==2?"Normal":"Fast") :
+                i==3 ? Text(mMenu.options[i]?"constant":"radio") : Text(mMenu.options[i]?"On":"Off");
+            mText.draw(mFrame,Text(keys[i])+": "+value,196,224+i*mText.height);
+        }
+        cursor(116,208+mMenu.row*mText.height);
+        mText.draw(mFrame,Text("esc-key")+": "+Text("Cancel"),0,480-mText.height);
+        const auto s=Text("rtn-key")+": "+Text("save");mText.draw(mFrame,s,640-mText.measure(s),480-mText.height);
+    } else {
+        // Original state 10: credits scroll two pixels per 25 Hz update.
+        mCreditsElapsed+=gTimeManager.mGameFrameDelta;
+        const int scroll=int(mCreditsElapsed*25)*2;
+        const int first=scroll/mText.height,offset=scroll%mText.height;
+        if(first>=int(CountOf(frontend::credits)))mQuitPending=true;
+        for(int i=0;i<12 && first+i<int(CountOf(frontend::credits));++i) {
+            const char* text=frontend::credits[first+i];
+            const bool name=*text=='@';if(name)++text;
+            mText.draw(mFrame,text,name?128:64,192-offset+i*mText.height,192);
+        }
+    }
+    mTexture->Upload(mFrame.pixels.data());
+    const auto& res=gGraphicsDevice.mScreenResolution;frontend::View v(res.x,res.y);
+    ImGui::GetBackgroundDrawList()->AddImage(mTexture,ImVec2(v.x,v.y),ImVec2(v.x+640*v.scale,v.y+480*v.scale));
+}
+void MainMenuGamestate::Tap(int px,int py) {
+    const auto& r=gGraphicsDevice.mScreenResolution;frontend::View v(r.x,r.y);int x,y;
+    if(!mReady || !v.point(px,py,x,y))return;
+    if(mMenu.page==frontend::Page::Quit) {Act(frontend::Action::Accept);return;}
+    if(y>=480-mText.height) {
+        Act(mMenu.page==frontend::Page::Main || x<320?frontend::Action::Back:frontend::Action::Accept);
+        return;
+    }
+    if(mMenu.page==frontend::Page::Main && x>=110 && x<600 && y>=216 && y<216+2*mHead.height) {
+        mMenu.row=(y-216)/mHead.height;Act(frontend::Action::Accept);
+    } else if(mMenu.page==frontend::Page::Options && x>=110 && y>=224 && y<224+5*mText.height) {
+        mMenu.row=(y-224)/mText.height;Act(x<320?frontend::Action::Left:frontend::Action::Right);
+    } else if(mMenu.page==frontend::Page::Profiles) {
+        if(x>=440 && y>=400 && y<400+2*mMiss.height)Act(y<400+mMiss.height?frontend::Action::Rename:frontend::Action::Reset);
+        else if(y>=192 && y<392)Act(x<319?frontend::Action::Left:frontend::Action::Right);
+    } else if(mMenu.page==frontend::Page::Reset && x<320 && y>=216 && y<216+2*mHead.height) {
+        mMenu.row=(y-216)/mHead.height;Act(frontend::Action::Accept);
+    } else if(mMenu.page==frontend::Page::Cities) {
+        const int xs[]={470,80,368},ys[]={242,230,338};
+        for(int i=0;i<=mMenu.lastCity();++i)if(x>=xs[i]-80 && x<xs[i]+140 && y>=ys[i] && y<ys[i]+mCity[i].height+mText.height+2*mMiss.height) {
+            const int top=ys[i]+mCity[i].height+mText.height;
+            mMenu.city=i;
+            if(y>=top)mMenu.chapter=std::min(mMenu.lastChapter(),(y-top)/mMiss.height);
+            return;
+        }
+    }
+}
+void MainMenuGamestate::OnGamestateInputEvent(KeyInputEvent& e) {
+    if(!e.mPressed)return;
+    switch(e.mKeycode) {
+        case eKeycode_UP:Act(frontend::Action::Up);break;
+        case eKeycode_DOWN:Act(frontend::Action::Down);break;
+        case eKeycode_LEFT:Act(frontend::Action::Left);break;
+        case eKeycode_RIGHT:Act(frontend::Action::Right);break;
+        case eKeycode_DELETE:if(mMenu.page==frontend::Page::Profiles)Act(frontend::Action::Rename);else return;break;
+        case eKeycode_BACKSPACE:Act(frontend::Action::Erase);break;
+        case eKeycode_R:if(mMenu.page==frontend::Page::Profiles)Act(frontend::Action::Reset);else return;break;
+        case eKeycode_ENTER:Act(frontend::Action::Accept);break;
+        case eKeycode_ESCAPE:Act(frontend::Action::Back);break;
+        default:return;
+    }e.SetConsumed();
+}
+void MainMenuGamestate::OnGamestateInputEvent(GamepadInputEvent& e) {
+    if(!e.mPressed)return;
+    switch(e.mButton) {
+        case eGamepadButton_DPAD_Up:Act(frontend::Action::Up);break;
+        case eGamepadButton_DPAD_Down:Act(frontend::Action::Down);break;
+        case eGamepadButton_DPAD_Left:Act(frontend::Action::Left);break;
+        case eGamepadButton_DPAD_Right:Act(frontend::Action::Right);break;
+        case eGamepadButton_A:case eGamepadButton_Start:Act(frontend::Action::Accept);break;
+        case eGamepadButton_B:Act(frontend::Action::Back);break;
+        default:return;
+    }e.SetConsumed();
+}
+void MainMenuGamestate::OnGamestateInputEvent(MouseButtonInputEvent& e) {
+    if(e.mPressed && e.mButton==eMButton_LEFT) {Tap(gInputs.mCursorPositionX,gInputs.mCursorPositionY);e.SetConsumed();}
+}
+void MainMenuGamestate::OnGamestateInputEvent(MouseMovedInputEvent&) {}
+void MainMenuGamestate::OnGamestateInputEvent(MouseScrollInputEvent&) {}
+void MainMenuGamestate::OnGamestateInputEvent(KeyCharEvent& e) {
+    if(mMenu.page==frontend::Page::Name){mMenu.character(e.mUnicodeChar);e.SetConsumed();}
+}
+void MainMenuGamestate::OnGamestateInputEventLost() {mStartPending=mQuitPending=false;}
