+++ b/src/police/PoliceRuntime.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "PoliceSystem.h"
+class Pedestrian;
+namespace gta { namespace police {
+// Desktop bridge; all policy not proved by the binary remains explicit intake.
+class PoliceRuntime {
+public:
+    explicit PoliceRuntime(GameEconomy& economy):system_(economy,4) {}
+    PoliceSystem& system() {return system_;}
+    void reset(int section);
+    void occupiedDriverTakeover(Pedestrian* actor,int model);
+    void update(); // caller supplies one engine mission update
+    bool death(int owner);
+    bool captured(int owner); // confirmed original capture, never proximity guessed
+private:
+    PoliceSystem system_;
+    int section_=1;
+    std::array<bool,4> representation2_{};
+    std::array<Action,4> placement_{};
+    std::array<bool,4> reported_{};
+    bool place(int owner,Action reason);
+    void clear(Pedestrian*);
+};
+}}
diff --git a/src/police/PoliceSystem.cpp b/src/police/PoliceSystem.cpp
new file mode 100755
index 0000000..ff0e6d8
--- /dev/null
+++ b/src/police/PoliceSystem.cpp
@@ -0,0 +1,177 @@
+#include "PoliceSystem.h"
+#include <cstdlib>
+#include <limits>
+#include <stdexcept>
+namespace gta { namespace police {
+namespace {
+long long distance(Cell a,Cell b) {
+    return std::max(std::llabs(static_cast<long long>(a.x)-b.x),std::llabs(static_cast<long long>(a.y)-b.y));
+}
+}
+std::optional<Cell> rankedRespawn(Cell from,std::vector<Cell> bases,
+    const std::function<std::optional<Cell>(Cell)>& scan) {
+    std::stable_sort(bases.begin(),bases.end(),[&](Cell a,Cell b){return distance(from,a)<distance(from,b);});
+    for(std::size_t rank=1;rank<bases.size();++rank) if(auto p=scan(bases[rank])) return p;
+    return {};
+}
+std::vector<int> roadblockOffsets(int width) {
+    std::vector<int> offsets;
+    for(int i=0;i<std::min(width,6);i+=2) offsets.push_back(i);
+    return offsets;
+}
+bool Roadblock::activate(int level,bool vehicle,bool enabled,int count) {
+    if(level<3 || !vehicle || !enabled) return false;
+    if(active) {timer=400; return false;}
+    if(count>=20) return false;
+    active=true; timer=400; return true;
+}
+bool Roadblock::update(bool highLevel,bool nearby) {
+    if(!active) return false;
+    if(nearby) timer=400;
+    else if(timer>std::numeric_limits<int>::min()) --timer;
+    if((timer>0 && highLevel) || nearby) return false;
+    active=false; return true; // caller must also prove original cleanup eligibility
+}
+PoliceSystem::PoliceSystem(GameEconomy& economy,std::size_t count):economy_(economy),players_(count),records_(count) {
+    if(count>4) throw std::invalid_argument("police has four response records");
+    for(std::size_t i=0;i<count;++i) (void)economy_.state(static_cast<int>(i));
+}
+void PoliceSystem::reset() {
+    std::fill(players_.begin(),players_.end(),Player{});
+    std::fill(records_.begin(),records_.end(),Record{});
+    groups_={}; pending_.clear(); queue_={};
+}
+Classification PoliceSystem::classify(int owner,int section,bool forceZero) {
+    economy_.classifyWantedInSection(owner,section,forceZero);
+    const int level=economy_.state(owner).wantedLevel;
+    int response=level;
+    if(section==102 || section==103) {static constexpr int table[]={0,1,2,4,6}; response=table[level];}
+    else if(section!=1 && section!=2) response=level>0?1:0;
+    records_.at(owner).response=response;
+    if(level!=0) records_.at(owner).delay=1; // 004133c0/004134d0/004135e0
+    for(auto& g:groups_) if(g.record==owner) {g.flag5=level==4; g.flag6=level>=3;}
+    return {level,response};
+}
+bool PoliceSystem::acceptedCrime(int owner,int crime) {
+    if(!economy_.acceptedCrime(owner,crime)) return false;
+    auto& r=records_.at(owner); r.crime=crime;
+    r.response=std::max(r.response,crime<7?3:6); return true;
+}
+bool PoliceSystem::occupiedDriverTakeover(int owner,int model,int section) {
+    return vehicleCrime(owner,-1,model,5,section,false);
+}
+bool PoliceSystem::queueCrime(int slot,int type,int entity,int crime,unsigned char countdown) {
+    if(slot<0 || slot>=4 || type<0 || type>2 || entity<0 || crime<2 || crime>9) return false;
+    auto& q=queue_[slot];
+    if(q.crime!=-1) return false;
+    q={type,entity,crime,0,countdown}; return true;
+}
+void PoliceSystem::updateCrimeQueue(const std::function<void(int,int,int)>& dispatch) {
+    for(auto& q:queue_) if(q.status==1) {
+        const auto old=q.countdown; --q.countdown;
+        if(old!=0) continue;
+        const auto event=q;
+        q.status=2; // must bypass duplicate suppression in reentrant intake
+        dispatch(event.type,event.entity,event.crime);
+        q.type=q.entity=q.crime=-1; q.countdown=255;
+    }
+}
+bool PoliceSystem::vehicleCrime(int owner,int entity,int model,int crime,int section,bool witness) {
+    if(owner<0 || static_cast<std::size_t>(owner)>=players_.size() || model==0x2f || crime<2 || crime>9) return false;
+    for(auto& q:queue_) if(q.entity==entity && q.type==0 && q.crime==crime && q.status<=1) {
+        q.status=1; return false;
+    }
+    auto& r=records_.at(owner);
+    const bool fresh=r.crime==0;
+    if(fresh && witness) {
+        auto& state=economy_.state(owner);
+        const int floor=(section==1 || section==2)?152:102;
+        if(state.wantedLevel==0 && state.wantedPoints<floor) economy_.witnessEscalation(owner,section);
+    }
+    if(!acceptedCrime(owner,crime)) return false;
+    r.type=0;
+    if(fresh) r.delay=witness?1:100;
+    if(classify(owner,section).level==0) {
+        std::vector<Unit> units; release(owner,units);
+    }
+    return true;
+}
+bool PoliceSystem::pedestrianCrime(int owner,int crime,int section) {
+    if(owner<0 || static_cast<std::size_t>(owner)>=players_.size() || crime<2 || crime>9) return false;
+    auto& r=records_.at(owner); const bool fresh=r.crime==0;
+    if(!acceptedCrime(owner,crime)) return false;
+    r.type=1; if(fresh) r.delay=200;
+    if(classify(owner,section).level==0) {std::vector<Unit> units; release(owner,units);}
+    return true;
+}
+bool PoliceSystem::beginDeath(int owner,bool repr2) {
+    auto& p=players_.at(owner);
+    if(p.phase!=Phase::Alive) return false;
+    p.clear=true; p.updates=1; p.deadline=repr2?87:100;
+    p.phase=economy_.consumeLife(owner)?Phase::Death:Phase::Terminal;
+    return true;
+}
+bool PoliceSystem::beginArrest(int owner,bool proven) {
+    auto& p=players_.at(owner);
+    if(!proven || p.phase!=Phase::Alive) return false;
+    p.clear=!economy_.state(owner).skipPenaltyOnce;
+    p.phase=Phase::Arrest1; return true;
+}
+Action PoliceSystem::updatePlayer(int owner) {
+    auto& p=players_.at(owner);
+    switch(p.phase) {
+    case Phase::Arrest1:p.phase=Phase::Arrest2; return Action::None;
+    case Phase::Arrest2:
+        economy_.resetState2(owner); p.phase=Phase::Respawn; return Action::ArrestRespawn;
+    case Phase::Death:
+        if(++p.updates>=p.deadline) {p.phase=Phase::Respawn; return Action::DeathRespawn;}
+        return Action::None;
+    case Phase::Terminal:return Action::GameOver;
+    default:return Action::None;
+    }
+}
+void PoliceSystem::respawned(int owner) {
+    auto& p=players_.at(owner);
+    if(p.phase!=Phase::Respawn) return;
+    economy_.clearWanted(owner); p=Player{};
+}
+bool PoliceSystem::gameOver(int owner) const {return players_.at(owner).phase==Phase::Terminal;}
+bool PoliceSystem::clearInventory(int owner) const {return players_.at(owner).clear;}
+bool PoliceSystem::waiting(int owner) const {return players_.at(owner).phase!=Phase::Alive;}
+bool PoliceSystem::allocate(int owner,Cell target,std::vector<Unit>& units) {
+    auto& r=records_.at(owner);
+    if(r.crime==0 || r.phase!=0) return false;
+    if(r.delay>std::numeric_limits<int>::min()) --r.delay;
+    if(r.delay>=1) return false;
+    auto it=std::find_if(groups_.begin(),groups_.end(),[](const Group& g){return g.status<=0;});
+    if(it==groups_.end() || it->status==0) return false;
+    if(r.type==2) {r.phase=1; return false;}
+    if(r.type!=0 && r.type!=1) return false;
+    const int index=static_cast<int>(it-groups_.begin());
+    it->status=1; it->record=owner;
+    for(int n=0;n<r.response;++n) {
+        Unit* best=nullptr; long long bestDist=std::numeric_limits<long long>::max();
+        for(auto& u:units) if(u.state==1 || u.state==4 || u.state==6) {
+            const auto d=std::llabs(static_cast<long long>(u.position.x)-target.x)+std::llabs(static_cast<long long>(u.position.y)-target.y);
+            if(d<bestDist) {best=&u; bestDist=d;}
+        }
+        if(best) {best->state=199; best->group=index;}
+        pending_.push_back({index,best?best->id:-1});
+    }
+    r.phase=1; return true;
+}
+bool PoliceSystem::completeAssignment(int index,int unit) {
+    auto& g=groups_.at(index);
+    auto it=std::find_if(pending_.begin(),pending_.end(),[&](const Assignment& a){return a.group==index && a.unit==unit;});
+    if(g.status<=0 || unit<0 || it==pending_.end() || std::find(g.members.begin(),g.members.end(),unit)!=g.members.end()) return false;
+    g.members.push_back(unit); pending_.erase(it); return true;
+}
+void PoliceSystem::release(int owner,std::vector<Unit>& units) {
+    for(std::size_t index=0;index<groups_.size();++index) if(groups_[index].record==owner) {
+        for(auto& u:units) if(u.group==static_cast<int>(index)) {u.group=-1; u.state=4;}
+        pending_.erase(std::remove_if(pending_.begin(),pending_.end(),[&](const Assignment& a){return a.group==static_cast<int>(index);}),pending_.end());
+        groups_[index]=Group{};
+    }
+    records_.at(owner)=Record{};
+}
+}}
