+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace driving {
+struct Result { float acceleration; float steering; };
+inline Result Resolve(float acceleration, float steering, float leftX,
+                      float rightY, float leftTrigger, float rightTrigger)
+{
+    if (std::fabs(leftX) > 0.2f)
+    {
+        const float amount = std::min((std::fabs(leftX) - 0.2f) / 0.7f, 1.0f);
+        steering = leftX > 0 ? amount : -amount;
+    }
+    // GLFW stick Y is positive down. Rescale outside the dead zone to 0..1.
+    // Override both triggers, including the touch aim stick's synthetic fire trigger.
+    if (std::fabs(rightY) > 0.2f)
+    {
+        const float amount = std::min((std::fabs(rightY) - 0.2f) / 0.8f, 1.0f);
+        return {rightY < 0 ? amount : -amount, steering};
+    }
+    if (rightTrigger > 0.1f) acceleration = std::max(acceleration, rightTrigger);
+    if (leftTrigger > 0.1f) acceleration = std::max(-1.0f, std::min(acceleration - leftTrigger, 1.0f));
+    return {acceleration, steering};
+}
+}
