+void FollowCameraController::ApplyHeading(float headingRadians)
+{
+    const glm::vec3 front = -SceneAxisY; // looking straight down
+    // screen-up = heading direction in world space (north-up classic view: heading = -90 degrees)
+    const glm::vec3 up = glm::vec3(cosf(headingRadians), 0.0f, sinf(headingRadians));
+    const glm::vec3 right = glm::cross(front, up);
+    mCamera->SetOrientation(front, right, up);
