+void MainMenuGamestate::LoadControls() {
+    mCapture.cancel();mControlsTop=0;mControlsNotice.clear();mControlsNoticeTime=0;
+    cxx::json_document defaults;
+    mDefaultsReady=gFiles.ReadConfig("config/inputs.json.default",defaults);
+    auto defaultsPlayer=defaults.get_root_node()["player1"];
+    mDefaultsReady=mDefaultsReady && bool(cxx::json_node_object(defaultsPlayer)) && bool(cxx::json_node_array(defaultsPlayer["actions"]));
+    mControlsDefaults.Clear();
+    if(mDefaultsReady)mControlsDefaults.LoadConfig(defaultsPlayer);
+    const std::string path=gFiles.mWorkingDirectoryPath+"/config/inputs.json";
+    errno=0;std::ifstream in(path,std::ios::binary);
+    const bool missing=!in && errno==ENOENT;
+    std::string content;
+    if(in) content.assign(std::istreambuf_iterator<char>(in),std::istreambuf_iterator<char>());
+    else if(missing && mDefaultsReady) defaults.dump_document(content);
+    mControlsWritable=mControlsDocument.parse_document(content);
+    auto root=mControlsDocument.get_root_node();auto player=root["player1"];
+    mControlsWritable=mControlsWritable && bool(cxx::json_node_object(root)) && bool(cxx::json_node_object(player)) && bool(cxx::json_node_array(player["actions"]));
+    mControlsMapping.Clear();
+    if(mControlsWritable)mControlsMapping.LoadConfig(player);
+    else {mControlsMapping=mControlsDefaults;mControlsNotice="Cannot read inputs.json; file preserved";mControlsNoticeTime=5;}
+}
+bool MainMenuGamestate::SaveControls(const InputActionsMapping& mapping) {
+    if(!mControlsWritable)return false;
+    std::string content;mControlsDocument.dump_document(content);
+    cxx::json_document document(content);
+    auto player=document.get_root_node()["player1"];
+    auto copy=mapping;copy.SaveConfig(player);document.dump_document(content);
+    const auto path=gFiles.mWorkingDirectoryPath+"/config/inputs.json",temp=path+".tmp";
+    std::ofstream out(temp,std::ios::binary|std::ios::trunc);
+    if(out)out<<content;
+    out.flush();const bool good=bool(out);out.close();
+#ifdef _WIN32
+    const bool saved=good && out && MoveFileExA(temp.c_str(),path.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH);
+#else
+    const bool saved=good && out && std::rename(temp.c_str(),path.c_str())==0;
+#endif
+    if(!saved) {
+        std::remove(temp.c_str());mControlsNotice="Cannot save inputs.json; change cancelled";mControlsNoticeTime=5;return false;
+    }
+    mControlsDocument.parse_document(content);mControlsMapping=mapping;
+    if(auto* player1=gCarnageGame.mHumanPlayers[0]) {
+        player1->InputEventLost();player1->mActionsMapping=mapping;
+    }
+    mControlsNotice="Controls saved";mControlsNoticeTime=2;return true;
+}
+void MainMenuGamestate::ControlsAction(frontend::Action action) {
+    if(mCapture.active) {if(action==frontend::Action::Back)mCapture.cancel();return;}
+    if(action==frontend::Action::Back) {mMenu.act(action);return;}
+    if(action==frontend::Action::Up || action==frontend::Action::Down) {
+        mMenu.row=(mMenu.row+21+(action==frontend::Action::Up?-1:1))%21;return;
+    }
+    if(action!=frontend::Action::Accept)return;
+    if(!mControlsWritable) {mControlsNotice="Cannot read inputs.json; file preserved";mControlsNoticeTime=5;return;}
+    if(mMenu.row==20) {
+        if(!mDefaultsReady) {mControlsNotice="Cannot read inputs.json.default";mControlsNoticeTime=5;return;}
+        auto mapping=mControlsMapping;mapping.RestoreGamepadButtons(mControlsDefaults);SaveControls(mapping);return;
+    }
+    const int pad=mControlsMapping.mGamepadID;
+    if(pad<0 || pad>=eGamepadID_COUNT || !gInputs.mGamepadsState[pad].mPresent) {
+        mControlsNotice="Connect Player 1 controller first";mControlsNoticeTime=3;return;
+    }
+    std::array<bool,eGamepadButton_COUNT> held{};
+    std::copy_n(gInputs.mGamepadsState[pad].mButtons,eGamepadButton_COUNT,held.begin());
+    mCapture.begin(pad,held);mControlsNoticeTime=0;
+}
+int MainMenuGamestate::ControlsVisibleRows() const {
+    return std::max(1,std::min(21,(398-236)/std::max(1,mMiss.height+4)));
+}
+void MainMenuGamestate::DrawControls() {
+    Center(mText,mFrame,"Player 1 - Controls",176);
+    const int visible=ControlsVisibleRows(),step=mMiss.height+4;
+    mControlsTop=std::max(0,std::min(mControlsTop,21-visible));
+    if(mMenu.row<mControlsTop)mControlsTop=mMenu.row;
+    if(mMenu.row>=mControlsTop+visible)mControlsTop=mMenu.row-visible+1;
+    Center(mMiss,mFrame,mMenu.row<20?controlsRows[mMenu.row].group:"Defaults",206);
+    auto fit=[&](std::string text,int width) {
+        while(!text.empty() && mMiss.measure(text)>width)text.pop_back();return text;
+    };
+    for(int i=mControlsTop;i<std::min(21,mControlsTop+visible);++i) {
+        const int y=236+(i-mControlsTop)*step;
+        std::string label=i<20?std::string(controlsRows[i].group)+": "+controlsRows[i].label:"Restore defaults";
+        mMiss.draw(mFrame,fit(label,360),50,y);
+        if(i<20) {
+            const auto button=mControlsMapping.mActionToKeys[controlsRows[i].action].mGpButton;
+            mMiss.draw(mFrame,fit(mCapture.active && i==mMenu.row?"Press a button...":ButtonLabel(button),180),430,y);
+        }
+        if(i==mMenu.row)mMiss.draw(mFrame,">",24,y);
+    }
+    Center(mMiss,mFrame,std::to_string(mMenu.row+1)+" / 21  -  Up / Down to scroll",404);
+    Center(mMiss,mFrame,mCapture.active?"Press a gamepad button. Esc / B cancels":
+        mControlsNoticeTime>0?mControlsNotice:"Enter / A: assign     Esc / B: back",426);
+    Center(mMiss,mFrame,"Analog sticks and analog triggers keep their behavior",448);
+}
