+            }
+            Once("kill-obj","UNRESOLVED KILL_OBJ on a record without a mission-created object (004787d0)");
+            return WorldResult::Unresolved;
+        }
+        if(handle<0) return WorldResult::Failure;
+        if(entity->type!=2 && handle<0x800) {
+            // Never dropped: the value is still the declared object type, which the original
+            // passes to 0044eb90 as an object slot. Slots are handed out from 0xdab downward
