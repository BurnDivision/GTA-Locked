diff --git a/src/android/touch_sticks.h b/src/android/touch_sticks.h
new file mode 100644
index 0000000..255e8ee
--- /dev/null
+++ b/src/android/touch_sticks.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+namespace touch_sticks {
+struct Vector { float x, y; Vector(float a = 0, float b = 0) : x(a), y(b) {} };
+// Radial 20% dead zone, preserving physical deflection beyond it; positive Y is down.
+inline Vector Deflection(float x, float y, float cx, float cy, float radius) {
+    if (radius <= 0) return {};
+    float dx = (x-cx)/radius, dy = (y-cy)/radius;
+    float length = std::sqrt(dx*dx + dy*dy);
+    if (length <= .2f) return {};
+    if (length > 1) { dx /= length; dy /= length; }
+    return {dx, dy};
+}
+inline bool Firing(Vector v) { return v.x*v.x + v.y*v.y > .6f*.6f; }
+struct Stick {
+    bool active = false;
+    std::int64_t owner = 0;
+    Vector value;
+    bool Begin(std::int64_t id, float x, float y, float cx, float cy, float radius) {
+        if (active) return false;
+        active = true; owner = id;
+        value = Deflection(x,y,cx,cy,radius);
+        return true;
+    }
+    void Move(std::int64_t id, float x, float y, float cx, float cy, float radius) {
+        if (active && owner == id) value = Deflection(x,y,cx,cy,radius);
+    }
+    void End(std::int64_t id) { if (active && owner == id) Reset(); }
+    void Reset() { active = false; value = {}; }
+};
+}
