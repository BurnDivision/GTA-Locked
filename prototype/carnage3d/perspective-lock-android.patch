diff --git a/src/HUDPresentation.h b/src/HUDPresentation.h
new file mode 100755
index 0000000..c5466fa
--- /dev/null
+++ b/src/HUDPresentation.h
@@ -0,0 +1,171 @@
+#pragma once
+
+#include "FrontendProfile.h"
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <string>
+#include <vector>
+#include <glm/vec2.hpp>
+#include <glm/vec4.hpp>
+
+namespace hud {
+enum class TextArea { Subtitle, Pager, Big };
+
+// gta.exe 004821c0: P_BRIEF modes 0/2 use the pager; MOBILE is
+// mode 3 -> 00481d40(2), a SUB-font bottom caption, not the pager.
+inline TextArea briefingArea(const std::string& opcode) {
+    if (opcode == "MESSAGE_BRIEF") return TextArea::Big;
+    if (opcode == "P_BRIEF" || opcode == "P_BRIEF_TIMED") return TextArea::Pager;
+    return TextArea::Subtitle;
+}
+
+// 004824a0 -> 00486760 -> 0047dab0: English pager text is uppercased.
+// PAGER fonts have no lowercase ink. Keep subtitles in their original case.
+inline std::string pagerText(std::string text) {
+    for (char& c : text) if (c >= 'a' && c <= 'z') c -= 'a' - 'A';
+    return text;
+}
+
+// The original length/text-speed timer is retained as a lower bound. This
+// reading-time floor is a presentation approximation, not recovered speech timing.
+inline double readableSeconds(std::size_t length, int speed) {
+    return std::max<double>(frontend::messageSeconds(length, speed),
+                            3.0 + static_cast<double>(length) / 14.0);
+}
+
+// Each entry gets its entire lifetime after the preceding entry finishes.
+// Units are seconds for captions and pixels travelled for the pager.
+class TextQueue {
+public:
+    struct Entry { std::string text; double duration; double elapsed = 0.0; };
+    void push(const std::string& text, double duration) {
+        if (!text.empty() && std::isfinite(duration) && duration > 0.0)
+            entries.push_back({text, duration});
+    }
+    Entry* current() { return entries.empty() ? nullptr : &entries.front(); }
+    const Entry* current() const { return entries.empty() ? nullptr : &entries.front(); }
+    void advance(double delta) {
+        if (!std::isfinite(delta) || delta <= 0.0) return;
+        while (!entries.empty()) {
+            auto& entry = entries.front();
+            const double remaining = std::max(0.0, entry.duration - entry.elapsed);
+            if (delta < remaining) { entry.elapsed += delta; break; }
+            delta -= remaining;
+            entries.pop_front();
+        }
+    }
+    void cancel(const std::string& text) {
+        entries.erase(std::remove_if(entries.begin(), entries.end(),
+            [&](const Entry& entry) { return entry.text == text; }), entries.end());
+    }
+    void clear() { entries.clear(); }
+private:
+    std::deque<Entry> entries;
+};
+
+// FXT strings use single-byte ANSI characters. Measure using the rendering font
+// rather than a character-count estimate; preserve explicit paragraph breaks.
+template<class Measure>
+std::vector<std::string> wrapText(const std::string& text, int width, Measure measure) {
+    std::vector<std::string> lines;
+    std::string line;
+    const auto flush = [&]() { lines.push_back(line); line.clear(); };
+    width = std::max(1, width);
+    for (std::size_t pos = 0; pos < text.size();) {
+        const char ch = text[pos];
+        if (ch == '\n') { flush(); ++pos; continue; }
+        if (ch == ' ' || ch == '\t' || ch == '\r') { ++pos; continue; }
+        const auto end = text.find_first_of(" \t\r\n", pos);
+        const auto count = (end == std::string::npos ? text.size() : end) - pos;
+        const std::string word = text.substr(pos, count);
+        pos += count;
+        if (!line.empty() && measure(line + " " + word) <= width) {
+            line += " " + word;
+            continue;
+        }
+        if (!line.empty()) flush();
+        for (char letter : word) {
+            if (!line.empty() && measure(line + letter) > width) flush();
+            line += letter;
+        }
+    }
+    if (!line.empty()) flush();
+    return lines;
+}
+
+struct SubtitleLayout {
+    std::vector<std::string> pages;
+    std::vector<double> seconds;
+    double duration = 0.0;
+    std::size_t pageAt(double elapsed) const {
+        std::size_t page = 0;
+        while (page + 1 < pages.size() && elapsed >= seconds[page]) {
+            elapsed -= seconds[page++];
+        }
+        return page;
+    }
+};
+
+template<class Measure>
+SubtitleLayout layoutSubtitle(const std::string& text, int width, int maxLines,
+                              int speed, Measure measure) {
+    SubtitleLayout result;
+    const auto lines = wrapText(text, width, measure);
+    maxLines = std::max(1, maxLines);
+    for (std::size_t first = 0; first < lines.size(); first += maxLines) {
+        std::string page;
+        const auto end = std::min(lines.size(), first + maxLines);
+        for (auto i = first; i < end; ++i) {
+            if (i != first) page += '\n';
+            page += lines[i];
+        }
+        result.pages.push_back(page);
+        result.seconds.push_back(readableSeconds(page.size(), speed));
+        result.duration += result.seconds.back();
+    }
+    return result;
+}
+
+struct TargetMarker {
+    glm::vec2 position{0.0f};
+    float radians = 0.0f; // screen-space direction: zero points right
+    bool edge = false;
+    bool valid = false;
+};
+
+// Work in the HUD's LOCAL LOGICAL viewport. Homogeneous X/Y retain the bearing
+// behind the camera, where dividing by negative W would reverse the pointer.
+// Rectangular edge intersection is an adaptation to this perspective camera;
+// gta.exe 00486220 instead positions its arrow along the player-target bearing.
+inline TargetMarker targetMarker(const glm::vec4& clip, float width, float height,
+                                 float inset) {
+    TargetMarker result;
+    if (!std::isfinite(width) || !std::isfinite(height) || width <= 0 || height <= 0 ||
+        !std::isfinite(inset) || !std::isfinite(clip.x) || !std::isfinite(clip.y) ||
+        !std::isfinite(clip.z) || !std::isfinite(clip.w)) return result;
+    const glm::vec2 center(width * 0.5f, height * 0.5f);
+    const glm::vec2 limits(std::max(0.0f, center.x - std::max(0.0f, inset)),
+                           std::max(0.0f, center.y - std::max(0.0f, inset)));
+    glm::dvec2 bearing(static_cast<double>(clip.x) * center.x,
+                       -static_cast<double>(clip.y) * center.y);
+    result.valid = true;
+    if (clip.w > 0.00001f) {
+        const glm::dvec2 offset = bearing / static_cast<double>(clip.w);
+        if (clip.z >= -clip.w && clip.z <= clip.w &&
+            std::abs(offset.x) <= limits.x && std::abs(offset.y) <= limits.y) {
+            result.position = center + glm::vec2(offset);
+            return result;
+        }
+    }
+    result.edge = true;
+    const double magnitude = std::max(std::abs(bearing.x), std::abs(bearing.y));
+    if (magnitude > 0.00001f) bearing /= magnitude;
+    else bearing = glm::dvec2(0.0, 1.0);
+    result.radians = std::atan2(bearing.y, bearing.x);
+    const double tx = bearing.x == 0 ? 1e300 : limits.x / std::abs(bearing.x);
+    const double ty = bearing.y == 0 ? 1e300 : limits.y / std::abs(bearing.y);
+    result.position = center + glm::vec2(bearing * std::min(tx, ty));
+    return result;
+}
+}
