+        auto* block=gGameMap.GetBlockInfo(x,y,INVERT_MAP_LAYER(layer));
+        if(block->mIsFlat || block->mSlopeType) {
+            Once("parked-terrain","PARKED_ON sloped/flat-bit terrain branch unresolved");
+            return WorldResult::Unresolved;
+        }
+        // The original overlap query uses original vehicle geometry. Until
+        // that query is mapped, an existing car anywhere could require its
+        // retention/removal rules. Only the empty-vehicle-list case is proved.
+        for(auto* existing:gGameObjectsManager.mVehiclesList)
+            if(!existing->IsMarkedForDeletion()) {
+                Once("parked-vehicles","PARKED_ON existing-vehicle spatial cleanup unresolved");
+                return WorldResult::Unresolved;
+            }
