+
+void HUDPagerMessage::UpdateTextScroll(float dt)
+{
+    // Original 00486430: one, two or three pixels per 25 Hz update.
+    const float speed = 25.0f * frontend::textPixelsPerTick(gCvarTextSpeed.mValue);
+    mMessages.advance(dt * speed);
+    const auto* entry = mMessages.current();
+    SetVisible(entry != nullptr);
+    mMessageText.SetText(entry ? hud::pagerText(entry->text) : "");
+    mMessageText.SetPosition(Point(entry ? mMessageContainer.mMaxSize.x -
+        static_cast<int>(entry->elapsed) : mMessageContainer.mMaxSize.x, 0));
+}
+
+void HUDPagerMessage::UpdatePagerFlash(float dt)
+{
+    static const float PagerFlashStateChangeTime = 0.5f; // seconds
+    mFlashTimeDelta += dt;
+    if (mFlashTimeDelta > PagerFlashStateChangeTime)
+    {
+        mFlashTimeDelta = 0.0f;
+        mFlash.SetVisible(!mFlash.IsVisible());
+    }
+}
