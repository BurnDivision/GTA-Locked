+        // do not exist in this engine; no invented seconds conversion.
+        Once("brief-presentation","Mission text uses HUD big-font presentation; speech and briefing duration unsupported");
+        return token=="FRENZY_BRIEF"?WorldResult::Success:WorldResult::Done;
+    }
