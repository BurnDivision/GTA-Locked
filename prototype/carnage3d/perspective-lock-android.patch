+++ b/src/mission/PhoneRules.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace mission {
+inline bool phoneNear(int px,int py,int x,int y) {
+    return px-16<x && x<px+16 && py-16<y && y<py+16;
+}
+inline bool phoneArea(int px64,int py64,int x,int y,int radius) {
+    const int px=static_cast<int>(std::floor(px64/64.0)), py=static_cast<int>(std::floor(py64/64.0));
+    return x-radius<=px && px<=x+radius && y-radius<=py && py<=y+radius;
+}
+// Engine association/driver state projects the recovered sentinel and ownership.
+// Numeric original states 6/7 and field+18 have no proven engine mapping.
+inline int phoneEligibility(int requested,bool associated,bool driver,bool originalVehicleState) {
+    if(requested==-1) return 1;
+    if(requested==0) return associated && driver ? 1:0;
+    if(requested==1) return !associated ? 1:0;
+    if(requested==2) return originalVehicleState ? 2:0;
+    return 0;
+}
+class MissionClock {
+    double remainder_=0;
+public:
+    int advance(float dt) {
+        if(!std::isfinite(dt) || dt<0) return 0;
+        remainder_+=std::min(static_cast<double>(dt),8.0/25.0);
+        const int steps=std::min(8,static_cast<int>((remainder_+1e-9)*25));
+        remainder_-=steps/25.0; return steps;
+    }
+};
+}
