+}
+GameObject* CarnageMissionWorld::ResolveObject(const Entity& e) const {
+    // Only handles allocated by this adapter are trusted; declaration values
+    // (models, counters) must never alias another engine object's ID.
+    switch(e.type) {
+    case 0: case 2: case 3: case 5: case 6: case 0x12: case 0x15: case 0x16: case 0x1b: case 99: break;
+    default: return nullptr; // value is a model, counter or trigger handle
+    }
+    if(!e.value || *e.value<0 || !ownedObjects_.count(static_cast<unsigned>(*e.value))) return nullptr;
+    auto* o=gGameObjectsManager.GetGameObjectByID(static_cast<unsigned>(*e.value));
+    return o && !o->IsMarkedForDeletion()?o:nullptr;
+}
+std::optional<glm::vec3> CarnageMissionWorld::ResolvePosition(const Entity& e) const {
+    // 0043e680 case9 reads the loader XYZ <<6, independent of runtime handle.
+    if(e.declaration.token=="DOOR") return DeclarationPosition(e.declaration);
+    if(auto* object=ResolveObject(e)) return object->mTransform.mPosition;
+    if(e.declaration.token=="POINT" || e.declaration.token=="TELEPHONE" || e.declaration.token=="LOCATION")
+        return DeclarationPosition(e.declaration);
+    return {};
+}
+Pedestrian* CarnageMissionWorld::SpawnPedestrian(const glm::vec3& position,int remap) {
+    if(!gGameMap.IsLoaded() || !gGameMap.mStyleData.IsLoaded() || remap<NO_REMAP || remap>=MAX_PED_REMAPS) {
+        Once("ped-spawn","Ped spawn requires loaded style and a valid pedestrian palette"); return nullptr;
+    }
+    auto* ped=gGameObjectsManager.CreatePedestrian(position,cxx::angle_t::from_degrees(0),ePedestrianType_Civilian,remap);
+    if(ped) {
+        // HandleSpawn chooses a civilian palette; the script's explicit
+        // remap is applied afterwards, including the unremapped value.
+        ped->SetRemap(remap);
+        ownedObjects_.insert(ped->mObjectID); missionEntities_.insert(ped->mObjectID);
+    }
+    return ped;
+}
+bool CarnageMissionWorld::EmptySpawn(int x,int y,int z) {
+    // 004770a0 is not a no-op. Only the provably empty case is projected
+    // here; refuse candidates requiring original spatial/cleanup flags.
+    for(auto* object:gGameObjectsManager.mAllObjects) {
+        if(object->IsMarkedForDeletion()) continue;
+        if(object->mClassID==eGameObjectClass_Pedestrian &&
+           static_cast<Pedestrian*>(object)->IsHumanPlayerCharacter()) continue; // O=0x25
+        const auto& at=object->mTransform.mPosition;
+        if(!std::isfinite(at.x) || !std::isfinite(at.y) || !std::isfinite(at.z)) return false;
+        const auto ox=Convert::MetersToMapUnits(at.x),oy=Convert::MetersToMapUnits(at.z);
+        const auto oz=MAP_LAYERS_COUNT*64-1-Convert::MetersToMapUnits(at.y)*64;
+        if(object->mClassID==eGameObjectClass_Car) {
+            auto* car=static_cast<Vehicle*>(object);
+            if(!car->mCarInfo) return false;
+            // 00435e00, as for PARKED_ON: a car is in the cell when a corner or
+            // the centre of its box lies in it, on the same layer.
+            if(std::floor(oz/64)==std::floor((z-1)/64.0)) {
+                const auto cx=std::llround(ox*pickup::cell),cy=std::llround(oy*pickup::cell);
+                const int cw=Convert::MetersToPixels(car->mCarInfo->mDimensions.x)/2;
+                const int cd=Convert::MetersToPixels(car->mCarInfo->mDimensions.z)/2;
+                const int ca=static_cast<int>(std::lround((90-car->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+                const auto shape=pickup::box(cx,cy,0,cw,cd,ca);
+                for(const auto& point:shape.p)
+                    if(point.x>=0 && point.y>=0 && point.x/pickup::cell==x/64 && point.y/pickup::cell==y/64) return false;
+            }
+        } else if(std::floor(ox)==x/64 && std::floor(oy)==y/64 &&
+                  std::floor(oz/64)==z/64) return false;
+    }
+    return true;
+}
+Vehicle* CarnageMissionWorld::SpawnVehicle(const glm::vec3& position,int model,int heading) {
+    if(!gGameMap.IsLoaded() || !gGameMap.mStyleData.IsLoaded()) return nullptr;
+    // Descriptor overload avoids the enum overload's assert on absent models.
+    for(auto& desc:gGameMap.mStyleData.mVehicles) if(static_cast<int>(desc.mModelID)==model) {
+        auto* car=gGameObjectsManager.CreateVehicle(position,-Convert::Fix16ToAngle(static_cast<unsigned short>(heading)),&desc);
+        if(car) {ownedObjects_.insert(car->mObjectID); missionEntities_.insert(car->mObjectID);}
+        return car;
+    }
+    Once("vehicle-model:"+std::to_string(model),"Vehicle model absent from current style"); return nullptr;
+}
+WorldResult CarnageMissionWorld::execute(WorldRequest& r) {
+    const auto& token=r.token; auto& i=r.instruction;
+    if(doorUpdateUnresolved_) return WorldResult::Unresolved;
+    auto found=r.entities.find(i.A);
