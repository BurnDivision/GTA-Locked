new file mode 100755
index 0000000..0f786bb
--- /dev/null
+++ b/src/mission/GameEconomy.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace gta {
+// Recovered fields; raw byte/word storage preserves executable wrapping.
+struct EconomyState {
+    std::int32_t score=0;             // 0074f23c; normal init 00463290
+    std::uint16_t multiplier=1;        // 0074f240; normal init 00463290
+    std::int32_t previousEvent=0;      // 0074f2b8; cleared by 00464880
+    std::uint16_t run=0, expiry=0;      // 0074f2bc/0074f2b4
+    std::int16_t event24Value=0;        // 0074f2c8; caller-owned input
+    std::int16_t wantedPoints=0;       // 0074f298; 004617e0
+    std::int32_t wantedLevel=0;        // 0074f29c; 00461910
+    std::uint8_t lives=4;              // 0074f2df; normal-mode init 00463290
+    bool skipPenaltyOnce=false;        // 0074f242; 00464880
+};
+struct EventAward {
+    std::int32_t primary=0, bonus=0; // display amounts BEFORE score clamp
+    bool bonusTriggered=false;      // text key 004b221c, event7/run7
+};
+class GameEconomy {
+public:
+    // One record per explicitly participating player; no guessed maximum.
+    explicit GameEconomy(std::size_t participants): players_(participants) {}
+    EconomyState& state(int owner);
+    const EconomyState& state(int owner) const;
+    std::int32_t score(int owner) const;
+    // VM-compatible calls. reward implements primitive even for negative bases;
+    // VM is responsible for only paying positive E on decoded reward paths.
+    std::int32_t reward(int owner,std::int32_t base);
+    void deduct(int owner,std::int32_t cost);
+    void incrementMultiplier(int owner);
+    void halveMultiplier(int owner);
+    void missionEnd(int owner,std::int32_t e);
+    EventAward event(int owner,std::int32_t eventID,int methodID);
+    void tickCombo(int owner); // update count; NOT seconds
+    void addLife(int owner);
+    bool consumeLife(int owner); // life-counter tail only, no inventory cleanup
+    void resetState2(int owner); // economy subset; caller proves state2 entered
+    void addWantedPoints(int owner,std::int32_t delta);
+    void clearWanted(int owner);
+    void setWantedLevel(int owner,std::int32_t level);
+    static int classifyWanted(std::int16_t points,bool forceZero=false);
+    void classifyWantedNow(int owner,bool forceZero=false);
+    void classifyWantedInSection(int owner,int section,bool forceZero=false);
+    // Caller MUST first apply original ownership/witness/duplicate gates.
+    // Only points, not score or police-record mutations. Unknown ID -> false.
+    bool acceptedCrime(int owner,int crimeID);
+    void bankRobbery(int owner); // opcode76 direct effect; crime9 separately gated
+    void witnessEscalation(int owner,int section); // caller proves witness branch
+    static constexpr bool hasUnresolvedRules=true;
+    // TODO-evidence:004136c0 gates/vehicle mapping;00464880 reset entry;
+    // 004133c0 classifier cadence;004601a0/00460500 fees/respawn;
+    // 00462000 local audio/frenzy effects; natural wanted decay untraced.
+private:
+    std::vector<EconomyState> players_;
+};
+}
diff --git a/src/mission/MissionScript.cpp b/src/mission/MissionScript.cpp
new file mode 100755
index 0000000..b8b1f7f
--- /dev/null
+++ b/src/mission/MissionScript.cpp
@@ -0,0 +1,94 @@
+#include "MissionScript.h"
+#include <regex>
+#include <sstream>
+#include <stdexcept>
+#include <utility>
+
+namespace mission {
+namespace {
+std::string trim(const std::string& s) {
+    const auto first = s.find_first_not_of(" \t\r\n");
+    if (first == std::string::npos) return {};
+    return s.substr(first, s.find_last_not_of(" \t\r\n") - first + 1);
+}
+void tally(Inventory& inventory, const std::string& token, std::size_t line) {
+    auto& entry = inventory[token];
+    if (entry.count == 0) entry.firstLine = line;
+    ++entry.count;
+}
+std::vector<std::string> words(const std::string& text) {
+    std::istringstream input(text);
+    std::vector<std::string> result;
+    for (std::string word; input >> word;) result.push_back(word);
+    return result;
+}
+}
+MissionScript MissionScript::parse(std::istream& input) {
+    const std::regex header(R"(^\[([^\[\]]+)\]$)");
+    const std::regex declaration(R"(^([0-9]+)\s+(?:([+-]?[0-9]+)\s*)?(\([^()]*\))\s+([A-Z_][A-Z_0-9]*)(\s.*)?$)");
+    const std::regex instruction(R"(^([0-9]+)\s+([A-Z_][A-Z_0-9]*)(\s.*)?$)");
+    const std::regex title(R"(^[^,]+,\s*[0-9]+,\s*[^,\s]+\.[cC][mM][pP],\s*[+-]?[0-9]+,\s*$)");
+    const std::regex config(R"(^[0-9]+(?:\s+[0-9]+){5}$)");
+    // The original data has one fused terminator/header line ("-1[1003]"): it ends the current
+    // section and starts the next one. The marker is kept on the section it terminates.
+    const std::regex marker(R"(^-1(?:\[([^\[\]]+)\])?$)");
+    MissionScript result;
+    for (std::string raw; std::getline(input, raw);) {
+        const auto line = ++result.lineCount;
+        auto text = trim(raw);
+        if (text.empty()) continue;
+        if (text == std::string(1, '\x1a')) {
+            if (!result.sections.empty()) result.sections.back().markers.push_back({line, raw});
+            else result.unparsed.push_back({line, raw});
+            continue;
+        }
+        std::smatch match;
+        if (std::regex_match(text, match, header)) {
+            Section section;
+            section.line = line; section.raw = raw; section.name = match[1].str();
+            result.sections.push_back(std::move(section));
+            continue;
+        }
+        if (result.sections.empty()) { result.unparsed.push_back({line, raw}); continue; }
+        auto& section = result.sections.back();
+        // Match against left-trimmed input to keep trailing operand whitespace exact.
+        auto body = raw.substr(raw.find_first_not_of(" \t"));
+        if (!body.empty() && body.back() == '\r') body.pop_back();
+        bool isDeclaration = std::regex_match(body, match, declaration);
+        if (isDeclaration || std::regex_match(body, match, instruction)) {
+            Record record;
+            record.line = line; record.raw = raw; record.label = match[1].str();
+            if (isDeclaration) {
+                record.prefix = match[2].str(); record.coordinates = match[3].str();
+                record.token = match[4].str(); record.rawOperands = match[5].str();
+            } else { record.token = match[2].str(); record.rawOperands = match[3].str(); }
+            record.operands = words(record.rawOperands);
+            tally(section.tokens, record.token, line); tally(result.tokens, record.token, line);
+            if (isDeclaration) section.declarations.push_back(std::move(record));
+            else {
+                section.instructionsByLabel[record.label].push_back(section.instructions.size());
+                section.instructions.push_back(std::move(record));
+            }
+        } else if (std::regex_match(text, match, marker)) {
+            section.markers.push_back({line, raw});
+            if (match[1].matched) {
+                Section next;
+                next.line = line; next.raw = raw; next.name = match[1].str();
+                result.sections.push_back(std::move(next));
+            }
+        }
+        else if (std::regex_match(text, title) || std::regex_match(text, config)) section.metadata.push_back({line, raw});
+        else result.unparsed.push_back({line, raw});
+    }
+    if (input.bad() || (input.fail() && !input.eof())) throw std::runtime_error("MISSION input read failure");
+    return result;
+}
+void writeUnsupportedReport(const MissionScript& script, std::ostream& out) {
+    for (const auto& section : script.sections) {
+        out << "## [" << section.name << "]\n\nToken | Count | First line | Execution\n--- | ---: | ---: | ---\n";
+        for (const auto& item : section.tokens)
+            out << item.first << " | " << item.second.count << " | " << item.second.firstLine << " | unsupported\n";
+        out << '\n';
+    }
+}
+}
diff --git a/src/mission/MissionScript.h b/src/mission/MissionScript.h
new file mode 100755
index 0000000..6c8003b
--- /dev/null
+++ b/src/mission/MissionScript.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstddef>
+#include <istream>
+#include <map>
+#include <ostream>
+#include <string>
+#include <vector>
+
+namespace mission {
+struct SourceLine { std::size_t line = 0; std::string raw; };
+struct Record : SourceLine {
+    std::string label;
+    std::string token;
+    std::vector<std::string> operands;
+    std::string rawOperands;
+    // Empty for instructions. Preserved, never converted or interpreted.
+    std::string coordinates;
+    std::string prefix; // Optional integer between declaration label and tuple.
+};
+struct TokenCount { std::size_t count = 0; std::size_t firstLine = 0; };
+using Inventory = std::map<std::string, TokenCount>;
+struct Section : SourceLine {
+    std::string name;
+    std::vector<Record> declarations;
+    std::vector<Record> instructions;
+    // Lexical label -> all indices in instructions (duplicates retained).
+    std::map<std::string, std::vector<std::size_t>> instructionsByLabel;
+    Inventory tokens;
+    std::vector<SourceLine> metadata;
+    std::vector<SourceLine> markers;
+};
+struct MissionScript {
+    std::vector<Section> sections;
+    Inventory tokens;
+    std::vector<SourceLine> unparsed;
+    std::size_t lineCount = 0;
+    static MissionScript parse(std::istream& input);
+};
+// No execution support exists: all observed tokens are reported unsupported.
+void writeUnsupportedReport(const MissionScript&, std::ostream&);
+}
diff --git a/src/mission/MissionSession.cpp b/src/mission/MissionSession.cpp
new file mode 100755
index 0000000..582e43d
--- /dev/null
+++ b/src/mission/MissionSession.cpp
@@ -0,0 +1,82 @@
+#include "../stdafx.h"
+#include "MissionSession.h"
+#include "../FileSystem.h"
+#include "../CarnageGame.h"
+#include "../HumanPlayer.h"
+#include "../cvars.h"
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <fstream>
+namespace mission {
+namespace {
+MissionSession* current=nullptr;
+std::string normalized(std::string s) {
+    const auto begin=s.find_first_not_of(" \t\r\n");
+    if(begin==std::string::npos) return {};
+    s=s.substr(begin,s.find_last_not_of(" \t\r\n")-begin+1);
+    const auto slash=s.find_last_of("/\\"); if(slash!=std::string::npos) s=s.substr(slash+1);
+    std::transform(s.begin(),s.end(),s.begin(),[](unsigned char c){return std::tolower(c);}); return s;
+}
+}
+MissionSession* MissionSession::Current() {return current;}
+void MissionSession::SetCurrent(MissionSession* p) {current=p;}
+void MissionSession::Stop() {loaded_=false; outcome_=ChapterOutcome::Playing; chapter_=-1; target_.reset(); resultScore_=0; clock_=MissionClock{}; world_.Reset();}
+bool MissionSession::LoadSection(int section) {
+    Stop(); economy_=gta::GameEconomy(4); police_.reset(section); script_={};
+    std::ifstream input;
+    // FileSystem searches g_data first; Android sets it to the imported GTADATA.
+    if(!gFiles.OpenTextFile("MISSION.INI",input)) {
+        world_.diagnostic({"load","MISSION.INI missing in configured GTADATA",0,-1}); return false;
+    }
+    script_=MissionScript::parse(input);
+    for(const auto& line:script_.unparsed)
+        world_.diagnostic({"parser-unparsed",line.raw,line.line,-1});
+    auto it=std::find_if(script_.sections.begin(),script_.sections.end(),[&](const Section& s){return s.name==std::to_string(section);});
+    if(it==script_.sections.end()) {world_.diagnostic({"load","Section not found",0,-1}); return false;}
+    chapter_=chapterIndex(it->name);target_=chapterTarget(*it);
+    bool mapMatches=false;
+    for(const auto& m:it->metadata) {
+        auto first=m.raw.find(','); if(first==std::string::npos) continue;
+        auto second=m.raw.find(',',first+1); auto third=m.raw.find(',',second==std::string::npos?m.raw.size():second+1);
+        if(second!=std::string::npos && third!=std::string::npos)
+            mapMatches=mapMatches||normalized(m.raw.substr(second+1,third-second-1))==normalized(gCvarMapname.mValue);
+    }
+    if(!mapMatches) {world_.diagnostic({"load","Section map does not match g_mapname="+gCvarMapname.mValue,it->line,-1}); return false;}
+    auto report=vm_.load(*it);
+    for(const auto& d:report.diagnostics) if(d.code=="load-invalid") return false;
+    world_.Prepare(*it);
+    vm_.construct();
+    for(int i=0;i<4;++i) if(gCarnageGame.mHumanPlayers[i] && gCarnageGame.mHumanPlayers[i]->mCharacter)
+        loaded_=vm_.start(i)||loaded_;
+    if(!loaded_) world_.diagnostic({"load","No participating human character",it->line,-1});
+    return loaded_;
+}
+void MissionSession::Update(float dt) {
+    if(!loaded_ || !std::isfinite(dt) || dt<0) return;
+    for(int steps=clock_.advance(dt); steps>0; --steps) {
+        police_.update();
+        bool any=false,allTerminal=true;
+        for(int owner=0;owner<4;++owner) if(gCarnageGame.mHumanPlayers[owner]) {
+            any=true; allTerminal=allTerminal && police_.system().gameOver(owner);
+        }
+
+        if(loaded_) {world_.Update(1.0f/25); vm_.tick();}
+        // Front-end progression is single player only. Four-participant/network
+        // result ordering is intentionally not inferred from this adapter.
+        if(any && gCarnageGame.GetHumanPlayersCount()==1 && chapter_>=0) {
+            for(int owner=0;owner<4;++owner)if(gCarnageGame.mHumanPlayers[owner]) {
+                outcome_=chapterOutcome(vm_.processes()[owner],allTerminal);
+                if(outcome_!=ChapterOutcome::Playing) {
+                    resultScore_=economy_.score(owner);loaded_=false;return;
+                }
+            }
+        }
+    }
+}
+MissionSession::HUDNumbers MissionSession::Numbers(int owner) const {
+    if(owner<0 || owner>=4) return {};
+    const auto& s=economy_.state(owner);
+    return {s.score,static_cast<int>(s.multiplier),static_cast<int>(s.lives),s.wantedLevel};
+}
+}
