+    assert(mapping.GetAction(eInputActionsGroup_InCar,eGamepadButton_A)==eInputAction_Horn);
+    assert(!mapping.AssignGamepadButton(eInputAction_Jump,eGamepadButton_null));
+    InputActionsMapping defaults;defaults.LoadConfig(p1);
+    mapping.RestoreGamepadButtons(defaults);
+    assert(mapping.GetAction(eInputActionsGroup_OnFoot,eGamepadButton_A)==eInputAction_Jump);
+    assert(mapping.mGamepadID==eGamepadID_Gamepad2);
+    assert(mapping.mActionToKeys[eInputAction_Shoot].mKeycode==eKeycode_LEFT_CTRL);
+    mapping.SaveConfig(p1);
+    assert(cxx::json_node_string(p1["note"]).get_value()=="keep");
