+    Pedestrian* SpawnPedestrian(const glm::vec3& position,int remap);
+    Vehicle* SpawnVehicle(const glm::vec3& position,int model,int heading);
+    // GTA declaration tuples are map cells. Resolved opcode XYZ are 1/64 cells.
+    static std::optional<glm::vec3> DeclarationPosition(const Record&);
+    static std::optional<glm::vec3> ScriptPosition(int x,int y,int z);
+private:
+    std::array<Pickup,256> pickups_{};
+    void UpdatePickups();
+    void PrepareDoors(const Section&);
+    void UpdateDoors();
+    void CopyDoorFrame(const DoorState&);
+    void AnimateDoor(DoorState&,bool open);
+    std::map<int,DoorState> doors_;
+    std::vector<int> doorOrder_;
+    std::vector<DoorState*> enabledDoors_,animatingDoors_;
+    std::map<std::tuple<int,int,int>,MapBlockInfo> savedDoorBlocks_;
