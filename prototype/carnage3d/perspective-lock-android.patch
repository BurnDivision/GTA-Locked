+                    if(binding!=playerBindings_.end()) victim=gGameObjectsManager.GetGameObjectByID(binding->second);
+                } else if(target->second.type==99) victim=ResolveObject(target->second);
+            }
+            if(!victim || victim->mClassID!=eGameObjectClass_Pedestrian) {
+                Once("ped-attack-target","UNRESOLVED CHANGE_PED_TYPE attacker target is not a live ped or the player");
+                return WorldResult::Unresolved;
+            }
+            if(ped->mCurrentCar || ped->IsEnteringOrExitingCar()) {
+                Once("ped-attack-car","UNRESOLVED CHANGE_PED_TYPE 23 for a seated ped");
+                return WorldResult::Unresolved;
+            }
+            auto state=scriptPeds_.find(ped->mObjectID);
+            if(state==scriptPeds_.end()) return WorldResult::Unresolved;
+            if(ped->mController && !pedControllers_.count(ped->mObjectID)) {
+                Once("ped-attack-controller","UNRESOLVED CHANGE_PED_TYPE 23 for a ped driven by another controller");
+                return WorldResult::Unresolved;
+            }
+            if(!pedControllers_.count(ped->mObjectID))
+                pedControllers_[ped->mObjectID]=std::make_shared<ScriptPedControllerHolder>(ped);
+            auto& motion=state->second;
+            motion.destination.reset(); motion.objective=objective; motion.state=3; motion.action=8; motion.current=0;
+            motion.attackTarget=victim->mObjectID; motion.attackDelay=0; motion.attackCooldown=0; motion.attacking=false;
+            ped->mWeapons[eWeapon_Pistol].Setup(eWeapon_Pistol,99);
+            ped->ChangeWeapon(eWeapon_Pistol);
+            ped->mMissionVelocity={0,0};
+            Once("ped-attack-weapon","Script attacker weapon 1 projected as the engine pistol (00488e20 single projectile)");
+            return WorldResult::Success;
+        }
+        Once("ped-change:"+std::to_string(i.D),"CHANGE_PED_TYPE "+std::to_string(i.D)+" objective not implemented yet");
+        return WorldResult::Unresolved;
+    }
+    if(token=="KILL_PED") {
+        // 004445d0: a live type-99 record's ped is removed from the world
+        // (not killed) and from the cleanup list.
+        if(!entity || entity->type!=99 || !entity->value || *entity->value<0) return WorldResult::Failure;
+        if(auto* object=ResolveObject(*entity)) {
+            if(object->mClassID!=eGameObjectClass_Pedestrian) return WorldResult::Unresolved;
+            if(static_cast<Pedestrian*>(object)->mCurrentCar) {Once("kill-ped-car","KILL_PED of a seated ped (00477320 car rules) unresolved"); return WorldResult::Unresolved;}
+            auto state=scriptPeds_.find(object->mObjectID);
+            if(state==scriptPeds_.end()) return WorldResult::Unresolved;
+            state->second.removed=true; state->second.killer=static_cast<Pedestrian*>(object)->mLastDamageCauserID;
+            object->MarkForDeletion();
+            missionEntities_.erase(object->mObjectID);
+        }
+        return WorldResult::Done;
+    }
+    if(token=="CRANE") {
+        // 00440040 stage1: mode!=0 or car outside D's XYZ cell takes F,
+        // without consulting the crane allocation or granting a reward.
+        if(r.process.state!=1) return WorldResult::Unresolved;
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        if(!ped || ped->IsMarkedForDeletion() || ped->IsDead() || ped->IsDies() ||
+           ped->IsEnteringOrExitingCar()) return WorldResult::Unresolved;
+        if(!ped->mCurrentCar) {
+            if(ped->IsStanding() || ped->IsWalking()) return WorldResult::Failure;
+            return WorldResult::Unresolved;
+        }
+        auto* car=ped->mCurrentCar;
+        if(!ped->IsCarDriver() || car->GetCarDriver()!=ped || car->IsMarkedForDeletion()) return WorldResult::Unresolved;
+        auto target=r.entities.find(i.D);
+        if(target==r.entities.end()) return WorldResult::Unresolved;
+        auto destination=OriginalPosition(target->second,i.D);
+        const auto& at=car->mTransform.mPosition;
+        if(!destination || !std::isfinite(at.x) || !std::isfinite(at.y) || !std::isfinite(at.z)) return WorldResult::Unresolved;
+        const double cells[]={std::floor(Convert::MetersToMapUnits(at.x)),
+                              std::floor(Convert::MetersToMapUnits(at.z)),
+                              std::floor((MAP_LAYERS_COUNT*64-1-Convert::MetersToMapUnits(at.y)*64)/64.0)};
+        for(int axis=0;axis<3;++axis)
+            if(cells[axis]!=std::floor((*destination)[axis]/64.0)) return WorldResult::Failure;
+        Once("crane-acceptance","UNRESOLVED CRANE machine acceptance/update/removal state");
+        return WorldResult::Unresolved;
+    }
+    if(token=="PARK") {
+        // 004407c0 (SPEC_PARK): state1 takes the car over at speed 5, state2
+        // waits for the approach position, puts the participant out at the
+        // exit point, state3 stops the car, shuts the door and queues the
+        // car's removal ten updates later. Speed unit: pixels per update.
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        auto door=doors_.find(i.A);
+        if(!ped || !entity || entity->type!=9 || door==doors_.end()) return WorldResult::Unresolved;
+        auto& state=r.process.state; auto& cached=parkCars_[r.owner];
+        Vehicle* car=nullptr;
+        if(!cached) {
+            if(ped->IsEnteringOrExitingCar() || !ped->mCurrentCar || !ped->IsCarDriver() ||
+               ped->mCurrentCar->GetCarDriver()!=ped) return WorldResult::Hold;
+            car=ped->mCurrentCar; cached=car->mObjectID;
+        } else {
+            auto* object=gGameObjectsManager.GetGameObjectByID(cached);
+            if(!object || object->IsMarkedForDeletion() || object->mClassID!=eGameObjectClass_Car) {
+                cached=0; Once("park-lost","PARK car slot vanished; original would reuse the slot"); return WorldResult::Unresolved;
+            }
+            car=static_cast<Vehicle*>(object);
+            if(state<3 && ped->mCurrentCar!=car) return WorldResult::Hold;
+        }
+        auto target=OriginalPosition(*entity,i.A); if(!target) return WorldResult::Unresolved;
+        const int X=(*target)[0],Y=(*target)[1];
+        const auto& at=car->mTransform.mPosition;
+        const int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x)*64));
+        const int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z)*64));
+        const int tx=x>>6,ty=y>>6;
+        auto roll=[&](int speed) {
+            car->SetScriptedDrive(true,Convert::MapUnitsToMeters(speed*25/64.0f));
+        };
+        if(state==1) {
+            roll(5); state=2;
+            Once("park-camera","PARK: the original camera hold (00462cb0/0043cac0) is not applied to the engine view");
+            return WorldResult::Hold;
+        }
+        const int D=i.D;
+        if(state==2) {
+            if(D<0 || D>3) return WorldResult::Hold;
+            const int L=Convert::MetersToPixels(car->mCarInfo->mDimensions.z)>64?128:64;
+            bool ready=false;
+            if(D==0) ready=y<Y-L/2+64 && ty>(Y>>6)-3 && X-64<=x && x<=X+64;
+            if(D==1) ready=x>X+L/2 && tx<(X>>6)+3 && Y-64<=y && y<=Y+64;
+            if(D==2) ready=y>Y+L/2 && ty<(Y>>6)+3 && X-64<=x && x<=X+64;
+            if(D==3) ready=x<X-L/2+64 && tx>(X>>6)-3 && Y-64<=y && y<=Y+64;
+            if(!ready) return WorldResult::Hold;
+            // 00476500 facing sector of the car's original angle.
+            const int a=static_cast<int>(std::lround((90-car->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+            const int facing=(a<0x80 || a>0x37f)?2:a>0x27f?4:a<0x180?8:1;
+            static const int reverse[4]={2,4,1,8};
+            static const int offsetX[4]={32,-10,32,74},offsetY[4]={74,32,-10,32},angle[4]={0,0x300,0x200,0x100};
+            roll(facing==reverse[D]?-5:5);
+            // 00463be0 -> 0045fc60: the participant is put on foot at the exit point.
+            if(car->GetCarDriver()==ped) {
+                const int z=static_cast<int>(std::lround(MAP_LAYERS_COUNT*64-1-Convert::MetersToMapUnits(at.y)*64));
+                if(auto exit=EnginePosition(X+offsetX[D],Y+offsetY[D],z)) {
+                    ped->PutOnFoot();
+                    ped->SetTransform(*exit,-Convert::Fix16ToAngle(static_cast<unsigned short>(angle[D])));
+                }
+            } else if(D==1) return WorldResult::Hold;
+            state=3; return WorldResult::Hold;
+        }
+        if(state!=3) return WorldResult::Hold;
+        if(ped->mCurrentCar==car) return WorldResult::Hold; // ped state 7: still seated
+        // 00474670 starts the door's state3 animation.
+        AnimateDoor(door->second,false);
+        roll(0);
+        carRecords_.erase(car->mObjectID); // car+0x134 = -1
+        parkRemovals_.emplace_back(car->mObjectID,10);
+        cached=0;
+        return WorldResult::Success;
+    }
+    // Guarded effects with known VM failure contracts; do not guess engine health.
+    if((token=="KILL_DROP" || token=="REMAP_PED" || token=="CLOSE_DOOR") &&
+       (!entity || !entity->value || *entity->value<0)) return WorldResult::Failure;
+    if(token=="KILL_PED" && (!entity || entity->type!=99 || !entity->value || *entity->value<0))
+        return WorldResult::Failure;
+    // No broad success fallback: VM blocks unresolved commands after one dispatch.
+    Once("execute:"+token,"Unsupported world command "+token+" ("+r.evidence+")");
+    return WorldResult::Unresolved;
+}
+std::optional<bool> CarnageMissionWorld::predicate(const WorldRequest& r) {
+    if(doorUpdateUnresolved_) return {};
+    if(r.token=="CHECKPOINT_PARTICIPANT" || r.token=="CHECKPOINT_AREA") {
+        // 00412a70/00412a90: participant0 only. We project stable modes0/2;
+        // temporary participant modes and additional humans remain unknown.
+        auto* human=player(0); auto* ped=human?human->mCharacter:nullptr;
+        if(r.owner!=0 || !ped || ped->IsMarkedForDeletion()) return {};
+        for(int owner=1;owner<4;++owner) if(player(owner)) return {};
+        if(r.token=="CHECKPOINT_PARTICIPANT") return true;
+        if(ped->IsEnteringOrExitingCar()) return {};
+        GameObject* participant=ped;
+        if(ped->IsCarDriver() && ped->mCurrentCar && ped->mCurrentCar->GetCarDriver()==ped &&
+           !ped->mCurrentCar->IsMarkedForDeletion()) participant=ped->mCurrentCar;
+        else if(ped->mCurrentCar || (!ped->IsStanding() && !ped->IsWalking())) return {};
+        auto at=r.entities.find(r.instruction.A);
+        int x=0,y=0,z=0;
+        if(at==r.entities.end() || !Tuple(at->second.declaration,x,y,z)) return {};
+        const auto& position=participant->mTransform.mPosition;
+        if(!std::isfinite(position.x) || !std::isfinite(position.z)) return {};
+        const double px=std::floor(Convert::MetersToMapUnits(position.x));
+        const double py=std::floor(Convert::MetersToMapUnits(position.z));
+        // 004744a0 truncates XYZ to bytes. The inclusive area ignores Z.
+        const double tx=x&255,ty=y&255,d=r.instruction.D;
+        if(d<0 || d>32767) return {}; // unprojected signed-overflow geometry
+        return tx-d<=px && px<=tx+d && ty-d<=py && py<=ty+d;
+    }
+    if(r.token=="WAIT_FOR_PED") {
+        // 00447b2d -> 00475e60(ped(value(D)), X(A)>>6,Y(A)>>6,Z(A)>>6,0).
+        // No health, arrival, objective or timeout test. 0045fb00 reads the
+        // ped's own raw XYZ, not its associated car's position.
+        auto target=r.entities.find(r.instruction.A);
+        auto subject=r.entities.find(r.instruction.D);
+        if(target==r.entities.end() || subject==r.entities.end()) return {};
+        GameObject* object=nullptr;
+        if(subject->second.type==3) {
+            auto binding=playerBindings_.find(r.instruction.D);
+            if(binding!=playerBindings_.end()) object=gGameObjectsManager.GetGameObjectByID(binding->second);
+        } else if(subject->second.type==99) object=ResolveObject(subject->second);
+        // Original numeric ped slots cannot be inferred from engine object IDs.
+        if(!object || object->IsMarkedForDeletion() || object->mClassID!=eGameObjectClass_Pedestrian) return {};
+        auto* ped=static_cast<Pedestrian*>(object);
+        if(ped->mCurrentCar || ped->IsEnteringOrExitingCar()) return {};
+        auto destination=OriginalPosition(target->second,r.instruction.A);
+        auto position=OriginalPosition(subject->second,r.instruction.D);
+        if(!destination || !position) return {};
+        for(int axis=0;axis<3;++axis)
+            if(std::floor((*position)[axis]/64.0)!=std::floor((*destination)[axis]/64.0)) return false;
+        return true;
+    }
+    if(r.token=="IS_POWERUP_DONE") {
+        const auto at=r.entities.find(r.instruction.A);
+        if(at==r.entities.end() || at->second.declaration.token!="POWERUP") return {};
+        auto pos=DeclarationPosition(at->second.declaration); if(!pos)return {};
+        const auto x=std::llround(Convert::MetersToMapUnits(pos->x)*pickup::cell)+pickup::cell/2;
+        const auto y=std::llround(Convert::MetersToMapUnits(pos->z)*pickup::cell)+pickup::cell/2;
+        for(const auto& entry:pickups_) if(entry.object && entry.shape.p[4].x==x && entry.shape.p[4].y==y) return false;
+        return true;
+    }
+    if(r.token=="DOOR_ON" || r.token=="DOOR_OFF") {
+        auto entity=r.entities.find(r.instruction.A);
+        if(entity==r.entities.end()) return {};
+        int id=r.instruction.A;
+        // 004484dd/0044850a read record.value with no type guard. Ordinary
+        // door declarations already have an adapter identity. For numeric
+        // records (including DUMMY), project the original allocation slot.
+        if(entity->second.value) {
+            // These values are engine object IDs, not recovered original slots.
+            // Do not interpret a coincidentally small handle as a door alias.
+            switch(entity->second.type) {
+            case 0: case 1: case 2: case 3: case 5: case 6:
+            case 0x12: case 0x15: case 0x16: case 0x1b: case 99:
+                Once("door-object-slot","UNRESOLVED original object-slot door alias");
+                return {};
+            default: break;
+            }
+            const int slot=*entity->second.value;
+            if(slot<0 || static_cast<std::size_t>(slot)>=doorSlots_.size() || !doorSlots_[slot]) {
+                Once("door-slot:"+std::to_string(slot),"UNRESOLVED original door slot "+std::to_string(slot));
+                return {};
+            }
+            id=*doorSlots_[slot];
+        }
+        // An unset numeric record cannot borrow a same-numbered declaration.
+        else if(entity->second.declaration.token!="DOOR" &&
+                entity->second.declaration.token!="BARRIER" &&
+                entity->second.declaration.token!="BASIC_BARRIER" &&
+                entity->second.declaration.token!="MODEL_BARRIER" &&
+                entity->second.declaration.token!="MODEL_DOOR" &&
+                entity->second.declaration.token!="SPECIFIC_DOOR") return {};
