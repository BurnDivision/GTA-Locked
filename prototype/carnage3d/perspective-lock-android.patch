+        return {};
+    }
+    if(r.token=="CHECK_CAR") {
+        auto at=r.entities.find(r.instruction.A);
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        if(at==r.entities.end() || at->second.type!=0 || !ped) return {};
+        auto* object=ResolveObject(at->second);
+        if(!object || object->mClassID!=eGameObjectClass_Car || ped->IsEnteringOrExitingCar()) return {};
+        if(ped->IsCarDriver()) {
