+void glfwPollEvents(void)
+{
+    SDL_Event e;
+    while (SDL_PollEvent(&e))
+    {
+        switch (e.type)
+        {
+            case SDL_QUIT:
+                gWindow.mShouldClose = true;
+                break;
+            case SDL_APP_WILLENTERBACKGROUND:
+                touch::ReleaseAll();
+                break;
+            case SDL_KEYDOWN:
+            case SDL_KEYUP:
+                if (e.key.repeat) break;
+                if (e.key.keysym.sym == SDLK_AC_BACK) break; // back button: ignore (no accidental quit)
+                EmitKey(SdlKeyToGlfw(e.key.keysym.sym), e.type == SDL_KEYDOWN);
+                break;
+            case SDL_TEXTINPUT:
+                if (gCharCb)
+                    for (const char* p = e.text.text; *p; ++p)
+                        if ((unsigned char)*p < 128) gCharCb(&gWindow, (unsigned int)*p);
+                break;
+            case SDL_MOUSEMOTION:
+                if (e.motion.which == SDL_TOUCH_MOUSEID) break;
+                if (gCursorCb) gCursorCb(&gWindow, e.motion.x, e.motion.y);
+                break;
+            case SDL_MOUSEBUTTONDOWN:
+            case SDL_MOUSEBUTTONUP:
+            {
+                if (e.button.which == SDL_TOUCH_MOUSEID) break;
+                int b = (e.button.button == SDL_BUTTON_LEFT) ? GLFW_MOUSE_BUTTON_LEFT :
+                        (e.button.button == SDL_BUTTON_RIGHT) ? GLFW_MOUSE_BUTTON_RIGHT : GLFW_MOUSE_BUTTON_MIDDLE;
+                if (gMouseButtonCb) gMouseButtonCb(&gWindow, b, e.type == SDL_MOUSEBUTTONDOWN ? GLFW_PRESS : GLFW_RELEASE, 0);
+                break;
+            }
+            case SDL_MOUSEWHEEL:
+                if (gScrollCb) gScrollCb(&gWindow, e.wheel.x, e.wheel.y);
+                break;
+            case SDL_FINGERDOWN:
+            case SDL_FINGERUP:
+            case SDL_FINGERMOTION:
+                touch::OnFinger(e.tfinger, e.type);
+                break;
+            case SDL_CONTROLLERDEVICEADDED:
+            {
+                int idx = e.cdevice.which;
+                if (idx >= 0 && idx <= GLFW_JOYSTICK_LAST && !gPads[idx])
+                {
+                    gPads[idx] = SDL_GameControllerOpen(idx);
+                    if (gPads[idx])
+                    {
+                        if (touch::gMode == 0) touch::gVisible = false; // controller in use: hide touch overlay until next touch
+                        if (gJoystickCb) gJoystickCb(idx, GLFW_CONNECTED);
+                    }
+                }
+                break;
+            }
+            case SDL_CONTROLLERBUTTONDOWN:
+            case SDL_CONTROLLERBUTTONUP:
+                if (e.type == SDL_CONTROLLERBUTTONDOWN && touch::gMode == 0) touch::gVisible = false;
+                // Back / View / Select toggles the perspective lock (F9)
+                if (e.cbutton.button == SDL_CONTROLLER_BUTTON_BACK) EmitKey(GLFW_KEY_F9, e.type == SDL_CONTROLLERBUTTONDOWN);
+                break;
+            case SDL_CONTROLLERAXISMOTION:
+                if (touch::gMode == 0 && (e.caxis.value > 16000 || e.caxis.value < -16000)) touch::gVisible = false;
+                break;
+            case SDL_CONTROLLERDEVICEREMOVED:
+            {
+                for (int i = 0; i <= GLFW_JOYSTICK_LAST; ++i)
+                {
+                    if (gPads[i] && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(gPads[i])) == e.cdevice.which)
+                    {
+                        SDL_GameControllerClose(gPads[i]);
+                        gPads[i] = nullptr;
+                        touch::gVisible = (touch::gMode != 2);
+                        if (gJoystickCb) gJoystickCb(i, GLFW_DISCONNECTED);
+                    }
+                }
+                break;
+            }
+            default:
+                break;
+        }
+    }
+}
