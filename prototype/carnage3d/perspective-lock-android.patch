+#pragma once
+// GTA Classic Perspective Lock - Android: stand-in for GLEW.
+// OpenGL ES 3.0 entry points are linked directly from libGLESv3, so no extension loader is needed.
+
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+
+#define GLEW_OK 0
+static int glewExperimental = 1;
+inline int glewInit() { return GLEW_OK; }
+inline const char* glewGetErrorString(int) { return "n/a"; }
+
+#define GLEW_VERSION_3_2 1
+#define GLEW_ARB_texture_non_power_of_two 1 // core in ES 3.0
+#define GLEW_EXT_abgr 0
+
+#ifndef GL_MAX_TEXTURE_BUFFER_SIZE
+#define GL_MAX_TEXTURE_BUFFER_SIZE 0x8C2B // ES 3.2 only; query fails harmlessly on 3.0
+#endif
+#ifndef GL_PROGRAM_POINT_SIZE
+#define GL_PROGRAM_POINT_SIZE 0x8642 // always on in ES; glEnable is a harmless no-op error
+#endif
