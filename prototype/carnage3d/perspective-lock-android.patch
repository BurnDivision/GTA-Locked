diff --git a/src/ProfileStore.h b/src/ProfileStore.h
new file mode 100755
index 0000000..a7350bc
--- /dev/null
+++ b/src/ProfileStore.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "FrontendProfile.h"
+#include <fstream>
+#include <cstdio>
+#include <cerrno>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+namespace frontend {
+enum class ProfileLoad {Missing,Invalid,Loaded};
+inline ProfileLoad loadProfiles(const std::string& path,Profiles& profiles) {
+ errno=0;std::ifstream in(path,std::ios::binary);
+ if(!in)return errno==ENOENT?ProfileLoad::Missing:ProfileLoad::Invalid;
+ return profiles.importOriginal(in)?ProfileLoad::Loaded:ProfileLoad::Invalid;
+}
+// Rename only after a complete, closed write: failure keeps the prior save.
+// The app has one profile writer on its game thread.
+inline bool saveProfiles(const std::string& path,const Profiles& profiles) {
+ const auto temp=path+".tmp";
+ std::ofstream out(temp,std::ios::binary|std::ios::trunc);
+ if(!out || !profiles.exportOriginal(out)) {out.close();std::remove(temp.c_str());return false;}
+ out.flush();const bool good=bool(out);out.close();
+#ifdef _WIN32
+ // Windows CRT rename refuses an existing target. Never remove the old save first.
+ const bool replaced=good && out && MoveFileExA(temp.c_str(),path.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH);
+#else
+ const bool replaced=good && out && std::rename(temp.c_str(),path.c_str())==0;
+#endif
+ if(!replaced) {
+  std::remove(temp.c_str());return false;
+ }
+ return true;
+}
+}
