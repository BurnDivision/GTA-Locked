+
+void HUDSubtitleMessage::Self_DrawFrame(GuiContext& context)
+{
+    auto* entry = mMessages.current();
+    if (!entry || !mFont) return;
+    const int height = mFont->GetLineHeight();
+    if (height <= 0) return;
+    const int margin = std::min(12, context.GetScreenSizex() / 10);
+    const int width = std::max(1, context.GetScreenSizex() - margin * 2);
+    const int lines = std::max(1, (context.GetScreenSizey() / 3) / height);
+    const int speed = gCvarTextSpeed.mValue;
+    if (entry->text != mLayoutText || width != mLayoutWidth ||
+        lines != mLayoutLines || speed != mLayoutSpeed)
+    {
+        mLayout = hud::layoutSubtitle(entry->text, width, lines, speed,
+            [&](const std::string& text) { Point size; mFont->MeasureString(text, size); return size.x; });
+        mLayoutText = entry->text;
+        mLayoutWidth = width;
+        mLayoutLines = lines;
+        mLayoutSpeed = speed;
+    }
+    entry->duration = std::max(entry->duration, mLayout.duration);
+    if (mLayout.pages.empty()) return;
+    const auto& page = mLayout.pages[mLayout.pageAt(entry->elapsed)];
+    Point size;
+    mFont->MeasureString(page, size);
+    const Point at(margin, std::max(0, context.GetScreenSizey() - size.y - margin));
+    // Clip against this local logical viewport, including split-screen and g_uiScale.
+    if (context.EnterChildClipArea(Rect{0, 0, context.GetScreenSizex(), context.GetScreenSizey()}))
+    {
+        mFont->DrawString(context, page, at, gGameMap.mStyleData.GetFontPaletteIndex(FontRemap_Default));
+        context.LeaveChildClipArea();
+    }
+}
