+            participant=ped->mCurrentCar;
+        else if(ped->mCurrentCar || (!ped->IsStanding() && !ped->IsWalking())) return {};
+        auto target=DeclarationPosition(at->second.declaration); if(!target) return {};
+        const auto& pos=participant->mTransform.mPosition;
+        if(!std::isfinite(pos.x) || !std::isfinite(pos.z)) return {};
+        const double x=std::floor(Convert::MetersToMapUnits(pos.x));
+        const double y=std::floor(Convert::MetersToMapUnits(pos.z));
+        const double tx=Convert::MetersToMapUnits(target->x), ty=Convert::MetersToMapUnits(target->z);
+        const double d=r.instruction.D;
+        return tx-d<=x && x<=tx+d && ty-d<=y && y<=ty+d;
+    }
+    if(r.token=="CAR_TRIGGER" || r.token=="CORRECT_CAR_TRIGGER" ||
+       r.token=="CORRECT_MODEL_TRIGGER" || r.token=="TRIGGER_CAR_MODEL") {
+        // 0047a3a0 types 9/0x10/0xf need participant mode0. The stable seated
+        // driver is the proved projection; passengers and vehicle
+        // transitions are not.
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        if(!ped || ped->IsMarkedForDeletion() || ped->IsEnteringOrExitingCar()) return {};
+        auto* car=ped->mCurrentCar;
+        if(!car) return false;
+        if(!ped->IsCarDriver() || car->GetCarDriver()!=ped || car->IsMarkedForDeletion()) return {};
+        if(r.token=="CAR_TRIGGER") {
+            // car+0x134 equals trigger+0x14, and the record ID is not negative.
+            auto record=carRecords_.find(car->mObjectID);
+            return record!=carRecords_.end() && record->second>=0 && record->second==r.instruction.D;
+        }
+        if(r.token=="TRIGGER_CAR_MODEL") return int(car->mCarInfo->mModelID)==r.instruction.E;
+        auto at=r.entities.find(r.instruction.A);
+        if(at==r.entities.end()) return {};
+        auto target=DeclarationPosition(at->second.declaration); if(!target) return {};
+        const auto& pos=car->mTransform.mPosition;
+        if(!std::isfinite(pos.x) || !std::isfinite(pos.z)) return {};
+        const double x=std::floor(Convert::MetersToMapUnits(pos.x));
+        const double y=std::floor(Convert::MetersToMapUnits(pos.z));
+        const double tx=Convert::MetersToMapUnits(target->x), ty=Convert::MetersToMapUnits(target->z);
+        const double d=r.instruction.D;
