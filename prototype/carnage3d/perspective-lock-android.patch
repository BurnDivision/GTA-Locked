+#pragma once
+// GTA Classic Perspective Lock - Android platform layer.
+// Implements the small subset of the GLFW 3 API that Carnage3D uses, on top of SDL2,
+// so the engine runs on Android without changes to its windowing/input code.
+// Touch overlay injects keys or, in mode 3, a virtual twin-stick gamepad.
+
+#include <GLES3/gl3.h>
+
+#define GLFW_TRUE 1
+#define GLFW_FALSE 0
+#define GLFW_RELEASE 0
+#define GLFW_PRESS 1
+#define GLFW_REPEAT 2
+#define GLFW_CONNECTED 0x00040001
+#define GLFW_DISCONNECTED 0x00040002
+
+// window hints (accepted and ignored: SDL/EGL picks a GLES 3.0 context)
+#define GLFW_RESIZABLE 0x00020003
+#define GLFW_RED_BITS 0x00021001
+#define GLFW_GREEN_BITS 0x00021002
+#define GLFW_BLUE_BITS 0x00021003
