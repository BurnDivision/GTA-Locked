+GLFWwindow* glfwCreateWindow(int width, int height, const char* title, GLFWmonitor*, GLFWwindow*)
+{
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+    SDL_GL_SetAttribute(SDL_GL_RED_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_ALPHA_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+
+    gWindow.mSdlWindow = SDL_CreateWindow(title, SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, width, height,
+        SDL_WINDOW_OPENGL | SDL_WINDOW_FULLSCREEN | SDL_WINDOW_ALLOW_HIGHDPI);
+    if (!gWindow.mSdlWindow)
+    {
+        ReportError("SDL_CreateWindow");
+        return nullptr;
+    }
+    gWindow.mContext = SDL_GL_CreateContext(gWindow.mSdlWindow);
+    if (!gWindow.mContext)
+    {
+        // some devices refuse a 24-bit depth buffer
+        SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 16);
+        gWindow.mContext = SDL_GL_CreateContext(gWindow.mSdlWindow);
+    }
+    if (!gWindow.mContext)
+    {
+        ReportError("SDL_GL_CreateContext");
+        SDL_DestroyWindow(gWindow.mSdlWindow);
+        gWindow.mSdlWindow = nullptr;
+        return nullptr;
+    }
+    gWindow.mShouldClose = false;
+    int w = 0, h = 0;
+    SDL_GL_GetDrawableSize(gWindow.mSdlWindow, &w, &h);
+    touch::Layout(w, h);
+    SDL_Log("[shim] window %dx%d, GL %s", w, h, (const char*)glGetString(GL_VERSION));
+    return &gWindow;
+}
+
+void glfwDestroyWindow(GLFWwindow* window)
+{
+    if (!window) return;
+    if (window->mContext) SDL_GL_DeleteContext(window->mContext);
+    if (window->mSdlWindow) SDL_DestroyWindow(window->mSdlWindow);
+    window->mContext = nullptr;
+    window->mSdlWindow = nullptr;
+}
+
+void glfwMakeContextCurrent(GLFWwindow* window)
+{
+    if (window && window->mSdlWindow) SDL_GL_MakeCurrent(window->mSdlWindow, window->mContext);
+}
