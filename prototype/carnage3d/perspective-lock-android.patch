+// GTA Classic Reperspective camera.
+// Modes (cam_mode; F9 or the LOCK touch button cycles them):
+//  - classic: the original north-up view;
+//  - reperspective: the travel heading points to the top of the screen and the world rotates around
+//    the player. With tank controls the body heading is the travel heading; with twin-stick controls a
+//    persistent travel heading is followed, and the view holds while the player aims independently;
+//  - combat (experimental): the view follows the aiming direction.
+// In a car the view follows the car's heading in both rotating modes. Only the view matrix changes:
+// world coordinates, physics, AI and collision are untouched.
+//   ScreenPosition = R(-theta) * (WorldPosition - PlayerPosition)
+
+CvarString gCvarCameraMode("cam_mode", "reperspective", "Camera mode: classic, reperspective or combat", CvarFlags_Archive);
+CvarString gCvarCameraSmoothing("cam_smoothing", "fast", "Camera rotation smoothing: instant, fast or smooth", CvarFlags_Archive);
+CvarBoolean gCvarCameraDynamic("cam_dynamic", true, "Look ahead and trail turns slightly at speed", CvarFlags_Archive);
+
+namespace
+{
+    const float NorthUpHeading = -reperspective::kPi * 0.5f; // screen-up = -Z, the original view
+
+    reperspective::Smoothing GetSmoothingPreset()
+    {
+        const std::string& value = gCvarCameraSmoothing.mValue;
+        if (value == "instant") return reperspective::Smoothing::Instant;
+        if (value == "smooth") return reperspective::Smoothing::Smooth;
+        return reperspective::Smoothing::Fast;
+    }
+
+    void PublishViewModeLabel()
+    {
+#ifdef __ANDROID__
+        ::glfwShimSetLockLabel(GetCameraViewModeLabel(GetCameraViewMode()));
+#endif
+    }
+}
+
+eCameraViewMode GetCameraViewMode()
+{
+    const std::string& value = gCvarCameraMode.mValue;
+    if (value == "classic") return eCameraViewMode_Classic;
+    if (value == "combat") return eCameraViewMode_Combat;
+    return eCameraViewMode_Reperspective;
+}
+
+const char* GetCameraViewModeLabel(eCameraViewMode viewMode)
+{
+    switch (viewMode)
+    {
+        case eCameraViewMode_Classic: return "NORTH";
+        case eCameraViewMode_Combat: return "AIM";
+        default: break;
+    }
+    return "LOCK";
+}
 
