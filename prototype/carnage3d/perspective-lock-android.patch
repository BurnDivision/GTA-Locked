+#if !defined(__EMSCRIPTEN__) && !defined(GAMEPAD_SDL)
+// Engine gamepad slots are filled from whatever controllers GLFW reports, in
+// connection order, so a Bluetooth pad that is not joystick 0 still becomes
+// Gamepad1. Controllers with a known layout come first; an unknown controller
+// is read through a generic DirectInput-style layout.
+static int sSlotJoystick[eGamepadID_COUNT] = { -1, -1, -1, -1 };
+static bool sSlotMapped[eGamepadID_COUNT] = {};
+static bool sGamepadSlotsDirty = true;
+
+static void LoadGamepadMappings()
+{
+#ifndef __ANDROID__ // SDL shim already supplies mapped controllers.
+    std::string path = gFiles.mExecutableDirectory + "/gamecontrollerdb.txt";
+    std::ifstream file(path, std::ios::binary);
+    if (!file)
+        return;
+    std::stringstream buffer;
+    buffer << file.rdbuf();
+    bool loaded = ::glfwUpdateGamepadMappings(buffer.str().c_str()) == GLFW_TRUE;
+    gConsole.LogMessage(eLogMessage_Info, "Controller layouts %s from gamecontrollerdb.txt", loaded ? "loaded" : "NOT loaded");
+#endif
+}
+
+static void RefreshGamepadSlots()
+{
+    sGamepadSlotsDirty = false;
+    int joysticks[eGamepadID_COUNT];
+    bool mapped[eGamepadID_COUNT];
+    int count = 0;
+    for (int pass = 0; pass < 2; ++pass)
+    {
+        for (int jid = GLFW_JOYSTICK_1; jid <= GLFW_JOYSTICK_LAST && count < eGamepadID_COUNT; ++jid)
+        {
+            if (::glfwJoystickPresent(jid) != GLFW_TRUE)
+                continue;
+            bool isGamepad = ::glfwJoystickIsGamepad(jid) == GLFW_TRUE;
+            if (isGamepad != (pass == 0))
+                continue;
+            if (!isGamepad)
+            {
+#ifdef __ANDROID__
+                continue; // Android shim exposes mapped SDL controllers only.
+#else
+                int axes = 0, buttons = 0;
+                ::glfwGetJoystickAxes(jid, &axes);
+                ::glfwGetJoystickButtons(jid, &buttons);
+                if (axes < 2 || buttons < 4)
+                    continue; // not a game controller
+#endif
+            }
+            joysticks[count] = jid;
+            mapped[count] = isGamepad;
+            ++count;
+        }
+    }
+    for (int slot = 0; slot < eGamepadID_COUNT; ++slot)
+    {
+        int jid = slot < count ? joysticks[slot] : -1;
+        bool isMapped = slot < count && mapped[slot];
+        if (jid == sSlotJoystick[slot] && isMapped == sSlotMapped[slot] && gInputs.mGamepadsState[slot].mPresent == (jid >= 0))
+            continue;
+        sSlotJoystick[slot] = jid;
+        sSlotMapped[slot] = isMapped;
+        gInputs.SetGamepadPresent(slot, jid >= 0);
+        if (jid >= 0)
+        {
+#ifdef __ANDROID__
+            const char* name = "SDL controller", *guid = "";
+#else
+            const char* name = isMapped ? ::glfwGetGamepadName(jid) : ::glfwGetJoystickName(jid);
+            const char* guid = ::glfwGetJoystickGUID(jid);
+#endif
+            gConsole.LogMessage(eLogMessage_Info, "Gamepad%d: %s [%s] %s", slot + 1, name ? name : "?", guid ? guid : "?",
+                isMapped ? "known layout" : "unknown layout, generic layout used");
+        }
+        else
+        {
+            gConsole.LogMessage(eLogMessage_Info, "Gamepad%d disconnected", slot + 1);
+        }
+    }
+}
+
+// Reads one controller into engine form. Axes: 0-3 sticks, 4-5 triggers (0..1).
+static bool ReadGamepad(int jid, bool isMapped, float axes[6], bool buttons[eGamepadButton_COUNT])
+{
+    if (isMapped)
+    {
+        GLFWgamepadstate state;
+        if (::glfwGetGamepadState(jid, &state) != GLFW_TRUE)
+            return false;
+        for (int iaxis = 0; iaxis < 4; ++iaxis)
+            axes[iaxis] = state.axes[iaxis];
+        axes[4] = (state.axes[GLFW_GAMEPAD_AXIS_LEFT_TRIGGER] + 1.0f) * 0.5f;
+        axes[5] = (state.axes[GLFW_GAMEPAD_AXIS_RIGHT_TRIGGER] + 1.0f) * 0.5f;
+        for (int ibutton = 0; ibutton <= GLFW_GAMEPAD_BUTTON_LAST; ++ibutton)
+        {
+            eGamepadButton buttonNative = GlfwGamepadButtonToNative(ibutton);
+            if (buttonNative != eGamepadButton_null)
+                buttons[buttonNative] = state.buttons[ibutton] == GLFW_PRESS;
+        }
+        buttons[eGamepadButton_LeftTrigger] = state.axes[GLFW_GAMEPAD_AXIS_LEFT_TRIGGER] > 0.5f;
+        buttons[eGamepadButton_RightTrigger] = state.axes[GLFW_GAMEPAD_AXIS_RIGHT_TRIGGER] > 0.5f;
+        return true;
+    }
+    // Generic layout: X/Y left stick, Z/Rz (or axes 2/3) right stick, buttons in the
+    // common DirectInput order, first hat as d-pad. Triggers are read as buttons only,
+    // because the resting value of an unknown trigger axis is not known.
+#ifdef __ANDROID__
+    return false; // Unmapped raw devices are a desktop GLFW fallback.
+#else
+    int axisCount = 0, buttonCount = 0, hatCount = 0;
+    const float* rawAxes = ::glfwGetJoystickAxes(jid, &axisCount);
+    const unsigned char* rawButtons = ::glfwGetJoystickButtons(jid, &buttonCount);
+    const unsigned char* rawHats = ::glfwGetJoystickHats(jid, &hatCount);
+    if (rawAxes == nullptr || rawButtons == nullptr || axisCount < 2)
+        return false;
+    axes[0] = rawAxes[0];
+    axes[1] = rawAxes[1];
+    if (axisCount >= 6) { axes[2] = rawAxes[2]; axes[3] = rawAxes[5]; }
+    else if (axisCount >= 4) { axes[2] = rawAxes[2]; axes[3] = rawAxes[3]; }
+    static const eGamepadButton order[] = {
+        eGamepadButton_X, eGamepadButton_A, eGamepadButton_B, eGamepadButton_Y,
+        eGamepadButton_LeftBumper, eGamepadButton_RightBumper, eGamepadButton_LeftTrigger, eGamepadButton_RightTrigger,
+        eGamepadButton_Back, eGamepadButton_Start, eGamepadButton_LeftThumb, eGamepadButton_RightThumb };
+    for (int ibutton = 0; ibutton < buttonCount && ibutton < (int) (sizeof(order) / sizeof(order[0])); ++ibutton)
+        buttons[order[ibutton]] = rawButtons[ibutton] == GLFW_PRESS;
+    axes[4] = buttons[eGamepadButton_LeftTrigger] ? 1.0f : 0.0f;
+    axes[5] = buttons[eGamepadButton_RightTrigger] ? 1.0f : 0.0f;
+    if (rawHats != nullptr && hatCount > 0)
+    {
+        buttons[eGamepadButton_DPAD_Up] = (rawHats[0] & GLFW_HAT_UP) != 0;
+        buttons[eGamepadButton_DPAD_Right] = (rawHats[0] & GLFW_HAT_RIGHT) != 0;
+        buttons[eGamepadButton_DPAD_Down] = (rawHats[0] & GLFW_HAT_DOWN) != 0;
+        buttons[eGamepadButton_DPAD_Left] = (rawHats[0] & GLFW_HAT_LEFT) != 0;
+    }
+    return true;
+#endif
+}
+// Controller diagnostics: the first raw and translated input changes of each
+// controller are written to the log, so a controller that is found but does
+// nothing can be told apart from one whose layout is wrong.
+static int sGamepadLogBudget = 120;
+#ifndef __ANDROID__
+static void LogRawGamepadChanges(int slot, int jid)
+{
+    static float prevAxes[eGamepadID_COUNT][16];
+    static unsigned char prevButtons[eGamepadID_COUNT][64];
+    static unsigned char prevHats[eGamepadID_COUNT][4];
+    static bool reported[eGamepadID_COUNT];
+    if (sGamepadLogBudget <= 0)
+        return;
+    int axisCount = 0, buttonCount = 0, hatCount = 0;
+    const float* axes = ::glfwGetJoystickAxes(jid, &axisCount);
+    const unsigned char* buttons = ::glfwGetJoystickButtons(jid, &buttonCount);
+    const unsigned char* hats = ::glfwGetJoystickHats(jid, &hatCount);
+    if (!reported[slot])
+    {
+        reported[slot] = true;
+        gConsole.LogMessage(eLogMessage_Info, "Gamepad%d raw device: %d axes, %d buttons, %d hats%s", slot + 1, axisCount, buttonCount, hatCount,
+            (axes && buttons) ? "" : " (NO DATA from device)");
+        for (int i = 0; axes && i < axisCount && i < 16; ++i)
+        {
+            prevAxes[slot][i] = axes[i];
+            gConsole.LogMessage(eLogMessage_Info, "Gamepad%d raw axis %d rests at %.2f", slot + 1, i, axes[i]);
+        }
+    }
+    for (int i = 0; axes && i < axisCount && i < 16 && sGamepadLogBudget > 0; ++i)
+    {
+        if (fabsf(axes[i] - prevAxes[slot][i]) < 0.5f)
+            continue;
+        prevAxes[slot][i] = axes[i];
+        --sGamepadLogBudget;
+        gConsole.LogMessage(eLogMessage_Info, "Gamepad%d raw axis %d = %.2f", slot + 1, i, axes[i]);
+    }
+    for (int i = 0; buttons && i < buttonCount && i < 64 && sGamepadLogBudget > 0; ++i)
+    {
+        if (buttons[i] == prevButtons[slot][i])
+            continue;
+        prevButtons[slot][i] = buttons[i];
+        --sGamepadLogBudget;
+        gConsole.LogMessage(eLogMessage_Info, "Gamepad%d raw button %d %s", slot + 1, i, buttons[i] ? "down" : "up");
+    }
+    for (int i = 0; hats && i < hatCount && i < 4 && sGamepadLogBudget > 0; ++i)
+    {
+        if (hats[i] == prevHats[slot][i])
+            continue;
+        prevHats[slot][i] = hats[i];
+        --sGamepadLogBudget;
+        gConsole.LogMessage(eLogMessage_Info, "Gamepad%d raw hat %d = %d", slot + 1, i, (int) hats[i]);
+    }
+}
+#else
+static void LogRawGamepadChanges(int, int) {}
+#endif
