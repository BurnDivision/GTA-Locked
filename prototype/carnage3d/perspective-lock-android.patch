+void MainMenuGamestate::OnGamestateInputEvent(KeyInputEvent& e) {
+    if(!e.mPressed)return;
+    switch(e.mKeycode) {
+        case eKeycode_UP:Act(frontend::Action::Up);break;
+        case eKeycode_DOWN:Act(frontend::Action::Down);break;
+        case eKeycode_LEFT:Act(frontend::Action::Left);break;
+        case eKeycode_RIGHT:Act(frontend::Action::Right);break;
+        case eKeycode_DELETE:if(mMenu.page==frontend::Page::Profiles)Act(frontend::Action::Rename);else return;break;
+        case eKeycode_BACKSPACE:Act(frontend::Action::Erase);break;
+        case eKeycode_R:if(mMenu.page==frontend::Page::Profiles)Act(frontend::Action::Reset);else return;break;
+        case eKeycode_ENTER:Act(frontend::Action::Accept);break;
+        case eKeycode_ESCAPE:Act(frontend::Action::Back);break;
+        default:return;
+    }e.SetConsumed();
+}
+void MainMenuGamestate::OnGamestateInputEvent(GamepadInputEvent& e) {
+    if(mCapture.active) {
+        if(!e.mPressed) mCapture.release(e.mGamepad,e.mButton);
+        else if(e.mGamepad==mCapture.gamepad && e.mButton==eGamepadButton_B)
+            mCapture.cancel();
+        else if(mCapture.press(e.mGamepad,e.mButton)) {
+            auto mapping=mControlsMapping;
+            if(mapping.AssignGamepadButton(ControlsRowAction(mMenu.row),e.mButton))SaveControls(mapping);
+        }
+        e.SetConsumed();return;
+    }
+    if(!e.mPressed)return;
+    switch(e.mButton) {
+        case eGamepadButton_DPAD_Up:Act(frontend::Action::Up);break;
+        case eGamepadButton_DPAD_Down:Act(frontend::Action::Down);break;
+        case eGamepadButton_DPAD_Left:Act(frontend::Action::Left);break;
+        case eGamepadButton_DPAD_Right:Act(frontend::Action::Right);break;
+        case eGamepadButton_A:case eGamepadButton_Start:Act(frontend::Action::Accept);break;
+        case eGamepadButton_B:Act(frontend::Action::Back);break;
+        default:return;
+    }e.SetConsumed();
+}
