+// Discover all real pads before exposing slot 1 as a virtual controller.
+static void DiscoverPads()
+{
+    for (int idx = 0; idx < SDL_NumJoysticks(); ++idx)
+    {
+        if (!SDL_IsGameController(idx)) continue;
+        const SDL_JoystickID id = SDL_JoystickGetDeviceInstanceID(idx);
+        bool opened = false;
+        for (auto* pad : gPads)
+            if (pad && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(pad)) == id) opened = true;
+        if (opened) continue;
+        for (int slot = 0; slot <= GLFW_JOYSTICK_LAST; ++slot)
+            if (!gPads[slot])
+            {
+                gPads[slot] = SDL_GameControllerOpen(idx);
+                if (gPads[slot]) touch::ReleaseAll();
+                break;
+            }
+    }
+}
+
+int glfwJoystickPresent(int jid)
+{
+    if (jid < 0 || jid > GLFW_JOYSTICK_LAST) return GLFW_FALSE;
+    DiscoverPads();
+    return gPads[jid] || (jid == GLFW_JOYSTICK_1 && touch::VirtualPad()) ? GLFW_TRUE : GLFW_FALSE;
+}
+
+int glfwJoystickIsGamepad(int jid) { return glfwJoystickPresent(jid); }
+
+int glfwGetGamepadState(int jid, GLFWgamepadstate* state)
+{
+    if (!state || !glfwJoystickPresent(jid)) return GLFW_FALSE;
+    if (jid == GLFW_JOYSTICK_1 && touch::VirtualPad())
+    {
+        memset(state, 0, sizeof(*state));
+        state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] = touch::gLeftStick.value.x;
+        state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] = touch::gLeftStick.value.y;
+        state->axes[GLFW_GAMEPAD_AXIS_RIGHT_X] = touch::gRightStick.value.x;
+        state->axes[GLFW_GAMEPAD_AXIS_RIGHT_Y] = touch::gRightStick.value.y;
+        state->axes[GLFW_GAMEPAD_AXIS_LEFT_TRIGGER] = -1;
+        state->axes[GLFW_GAMEPAD_AXIS_RIGHT_TRIGGER] = touch_sticks::Firing(touch::gRightStick.value) ? 1 : -1;
+        // Preserve the shim's stick-as-d-pad fallback for vehicle driving.
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_UP] = touch::gLeftStick.value.y < -.5f;
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_DOWN] = touch::gLeftStick.value.y > .5f;
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_LEFT] = touch::gLeftStick.value.x < -.5f;
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_RIGHT] = touch::gLeftStick.value.x > .5f;
+        return GLFW_TRUE;
+    }
+    SDL_GameController* c = gPads[jid];
+    static const SDL_GameControllerButton map[15] = {
+        SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_B, SDL_CONTROLLER_BUTTON_X, SDL_CONTROLLER_BUTTON_Y,
+        SDL_CONTROLLER_BUTTON_LEFTSHOULDER, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, SDL_CONTROLLER_BUTTON_BACK,
+        SDL_CONTROLLER_BUTTON_START, SDL_CONTROLLER_BUTTON_GUIDE, SDL_CONTROLLER_BUTTON_LEFTSTICK,
+        SDL_CONTROLLER_BUTTON_RIGHTSTICK, SDL_CONTROLLER_BUTTON_DPAD_UP, SDL_CONTROLLER_BUTTON_DPAD_RIGHT,
+        SDL_CONTROLLER_BUTTON_DPAD_DOWN, SDL_CONTROLLER_BUTTON_DPAD_LEFT };
+    memset(state, 0, sizeof(*state));
+    for (int i = 0; i < 15; ++i)
+        state->buttons[i] = SDL_GameControllerGetButton(c, map[i]) ? GLFW_PRESS : GLFW_RELEASE;
+
+    const float k = 1.0f / 32767.0f;
+    state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTX) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTY) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_RIGHT_X] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_RIGHTX) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_RIGHT_Y] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_RIGHTY) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_LEFT_TRIGGER] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERLEFT) * k * 2.0f - 1.0f;
+    state->axes[GLFW_GAMEPAD_AXIS_RIGHT_TRIGGER] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) * k * 2.0f - 1.0f;
+
+    // left analog stick also drives the d-pad (the game uses digital steering)
+    const float t = 0.5f;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] < -t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_UP] = GLFW_PRESS;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] > t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_DOWN] = GLFW_PRESS;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] < -t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_LEFT] = GLFW_PRESS;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] > t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_RIGHT] = GLFW_PRESS;
+    return GLFW_TRUE;
+}
+
+void glfwShimGetDisplaySize(int* width, int* height)
+{
+    int w = 0, h = 0;
+    if (gWindow.mSdlWindow) SDL_GL_GetDrawableSize(gWindow.mSdlWindow, &w, &h);
+    if (width) *width = w;
+    if (height) *height = h;
+}
+
+const char* glfwShimInternalStoragePath(void) { return SDL_AndroidGetInternalStoragePath(); }
+const char* glfwShimExternalStoragePath(void) { return SDL_AndroidGetExternalStoragePath(); }
+
+void glfwShimSetAspectLabel(const char* label)
+{
+    if (!label) return;
+    SDL_strlcpy(touch::gAspectLabel, label, sizeof(touch::gAspectLabel));
+}
+
+void glfwShimSetLockLabel(const char* label)
+{
+    if (!label) return;
+    strncpy(touch::gLockLabel, label, sizeof(touch::gLockLabel) - 1);
+    touch::gLockLabel[sizeof(touch::gLockLabel) - 1] = 0;
+}
+
+void glfwShimSetGameViewRect(int x, int y, int w, int h)
+{
+    if (x == touch::gViewX && y == touch::gViewY && w == touch::gViewW && h == touch::gViewH) return;
+    touch::ReleaseAll();
+    touch::gViewX = x; touch::gViewY = y; touch::gViewW = w; touch::gViewH = h;
+    touch::gScreenW = 0; // force a touch layout refresh on the next frame
+}
+
+// Launcher maps touch_controls="twinstick" to mode 3; apply on the SDL thread.
+// 0 auto, 1 always, 2 off, 3 twin-stick
+#include <jni.h>
+extern "C" JNIEXPORT void JNICALL Java_com_burndivision_gtaperspectivelock_GameActivity_nativeSetTouchMode(JNIEnv*, jclass, jint mode)
+{
+    gRequestedTouchMode.store((mode >= 0 && mode <= 3) ? (int)mode : 0);
+}
