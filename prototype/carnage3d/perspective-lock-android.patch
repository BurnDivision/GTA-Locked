+void glfwSwapBuffers(GLFWwindow* window)
+{
+    if (!window || !window->mSdlWindow) return;
+    int w = 0, h = 0;
+    SDL_GL_GetDrawableSize(window->mSdlWindow, &w, &h);
+    touch::Draw(w, h);
+    SDL_GL_SwapWindow(window->mSdlWindow);
+}
