diff --git a/src/mission/ChapterProgress.h b/src/mission/ChapterProgress.h
new file mode 100755
index 0000000..657622a
--- /dev/null
+++ b/src/mission/ChapterProgress.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "MissionVM.h"
+#include <optional>
+#include <limits>
+namespace mission {
+inline int chapterIndex(const std::string& section) {
+ const char* sections[]={"1","2","102","103","202","203"};
+ for(int i=0;i<6;++i)if(section==sections[i])return i;
+ return -1;
+}
+// TARGET_SCORE is a declaration, not the MISSION.INI metadata line.
+inline std::optional<int> chapterTarget(const Section& section) {
+ std::optional<int> target;
+ for(const auto& r:section.declarations)if(r.token=="TARGET_SCORE") {
+  if(target || r.operands.size()!=2)return {};
+  try {
+   std::size_t end=0;auto n=std::stoll(r.operands[0],&end);
+   if(end!=r.operands[0].size() || n<=0 || n>std::numeric_limits<int>::max())return {};
+   target=static_cast<int>(n);
+  }catch(...) {return {};}
+ }
+ return target;
+}
+enum class ChapterOutcome {Playing,Complete,GameOver};
+// 00446fe0 waits for root processes to stop. END 1 is success; score alone
+// starts the mission-authored finale and must not skip that script.
+inline ChapterOutcome chapterOutcome(const Process& root,bool gameOver) {
+ if(gameOver)return ChapterOutcome::GameOver;
+ if(!root.active && root.outcome==1)return ChapterOutcome::Complete;
+ return ChapterOutcome::Playing;
+}
+}
