+    void Reset(); // call before map objects are destroyed
+    void Prepare(const Section&);
+    void Update(float dt);
+    struct Phone { glm::vec3 position; int facing=0; unsigned int object=0; int mode=1,baseSprite=0; };
+    const std::map<int,Phone>& Phones() const {return phones_;}
+    std::optional<glm::vec3> Arrow(int owner) const;
+    struct Pickup {unsigned int object=0; int help=0; pickup::Box shape{}; int depth=0; int type=14;};
