+void cxx::json_document_node::set_string_attribute(const std::string& name, const std::string& value)
+{
+    if (!mJsonElement || mJsonElement->type != cJSON_Object) return;
+    cJSON* item = cJSON_CreateString(value.c_str());
+    if (cJSON_GetObjectItem(mJsonElement, name.c_str()))
+        cJSON_ReplaceItemInObject(mJsonElement, name.c_str(), item);
+    else cJSON_AddItemToObject(mJsonElement, name.c_str(), item);
+}
+
+cxx::json_document_node cxx::json_document_node::append_object()
+{
+    if (!mJsonElement || mJsonElement->type != cJSON_Array) return {};
+    cJSON* item = cJSON_CreateObject();
+    cJSON_AddItemToArray(mJsonElement, item);
+    return json_document_node{item};
+}
+
+void cxx::json_document_node::remove_attribute(const std::string& name)
+{
+    if (mJsonElement && mJsonElement->type == cJSON_Object)
+        cJSON_DeleteItemFromObject(mJsonElement, name.c_str());
+}
