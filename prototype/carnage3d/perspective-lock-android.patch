diff --git a/src/mission/MissionVM.cpp b/src/mission/MissionVM.cpp
new file mode 100755
index 0000000..2ca86b0
--- /dev/null
+++ b/src/mission/MissionVM.cpp
@@ -0,0 +1,759 @@
+#include "MissionVM.h"
+#include <algorithm>
+#include <limits>
+#include <set>
+#include <stdexcept>
+#include <utility>
+
+namespace mission {
+namespace {
+struct Command { const char* name; const char* evidence; bool supported; };
+const Command commands[]={
+#include "CommandTable.inc"
+};
+// 004b0d98 declaration-name table; the index is the record type (005f30e8).
+const char* const declarationTypes[]={
+    "CAR","PED","OBJECT","PLAYER","DRIVER","PARKED","MODEL","TELEPHONE","TRIGGER","DOOR",
+    "TARGET","FUTURE","COUNTER","CRANE","CLOCK","DUMMY","SPRAY","BARRIER","ESCORT","CARBOMB",
+    "BOMBSHOP","ESCORTED","STOPPED","INIT","FUTUREPED","CARTRIGGER","FUTUREDROP","HELLS",
+    "DRIVER_PARK","FUTURECAR","ONETRIGGER","MODEL_BARRIER","MOVING_TRIG","SPECIFIC_BARR",
+    "MPHONES","MODEL_DOOR","GTA_DEMAND","MY_MODEL","BOMBSHOP_COST","PHONE_TOGG","SPECIFIC_DOOR",
+    "TARGET_SCORE","DUM_MISSION_TRIG","CORRECT_MOD_TRIG","CORRECT_CAR_TRIG","CLOCK_START",
+    "CLOCK_STOP","MIDPOINT_MULTI","MID_MULTI_SETUP","FINAL_MULTI","POWERUP","BLOCK_INFO",
+    "SPECIFIC_DOOR_BOMB","MOVING_TRIG_HIRED","SETUP_SPEED","CARBOMB_TRIG","DAMAGE_TRIG",
+    "GUN_TRIG","GUN_SCREEN_TRIG","CARDESTROY_TRIG","CARWAIT_TRIG","PEDCAR_TRIG","CANNON_START",
+    "DUM_PED_BLOCK_TRIG","PARKED_PIXELS","CHOPPER_ENDPOINT","MISSION_COUNTER",
+    "SECRET_MISSION_COUNTER","MISSION_TOTAL","CARSTUCK_TRIG","BASIC_BARRIER","ALT_DAMAGE_TRIG"};
+static_assert(sizeof(declarationTypes)/sizeof(declarationTypes[0])==0x48,"exe declaration table");
+std::int32_t number(const std::string& s) {
+    std::size_t n=0; auto v=std::stoll(s,&n,10);
+    if(n!=s.size() || v<std::numeric_limits<std::int32_t>::min() ||
+       v>std::numeric_limits<std::int32_t>::max()) throw std::invalid_argument("int32 operand");
+    return static_cast<std::int32_t>(v);
+}
+std::int32_t wrap(std::uint32_t n) {
+    return n<=0x7fffffffU ? static_cast<std::int32_t>(n) :
+        -1-static_cast<std::int32_t>(0xffffffffU-n);
+}
+std::int16_t low16(std::int32_t n) {
+    const auto u=static_cast<std::uint32_t>(n)&65535U;
+    return static_cast<std::int16_t>(u<32768U ? static_cast<int>(u) : static_cast<int>(u)-65536);
+}
+bool oneOf(std::uint16_t id,std::initializer_list<int> ids) {
+    return std::find(ids.begin(),ids.end(),id)!=ids.end();
+}
+}
+LoadReport MissionVM::load(const Section& section) {
+    declarationOrder_.clear(); constructed_=false;
+    checkpoints_.fill(-1); checkpointCount_=checkpointCursor_=0; checkpointUnresolved_=false;
+    processes_={}; instructions_.clear(); lines_.clear(); labels_.clear();
+    entities_.clear(); triggers_.clear(); unresolvedTriggerTypes_=0; startupDone_=false; bookkeeping_.clear(); childRecords_.clear(); phoneRing_=false; phoneMission_={}; valid_=true;
+    LoadReport report; std::set<std::string> unsupported;
+    auto error=[&](const Record& r,const std::string& message) {
+        Diagnostic d{"load-invalid",message,r.line,-1};
+        report.diagnostics.push_back(d); world_.diagnostic(d); valid_=false;
+    };
+    std::int32_t recordIndex=-1;
+    for(const auto& r:section.declarations) {
+        ++recordIndex;
+        try {
+            const auto id=number(r.label); Entity e; e.declaration=r;
+            for(std::size_t n=0;n<std::size(declarationTypes);++n)
+                if(r.token==declarationTypes[n]) {e.type=static_cast<std::int32_t>(n); break;}
+            // 00445800 reads operands on demand (0044ae50). A missing operand
+            // is a fatal original error: keep the record and report it.
+            auto op=[&](std::size_t n)->std::int32_t {
+                if(n<r.operands.size()) return number(r.operands[n]);
+                Diagnostic d{"load-partial","declaration operand missing: "+r.token,r.line,-1};
+                report.diagnostics.push_back(d); world_.diagnostic(d); return 0;
+            };
+            auto typeAt=[&](std::int32_t other) {
+                auto at=entities_.find(other); return at==entities_.end()?-1:at->second.type;
+            };
+            auto valueAt=[&](std::int32_t other)->std::int32_t {
+                auto at=entities_.find(other);
+                return at==entities_.end() || !at->second.value ? -1 : *at->second.value;
+            };
+            // A referenced car record that is still FUTURECAR has no handle.
+            auto car=[&](std::int32_t other) {return typeAt(other)==0x1d?-1:valueAt(other);};
+            // 004744a0(x,y,z,type,a,b,c,prefix); the listed types move c to the
+            // bound handle and start with no delay.
+            auto alloc=[&](int type,std::int32_t a,std::int32_t b,std::int32_t c) {
+                Trigger trigger; trigger.type=type; trigger.target=a; trigger.radius=b;
+                trigger.delay=c; trigger.entity=id;
+                trigger.preserve=!r.prefix.empty() && number(r.prefix)>=0;
+                if(oneOf(static_cast<std::uint16_t>(type),
+                         {10,0xb,0xe,0xf,0x10,0x13,0x15,0x18,0x19,0x1b,0x1c,0x1d,0x1e,0x21})) {
+                    trigger.delay=0; trigger.bound=c;
+                }
+                triggers_.push_back(trigger);
+                e.value=static_cast<std::int32_t>(triggers_.size()-1);
+            };
+            switch(e.type) {
+            case 7: // TELEPHONE: 0043d3c0 keeps a positive first operand.
+                if(!r.operands.empty()) e.aux=number(r.operands[0]);
+                break;
+            case 12: // COUNTER
+                if(r.operands.empty()) throw std::invalid_argument("counter value missing");
+                e.value=op(0); e.aux=r.operands.size()>1?op(1):0; break;
+            // value = first operand, aux = second.
+            case 10: case 11: case 0x18: case 0x1d: case 0x32: case 0x33:
+            case 0x42: case 0x43: case 0x44:
+                if(!r.operands.empty()) {e.value=op(0); e.aux=r.operands.size()>1?op(1):0;}
+                break;
+            case 0xf: if(r.operands.size()>1) e.value=op(1); break;
+            case 0x1a: if(!r.operands.empty()) e.value=op(0); break;
+            case 8: alloc(4,op(0),op(1),0); break;
+            case 0x10: alloc(3,op(0),op(1),0); break;
+            case 0x14: alloc(8,op(0),op(1),0); break;
+            case 0x19: alloc(9,op(0),op(1),0); break;
+            case 0x1e: {const auto third=op(2); alloc(10,op(0),op(1),typeAt(third)==0x1d?-1:third); e.aux=third; break;}
+            case 0x20: {
+                const auto first=op(0),second=op(1),third=op(2);
+                e.aux=first; alloc(0xb,car(first),second,third); break;
+            }
+            case 0x22: alloc(0xc,op(0),op(1),0); break;
+            case 0x27: alloc(0xd,valueAt(op(0)),op(1),0); break;
+            case 0x2a: {const auto third=op(2); e.aux=third; alloc(0xe,op(0),op(1),car(third)); break;}
+            case 0x2b: alloc(0xf,op(0),op(1),op(2)); break;
+            case 0x2c: e.aux=op(2); alloc(0x10,op(0),op(1),-1); break;
+            case 0x2d: alloc(0x11,op(0),op(1),0); break;
+            case 0x2e: {
+                // CLOCK_STOP links itself into the referenced CLOCK_START.
+                const auto first=op(0); const auto other=valueAt(first);
+                auto at=entities_.find(first);
+                if(at!=entities_.end()) at->second.aux=recordIndex;
+                alloc(0x12,other,op(1),0);
+                if(other>=0 && static_cast<std::size_t>(other)<triggers_.size()-1)
+                    triggers_[other].bound=*e.value;
+                break;
+            }
+            case 0x2f: case 0x31: {
+                if(e.type==0x2f) {e.aux=op(0); alloc(0x13,-1,op(1),0);}
+                else alloc(0x14,-1,op(0),0);
+                const int byte=*e.value&255;
+                if(checkpointCount_<20) checkpoints_[checkpointCount_++]=byte<128?byte:byte-256;
+                else checkpointUnresolved_=true; // original would overwrite adjacent globals
+                break;
+            }
+            case 0x30: { // 00445800 -> 00474db0, only preceding declarations exist
+                int current=op(0); std::set<int> visited;
+                while(true) {
+                    auto at=entities_.find(current);
+                    if(at==entities_.end() || at->second.type!=0x2f || !at->second.value ||
+                       !visited.insert(current).second) {checkpointUnresolved_=true; break;}
+                    auto next=entities_.find(at->second.aux);
+                    if(next==entities_.end() || !next->second.value ||
+                       (next->second.type!=0x2f && next->second.type!=0x31)) {checkpointUnresolved_=true; break;}
+                    const int handle=*at->second.value;
+                    if(handle<0 || handle>=int(triggers_.size())) {checkpointUnresolved_=true; break;}
+                    triggers_[handle].bound=*next->second.value;
+                    if(next->second.type!=0x2f) break;
+                    current=next->first;
+                }
+                break;
+            }
+            case 0x35: {const auto first=op(0); e.aux=first; alloc(0x16,car(first),op(1),0); break;}
+            case 0x37: {const auto first=op(0); e.aux=first; alloc(0x18,op(1),0,car(first)); break;}
+            case 0x38: alloc(0x19,op(0),op(1),0); break;
+            case 0x39: alloc(0x1a,op(0),op(1),0); break;
+            case 0x3a: {
+                const auto second=op(1);
+                if(typeAt(second)==99) alloc(0x1b,op(0),0,valueAt(second));
+                else {alloc(0x1b,op(0),0,-1); e.aux=second;}
+                break;
+            }
+            case 0x3b: {const auto third=op(2); e.aux=third; alloc(0x1c,op(0),op(1),car(third)); break;}
+            case 0x3c: {const auto second=op(1); e.aux=second; alloc(0x1d,op(0),0,car(second)); break;}
+            case 0x3d: {
+                const auto first=op(0),second=op(1),third=op(2);
+                const bool both=typeAt(second)==99 && typeAt(third)==0;
+                alloc(0x1e,both?valueAt(third):-1,first,both?valueAt(second):-1); break;
+            }
+            case 0x3e: alloc(0x1f,op(0),op(1),0); break;
+            case 0x3f: {
+                const auto third=op(2); std::int32_t bound=-1;
+                if(typeAt(third)!=99) {e.aux=third; bound=valueAt(third);}
+                alloc(0x15,op(0),op(1),bound); break;
+            }
+            case 0x45: {const auto second=op(1); e.aux=second; alloc(0x20,op(0),0,car(second)); break;}
+            case 0x47: alloc(0x21,op(0),op(1),0); break;
+            default: break; // Remaining types create world objects or doors.
+            }
+            if(!entities_.emplace(id,std::move(e)).second) error(r,"duplicate entity ID");
+            else declarationOrder_.push_back(id);
+        } catch(const std::exception& e) {error(r,e.what());}
+    }
+    for(std::size_t n=0;n<section.declarations.size();++n) bookkeeping_[static_cast<int>(n)].type=0;
+    for(const auto& r:section.instructions) {
+        Instruction i;
+        for(std::size_t op=0;op<std::size(commands);++op) {
+            if(r.token==commands[op].name) {i.opcode=static_cast<std::uint16_t>(op); break;}
+        }
+        if(i.opcode==0xffff || !commands[i.opcode].supported) unsupported.insert(r.token);
+        try {
+            if(instructions_.size()>=32768) throw std::invalid_argument("signed16 PC capacity exceeded");
+            if(!labels_.emplace(number(r.label),instructions_.size()).second)
+                error(r,"duplicate instruction label: unsafe original behavior rejected");
+            // Lexical parser preserves comments; strip brace comments before integer reading.
+            std::string text; bool comment=false;
+            for(char c:r.rawOperands) {
+                if(c=='{') {comment=true; text+=' ';}
+                else if(c=='}') comment=false;
+                else if(!comment) text+=c;
+            }
+            if(comment) throw std::invalid_argument("unterminated operand comment");
+            std::vector<std::int32_t> values;
+            std::size_t begin=0;
+            while(begin<text.size()) {
+                begin=text.find_first_not_of(" \t\r\n",begin);
+                if(begin==std::string::npos) break;
+                auto end=text.find_first_of(" \t\r\n",begin);
+                values.push_back(number(text.substr(begin,end-begin)));
+                if(end==std::string::npos) break;
+                begin=end;
+            }
+            if(values.size()!=5) throw std::invalid_argument("instruction requires five int32 operands");
+            i.A=values[0]; i.B=values[1]; i.C=values[2]; i.D=values[3]; i.E=values[4];
+        } catch(const std::exception& e) {error(r,e.what());}
+        instructions_.push_back(i); lines_.push_back(r.line);
+    }
+    report.unsupported.assign(unsupported.begin(),unsupported.end());
+    for(const auto& token:report.unsupported) {
+        Diagnostic d{"unsupported",token,section.line,-1};
+        report.diagnostics.push_back(d); world_.diagnostic(d);
+    }
+    return report;
+}
+std::size_t MissionVM::indexOf(std::int32_t label) const {return labels_.at(label);}
+void MissionVM::construct() {
+    if(constructed_ || !valid_) return;
+    constructed_=true;
+    // Loader order is physical declaration order, never numeric label order.
+    // FUTUREPED/FUTURECAR retain their operands until an explicit *_ON.
+    for(auto id:declarationOrder_) {
+        const int type=entities_.at(id).type;
+        const char* token=type==1?"LOAD_PED":type==5 || type==0x40?"LOAD_PARKED":nullptr;
+        if(!token) continue;
+        Instruction declared; declared.A=id;
+        WorldRequest request{token,"00445800",0,0,declared,processes_[0],entities_,instructions_,labels_};
+        if(world_.execute(request)==WorldResult::Unresolved)
+            issue("construction-unresolved",std::string(token)+" declaration "+std::to_string(id));
+    }
+}
+void MissionVM::issue(std::string code,std::string detail,int slot) {
+    std::size_t line=0;
+    if(slot>=0 && slot<32 && processes_[slot].pc>=0 &&
+       static_cast<std::size_t>(processes_[slot].pc)<lines_.size()) line=lines_[processes_[slot].pc];
+    world_.diagnostic({std::move(code),std::move(detail),line,slot});
+}
+void MissionVM::block(int slot,const std::string& detail) {
+    processes_[slot].blocked=true; issue("unresolved",detail,slot);
+}
+bool MissionVM::start(int slot,std::optional<std::int32_t> label) {
+    if(slot<0 || slot>=32 || !valid_ || instructions_.empty()) return false;
+    std::size_t pc=0;
+    if(label) {
+        auto at=labels_.find(*label);
+        if(at==labels_.end()) {issue("invalid-start","missing label",slot); return false;}
+        pc=at->second;
+    }
+    Process p; p.active=true; p.pc=static_cast<std::int16_t>(pc); p.player=static_cast<std::int16_t>(slot);
+    // Loader has trigger 0 for participants; children use -1 (00445800 / 00448edd).
+    p.trigger=slot<4 ? 0 : -1; processes_[slot]=p; return true;
+}
+int MissionVM::owner(int slot) const {
+    for(int depth=0;depth<32;++depth) {
+        const int parent=processes_[slot].parent;
+        if(parent<0) return slot;
+        if(parent>=32) return -1;
+        slot=parent;
+    }
+    return -1;
+}
+void MissionVM::pay(int slot,const Instruction& i) {
+    if(i.E>0) world_.reward(owner(slot),i.E);
+}
+void MissionVM::cleanup(int slot) {
+    auto& p=processes_[slot];
+    // 0043e3b0/0043e2b0 -> 00474d10(handle), bounds 0..0xd1. Includes the
+    // loader's handle 0 for participants; unallocated slots are unobservable.
+    if(p.trigger>=0 && p.trigger<=0xd1 && static_cast<std::size_t>(p.trigger)<triggers_.size())
+        triggers_[p.trigger].state=1;
+    p.active=false; p.pc=0; p.timer=0; p.trigger=0; p.protection=0; p.aux=-1;
+}
+void MissionVM::branch(int slot,std::int32_t target) {
+    auto& p=processes_[slot]; p.state=1;
+    if(target==-1) {cleanup(slot); return;}
+    if(target<0) {
+        p.active=false; block(slot,"negative destination other than -1 would index outside original label table"); return;
+    }
+    if(target==0) {p.pc=low16(static_cast<std::int32_t>(p.pc)+1); return;}
+    auto at=labels_.find(target);
+    if(at==labels_.end()) {block(slot,"missing destination label "+std::to_string(target)); return;}
+    p.pc=static_cast<std::int16_t>(at->second);
+}
+bool MissionVM::wait(int slot,const Instruction& i) {
+    auto& state=processes_[slot].state;
+    if(state==1) state=i.D>0 ? low16(wrap(static_cast<std::uint32_t>(i.D)+5U)) : 0;
+    if(state>5) {state=low16(state-1); return state==5;}
+    return false;
+}
+WorldResult MissionVM::execute(int slot,Instruction& i) {
+    const auto& c=commands[i.opcode];
+    WorldRequest request{c.name,std::string("TODO-evidence:")+c.evidence,slot,owner(slot),
+                         i,processes_[slot],entities_,instructions_,labels_};
+    return world_.execute(request);
+}
+bool MissionVM::predicate(int slot,Instruction& i,bool& value) {
+    const auto& c=commands[i.opcode];
+    WorldRequest r{c.name,std::string("TODO-evidence:")+c.evidence,slot,owner(slot),
+                   i,processes_[slot],entities_,instructions_,labels_};
+    auto result=world_.predicate(r);
+    if(!result) {block(slot,std::string(c.name)+" predicate unresolved"); return false;}
+    value=*result; return true;
+}
+void MissionVM::tick() {
+    // 00479e00 -> 0047a3a0: every trigger whose state is not 4, in handle
+    // order, for each participant, before the ascending live scheduler.
+    auto spawn=[&](int handle,int root) {
+        auto& t=triggers_[handle];
+        int child=4; while(child<32 && processes_[child].active) ++child;
+        if(child==32) {issue("trigger-exhausted","No free process slot; unsafe original write rejected",root); t.state=3; return;}
+        auto target=labels_.find(t.target);
+        if(target==labels_.end()) {issue("unresolved","Missing trigger target",root); return;}
+        auto& c=processes_[child]; c.active=true; c.blocked=false; c.state=1;
+        c.pc=static_cast<std::int16_t>(target->second); c.parent=root;
+        c.player=processes_[root].player; c.trigger=static_cast<std::int16_t>(handle); t.state=3;
+    };
+    for(int handle=0;handle<static_cast<int>(triggers_.size());++handle) for(int root=0;root<4;++root) {
+        auto& t=triggers_[handle];
+        if(t.state==4 || processes_[root].player<0) continue;
+        Instruction query; query.A=t.entity; query.D=t.radius; query.E=t.bound;
+        auto ask=[&](const char* token) {
+            WorldRequest request{token,"0047a3a0",root,root,query,processes_[root],entities_,instructions_,labels_};
+            return world_.predicate(request);
+        };
+        if(t.type==0x13 || t.type==0x14) {
+            if(root!=0) {checkpointUnresolved_=true; continue;}
+            if(checkpointUnresolved_) continue;
+            if(checkpointCursor_>=20) {checkpointUnresolved_=true; continue;}
+            if(checkpoints_[checkpointCursor_]!=handle) continue;
+            auto inside=ask("CHECKPOINT_AREA");
+            if(!inside) {checkpointUnresolved_=true; continue;}
+            if(!*inside || (t.state!=1 && t.state!=0)) continue;
+            // In single player, +8 changes from -1 to participant0 exactly
+            // once. Re-entry by that participant never advances the cursor.
+            if(t.target==0) continue;
+            if(t.target!=-1 || (t.type==0x13 && (t.bound<0 || t.bound>=int(triggers_.size())))) {
+                checkpointUnresolved_=true; continue;
+            }
+            Instruction event;
+            event.D=t.type;
+            if(t.type==0x13) event.A=triggers_[t.bound].entity;
+            WorldRequest notice{"CHECKPOINT_PASSED","0047b4bf",root,root,event,processes_[root],entities_,instructions_,labels_};
+            if(world_.execute(notice)!=WorldResult::Done) {checkpointUnresolved_=true; continue;}
+            ++checkpointCursor_; t.target=0; t.state=1;
+            if(t.type==0x13) triggers_[t.bound].state=1;
+            continue;
+        }
+        if(t.type==4 || t.type==12) {
+            if(t.type==4 && t.state==3) continue;
+            auto inside=ask(t.type==4?"AREA_TRIGGER":"MPHONES_TRIGGER");
+            if(!inside) {issue("unresolved","Trigger player mode/position mapping unavailable",root); continue;}
+            if(t.type==12 && t.state==0) {t.state=1; continue;}
+            if(!*inside || t.state!=1) continue;
+            t.state=0;
+            if(t.type==12 && (phoneRing_ || phoneMission_[root])) continue;
+            spawn(handle,root);
+            continue;
+        }
+        if(t.type==9 || t.type==0x10 || t.type==0xf) {
+            // Mode0 (seated driver) types. 9 CARTRIGGER: the car's record ID
+            // (car+0x134) equals the second operand, anywhere on the map.
+            // 0x10 CORRECT_CAR_TRIG: inside the area in the bound car.
+            // 0xf CORRECT_MOD_TRIG: inside the area; the action tests the model.
+            if(t.type!=9 && t.bound==-1) continue;
+            if(t.type==0x10 && t.state==3) continue;
+            auto fire=ask(t.type==9?"CAR_TRIGGER":t.type==0x10?"CORRECT_CAR_TRIGGER":"CORRECT_MODEL_TRIGGER");
+            if(!fire) {issue("unresolved","Trigger player mode/position mapping unavailable",root); continue;}
+            if(!*fire) continue;
+            if(t.state==1) t.state=0; // these types are allocated without a delay
+            if(t.state!=0) continue;
+            if(t.type==0xf) {
+                auto model=ask("TRIGGER_CAR_MODEL");
+                if(!model) {issue("unresolved","Trigger car model mapping unavailable",root); continue;}
+                if(!*model) continue;
+            }
+            spawn(handle,root);
+            continue;
+        }
+        // The remaining 0047a3a0 types test original car/ped fields with no
+        // proved engine projection. Their ENABLE/DISABLE state is exact, but
+        // they never fire: report that once per type instead of faking it.
+        if(t.state==1 && t.type>=0 && t.type<64 && !(unresolvedTriggerTypes_>>t.type&1)) {
+            unresolvedTriggerTypes_|=std::uint64_t(1)<<t.type;
+            issue("trigger-unresolved","Trigger type "+std::to_string(t.type)+" update not implemented (0047a3a0)");
+        }
+    }
+    // 00446fe0: ascending live slots; END aliases the loop cursor to its root.
+    for(int slot=0;slot<32;++slot) {
+        auto& p=processes_[slot];
+        if(!p.active || p.blocked) continue;
+        if(p.pc<0 || static_cast<std::size_t>(p.pc)>=instructions_.size()) {
+            block(slot,"physical PC out of range"); continue;
+        }
+        if(owner(slot)<0) {block(slot,"invalid/cyclic parent chain"); continue;}
+        epilogueSlot_=slot;
+        step(slot);
+        slot=epilogueSlot_;
+        world_.postDispatch(slot,processes_[slot]); // Also for DONOWT and newly deactivated processes.
+    }
+}
+void MissionVM::step(int slot) {
+    auto& p=processes_[slot]; auto& i=instructions_[p.pc];
+    const auto op=i.opcode;
+    if(op>=std::size(commands) || !commands[op].supported) {block(slot,"unsupported opcode"); return;}
+    auto success=[&] {pay(slot,i); branch(slot,i.B);};
+    if(op==143) {
+        bool single=processes_[0].player==0;
+        for(int root=1;root<4;++root) if(processes_[root].player>=0) single=false;
+        WorldRequest request{"CHECKPOINT_PARTICIPANT","00474040",slot,owner(slot),i,p,entities_,instructions_,labels_};
+        auto participant=world_.predicate(request);
+        auto at=entities_.find(i.A);
+        if(!single || !participant || !*participant || checkpointUnresolved_ || checkpointCursor_>=20 ||
+           at==entities_.end() || !at->second.value) {
+            block(slot,"WAIT_FOR_PLAYERS single-player checkpoint projection unresolved"); return;
+        }
+        switch(at->second.type) {
+        case 0: case 1: case 2: case 3: case 5: case 6:
+        case 0x12: case 0x15: case 0x16: case 0x1b: case 99:
+            block(slot,"WAIT_FOR_PLAYERS original object-slot value unresolved"); return;
+        default: break;
+        }
+        // Signed next handle > FULL value(A). Sentinel -1 is not completion.
+        if(checkpoints_[checkpointCursor_]>*at->second.value) success();
+        else branch(slot,i.C);
+        return;
+    }
+    auto effect=[&](bool reward=true) {
+        auto r=execute(slot,i);
+        if(r==WorldResult::Failure && oneOf(op,{32,40,53,74,79})) {
+            branch(slot,i.C); return; // Known invalid-handle/dead guard, no R.
+        }
+        if(r!=WorldResult::Done) {block(slot,std::string(commands[op].name)+" immediate effect unresolved"); return;}
+        if(op==18) p.trigger=-1;
+        if(reward) pay(slot,i);
+        branch(slot,i.B);
+    };
+    auto counter=[&]() -> std::int32_t* {
+        auto at=entities_.find(i.A);
+        if(at==entities_.end() || !at->second.value) {block(slot,"entity value/handle unresolved"); return nullptr;}
+        return &*at->second.value;
+    };
+    // Nested exe geometry/state predicates remain world-owned and may be unknown.
+    auto phoneQuery=[&](const char* token,int id)->std::optional<bool> {
+        Instruction query=i; query.A=id;
+        WorldRequest r{token,"00476340/00478630/00478700",slot,owner(slot),query,p,entities_,instructions_,labels_};
+        return world_.predicate(r);
+    };
+    auto phoneEffect=[&](const char* token,int id) {
+        Instruction event=i; event.A=id;
+        WorldRequest r{token,"00478900/00478b30/00478c90/00478d80",slot,owner(slot),event,p,entities_,instructions_,labels_};
+        if(world_.execute(r)!=WorldResult::Done) issue("partial",std::string(token)+" presentation/cleanup unresolved",slot);
+    };
+    if(op==2) {
+        if(p.state==1) {
+            p.state=low16(wrap(static_cast<std::uint32_t>(i.D)+10U)); i.E=1;
+            phoneEffect("PHONE_ANSWER_START",i.A);
+        }
+        auto entity=entities_.find(i.A);
+        if(entity==entities_.end()) {block(slot,"ANSWER missing phone"); return;}
+        bool eligible=true;
+        if(entity->second.aux>0 && i.E==1) {
+            auto result=phoneQuery("PHONE_ELIGIBLE",i.A);
+            if(!result) {block(slot,"00476340 eligibility unresolved"); return;}
+            eligible=*result; i.E=eligible?1:0;
+        }
+        const bool expired=p.timer==0;
+        if(expired) {
+            phoneEffect("PHONE_RING",i.A); p.timer=50; p.state=low16(p.state-1);
+            if(p.state==10) {phoneEffect("PHONE_STOP",i.A); branch(slot,i.C); return;}
+        } else p.timer=low16(p.timer-1);
+        if(!eligible) return;
+        auto near=phoneQuery("PHONE_NEAR",i.A);
+        if(!near) {block(slot,"00478630 answer geometry unresolved"); return;}
+        if(!*near) return;
+        auto state=phoneQuery("PHONE_ON_FOOT",i.A);
+        if(!state) {block(slot,"original ped state6/7 mapping unresolved"); return;}
+        if(!*state) return;
+        phoneEffect("PHONE_STOP",i.A);
+        branch(slot,expired && i.E!=1?i.C:i.B); return;
+    }
+    if(op==16) {
+        const int root=owner(slot);
+        if(root>=4) {block(slot,"MPHONE requires participant root"); return;}
+        if(phoneMission_[root]) return;
+        if(i.C<0 || i.C>0x578 || i.A<0 || i.A>INT32_MAX-i.C) {
+            block(slot,"invalid phone group"); return;
+        }
+        auto validPhone=[&](int id) {
+            auto at=entities_.find(id);
+            if(at==entities_.end() || at->second.declaration.token!="TELEPHONE") return false;
+            if(at->second.value) return *at->second.value>=0;
+            auto valid=phoneQuery("PHONE_VALID",id);
+            if(!valid) {block(slot,"phone runtime handle validity unresolved"); return false;}
+            return *valid;
+        };
+        auto group=[&](const char* event) {
+            for(int n=0;n<i.C;++n) if(validPhone(i.A+n)) phoneEffect(event,i.A+n);
+        };
+        if(p.state==1) {
+            p.state=0;
+            if(!phoneRing_) {phoneRing_=true; i.D=25; group("PHONE_START");}
+        }
+        i.D=wrap(static_cast<std::uint32_t>(i.D)-1U);
+        auto range=phoneQuery("PHONE_RANGE",i.A);
+        if(!range) {block(slot,"00478700 group range geometry unresolved"); return;}
+        if(!*range) {group("PHONE_STOP"); phoneRing_=false; p.active=false; return;}
+        bool rang=false;
+        for(int n=0;n<i.C;++n) {
+            if(!validPhone(i.A+n)) continue;
+            if(i.D==0 || i.D==-10) {phoneEffect("PHONE_RING",i.A+n); rang=true;}
+            auto near=phoneQuery("PHONE_NEAR",i.A+n);
+            if(!near) {block(slot,"00478630 answer geometry unresolved"); return;}
+            if(!*near) continue;
+            auto foot=phoneQuery("PHONE_ON_FOOT",i.A+n);
+            if(!foot) {block(slot,"phone player state mapping unresolved"); return;}
+            if(!*foot) continue;
+            group("PHONE_STOP");
+            for(int other=3;other<32;++other) {
+                auto& c=processes_[other];
+                if(other==slot || !c.active || c.protection==1 || c.protection==2) continue;
+                if(c.pc>=0 && static_cast<std::size_t>(c.pc)<instructions_.size() && instructions_[c.pc].opcode==16) continue;
+                cleanup(other);
+            }
+            // 0043fb20 then runs the RESET world cleanup, including 004745a0.
+            for(auto& t:triggers_) if(!t.preserve) t.state=4;
+            phoneEffect("PHONE_MISSION_CLEANUP",i.A+n);
+            branch(slot,i.B); p.pc=low16(static_cast<int>(p.pc)+n);
+            entities_.at(i.A+n).value=-1; phoneRing_=false; phoneMission_[root]=true;
+            return;
+        }
+        if(rang) i.D=i.D==0?-1:25;
+        return;
+    }
+    if(op==18 || op==19) {
+        auto at=entities_.find(i.A);
+        if(at==entities_.end()) {
+            block(slot,std::string(commands[op].name)+" record missing: original indexes outside the record table"); return;
+        }
+        auto& e=at->second;
+        auto valueOf=[&](std::int32_t id)->std::int32_t {
+            auto other=entities_.find(id);
+            return other==entities_.end() || !other->second.value ? -1 : *other->second.value;
+        };
+        const std::int32_t handle=e.value?*e.value:-1;
+        // 00474d70/00474d10 accept handles 0..0xd1; anything else only logs.
+        Trigger* trigger=handle>=0 && handle<=0xd1 && static_cast<std::size_t>(handle)<triggers_.size()
+            ? &triggers_[handle] : nullptr;
+        if(op==18) {
+            // 004476ef: 00474d70(record.value) whatever the record type, then
+            // the process forgets its own trigger.
+            if(trigger) trigger->state=4;
+            p.trigger=-1; success(); return;
+        }
+        // 00447752 -> 0043e4f0. Door-family records are world state and are
+        // not followed by 00474d10.
+        if(oneOf(static_cast<std::uint16_t>(e.type),{9,0x11,0x1f,0x21,0x23,0x28,0x34})) {effect(); return;}
+        if(trigger) {
+            switch(e.type) {
+            case 0x1e: case 0x2a: case 0x2c: case 0x37: case 0x3a: case 0x3b: case 0x3c: case 0x3f: case 0x45:
+                trigger->bound=valueOf(e.aux); break; // 00474db0
+            case 0x20: case 0x35:
+                trigger->target=valueOf(e.aux); // 00474dd0
+                issue("partial","Moving trigger car list (00474c30) unresolved",slot); break;
+            case 0x3d: {
+                const auto& operands=e.declaration.operands;
+                if(operands.size()>=3) {
+                    trigger->bound=valueOf(number(operands[1]));
+                    trigger->target=valueOf(number(operands[2]));
+                }
+                break;
+            }
+            default: break;
+            }
+            trigger->state=1;
+        }
+        success(); return;
+    }
+    if(op==129) {
+        for(int other=3;other<32;++other) {
+            const auto& c=processes_[other];
+            if(other==slot || !c.active || c.protection==1 || c.protection==2) continue;
+            if(c.pc>=0 && static_cast<std::size_t>(c.pc)<instructions_.size() && instructions_[c.pc].opcode==16) continue;
+            cleanup(other);
+        }
+        for(auto& t:triggers_) if(!t.preserve) t.state=4;
+        // Known VM effects apply even when nested world cleanup remains unresolved.
+        effect(); return;
+    }
+    if(op==17) return;
+    if(op==4) {
+        if(p.state==1) {p.state=2; i.C=i.D; return;}
+        i.C=wrap(static_cast<std::uint32_t>(i.C)-1U);
+        if(i.C<=0) success();
+        return;
+    }
+    if(op==20 || op==127 || op==128) {
+        auto v=counter(); if(!v) return;
+        if(op==20) *v=wrap(static_cast<std::uint32_t>(*v)-1U);
+        if(op==127) *v=wrap(static_cast<std::uint32_t>(*v)+1U);
+        const bool yes=op==20 ? *v<=0 : op==127 ? i.D>=0 && *v>=i.D : *v==i.D;
+        if(yes) success(); else branch(slot,i.C);
+        return;
+    }
+    if(op==10) {
+        int at=slot;
+        while(at>=0) {
+            auto& proc=processes_[at]; proc.active=false; proc.outcome=low16(i.A); at=proc.parent;
+        }
+        const int root=owner(slot);
+        processes_[root].pc=p.pc; processes_[root].timer=p.timer;
+        epilogueSlot_=root; return;
+    }
+    if(op==89) {
+        int child=4; while(child<32 && processes_[child].active) ++child;
+        if(child==32) {branch(slot,i.C); return;}
+        std::size_t dest=static_cast<std::size_t>(p.pc)+1;
+        if(i.A!=0) {
+            auto at=labels_.find(i.A);
+            if(at==labels_.end()) {block(slot,"KICKSTART missing child label"); return;}
+            dest=at->second;
+        }
+        if(dest>=instructions_.size()) {block(slot,"KICKSTART child PC out of range"); return;}
+        int record=0x577;
+        for(;record>=0;--record) {
+            auto& entry=bookkeeping_[record];
+            if(entry.type==-1 && entry.cells[0]==-1 && entry.cells[1]==-1 && entry.cells[2]==-1) break;
+        }
+        if(record<0) {block(slot,"KICKSTART bookkeeping exhaustion: unsafe original write rejected"); return;}
+        auto& c=processes_[child]; c.active=true; c.blocked=false; c.state=1; c.trigger=-1;
+        c.pc=static_cast<std::int16_t>(dest);
+        c.parent=static_cast<std::int16_t>(owner(slot)); c.player=processes_[owner(slot)].player;
+        c.protection=p.protection;
+        const auto target=i.B;
+        branch(slot,target); // Original branches before writing shared D/E.
+        i.D=child; i.E=slot; childRecords_[child]=record;
+        bookkeeping_[record].type=100; bookkeeping_[record].cells[0]=child;
+        return;
+    }
+    if(op==96 || op==98 || op==101) {
+        // Partial contract: A points to spawning instruction; never interpret A as slot.
+        auto at=labels_.find(i.A);
+        if(at==labels_.end()) {block(slot,"process cancellation references missing label"); return;}
+        auto& parent=instructions_[at->second];
+        auto mapped=childRecords_.find(parent.D);
+        auto record=bookkeeping_.find(mapped==childRecords_.end()?-1:mapped->second);
+        if(record!=bookkeeping_.end()) {
+            auto& entry=record->second;
+            auto cancel=[&](int cell) {
+                const int child=entry.cells[cell];
+                if(child>=0 && child<32) cleanup(child);
+                entry.type=100; entry.cells[cell]=-1;
+            };
+            if(op==101) {
+                if(i.D>=1 && i.D<=4) cancel(i.D-1);
+            } else for(int cell=0;cell<4;++cell) cancel(cell);
+        } else issue("partial","Cancellation record absent; original uninitialized access rejected",slot);
+        if(op==96 || (op==101 && (i.D<1 || i.D>4))) if(parent.E>=0) parent.E=-1;
+        success(); return;
+    }
+    if(op==60) {
+        // STARTUP 004480af: once per load it marks the trigger record fired
+        // (00474d30, state3) and branches B without a reward. Any later
+        // visit waits on the instruction forever.
+        if(startupDone_) return;
+        startupDone_=true;
+        auto at=entities_.find(i.A);
+        const std::int32_t handle=at==entities_.end() || !at->second.value ? -1 : *at->second.value;
+        if(handle>=0 && handle<=0xd1 && static_cast<std::size_t>(handle)<triggers_.size()) triggers_[handle].state=3;
+        // 00401050(10,0,0x14): a timed event whose consumer is not recovered.
+        issue("partial","STARTUP timed event 00401050(10,0,0x14) unresolved",slot);
+        branch(slot,i.B); return;
+    }
+    if(op==109) {
+        // LOCATE 00449e31: on foot within E pixels (0 means 16) of the
+        // 0043e680 position. E is a radius and is never paid. Success
+        // branches B; only an expired W(D) branches C.
+        if(p.state==1) p.state=i.D>0 ? low16(wrap(static_cast<std::uint32_t>(i.D)+5U)) : 2;
+        bool yes=false;
+        if(!predicate(slot,i,yes)) return;
+        if(yes) {branch(slot,i.B); return;}
+        if(p.state>5) {p.state=low16(p.state-1); if(p.state==5) branch(slot,i.C);}
+        return;
+    }
+    if(op==130) {p.protection=1; success(); return;}
+    if(op==141) {
+        if(execute(slot,i)!=WorldResult::Done) {block(slot,"KF_PROCESS unlock unresolved"); return;}
+        p.protection=2; success(); return;
+    }
+    if(op==142) {
+        if(execute(slot,i)!=WorldResult::Done) {block(slot,"RESET_KF relock unresolved"); return;}
+        for(int at=3;at<32;++at) if(at!=slot && processes_[at].protection==2) cleanup(at);
+        success(); return;
+    }
+    if(op==45) {pay(slot,i); world_.incrementMultiplier(owner(slot)); branch(slot,i.B); return;}
+    if(op==103) {
+        auto at=labels_.find(i.A);
+        if(at==labels_.end()) {block(slot,"FRENZY_SET missing instruction label"); return;}
+        instructions_[at->second].D=world_.score(owner(slot)); success(); return;
+    }
+    if(op==102 || op==104) {
+        const auto score=world_.score(owner(slot));
+        bool yes=(op==102 ? score : wrap(static_cast<std::uint32_t>(score)-static_cast<std::uint32_t>(i.D)))>=i.A;
+        if(yes) effect(); else branch(slot,i.C); // score flag / sound4 is a world effect.
+        return;
+    }
+    // Known predicates, with VM-owned W(D), R/S/F. World implements exact entity
+    // health/state/model/screen tests rather than synthesizing engine handles here.
+    if(oneOf(op,{1,3,21,39,70,71,84,85,90,105,106,120,132,133})) {
+        bool yes=false;
+        // W(D) initialized on entry before testing in original; unsuccessful visit
+        // performs the decrement. Preserve state on successful branches as well.
+        if(oneOf(op,{1,3,21,133}) && p.state==1)
+            p.state=i.D>0 ? low16(wrap(static_cast<std::uint32_t>(i.D)+5U)) : 0;
+        if(!predicate(slot,i,yes)) return;
+        if(yes) {
+            if(op==3) effect(); // STEAL also emits sound 0x11.
+            else success();
+        } else if(oneOf(op,{1,3,21,133})) {
+            if(op==133 && i.D<=0) branch(slot,i.C);
+            else if(wait(slot,i)) branch(slot,i.C);
+        } else if(!oneOf(op,{39,70,71})) branch(slot,i.C);
+        return;
+    }
+    // Complex partial handler protocol. No default success or reward guess.
+    if(oneOf(op,{2,16,22,23,31,44,57,60,69,88,121,125,135})) {
+        if(op==2 && p.state==1) {
+            p.state=low16(wrap(static_cast<std::uint32_t>(i.D)+10U)); i.E=1;
+        }
+        auto result=execute(slot,i);
+        if(result==WorldResult::Unresolved || result==WorldResult::Done) {
+            block(slot,std::string(commands[op].name)+" requires explicit partial-handler flow"); return;
+        }
+        if(result==WorldResult::Hold) return;
+        if(result==WorldResult::Failure) {branch(slot,i.C); return;}
+        // E1c: PED_ON / CHANGE_PED_TYPE E is a target, never money.
+        if(!oneOf(op,{2,16,31,44,60,69,135})) pay(slot,i);
+        branch(slot,i.B); return;
+    }
+    // Immediate commands with known outer S and explicit reward exclusions.
+    // Guards/spawn fields/coordinate transforms remain part of execute's contract.
+    if(oneOf(op,{11,12,15,18,19,24,26,30,32,34,35,36,37,38,40,43,50,51,52,53,87,
+                 64,65,68,74,76,79,80,81,91,92,93,94,100,110,111,116,119,124,126,129,134,144,146})) {
+        effect(!oneOf(op,{15,37,64,68,80,100,110,111,116})); return;
+    }
+    block(slot,std::string(commands[op].name)+" dispatch missing");
+}
+}
diff --git a/src/mission/MissionVM.h b/src/mission/MissionVM.h
new file mode 100755
index 0000000..a1a1b3a
--- /dev/null
+++ b/src/mission/MissionVM.h
@@ -0,0 +1,126 @@
+#pragma once
+#include "MissionScript.h"
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace mission {
+// Exact recovered record layout. PC is a physical record index, never a label.
+struct Instruction {
+    std::uint16_t opcode=0xffff, padding=0;
+    std::int32_t A=0, B=0, C=0, D=0, E=0;
+};
+static_assert(sizeof(Instruction)==24 && offsetof(Instruction,A)==4 &&
+              offsetof(Instruction,E)==20, "exe instruction layout");
+struct Process {
+    bool active=false, blocked=false;
+    std::int16_t pc=0, state=1, timer=0, parent=-1, player=-1;
+    std::int16_t trigger=-1, outcome=0;
+    std::int32_t protection=0, aux=0;
+};
+struct Entity {
+    Record declaration; // Original coordinates and operands: no universal scale conversion.
+    std::optional<std::int32_t> value; // Known COUNTER value; world installs runtime handles.
+    std::int32_t type=-1, aux=0;
+};
+struct Diagnostic {
+    std::string code, detail;
+    std::size_t line=0;
+    int slot=-1;
+};
+// 00771628 trigger record (0x20 bytes): +0 state, +4 type, +8 target,
+// +0xc bound handle, +0x14 radius/second operand, +0x18 delay, +0x1d prefix.
+struct Trigger {
+    int state=1,type=4,target=0,bound=-1,radius=0,delay=0,entity=-1;
+    bool preserve=false;
+};
+enum class WorldResult { Unresolved, Done, Hold, Success, Failure };
+// execute must not award E or branch itself. Success/Failure are reserved for
+// partially decoded state machines; Done confirms a known immediate effect.
+struct WorldRequest {
+    std::string token, evidence; // TODO-evidence:<VA> means incomplete semantics.
+    int slot, owner;
+    Instruction& instruction; // Shared mutable operands (ANSWER/MPHONE etc.).
+    Process& process;
+    std::map<std::int32_t,Entity>& entities;
+    std::vector<Instruction>& instructions;
+    const std::map<std::int32_t,std::size_t>& labels;
+};
+class IMissionWorld {
+public:
+    virtual ~IMissionWorld()=default;
+    // All effects: phones, briefing/text/audio/arrows, entity creation/removal,
+    // ped/car behavior, doors, explosions, wanted/lives and reset cleanup.
+    // A partial handler can mutate state/timer/operands; Unresolved blocks the slot.
+    virtual WorldResult execute(WorldRequest&)=0;
+    // Command-specific predicate, nullopt means unknown. See evidence table.
+    virtual std::optional<bool> predicate(const WorldRequest&)=0;
+    virtual std::int32_t score(int owner)=0;
+    // Implement 00461f20 (including multiplier, x86 wrapping and upper clamp).
+    virtual void reward(int owner,std::int32_t positiveBase)=0;
+    virtual void incrementMultiplier(int owner)=0; // uint16 addition, no cap.
+    // 004749c0/common epilogue and external scheduler pre/post work belong here.
+    virtual void postDispatch(int slot,Process&)=0;
+    virtual void diagnostic(const Diagnostic&)=0;
+};
+struct LoadReport {
+    std::vector<std::string> unsupported;
+    std::vector<Diagnostic> diagnostics;
+};
+class MissionVM {
+public:
+    explicit MissionVM(IMissionWorld& world):world_(world) {}
+    LoadReport load(const Section&);
+    // Explicit participant activation; label omitted means physical instruction zero.
+    bool start(int slot,std::optional<std::int32_t> label=std::nullopt);
+    // World objects that 00445800 constructs while loading. Call once after
+    // load(), when the world adapter is ready to create them.
+    void construct();
+    void tick();
+    const std::array<Process,32>& processes() const {return processes_;}
+    const std::vector<Instruction>& instructions() const {return instructions_;}
+    const std::map<std::int32_t,Entity>& entities() const {return entities_;}
+    std::size_t indexOf(std::int32_t label) const;
+    const std::vector<Trigger>& triggers() const {return triggers_;}
+private:
+    IMissionWorld& world_;
+    std::array<Process,32> processes_{};
+    std::vector<Instruction> instructions_;
+    std::vector<std::size_t> lines_;
+    std::map<std::int32_t,std::size_t> labels_;
+    std::map<std::int32_t,Entity> entities_;
+    std::vector<std::int32_t> declarationOrder_;
+    bool constructed_=false;
+    // 00473fb0/00474020: signed bytes of trigger handles, not record IDs.
+    std::array<int,20> checkpoints_{};
+    int checkpointCount_=0,checkpointCursor_=0;
+    bool checkpointUnresolved_=false;
+    // Raw entity-record indices, separate from declaration-ID lookup.
+    struct Bookkeeping { int type=-1; std::array<int,4> cells{{-1,-1,-1,-1}}; };
+    std::map<int,Bookkeeping> bookkeeping_;
+    std::map<int,int> childRecords_;
+    int epilogueSlot_=-1;
+    bool phoneRing_=false;
+    std::array<bool,4> phoneMission_{};
+    // 004744a0 allocation order. The index is the handle kept in the
+    // declaring record's value and in the process spawned by the trigger.
+    std::vector<Trigger> triggers_;
+    std::uint64_t unresolvedTriggerTypes_=0; // reported once per load
+    bool startupDone_=false; // 0067661c
+    bool valid_=true;
+    void step(int slot);
+    void branch(int slot,std::int32_t target);
+    void cleanup(int slot);
+    void issue(std::string code,std::string detail,int slot=-1);
+    void block(int slot,const std::string& detail);
+    int owner(int slot) const;
+    void pay(int slot,const Instruction&);
+    bool wait(int slot,const Instruction&);
+    bool predicate(int slot,Instruction&,bool&);
+    WorldResult execute(int slot,Instruction&);
+};
+}
diff --git a/src/mission/OriginalCamera.h b/src/mission/OriginalCamera.h
new file mode 100755
index 0000000..133d8f2
--- /dev/null
+++ b/src/mission/OriginalCamera.h
@@ -0,0 +1,98 @@
+#pragma once
+#include "DoorRules.h"
+#include "PickupMath.inc"
+#include <cstdint>
+#include <cstdlib>
+namespace mission {
+// The original camera of one participant: follow 0043bbd0, compose 0043b910.
+// It only decides what the ORIGINAL screen would show, which is what script
+// commands and cleanup rules test. The engine's own view is independent.
+// One update() is one 25 Hz game update. Units are original: pixels
+// (1/64 cell, Z downwards) and the participant's speed word (position
+// record +0x10). Integer arithmetic follows the executable.
+class OriginalCamera {
+public:
+    // Position record of the participant (00462d50) as the follow reads it.
+    struct Subject {
+        int x=0,y=0,z=0;      // +2,+6,+10
+        int speed=0;          // +0x10
+        int heading=0;        // +0x12, 0..1023
+        bool onFoot=true;     // participant mode 2; false is mode 0 (in a car)
+        bool tripleSpeed=false; // 00405920(car): the car's speed counts three times
+        bool held=false;      // 00460770 / 004772c0 participant states
+        bool frozenBase=false;// on foot with 00460790: base and Z targets stay
+    };
+    // 0043c5d0 + 0043c640: called when the level starts.
+    void reset(int speed) {
+        *this=OriginalCamera{};
+        const int v=clampSpeed(speed);
+        heightTerm_=heightTarget(v); zoomTerm_=zoomTarget(v); mode_=2;
+    }
+    void update(Subject s) {
+        // The follow multiplies some speeds, caps at 0x30 and floors at 8.
+        if(!s.onFoot && s.tripleSpeed) s.speed*=3;
+        if(s.speed>0x30) s.speed=0x30;
+        x_=s.x; y_=s.y;
+        int leadX=0,leadY=0;
+        if(!s.onFoot) {
+            // 00511e28 / 00512228: 16.16 sine and its quarter-turn neighbour.
+            const int h=s.heading&1023;
+            leadX=static_cast<int>((std::int64_t(pickup_math::sine[h])*s.speed*10)>>16);
+            leadY=static_cast<int>((std::int64_t(pickup_math::sine[h+256])*s.speed*10)>>16);
+        }
+        const int v=clampSpeed(s.speed);
+        int height=heightTarget(v),zoom=zoomTarget(v);
+        int base=extra_+bias+standard,z=s.z;
+        if(mode_==2) {
+            // First update after a reset: base and Z snap, the rest eases by 1.
+            zoomBase_=base; z_=z;
+            ease(leadX_,vLeadX_,leadX,1,1); ease(leadY_,vLeadY_,leadY,1,1);
+            ease(heightTerm_,vHeight_,height,1,1); ease(zoomTerm_,vZoom_,zoom,1,1);
+            mode_=0; return;
+        }
+        if(mode_==1) {
+            // Returning after a scripted cut (0043cac0): leads ease back to 0.
+            ease(leadX_,vLeadX_,0,1,1); ease(leadY_,vLeadY_,0,1,1);
+            ease(heightTerm_,vHeight_,height,2,1); ease(zoomTerm_,vZoom_,zoom,2,1);
+            ease(zoomBase_,vBase_,base,1,1); ease(z_,vZ_,z,1,1);
+            if(leadX_==0 && leadY_==0) mode_=0;
+            return;
+        }
+        if(s.held) {height=heightTerm_; zoom-=300;}
+        else if(s.onFoot && s.frozenBase) {base=zoomBase_; z=z_;}
+        ease(leadX_,vLeadX_,leadX,4,4); ease(leadY_,vLeadY_,leadY,4,4);
+        ease(heightTerm_,vHeight_,height,2,1); ease(zoomTerm_,vZoom_,zoom,2,1);
+        ease(zoomBase_,vBase_,base,2,1); ease(z_,vZ_,z,2,1);
+    }
+    // 0043b910: centre, height and zoom, then the screen rectangle (0043ca30).
+    OriginalView view() const {
+        int height=standard-heightTerm_-z_;
+        height=height<0x10?0x10:height>0x2cc?0x2cc:height;
+        int zoom=zoomBase_-zoomTerm_;
+        zoom=zoom<0x3c?0x3c:zoom>500?500:zoom;
+        return {height,leadX_+x_,leadY_+y_,zoom};
+    }
+private:
+    // 004b0d10 row 0, the camera setting selected by 0074f2d0 == 0.
+    static constexpr int scale=8,limit=16,standard=300,bias=0,rise=5,pull=5;
+    int x_=0,y_=0,leadX_=0,leadY_=0,zoomBase_=0,z_=0,zoomTerm_=0,heightTerm_=0;
+    int vLeadX_=0,vLeadY_=0,vHeight_=0,vZoom_=0,vBase_=0,vZ_=0,extra_=0,mode_=2;
+    static int clampSpeed(int v) {if(v<8) v=8; return std::abs(v);}
+    // (rise*|v|*scale) * -0x66666667 >> 34: a signed division by -10.
+    static int heightTarget(int v) {return -((rise*v*scale)/10);}
+    static int zoomTarget(int v) {return (((v*scale)/2)*pull)/10;}
+    // One eased channel: velocity grows by up/down per update to +-limit,
+    // the value moves by half the velocity and stops exactly on the target.
+    static void ease(int& value,int& velocity,int target,int up,int down) {
+        const int v=velocity; int next=(v>>1)+value;
+        if(value<target) {
+            if(next<target) {if(v<limit) velocity=v+up>limit?limit:v+up;}
+            else {velocity=0; next=target;}
+        } else {
+            if(next<=target) {velocity=0; next=target;}
+            else if(-limit<v) velocity=v-down<-limit?-limit:v-down;
+        }
+        value=next;
+    }
+};
+}
