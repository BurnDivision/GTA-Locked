+
+void HUD::ClearMissionText(const std::string& text)
+{
+    mSubtitlePanel.CancelMessage(text);
+    mPagerPanel.CancelMessage(text);
+    if (mMissionText.empty() || mMissionText != text)
+        return;
+    mMissionText.clear();
+    mBigFontMessage.SetVisible(false);
+    for (AutoHidePanel& currElement: mAutoHidePanels)
+    {
+        if (currElement.mPointer == &mBigFontMessage)
+        {
+            currElement.mShowDuration = 0.0f;
+        }
+    }
+}
+
+void HUD::ShowMissionText(const std::string& text, hud::TextArea area)
+{
+    if (text.empty()) return;
+    if (area == hud::TextArea::Pager) { PushPagerMessage(text); return; }
+    if (area == hud::TextArea::Subtitle) { mSubtitlePanel.PushMessage(text); return; }
+    mMissionText = text;
+    mBigFontMessage.SetText(text);
+    ShowAutoHidePanel(&mBigFontMessage, frontend::messageSeconds(text.size(),gCvarTextSpeed.mValue));
+}
