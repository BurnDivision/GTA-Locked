+GameObject* CarnageMissionWorld::ResolveObject(const Entity& e) const {
+    // Only handles allocated by this adapter are trusted; declaration values
+    // (models, counters) must never alias another engine object's ID.
+    if(!e.value || *e.value<0 || !ownedObjects_.count(static_cast<unsigned>(*e.value))) return nullptr;
+    auto* o=gGameObjectsManager.GetGameObjectByID(static_cast<unsigned>(*e.value));
+    return o && !o->IsMarkedForDeletion()?o:nullptr;
+}
+std::optional<glm::vec3> CarnageMissionWorld::ResolvePosition(const Entity& e) const {
+    // 0043e680 case9 reads the loader XYZ <<6, independent of runtime handle.
+    if(e.declaration.token=="DOOR") return DeclarationPosition(e.declaration);
+    if(auto* object=ResolveObject(e)) return object->mTransform.mPosition;
+    if(e.declaration.token=="POINT" || e.declaration.token=="TELEPHONE" || e.declaration.token=="LOCATION")
+        return DeclarationPosition(e.declaration);
+    return {};
+}
+Pedestrian* CarnageMissionWorld::SpawnPedestrian(const glm::vec3& position,int remap) {
+    if(!gGameMap.IsLoaded() || !gGameMap.mStyleData.IsLoaded() || remap!=NO_REMAP) {
+        Once("ped-spawn","Ped spawn requires loaded style and NO_REMAP; unverified palettes rejected"); return nullptr;
+    }
+    auto* ped=gGameObjectsManager.CreatePedestrian(position,cxx::angle_t::from_degrees(0),ePedestrianType_Civilian,remap);
+    if(ped) {ownedObjects_.insert(ped->mObjectID); missionEntities_.insert(ped->mObjectID);}
+    return ped;
+}
+Vehicle* CarnageMissionWorld::SpawnVehicle(const glm::vec3& position,int model,int heading) {
+    if(!gGameMap.IsLoaded() || !gGameMap.mStyleData.IsLoaded()) return nullptr;
+    // Descriptor overload avoids the enum overload's assert on absent models.
+    for(auto& desc:gGameMap.mStyleData.mVehicles) if(static_cast<int>(desc.mModelID)==model) {
+        auto* car=gGameObjectsManager.CreateVehicle(position,-Convert::Fix16ToAngle(static_cast<unsigned short>(heading)),&desc);
+        if(car) {ownedObjects_.insert(car->mObjectID); missionEntities_.insert(car->mObjectID);}
+        return car;
+    }
+    Once("vehicle-model:"+std::to_string(model),"Vehicle model absent from current style"); return nullptr;
+}
+WorldResult CarnageMissionWorld::execute(WorldRequest& r) {
+    const auto& token=r.token; auto& i=r.instruction;
+    auto found=r.entities.find(i.A);
+    auto* entity=found==r.entities.end()?nullptr:&found->second;
+    if(!OwnerValid(r.owner)) {Once("owner","Invalid mission owner"); return WorldResult::Unresolved;}
+    if(token=="PHONE_START" || token=="PHONE_ANSWER_START" || token=="PHONE_RING" || token=="PHONE_STOP") {
+        auto phone=phones_.find(i.A);
+        if(phone==phones_.end() || !phone->second.object) return WorldResult::Unresolved;
+        auto* object=gGameObjectsManager.GetGameObjectByID(phone->second.object);
+        if(!object || object->IsMarkedForDeletion()) return WorldResult::Unresolved;
+        auto& ph=phone->second;
+        if(token=="PHONE_STOP") {
+            ph.mode=1; object->StopGameObjectSounds();
+            for(auto& handle:soundPhones_) if(handle==i.A) handle=-1;
+        } else if(token=="PHONE_START" || token=="PHONE_ANSWER_START") {
+            ph.mode=token=="PHONE_START"?3:2;
