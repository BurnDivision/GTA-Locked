+namespace {
+Pedestrian* character(int owner) {
+    if(owner<0 || owner>=4 || !gCarnageGame.mHumanPlayers[owner]) return nullptr;
+    return gCarnageGame.mHumanPlayers[owner]->mCharacter;
+}
+Cell cell(const glm::vec3& p) {
+    return {static_cast<int>(std::floor(Convert::MetersToMapUnits(p.x))),
+        static_cast<int>(std::floor(Convert::MetersToMapUnits(p.z))),
+        static_cast<int>(std::floor(Convert::MetersToMapUnits(p.y)))};
+}
+}
+void PoliceRuntime::reset(int section) {
+    system_.reset(); section_=section; representation2_.fill(false); placement_.fill(Action::None); reported_.fill(false);
+}
+void PoliceRuntime::occupiedDriverTakeover(Pedestrian* actor,int model) {
+    if(!actor || !actor->IsHumanPlayerCharacter() || actor->IsDead()) return;
+    const int owner=gCarnageGame.GetHumanPlayerIndex(actor);
+    system_.occupiedDriverTakeover(owner,model,section_);
+}
+void PoliceRuntime::clear(Pedestrian* ped) {
+    ped->ClearAmmunition(); ped->ChangeWeapon(eWeapon_Fists); ped->mArmorHitPoints=0;
+    // U: remaining frenzy/powerup systems do not have faithful engine equivalents.
+}
+bool PoliceRuntime::death(int owner) {
+    auto* ped=character(owner);
+    if(!ped || !ped->IsDead() || !system_.beginDeath(owner,representation2_[owner])) return false;
+    clear(ped);
+    std::vector<Unit> units; system_.release(owner,units);
+    return true;
+}
+bool PoliceRuntime::captured(int owner) {
+    auto* ped=character(owner);
+    if(!ped || ped->IsDead() || !system_.beginArrest(owner,true)) return false;
+    std::vector<Unit> units; system_.release(owner,units);
+    gCarnageGame.mHumanPlayers[owner]->mHUD.ShowBigFontMessage(eHUDBigFontMessage_Busted);
+    return true;
+}
+bool PoliceRuntime::place(int owner,Action reason) {
+    auto* ped=character(owner); if(!ped) return false;
+    const auto service=reason==Action::DeathRespawn?eAccidentServise_Hospital:eAccidentServise_PoliceStation;
+    std::vector<Cell> bases;
+    for(const auto& p:gGameMap.GetServiceBases(service)) bases.push_back({p.x,p.z,p.y});
+    int heading=0;
+    const auto dest=rankedRespawn(cell(ped->mTransform.mPosition),bases,[&](Cell p)->std::optional<Cell>{
+        if(p.x<0 || p.x>=MAP_DIMENSIONS || p.y<0 || p.y>=MAP_DIMENSIONS || p.z<0 || p.z>=MAP_LAYERS_COUNT) return {};
+        if(p.z+1>=MAP_LAYERS_COUNT) return {};
+        const auto* start=gGameMap.GetBlockInfo(p.x,p.y,p.z+1);
+        int dx=0,dy=0;
+        if(start->mUpDirection) {dy=-1; heading=0x200;}
+        else if(start->mDownDirection) {dy=1; heading=0;}
+        else if(start->mLeftDirection) {dx=-1; heading=0x300;}
+        else if(start->mRightDirection) {dx=1; heading=0x100;}
+        else return {};
+        p.x+=dx; p.y+=dy; // 0045ffb0 advances BEFORE testing
+        for(int n=0;n<15;++n,p.x+=dx,p.y+=dy) {
+            if(p.x<0 || p.x>=MAP_DIMENSIONS || p.y<0 || p.y>=MAP_DIMENSIONS) break;
+            // category0x30 is pavement in the current decoded map representation.
+            if(gGameMap.GetBlockInfo(p.x,p.y,p.z)->mGroundType!=eGroundType_Pawement) continue;
+            bool occupied=false;
+            for(const auto* car:gGameObjectsManager.mVehiclesList) {
+                const auto c=cell(car->mTransform.mPosition);
+                if(c.x==p.x && c.y==p.y) {occupied=true; break;}
+            }
+            if(!occupied) return p;
+        }
+        return {};
+    });
+    if(!dest) {
+        if(!reported_[owner]) gConsole.LogMessage(eLogMessage_Warning,"Unresolved police respawn: no usable rank>=1 service point, player %d",owner);
+        reported_[owner]=true; return false;
+    }
+    // Engine stores inverted layers; retain the executable subcell offset at0x3f0000.
+    const glm::vec3 position(Convert::MapUnitsToMeters(dest->x+0.5f),
+        Convert::MapUnitsToMeters(dest->z+1.0f/64.0f),Convert::MapUnitsToMeters(dest->y+0.5f));
+    const bool preserve=reason==Action::ArrestRespawn && !system_.clearInventory(owner);
+    std::array<Weapon,eWeapon_COUNT> weapons;
+    std::copy(std::begin(ped->mWeapons),std::end(ped->mWeapons),weapons.begin());
+    // 00464880 restores frenzy even when jail-free preserves ordinary inventory.
+    if(ped->mOriginalWeaponsEnabled) {ped->mOriginalWeapons.stop();ped->mOriginalWeapons.kfTimer=-1;ped->SyncOriginalWeapons();}
+    const bool originalEnabled=ped->mOriginalWeaponsEnabled;
+    const auto originalInventory=ped->mOriginalWeapons;
+    // Refresh projected weapon snapshots after restoration.
+    std::copy(std::begin(ped->mWeapons),std::end(ped->mWeapons),weapons.begin());
+    const auto selected=originalEnabled?ped->mChangeWeapon:ped->mCurrentWeapon;
+    const int armor=ped->mArmorHitPoints;
+    ped->PutOnFoot(); ped->HandleDespawn();
+    ped->SetTransform(position,Convert::Fix16ToAngle(heading)); ped->HandleSpawn();
+    if(preserve) {
+        std::copy(weapons.begin(),weapons.end(),std::begin(ped->mWeapons));
+        ped->mOriginalWeaponsEnabled=originalEnabled;ped->mOriginalWeapons=originalInventory;
+        ped->ChangeWeapon(selected);ped->SyncOriginalWeapons(); ped->mArmorHitPoints=armor;
+    }
+    representation2_[owner]=true; system_.respawned(owner); reported_[owner]=false;
+    return true;
+}
+void PoliceRuntime::update() {
+    for(int owner=0;owner<4;++owner) {
+        auto* ped=character(owner); if(!ped) continue;
+        // Call only for an allocated, non-arrested response group (0040d800).
+        for(int index=0;index<4;++index) {
+            auto& group=system_.group(index);
+            if(group.status>0 && group.record==owner && !system_.waiting(owner)) {
+                if(system_.classify(owner,section_).level==0) {
+                    std::vector<Unit> units; system_.release(owner,units);
+                }
+                break;
+            }
+        }
+        const auto action=system_.updatePlayer(owner);
+        if(action==Action::ArrestRespawn && system_.clearInventory(owner)) clear(ped);
+        if(action==Action::ArrestRespawn || action==Action::DeathRespawn) placement_[owner]=action;
+        if(placement_[owner]!=Action::None && place(owner,placement_[owner])) placement_[owner]=Action::None;
+        if(action==Action::GameOver && !reported_[owner]) {
+            gConsole.LogMessage(eLogMessage_Info,"Game over: player %d has exhausted lives",owner);
+            reported_[owner]=true;
+        }
+    }
+}
+}}
diff --git a/src/police/PoliceRuntime.h b/src/police/PoliceRuntime.h
