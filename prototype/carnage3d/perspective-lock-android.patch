+// Engine headers other than GLM intentionally stay in the implementation.
+class CarnageMissionWorld final: public IMissionWorld {
+public:
+    explicit CarnageMissionWorld(gta::GameEconomy& economy): economy_(economy) {}
+    ~CarnageMissionWorld() override;
+    WorldResult execute(WorldRequest&) override;
