+        if(r.token=="PHONE_RANGE" || r.token=="MPHONES_TRIGGER")
+            if(ped->mCurrentCar) current=ped->mCurrentCar->mTransform.mPosition;
+        int px=static_cast<int>(std::floor(Convert::MetersToMapUnits(current.x)*64));
+        int py=static_cast<int>(std::floor(Convert::MetersToMapUnits(current.z)*64));
+        auto at=r.entities.find(r.instruction.A); if(at==r.entities.end()) return {};
+        auto target=DeclarationPosition(at->second.declaration); if(!target) return {};
+        int x=static_cast<int>(std::lround(Convert::MetersToMapUnits(target->x)*64));
+        int y=static_cast<int>(std::lround(Convert::MetersToMapUnits(target->z)*64));
+        // 00478630 is called with the 0043e680 position: the cell centre.
+        if(r.token=="PHONE_NEAR") return phoneNear(px,py,x+32,y+32);
+        if(r.token=="MPHONES_TRIGGER") {
+            if(ped->mCurrentCar && static_cast<int>(ped->mCurrentCar->mCarInfo->mModelID)==47) return false;
+            if(ped->IsEnteringOrExitingCar()) {
+                Once("trigger-mode","Original player mode mapping during vehicle transition unresolved"); return {};
+            }
+        }
+        return phoneArea(px,py,x/64,y/64,r.token=="PHONE_RANGE"?15:r.instruction.D);
+    }
+    if(r.token=="STEAL") {
+        auto at=r.entities.find(r.instruction.A);
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        if(at==r.entities.end() || at->second.type!=0 || !ped) return {};
+        auto* object=ResolveObject(at->second);
+        if(!object || object->mClassID!=eGameObjectClass_Car) return {};
+        if(ped->IsEnteringOrExitingCar()) return {};
+        // 00476020: associated driver handle, state6/7, health>0,
+        // and original animation0 or >126. Stable seated engine driver only.
+        if(ped->IsDead()) return false;
+        // IsCarPassenger includes the driver in Carnage3D; test driver first.
+        if(ped->IsCarDriver()) return ped->mCurrentCar==object &&
+            static_cast<Vehicle*>(object)->GetCarDriver()==ped;
+        if(ped->IsStanding() || ped->IsWalking() || ped->IsCarPassenger()) return false;
+        return {};
+    }
+    if(r.token=="IS_GOAL_DEAD" || r.token=="DESTROY") {
+        // DESTROY 0043ed90 waits on 0043e870(A)==0; it does not damage
+        // or remove A. The VM owns W(D), E and S/F. Unlike IS_GOAL_DEAD,
+        // DESTROY never interprets D as a killer declaration.
+        // 0043e870 returns100 for all non-car/non-ped declaration types.
+        auto at=r.entities.find(r.instruction.A); if(at==r.entities.end()) return {};
+        const auto& e=at->second;
+        switch(e.type) {
+        case 0x1c: case 0x40:
+            // Successful original loader construction rewrites these types.
+            // An unprojected constructor cannot borrow default health100.
+            return {};
+        case 0: case 5: case 6: case 0x12: case 0x15: case 0x16: case 0x1b: {
+            auto* object=ResolveObject(e);
+            if(!object || object->mClassID!=eGameObjectClass_Car) return {};
+            auto* car=static_cast<Vehicle*>(object);
+            // Engine damage has the same critical boundary100. A live damaged
+            // car is not an unknown health value. Wreck projects original model=-1.
+            return car->IsWrecked() || car->GetCurrentDamage()>=100;
+        }
+        case 1: case 3: case 99: {
+            GameObject* object=nullptr;
+            if(e.type==3) {
+                auto binding=playerBindings_.find(r.instruction.A);
+                if(binding!=playerBindings_.end()) object=gGameObjectsManager.GetGameObjectByID(binding->second);
+            } else object=ResolveObject(e);
+            bool dead=false; unsigned int killer=0;
+            if(object && !object->IsMarkedForDeletion() && object->mClassID==eGameObjectClass_Pedestrian) {
+                auto* ped=static_cast<Pedestrian*>(object);
+                // Engine dead/electrocution states project the original zero-health
+                // conditions. It has no original +49 or +58 health/effect fields.
+                dead=ped->IsDead() || ped->IsDies(); killer=ped->mLastDamageCauserID;
+            } else {
+                auto known=e.value?scriptPeds_.find(static_cast<unsigned int>(*e.value)):scriptPeds_.end();
+                if(known==scriptPeds_.end() || !known->second.removed) {
+                    Once("goal-ped-handle", "UNRESOLVED health predicate: ped handle was never bound or disappeared without a known removal");
+                    return {};
+                }
+                dead=true; killer=known->second.killer;
+            }
+            if(!dead) return false; // short circuit before any killer lookup
+            if(r.token=="DESTROY" || r.instruction.D<=0 || e.type!=99) return true;
+            auto target=r.entities.find(r.instruction.D); if(target==r.entities.end()) return {};
+            GameObject* other=nullptr;
+            auto binding=playerBindings_.find(r.instruction.D);
+            if(target->second.type==3 && binding!=playerBindings_.end()) other=gGameObjectsManager.GetGameObjectByID(binding->second);
+            else other=ResolveObject(target->second);
+            if(!other) {
+                if(target->second.value && *target->second.value==-1) return killer==0;
+                return {};
+            }
+            return killer==other->mObjectID;
+        }
+        default:return false;
+        }
+    }
+    if(r.token=="PHONE_VALID") {
+        auto phone=phones_.find(r.instruction.A);
+        if(phone==phones_.end() || !phone->second.object) return false;
+        auto* object=gGameObjectsManager.GetGameObjectByID(phone->second.object);
+        return object && !object->IsMarkedForDeletion();
+    }
+    if(r.token=="LOCATE") {
+        auto at=r.entities.find(r.instruction.A);
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        if(at==r.entities.end() || !ped || ped->IsMarkedForDeletion()) return {};
+        auto target=OriginalPosition(at->second,r.instruction.A); if(!target) return {};
+        // Ped states 6/7 (seated) never succeed; transitions are not mapped.
+        if(ped->IsEnteringOrExitingCar()) return {};
+        if(ped->mCurrentCar) return false;
+        const auto& pos=ped->mTransform.mPosition;
+        if(!std::isfinite(pos.x) || !std::isfinite(pos.z)) return {};
+        const int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos.x)*64));
+        const int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos.z)*64));
+        int radius=static_cast<std::int16_t>(r.instruction.E); if(radius==0) radius=16;
+        // 00478690: strict inequalities on both axes.
+        return (*target)[0]<x+radius && x-radius<(*target)[0] &&
+               (*target)[1]<y+radius && y-radius<(*target)[1];
+    }
+    if(r.token=="IS_PED_ARRESTED") {
+        // 0044a3c0: true only in ped state 9 (arrested). The engine has no
+        // police capture yet, so the bound participant is never in it.
+        auto at=r.entities.find(r.instruction.A);
+        auto binding=playerBindings_.find(r.instruction.A);
+        if(at==r.entities.end() || at->second.type!=3 || binding==playerBindings_.end()) return {};
+        auto* human=player(0); auto* ped=human?human->mCharacter:nullptr;
+        if(!ped || ped->mObjectID!=binding->second) return {};
+        Once("arrest-state","IS_PED_ARRESTED: arrest (state9) has no engine source until police capture is recovered");
+        return false;
+    }
+    if(r.token=="DEAD_ARRESTED") {
+        // 0044a710: true when the ped is in state9 (arrested) or 0043e870
+        // reports no health. Only the bound participant ped is resolvable.
+        auto at=r.entities.find(r.instruction.A);
+        auto binding=playerBindings_.find(r.instruction.A);
+        if(at==r.entities.end() || at->second.type!=3 || binding==playerBindings_.end()) return {};
+        auto* human=player(0); auto* ped=human?human->mCharacter:nullptr;
+        if(!ped || ped->mObjectID!=binding->second) return {};
+        if(ped->IsDead() || ped->IsDies()) return true;
+        Once("arrest-state","DEAD_ARRESTED: arrest (state9) has no engine source until police capture is recovered");
+        return false;
+    }
+    if(r.token=="GOTO") {
+        auto at=r.entities.find(r.instruction.A); auto* p=player(r.owner);
+        if(at!=r.entities.end() && p && p->mCharacter) if(auto target=OriginalPosition(at->second,r.instruction.A)) {
+            // 00462ef0: a seated participant is located by the car.
+            const GameObject* participant=p->mCharacter;
+            if(p->mCharacter->mCurrentCar) participant=p->mCharacter->mCurrentCar;
+            const auto current=Convert::MetersToMapUnits(glm::vec2(participant->mTransform.mPosition.x,participant->mTransform.mPosition.z));
+            // 0043eb50: 0043e680 target and participant X/Y with the low six
+            // bits masked, i.e. the same map cell.
+            return std::floor(current.x)==((*target)[0]>>6) && std::floor(current.y)==((*target)[1]>>6);
+        }
+    }
+    Once("predicate:"+r.token,"Unsupported mission predicate "+r.token+"; engine health/state is not original script health/state");
+    return {};
+}
+
+bool CarnageMissionWorld::SetOriginalView(int owner,const OriginalView& view) {
+    if(!OwnerValid(owner)) return false;
+    rectangles_[owner]=originalRectangle(view); return rectangles_[owner].has_value();
+}
+void CarnageMissionWorld::PrepareDoors(const Section& section) {
+    if(!gGameMap.IsLoaded()) return;
+    for(const auto& r:section.declarations) {
+        const bool ordinary=r.token=="DOOR";
+        const bool barrier=r.token=="BARRIER" || r.token=="BASIC_BARRIER";
+        const bool model=r.token=="MODEL_BARRIER" || r.token=="MODEL_DOOR";
+        const bool specific=r.token=="SPECIFIC_BARR" || r.token=="SPECIFIC_DOOR" || r.token=="SPECIFIC_DOOR_BOMB";
+        if(!ordinary && !barrier && !model && !specific) continue;
+        // Reserve before validation: a missing projection must not shift all
+        // later slots and silently redirect a numeric DUMMY to another door.
+        doorSlots_.push_back(std::nullopt);
+        int id=0,direction=0,base=0,roof=0,frames=8,required=-1;
+        auto pos=DeclarationPosition(r);
+        std::vector<int> operands; bool valid=true;
+        for(const auto& text:r.operands) {int n=0;if(!integer(text,n)) valid=false;operands.push_back(n);}
+        const auto count=r.token=="MODEL_DOOR"?5U:model?4U:specific?5U:3U;
+        if(!integer(r.label,id) || !pos || !valid || operands.size()!=count) {
+            Once("door-declaration:"+r.label,"UNRESOLVED "+r.token+" malformed constructor"); continue;
+        }
+        direction=operands[0];
+        if(barrier) {frames=operands[1];base=operands[2];}
+        else if(r.token=="MODEL_BARRIER" || r.token=="SPECIFIC_BARR") {base=operands[1];frames=operands[2];}
+        else if(r.token=="MODEL_DOOR") {base=operands[1];frames=operands[2];roof=operands[3];}
+        else {base=operands[1];roof=operands[2];}
+        if(model) required=static_cast<std::int16_t>(operands[r.token=="MODEL_DOOR"?4:3]);
+        int specificCar=-1,specificColor=0xffff;
+        if(specific) {
+            if(r.token!="SPECIFIC_DOOR") {
+                // SPECIFIC_DOOR_BOMB (0043e040, kind 5) needs car+0x9c, which SETBOMB does not
+                // project yet; the SPECIFIC_BARR constructor is not recovered.
+                Once("door-specific:"+r.label,"UNRESOLVED "+r.token+" constructor binding"); continue;
+            }
+            // 0043df70: the binding is the record NUMBER (not its
+            // value), or -1 when that record is a FUTURECAR (type 0x1d).
+            specificCar=operands[3];
+            specificColor=operands[4]==-1?0xffff:(operands[4]&0xffff);
+        }
+        if(direction<0 || direction>3 || frames<2 ||
+           base<0 || frames>gGameMap.mStyleData.GetBlockTexturesCount(eBlockType_Aux)-base ||
+           roof<0 || roof>=gGameMap.mStyleData.GetBlockTexturesCount(eBlockType_Lid)) {
+            Once("door-texture:"+r.label,"UNRESOLVED "+r.token+" direction/frame/texture range"); continue;
+        }
+        DoorState d; d.x=static_cast<int>(Convert::MetersToMapUnits(pos->x));
+        d.y=static_cast<int>(Convert::MetersToMapUnits(pos->z));
+        d.z=static_cast<int>(Convert::MetersToMapUnits(pos->y));
+        d.direction=direction; d.frames=frames; d.base=base; d.roof=roof;
+        d.kind=specific?2:r.token=="BARRIER"?1:model?3:0;
+        if(specific) {
+            d.carRecord=specificCar; d.color=specificColor; d.car=specificCar;
+            for(const auto& other:section.declarations)
+                if(other.label==r.operands[3] && other.token=="FUTURECAR") d.car=-1;
+        }
+        d.radius=specific?3:barrier?1:model?(r.token=="MODEL_BARRIER"?1:2):2;
+        d.model=required;
+        int x=d.x+(direction==1),y=d.y+(direction==3),z=INVERT_MAP_LAYER(d.z);
+        if(x>=MAP_DIMENSIONS || y>=MAP_DIMENSIONS ||
+           (roof && (d.z+1>=MAP_LAYERS_COUNT || (direction<2?(d.y<1 || d.y>=255):(d.x<1 || d.x>=255))))) continue;
+        // Reject overlaps rather than corrupt another door's dynamic texture.
+        if(savedDoorBlocks_.count({d.x,d.y,z}) || savedDoorBlocks_.count({x,y,z})) {
+            Once("door-overlap","Unresolved overlapping door constructors"); continue;
+        }
+        auto save=[&](int bx,int by) {
+            savedDoorBlocks_.emplace(std::make_tuple(bx,by,z),*gGameMap.GetBlockInfo(bx,by,z));
+        };
+        save(d.x,d.y); save(x,y);
+        auto block=*gGameMap.GetBlockInfo(d.x,d.y,z);
+        // 004740f0:1/3 erase the old east/south face and flatten both cells.
+        if(direction==1 || direction==3) {
+            block.mFaces[direction]=0; block.mIsFlat=true;
+            gGameMap.SetBlockInfo(d.x,d.y,z,block);
+        }
+        block=*gGameMap.GetBlockInfo(x,y,z); block.mIsFlat=true;
+        gGameMap.SetBlockInfo(x,y,z,block);
+        if(roof) for(int offset=-1;offset<=1;++offset) {
+            int rx=d.x+(direction>=2?offset:0), ry=d.y+(direction<2?offset:0), rz=INVERT_MAP_LAYER(d.z+1);
+            savedDoorBlocks_.emplace(std::make_tuple(rx,ry,rz),*gGameMap.GetBlockInfo(rx,ry,rz));
+            auto lid=*gGameMap.GetBlockInfo(rx,ry,rz); lid.mFaces[eBlockFace_Lid]=roof;
+            gGameMap.SetBlockInfo(rx,ry,rz,lid);
+        }
+        int prefix=-1;
+        d.permanent=integer(r.prefix,prefix) && prefix>=0; // 00773247
+        doors_.emplace(id,d); doorOrder_.push_back(id); doorSlots_.back()=id; CopyDoorFrame(d);
+    }
+}
+void CarnageMissionWorld::CopyDoorFrame(const DoorState& d) {
+    int x=d.x+(d.direction==1),y=d.y+(d.direction==3),z=INVERT_MAP_LAYER(d.z);
+    int face=d.direction<2?0:2;
+    int texture=gGameMap.mStyleData.GetBlockTextureLinearIndex(eBlockType_Aux,d.texture());
+    // Both faces use one dynamic slot in the exe. Per-cell linear overrides
+    // preserve that identity without exhausting/reusing global side bytes.
+    gGameMap.SetRuntimeFace(x,y,z,static_cast<eBlockFace>(face),texture,d.solid);
+    gGameMap.SetRuntimeFace(x,y,z,static_cast<eBlockFace>(face+1),texture,d.solid);
+}
+void CarnageMissionWorld::AnimateDoor(DoorState& d,bool open) {
+    d.animate(open);
+    // Rebuild scheduling only on a state transition, preserving declaration
+    // order even when doors started animating in a different order.
+    animatingDoors_.clear();
+    for(int id:doorOrder_) {
+        auto& door=doors_.at(id);
+        if(door.state==2 || door.state==3) animatingDoors_.push_back(&door);
+    }
+    if(open) {
+        int z=INVERT_MAP_LAYER(d.z); auto block=*gGameMap.GetBlockInfo(d.x,d.y,z);
+        block.mGroundType=eGroundType_Field; //00437cb0(...,0x40), not collision removal callback
+        gGameMap.SetBlockInfo(d.x,d.y,z,block);
+    }
+    CopyDoorFrame(d);
+}
+void CarnageMissionWorld::UpdateScriptPeds() {
+    for(auto& entry:scriptPeds_) {
+        auto& state=entry.second;
+        auto* object=gGameObjectsManager.GetGameObjectByID(entry.first);
+        if(!object || object->IsMarkedForDeletion() || object->mClassID!=eGameObjectClass_Pedestrian) continue;
+        auto* ped=static_cast<Pedestrian*>(object); ped->mMissionVelocity={0,0};
+        if(state.state==1 && state.fleeFrom) {
+            // 00456fb0 state 1: every fifth update face directly away from the threat (or the
+            // car it sits in) and run toward a point 63 units ahead at the desired speed (+08).
+            if(state.removed || ped->IsDead() || ped->IsDies() || ped->mCurrentCar) continue;
+            const auto& at=ped->mTransform.mPosition;
+            if(state.fleeCounter==4) {
+                auto* from=gGameObjectsManager.GetGameObjectByID(state.fleeFrom);
+                if(from && from->mClassID==eGameObjectClass_Pedestrian && static_cast<Pedestrian*>(from)->mCurrentCar)
+                    from=static_cast<Pedestrian*>(from)->mCurrentCar;
+                if(!from || from->IsMarkedForDeletion()) {
+                    // The threat's car is gone: the original drops the threat (state 2, act 2).
+                    state.fleeFrom=0; state.state=3; state.action=8; state.current=0;
+                    Once("ped-flee-wander","Fleeing ped lost its threat; original wander state 2 projected as standing");
+                    continue;
+                }
+                const auto& threat=from->mTransform.mPosition;
+                const double dx=Convert::MetersToMapUnits(at.x-threat.x),dy=Convert::MetersToMapUnits(at.z-threat.z);
+                if(dx!=0 || dy!=0) state.fleeHeading=std::atan2(-dy,dx);
+            }
+            state.fleeCounter=state.fleeCounter>=4?0:state.fleeCounter+1;
+            state.current=state.desired;
+            ped->SetTransform(at,cxx::angle_t::from_radians(static_cast<float>(state.fleeHeading)));
+            const float velocity=Convert::MapUnitsToMeters(state.desired*25.0f/64);
+            ped->mMissionVelocity=glm::vec2(std::cos(state.fleeHeading),-std::sin(state.fleeHeading))*velocity;
+            continue;
+        }
+        if((state.objective==0x1b || state.objective==0x1a || state.objective==0x18) && state.state==3 && state.attackTarget) {
+            // 00456770 state 3: face the target, fire when the delay is spent.
+            auto holder=pedControllers_.find(entry.first);
+            if(holder==pedControllers_.end() || ped->mController!=&holder->second->controller) continue;
+            auto& ctl=holder->second->controller.mCtlState; ctl.mShoot=false;
+            if(state.removed || ped->IsDead() || ped->IsDies() || ped->mCurrentCar) continue;
+            bool known=true;
+            if(!PedOnScreen(*ped,known)) {
+                // 00453480 failed: fire off, act 8, delay 0.
+                if(known) {state.attacking=false; state.attackDelay=0;}
+                continue;
+            }
+            auto* victim=gGameObjectsManager.GetGameObjectByID(state.attackTarget);
+            if(!victim || victim->IsMarkedForDeletion()) continue;
+            glm::vec3 aim=victim->mTransform.mPosition;
+            if(victim->mClassID==eGameObjectClass_Pedestrian && static_cast<Pedestrian*>(victim)->mCurrentCar)
+                aim=static_cast<Pedestrian*>(victim)->mCurrentCar->mTransform.mPosition; // state 7: the car
+            const auto& at=ped->mTransform.mPosition;
+            double dx=Convert::MetersToMapUnits(aim.x-at.x)*64,dy=Convert::MetersToMapUnits(aim.z-at.z)*64; // pixels
+            const bool seated=victim->mClassID==eGameObjectClass_Pedestrian && static_cast<Pedestrian*>(victim)->mCurrentCar;
+            // aim threshold / lateral offset: 0x18 -> 10/16, 0x1a -> 5/8, 0x1b direct (counter set to 1)
+            const int threshold=state.objective==0x18?10:state.objective==0x1a?5:0;
+            const int lateral=state.objective==0x18?16:state.objective==0x1a?8:0;
+            if(state.objective==0x1b) aimCounter_=1;
+            if(!seated) {
+                if(threshold<aimCounter_) aimCounter_=0; // aim straight at the target
+                else {
+                    const double distance=std::floor(std::hypot(std::floor(std::abs(dx)),std::floor(std::abs(dy))));
+                    const double offset=distance>64?lateral:distance>32?lateral/2:0;
+                    const double length=std::hypot(dx,dy);
+                    if(offset>0 && length>0) {
+                        // perpendicular to the aim line; the side alternates with 007284c8
+                        const double side=aimSide_==0?1.0:-1.0;
+                        const double px=dy/length,py=-dx/length;
+                        dx+=side*px*offset; dy+=side*py*offset;
+                    }
+                    ++aimCounter_;
+                }
+            }
+            if(dx!=0 || dy!=0) ped->SetTransform(at,cxx::angle_t::from_radians(std::atan2(-dy,dx)));
+            bool shotStarted=false;
+            if(state.attacking) {
+                if(state.attackCooldown>0) --state.attackCooldown;
+                if(state.attackCooldown==0) {state.attacking=false; state.attackDelay=50;}
+            } else if(state.attackDelay==0) {
+                // fire byte set, act 0x10; weapon 1 fires once and sets cooldown 15 (00488e20).
+                state.attacking=true; state.attackCooldown=15; shotStarted=true; ++aimCounter_;
+                ped->mWeapons[eWeapon_Pistol].SetAmmunition(99);
+                ctl.mShoot=true;
+                Once("ped-attack-cadence","Script attacker cadence: one shot, 15-update cooldown then 50-update delay (cooldown decrement per update assumed)");
+            } else --state.attackDelay;
+            if(!shotStarted) aimSide_=aimSide_?0:1; // 00456e68, skipped by the early return that starts a shot
+            continue;
+        }
+        if(state.removed || !state.destination || ped->IsDead() || ped->IsDies() ||
+           ped->mCurrentCar || !ped->IsIdle()) continue;
+        const auto& at=ped->mTransform.mPosition;
+        const double x=Convert::MetersToMapUnits(at.x)*64, y=Convert::MetersToMapUnits(at.z)*64;
+        if(!std::isfinite(x) || !std::isfinite(y)) continue;
+        const int speed=state.speedFor(x,y); if(!state.destination || speed==0) continue;
+        const double dx=(*state.destination)[0]-x,dy=(*state.destination)[1]-y;
+        const double length=std::hypot(dx,dy); if(length==0) continue;
+        // Projection: continuous direction and Box2D collision replace original
+        // 1024-angle fixed-point steps and refreshed obstacle/path waypoints.
+        const auto heading=cxx::angle_t::from_radians(std::atan2(-dy,dx));
+        ped->SetTransform(at,heading);
+        const float velocity=Convert::MapUnitsToMeters(speed*25.0f/64);
+        ped->mMissionVelocity=glm::vec2(dx/length,dy/length)*velocity;
+    }
+}
+void CarnageMissionWorld::UpdateDoors() {
+    doorUpdateUnresolved_=false;
+    // Original00430c00: animation tick BEFORE scheduler00479e00/00479f00.
+    if(enabledDoors_.empty() && animatingDoors_.empty()) return;
+    for(auto* door:animatingDoors_) {
+        auto& d=*door;
+        if(d.tick()) {
+            if(d.state<2) {
+                //00404810 ->004046b0 ->004728d0 is positional sample38.
+                auto at=Convert::MapUnitsToMeters(glm::vec3(d.x,INVERT_MAP_LAYER(d.z),d.y));
+                gAudioManager.StartSound(eSfxSampleType_Level,38,SfxFlags_None,at);
+                Once("door-audio","Door sample38 emitted; original three-channel arbitration/attenuation unresolved");
+            }
+            CopyDoorFrame(d);
+        }
+    }
+    animatingDoors_.erase(std::remove_if(animatingDoors_.begin(),animatingDoors_.end(),
+        [](const DoorState* d){return d->state!=2 && d->state!=3;}),animatingDoors_.end());
+    // Preserve original ascending participant decisions, including multiple
+    // participants starting another animation during the same enumeration.
+    for(auto* door:enabledDoors_) {
+        auto& d=*door; if(d.state!=0 && d.state!=1) continue;
+        for(int owner=0;owner<4;++owner) {
+            auto* human=player(owner); auto* ped=human?human->mCharacter:nullptr;
+            if(!ped || ped->IsMarkedForDeletion()) continue;
+            if(ped->IsEnteringOrExitingCar()) {
+                Once("door-participant","Unresolved automatic door participant mode during vehicle transition"); continue;
+            }
+            GameObject* participant=ped; bool mode0=false;
+            if(ped->IsCarDriver() && ped->mCurrentCar && ped->mCurrentCar->GetCarDriver()==ped) {
+                participant=ped->mCurrentCar; mode0=true;
+            } else if(ped->mCurrentCar || (!ped->IsStanding() && !ped->IsWalking())) continue;
+            const auto& pos=participant->mTransform.mPosition;
+            if(!std::isfinite(pos.x) || !std::isfinite(pos.z)) continue;
+            int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos.x)));
+            int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos.z)));
+            if(d.x-d.radius<=x && x<=d.x+d.radius && d.y-d.radius<=y && y<=d.y+d.radius) {
+                if(d.state==1 && mode0) {
+                    const int model=static_cast<int>(static_cast<Vehicle*>(participant)->mCarInfo->mModelID);
+                    bool opens=d.kind==0 || (d.kind==3 && model==d.model);
+                    if(d.kind==2) {
+                        // 00479f00 case 2: (binding==-1 || car index==binding) && (colour==0xffff || colour==car+0x24c).
+                        bool carOk=d.car==-1,known=true;
+                        if(!carOk) {
+                            if(d.carBound) {
+                                auto record=carRecords_.find(participant->mObjectID);
+                                carOk=record!=carRecords_.end() && record->second==d.car;
+                            }
+                            // A raw record number is compared with the car pool index (004be248, stride
+                            // 0x2b0, below the record table at 005f30e8): numbers above 1839 can never match.
+                            else if(d.car<=1839) known=false;
+                        }
+                        if(carOk && d.color!=0xffff) known=false; // car+0x24c has no trusted engine source
+                        if(!known) {
+                            doorUpdateUnresolved_=true;
+                            Once("specific-door-car", "UNRESOLVED specific door car index/colour comparison; next script dispatch stops");
+                        } else opens=carOk;
+                    }
+                    if(d.kind==1) {
+                        opens=model==5 || model==4 || model==15 || model==32 || model==16 || model==44;
+                        if(!opens) {
+                            // car+0x34==14 also qualifies; it is not the style class.
+                            doorUpdateUnresolved_=true;
+                            Once("barrier-car-state", "UNRESOLVED BARRIER car+0x34==14 alternative; next script dispatch stops");
+                        }
+                    }
+                    if(opens) AnimateDoor(d,true);
+                }
+            } else if(d.state==0) {
+                bool obstructed=false,unknown=false;
+                for(int other=0;other<4;++other) {
+                    auto* h=player(other); auto* p=h?h->mCharacter:nullptr;
+                    if(!p || p->IsMarkedForDeletion()) continue;
+                    if(p->IsEnteringOrExitingCar() || (p->mCurrentCar && !p->IsCarDriver())) {unknown=true;break;}
+                    GameObject* o=p->mCurrentCar?static_cast<GameObject*>(p->mCurrentCar):p;
+                    auto at=o->mTransform.mPosition;
+                    if(!std::isfinite(at.x) || !std::isfinite(at.z)) {unknown=true;break;}
+                    if(d.obstructs(static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x))),
+                                   static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z))))) obstructed=true;
+                }
+                if(!unknown && !obstructed) AnimateDoor(d,false);
+            }
+        }
+    }
+}
+}
