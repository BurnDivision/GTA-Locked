diff --git a/src/mission/MissionVM.cpp b/src/mission/MissionVM.cpp
new file mode 100755
index 0000000..25aae3e
--- /dev/null
+++ b/src/mission/MissionVM.cpp
@@ -0,0 +1,486 @@
+#include "MissionVM.h"
+#include <algorithm>
+#include <limits>
+#include <set>
+#include <stdexcept>
+#include <utility>
+
+namespace mission {
+namespace {
+struct Command { const char* name; const char* evidence; bool supported; };
+const Command commands[]={
+#include "CommandTable.inc"
+};
+std::int32_t number(const std::string& s) {
+    std::size_t n=0; auto v=std::stoll(s,&n,10);
+    if(n!=s.size() || v<std::numeric_limits<std::int32_t>::min() ||
+       v>std::numeric_limits<std::int32_t>::max()) throw std::invalid_argument("int32 operand");
+    return static_cast<std::int32_t>(v);
+}
+std::int32_t wrap(std::uint32_t n) {
+    return n<=0x7fffffffU ? static_cast<std::int32_t>(n) :
+        -1-static_cast<std::int32_t>(0xffffffffU-n);
+}
+std::int16_t low16(std::int32_t n) {
+    const auto u=static_cast<std::uint32_t>(n)&65535U;
+    return static_cast<std::int16_t>(u<32768U ? static_cast<int>(u) : static_cast<int>(u)-65536);
+}
+bool oneOf(std::uint16_t id,std::initializer_list<int> ids) {
+    return std::find(ids.begin(),ids.end(),id)!=ids.end();
+}
+}
+LoadReport MissionVM::load(const Section& section) {
+    processes_={}; instructions_.clear(); lines_.clear(); labels_.clear();
+    entities_.clear(); triggers_.clear(); bookkeeping_.clear(); childRecords_.clear(); phoneRing_=false; phoneMission_={}; valid_=true;
+    LoadReport report; std::set<std::string> unsupported;
+    auto error=[&](const Record& r,const std::string& message) {
+        Diagnostic d{"load-invalid",message,r.line,-1};
+        report.diagnostics.push_back(d); world_.diagnostic(d); valid_=false;
+    };
+    for(const auto& r:section.declarations) {
+        try {
+            const auto id=number(r.label); Entity e; e.declaration=r;
+            // Raw loader initializes other runtime values via type-specific helpers.
+            if(r.token=="COUNTER") {
+                if(r.operands.empty()) throw std::invalid_argument("counter value missing");
+                e.value=number(r.operands[0]);
+            }
+            if(r.token=="TELEPHONE" && !r.operands.empty()) e.aux=number(r.operands[0]);
+            // 00445800 case8 -> 004744a0(type4, target, radius,0,prefix).
+            if(r.token=="TRIGGER" && r.operands.size()==2) {
+                triggers_[id]={1,number(r.operands[0]),number(r.operands[1]),r.prefix=="1",4};
+                e.value=id; e.type=8;
+            }
+            if(r.token=="MPHONES" && r.operands.size()>=2) {
+                triggers_[id]={1,number(r.operands[0]),number(r.operands[1]),r.prefix=="1"};
+                e.value=id; e.type=34;
+            }
+            // 00445800 case0x27: PHONE_TOGG allocates a type13 trigger.
+            // Keep ENABLE/DISABLE/rearm state, without pretending its update
+            // behavior is the recovered type12 MPHONES dispatch.
+            if(r.token=="PHONE_TOGG" && r.operands.size()>=2) {
+                triggers_[id]={1,number(r.operands[0]),number(r.operands[1]),r.prefix=="1",13};
+                e.value=id; e.type=39;
+            }
+            if(!entities_.emplace(id,std::move(e)).second) error(r,"duplicate entity ID");
+        } catch(const std::exception& e) {error(r,e.what());}
+    }
+    for(std::size_t n=0;n<section.declarations.size();++n) bookkeeping_[static_cast<int>(n)].type=0;
+    for(const auto& r:section.instructions) {
+        Instruction i;
+        for(std::size_t op=0;op<std::size(commands);++op) {
+            if(r.token==commands[op].name) {i.opcode=static_cast<std::uint16_t>(op); break;}
+        }
+        if(i.opcode==0xffff || !commands[i.opcode].supported) unsupported.insert(r.token);
+        try {
+            if(instructions_.size()>=32768) throw std::invalid_argument("signed16 PC capacity exceeded");
+            if(!labels_.emplace(number(r.label),instructions_.size()).second)
+                error(r,"duplicate instruction label: unsafe original behavior rejected");
+            // Lexical parser preserves comments; strip brace comments before integer reading.
+            std::string text; bool comment=false;
+            for(char c:r.rawOperands) {
+                if(c=='{') {comment=true; text+=' ';}
+                else if(c=='}') comment=false;
+                else if(!comment) text+=c;
+            }
+            if(comment) throw std::invalid_argument("unterminated operand comment");
+            std::vector<std::int32_t> values;
+            std::size_t begin=0;
+            while(begin<text.size()) {
+                begin=text.find_first_not_of(" \t\r\n",begin);
+                if(begin==std::string::npos) break;
+                auto end=text.find_first_of(" \t\r\n",begin);
+                values.push_back(number(text.substr(begin,end-begin)));
+                if(end==std::string::npos) break;
+                begin=end;
+            }
+            if(values.size()!=5) throw std::invalid_argument("instruction requires five int32 operands");
+            i.A=values[0]; i.B=values[1]; i.C=values[2]; i.D=values[3]; i.E=values[4];
+        } catch(const std::exception& e) {error(r,e.what());}
+        instructions_.push_back(i); lines_.push_back(r.line);
+    }
+    report.unsupported.assign(unsupported.begin(),unsupported.end());
+    for(const auto& token:report.unsupported) {
+        Diagnostic d{"unsupported",token,section.line,-1};
+        report.diagnostics.push_back(d); world_.diagnostic(d);
+    }
+    return report;
+}
+std::size_t MissionVM::indexOf(std::int32_t label) const {return labels_.at(label);}
+void MissionVM::issue(std::string code,std::string detail,int slot) {
+    std::size_t line=0;
+    if(slot>=0 && slot<32 && processes_[slot].pc>=0 &&
+       static_cast<std::size_t>(processes_[slot].pc)<lines_.size()) line=lines_[processes_[slot].pc];
+    world_.diagnostic({std::move(code),std::move(detail),line,slot});
+}
+void MissionVM::block(int slot,const std::string& detail) {
+    processes_[slot].blocked=true; issue("unresolved",detail,slot);
+}
+bool MissionVM::start(int slot,std::optional<std::int32_t> label) {
+    if(slot<0 || slot>=32 || !valid_ || instructions_.empty()) return false;
+    std::size_t pc=0;
+    if(label) {
+        auto at=labels_.find(*label);
+        if(at==labels_.end()) {issue("invalid-start","missing label",slot); return false;}
+        pc=at->second;
+    }
+    Process p; p.active=true; p.pc=static_cast<std::int16_t>(pc); p.player=static_cast<std::int16_t>(slot);
+    // Loader has trigger 0 for participants; children use -1 (00445800 / 00448edd).
+    p.trigger=slot<4 ? 0 : -1; processes_[slot]=p; return true;
+}
+int MissionVM::owner(int slot) const {
+    for(int depth=0;depth<32;++depth) {
+        const int parent=processes_[slot].parent;
+        if(parent<0) return slot;
+        if(parent>=32) return -1;
+        slot=parent;
+    }
+    return -1;
+}
+void MissionVM::pay(int slot,const Instruction& i) {
+    if(i.E>0) world_.reward(owner(slot),i.E);
+}
+void MissionVM::cleanup(int slot) {
+    auto& p=processes_[slot];
+    if(triggers_.count(p.trigger)) triggers_.at(p.trigger).state=1;
+    else if(p.trigger!=-1) {
+        Instruction trigger; trigger.A=p.trigger;
+        WorldRequest request{"CLEANUP_TRIGGER","0043e2b0/00474d10",slot,owner(slot),
+                             trigger,p,entities_,instructions_,labels_};
+        if(world_.execute(request)!=WorldResult::Done) {
+            issue("cleanup-unresolved","TODO-evidence:0043e2b0 trigger re-enable",slot);
+        }
+    }
+    p.active=false; p.pc=0; p.timer=0; p.trigger=0; p.protection=0; p.aux=-1;
+}
+void MissionVM::branch(int slot,std::int32_t target) {
+    auto& p=processes_[slot]; p.state=1;
+    if(target==-1) {cleanup(slot); return;}
+    if(target<0) {
+        p.active=false; block(slot,"negative destination other than -1 would index outside original label table"); return;
+    }
+    if(target==0) {p.pc=low16(static_cast<std::int32_t>(p.pc)+1); return;}
+    auto at=labels_.find(target);
+    if(at==labels_.end()) {block(slot,"missing destination label "+std::to_string(target)); return;}
+    p.pc=static_cast<std::int16_t>(at->second);
+}
+bool MissionVM::wait(int slot,const Instruction& i) {
+    auto& state=processes_[slot].state;
+    if(state==1) state=i.D>0 ? low16(wrap(static_cast<std::uint32_t>(i.D)+5U)) : 0;
+    if(state>5) {state=low16(state-1); return state==5;}
+    return false;
+}
+WorldResult MissionVM::execute(int slot,Instruction& i) {
+    const auto& c=commands[i.opcode];
+    WorldRequest request{c.name,std::string("TODO-evidence:")+c.evidence,slot,owner(slot),
+                         i,processes_[slot],entities_,instructions_,labels_};
+    return world_.execute(request);
+}
+bool MissionVM::predicate(int slot,Instruction& i,bool& value) {
+    const auto& c=commands[i.opcode];
+    WorldRequest r{c.name,std::string("TODO-evidence:")+c.evidence,slot,owner(slot),
+                   i,processes_[slot],entities_,instructions_,labels_};
+    auto result=world_.predicate(r);
+    if(!result) {block(slot,std::string(c.name)+" predicate unresolved"); return false;}
+    value=*result; return true;
+}
+void MissionVM::tick() {
+    // 00479e00: type4/type12 triggers precede the ascending live scheduler.
+    for(auto& item:triggers_) for(int root=0;root<4;++root) {
+        auto& t=item.second;
+        if((t.type!=12 && t.type!=4) || t.state==4 || processes_[root].player<0) continue;
+        if(t.type==4 && t.state==3) continue;
+        Instruction query; query.A=item.first; query.D=t.radius;
+        WorldRequest request{t.type==4?"AREA_TRIGGER":"MPHONES_TRIGGER","0047a3a0",root,root,query,processes_[root],entities_,instructions_,labels_};
+        auto inside=world_.predicate(request);
+        if(!inside) {issue("unresolved","Trigger player mode/position mapping unavailable",root); continue;}
+        if(t.type==12 && t.state==0) {t.state=1; continue;}
+        if(!*inside || t.state!=1) continue;
+        t.state=0;
+        if(t.type==12 && (phoneRing_ || phoneMission_[root])) continue;
+        int child=4; while(child<32 && processes_[child].active) ++child;
+        if(child==32) {issue("trigger-exhausted","No free process slot; unsafe original write rejected",root); t.state=3; continue;}
+        auto target=labels_.find(t.target);
+        if(target==labels_.end()) {issue("unresolved","Missing trigger target",root); continue;}
+        auto& c=processes_[child]; c.active=true; c.blocked=false; c.state=1;
+        c.pc=static_cast<std::int16_t>(target->second); c.parent=root;
+        c.player=processes_[root].player; c.trigger=item.first; t.state=3;
+    }
+    // 00446fe0: ascending live slots; END aliases the loop cursor to its root.
+    for(int slot=0;slot<32;++slot) {
+        auto& p=processes_[slot];
+        if(!p.active || p.blocked) continue;
+        if(p.pc<0 || static_cast<std::size_t>(p.pc)>=instructions_.size()) {
+            block(slot,"physical PC out of range"); continue;
+        }
+        if(owner(slot)<0) {block(slot,"invalid/cyclic parent chain"); continue;}
+        epilogueSlot_=slot;
+        step(slot);
+        slot=epilogueSlot_;
+        world_.postDispatch(slot,processes_[slot]); // Also for DONOWT and newly deactivated processes.
+    }
+}
+void MissionVM::step(int slot) {
+    auto& p=processes_[slot]; auto& i=instructions_[p.pc];
+    const auto op=i.opcode;
+    if(op>=std::size(commands) || !commands[op].supported) {block(slot,"unsupported opcode"); return;}
+    auto success=[&] {pay(slot,i); branch(slot,i.B);};
+    auto effect=[&](bool reward=true) {
+        auto r=execute(slot,i);
+        if(r==WorldResult::Failure && oneOf(op,{32,40,53,74,79})) {
+            branch(slot,i.C); return; // Known invalid-handle/dead guard, no R.
+        }
+        if(r!=WorldResult::Done) {block(slot,std::string(commands[op].name)+" immediate effect unresolved"); return;}
+        if(op==18) p.trigger=-1;
+        if(reward) pay(slot,i);
+        branch(slot,i.B);
+    };
+    auto counter=[&]() -> std::int32_t* {
+        auto at=entities_.find(i.A);
+        if(at==entities_.end() || !at->second.value) {block(slot,"entity value/handle unresolved"); return nullptr;}
+        return &*at->second.value;
+    };
+    // Nested exe geometry/state predicates remain world-owned and may be unknown.
+    auto phoneQuery=[&](const char* token,int id)->std::optional<bool> {
+        Instruction query=i; query.A=id;
+        WorldRequest r{token,"00476340/00478630/00478700",slot,owner(slot),query,p,entities_,instructions_,labels_};
+        return world_.predicate(r);
+    };
+    auto phoneEffect=[&](const char* token,int id) {
+        Instruction event=i; event.A=id;
+        WorldRequest r{token,"00478900/00478b30/00478c90/00478d80",slot,owner(slot),event,p,entities_,instructions_,labels_};
+        if(world_.execute(r)!=WorldResult::Done) issue("partial",std::string(token)+" presentation/cleanup unresolved",slot);
+    };
+    if(op==2) {
+        if(p.state==1) {
+            p.state=low16(wrap(static_cast<std::uint32_t>(i.D)+10U)); i.E=1;
+            phoneEffect("PHONE_ANSWER_START",i.A);
+        }
+        auto entity=entities_.find(i.A);
+        if(entity==entities_.end()) {block(slot,"ANSWER missing phone"); return;}
+        bool eligible=true;
+        if(entity->second.aux>0 && i.E==1) {
+            auto result=phoneQuery("PHONE_ELIGIBLE",i.A);
+            if(!result) {block(slot,"00476340 eligibility unresolved"); return;}
+            eligible=*result; i.E=eligible?1:0;
+        }
+        const bool expired=p.timer==0;
+        if(expired) {
+            phoneEffect("PHONE_RING",i.A); p.timer=50; p.state=low16(p.state-1);
+            if(p.state==10) {phoneEffect("PHONE_STOP",i.A); branch(slot,i.C); return;}
+        } else p.timer=low16(p.timer-1);
+        if(!eligible) return;
+        auto near=phoneQuery("PHONE_NEAR",i.A);
+        if(!near) {block(slot,"00478630 answer geometry unresolved"); return;}
+        if(!*near) return;
+        auto state=phoneQuery("PHONE_ON_FOOT",i.A);
+        if(!state) {block(slot,"original ped state6/7 mapping unresolved"); return;}
+        if(!*state) return;
+        phoneEffect("PHONE_STOP",i.A);
+        branch(slot,expired && i.E!=1?i.C:i.B); return;
+    }
+    if(op==16) {
+        const int root=owner(slot);
+        if(root>=4) {block(slot,"MPHONE requires participant root"); return;}
+        if(phoneMission_[root]) return;
+        if(i.C<0 || i.C>0x578 || i.A<0 || i.A>INT32_MAX-i.C) {
+            block(slot,"invalid phone group"); return;
+        }
+        auto validPhone=[&](int id) {
+            auto at=entities_.find(id);
+            if(at==entities_.end() || at->second.declaration.token!="TELEPHONE") return false;
+            if(at->second.value) return *at->second.value>=0;
+            auto valid=phoneQuery("PHONE_VALID",id);
+            if(!valid) {block(slot,"phone runtime handle validity unresolved"); return false;}
+            return *valid;
+        };
+        auto group=[&](const char* event) {
+            for(int n=0;n<i.C;++n) if(validPhone(i.A+n)) phoneEffect(event,i.A+n);
+        };
+        if(p.state==1) {
+            p.state=0;
+            if(!phoneRing_) {phoneRing_=true; i.D=25; group("PHONE_START");}
+        }
+        i.D=wrap(static_cast<std::uint32_t>(i.D)-1U);
+        auto range=phoneQuery("PHONE_RANGE",i.A);
+        if(!range) {block(slot,"00478700 group range geometry unresolved"); return;}
+        if(!*range) {group("PHONE_STOP"); phoneRing_=false; p.active=false; return;}
+        bool rang=false;
+        for(int n=0;n<i.C;++n) {
+            if(!validPhone(i.A+n)) continue;
+            if(i.D==0 || i.D==-10) {phoneEffect("PHONE_RING",i.A+n); rang=true;}
+            auto near=phoneQuery("PHONE_NEAR",i.A+n);
+            if(!near) {block(slot,"00478630 answer geometry unresolved"); return;}
+            if(!*near) continue;
+            auto foot=phoneQuery("PHONE_ON_FOOT",i.A+n);
+            if(!foot) {block(slot,"phone player state mapping unresolved"); return;}
+            if(!*foot) continue;
+            group("PHONE_STOP");
+            for(int other=3;other<32;++other) {
+                auto& c=processes_[other];
+                if(other==slot || !c.active || c.protection==1 || c.protection==2) continue;
+                if(c.pc>=0 && static_cast<std::size_t>(c.pc)<instructions_.size() && instructions_[c.pc].opcode==16) continue;
+                cleanup(other);
+            }
+            phoneEffect("PHONE_MISSION_CLEANUP",i.A+n);
+            branch(slot,i.B); p.pc=low16(static_cast<int>(p.pc)+n);
+            entities_.at(i.A+n).value=-1; phoneRing_=false; phoneMission_[root]=true;
+            return;
+        }
+        if(rang) i.D=i.D==0?-1:25;
+        return;
+    }
+    if(op==18 || op==19) {
+        auto trigger=triggers_.find(i.A);
+        if(trigger!=triggers_.end()) {
+            trigger->second.state=op==18?4:1;
+            if(op==18) p.trigger=-1;
+            success(); return;
+        }
+    }
+    if(op==129) {
+        for(int other=3;other<32;++other) {
+            const auto& c=processes_[other];
+            if(other==slot || !c.active || c.protection==1 || c.protection==2) continue;
+            if(c.pc>=0 && static_cast<std::size_t>(c.pc)<instructions_.size() && instructions_[c.pc].opcode==16) continue;
+            cleanup(other);
+        }
+        for(auto& t:triggers_) if(!t.second.preserve) t.second.state=4;
+        // Known VM effects apply even when nested world cleanup remains unresolved.
+        effect(); return;
+    }
+    if(op==17) return;
+    if(op==4) {
+        if(p.state==1) {p.state=2; i.C=i.D; return;}
+        i.C=wrap(static_cast<std::uint32_t>(i.C)-1U);
+        if(i.C<=0) success();
+        return;
+    }
+    if(op==20 || op==127 || op==128) {
+        auto v=counter(); if(!v) return;
+        if(op==20) *v=wrap(static_cast<std::uint32_t>(*v)-1U);
+        if(op==127) *v=wrap(static_cast<std::uint32_t>(*v)+1U);
+        const bool yes=op==20 ? *v<=0 : op==127 ? i.D>=0 && *v>=i.D : *v==i.D;
+        if(yes) success(); else branch(slot,i.C);
+        return;
+    }
+    if(op==10) {
+        int at=slot;
+        while(at>=0) {
+            auto& proc=processes_[at]; proc.active=false; proc.outcome=low16(i.A); at=proc.parent;
+        }
+        const int root=owner(slot);
+        processes_[root].pc=p.pc; processes_[root].timer=p.timer;
+        epilogueSlot_=root; return;
+    }
+    if(op==89) {
+        int child=4; while(child<32 && processes_[child].active) ++child;
+        if(child==32) {branch(slot,i.C); return;}
+        std::size_t dest=static_cast<std::size_t>(p.pc)+1;
+        if(i.A!=0) {
+            auto at=labels_.find(i.A);
+            if(at==labels_.end()) {block(slot,"KICKSTART missing child label"); return;}
+            dest=at->second;
+        }
+        if(dest>=instructions_.size()) {block(slot,"KICKSTART child PC out of range"); return;}
+        int record=0x577;
+        for(;record>=0;--record) {
+            auto& entry=bookkeeping_[record];
+            if(entry.type==-1 && entry.cells[0]==-1 && entry.cells[1]==-1 && entry.cells[2]==-1) break;
+        }
+        if(record<0) {block(slot,"KICKSTART bookkeeping exhaustion: unsafe original write rejected"); return;}
+        auto& c=processes_[child]; c.active=true; c.blocked=false; c.state=1; c.trigger=-1;
+        c.pc=static_cast<std::int16_t>(dest);
+        c.parent=static_cast<std::int16_t>(owner(slot)); c.player=processes_[owner(slot)].player;
+        c.protection=p.protection;
+        const auto target=i.B;
+        branch(slot,target); // Original branches before writing shared D/E.
+        i.D=child; i.E=slot; childRecords_[child]=record;
+        bookkeeping_[record].type=100; bookkeeping_[record].cells[0]=child;
+        return;
+    }
+    if(op==96 || op==98 || op==101) {
+        // Partial contract: A points to spawning instruction; never interpret A as slot.
+        auto at=labels_.find(i.A);
+        if(at==labels_.end()) {block(slot,"process cancellation references missing label"); return;}
+        auto& parent=instructions_[at->second];
+        auto mapped=childRecords_.find(parent.D);
+        auto record=bookkeeping_.find(mapped==childRecords_.end()?-1:mapped->second);
+        if(record!=bookkeeping_.end()) {
+            auto& entry=record->second;
+            auto cancel=[&](int cell) {
+                const int child=entry.cells[cell];
+                if(child>=0 && child<32) cleanup(child);
+                entry.type=100; entry.cells[cell]=-1;
+            };
+            if(op==101) {
+                if(i.D>=1 && i.D<=4) cancel(i.D-1);
+            } else for(int cell=0;cell<4;++cell) cancel(cell);
+        } else issue("partial","Cancellation record absent; original uninitialized access rejected",slot);
+        if(op==96 || (op==101 && (i.D<1 || i.D>4))) if(parent.E>=0) parent.E=-1;
+        success(); return;
+    }
+    if(op==130) {p.protection=1; success(); return;}
+    if(op==141) {
+        if(execute(slot,i)!=WorldResult::Done) {block(slot,"KF_PROCESS unlock unresolved"); return;}
+        p.protection=2; success(); return;
+    }
+    if(op==142) {
+        if(execute(slot,i)!=WorldResult::Done) {block(slot,"RESET_KF relock unresolved"); return;}
+        for(int at=3;at<32;++at) if(at!=slot && processes_[at].protection==2) cleanup(at);
+        success(); return;
+    }
+    if(op==45) {pay(slot,i); world_.incrementMultiplier(owner(slot)); branch(slot,i.B); return;}
+    if(op==103) {
+        auto at=labels_.find(i.A);
+        if(at==labels_.end()) {block(slot,"FRENZY_SET missing instruction label"); return;}
+        instructions_[at->second].D=world_.score(owner(slot)); success(); return;
+    }
+    if(op==102 || op==104) {
+        const auto score=world_.score(owner(slot));
+        bool yes=(op==102 ? score : wrap(static_cast<std::uint32_t>(score)-static_cast<std::uint32_t>(i.D)))>=i.A;
+        if(yes) effect(); else branch(slot,i.C); // score flag / sound4 is a world effect.
+        return;
+    }
+    // Known predicates, with VM-owned W(D), R/S/F. World implements exact entity
+    // health/state/model/screen tests rather than synthesizing engine handles here.
+    if(oneOf(op,{1,3,21,39,70,71,84,85,90,105,106,120,132,133})) {
+        bool yes=false;
+        // W(D) initialized on entry before testing in original; unsuccessful visit
+        // performs the decrement. Preserve state on successful branches as well.
+        if(oneOf(op,{1,3,21,133}) && p.state==1)
+            p.state=i.D>0 ? low16(wrap(static_cast<std::uint32_t>(i.D)+5U)) : 0;
+        if(!predicate(slot,i,yes)) return;
+        if(yes) {
+            if(op==3) effect(); // STEAL also emits sound 0x11.
+            else success();
+        } else if(oneOf(op,{1,3,21,133})) {
+            if(op==133 && i.D<=0) branch(slot,i.C);
+            else if(wait(slot,i)) branch(slot,i.C);
+        } else if(!oneOf(op,{39,70,71})) branch(slot,i.C);
+        return;
+    }
+    // Complex partial handler protocol. No default success or reward guess.
+    if(oneOf(op,{2,16,22,23,31,44,57,60,69,88,121,125,135})) {
+        if(op==2 && p.state==1) {
+            p.state=low16(wrap(static_cast<std::uint32_t>(i.D)+10U)); i.E=1;
+        }
+        auto result=execute(slot,i);
+        if(result==WorldResult::Unresolved || result==WorldResult::Done) {
+            block(slot,std::string(commands[op].name)+" requires explicit partial-handler flow"); return;
+        }
+        if(result==WorldResult::Hold) return;
+        if(result==WorldResult::Failure) {branch(slot,i.C); return;}
+        // E1c: PED_ON / CHANGE_PED_TYPE E is a target, never money.
+        if(!oneOf(op,{2,16,31,44,60,69,135})) pay(slot,i);
+        branch(slot,i.B); return;
+    }
+    // Immediate commands with known outer S and explicit reward exclusions.
+    // Guards/spawn fields/coordinate transforms remain part of execute's contract.
+    if(oneOf(op,{12,15,18,19,24,26,30,32,34,35,36,37,38,40,43,50,51,52,53,
+                 64,65,68,74,76,79,80,81,91,92,93,94,100,110,111,116,119,124,126,129,134,144,146})) {
+        effect(!oneOf(op,{15,37,64,68,80,100,110,111,116})); return;
+    }
+    block(slot,std::string(commands[op].name)+" dispatch missing");
+}
+}
diff --git a/src/mission/MissionVM.h b/src/mission/MissionVM.h
new file mode 100755
index 0000000..e455b34
--- /dev/null
+++ b/src/mission/MissionVM.h
@@ -0,0 +1,107 @@
+#pragma once
+#include "MissionScript.h"
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace mission {
+// Exact recovered record layout. PC is a physical record index, never a label.
+struct Instruction {
+    std::uint16_t opcode=0xffff, padding=0;
+    std::int32_t A=0, B=0, C=0, D=0, E=0;
+};
+static_assert(sizeof(Instruction)==24 && offsetof(Instruction,A)==4 &&
+              offsetof(Instruction,E)==20, "exe instruction layout");
+struct Process {
+    bool active=false, blocked=false;
+    std::int16_t pc=0, state=1, timer=0, parent=-1, player=-1;
+    std::int16_t trigger=-1, outcome=0;
+    std::int32_t protection=0, aux=0;
+};
+struct Entity {
+    Record declaration; // Original coordinates and operands: no universal scale conversion.
+    std::optional<std::int32_t> value; // Known COUNTER value; world installs runtime handles.
+    std::int32_t type=-1, aux=0;
+};
+struct Diagnostic {
+    std::string code, detail;
+    std::size_t line=0;
+    int slot=-1;
+};
+enum class WorldResult { Unresolved, Done, Hold, Success, Failure };
+// execute must not award E or branch itself. Success/Failure are reserved for
+// partially decoded state machines; Done confirms a known immediate effect.
+struct WorldRequest {
+    std::string token, evidence; // TODO-evidence:<VA> means incomplete semantics.
+    int slot, owner;
+    Instruction& instruction; // Shared mutable operands (ANSWER/MPHONE etc.).
+    Process& process;
+    std::map<std::int32_t,Entity>& entities;
+    std::vector<Instruction>& instructions;
+    const std::map<std::int32_t,std::size_t>& labels;
+};
+class IMissionWorld {
+public:
+    virtual ~IMissionWorld()=default;
+    // All effects: phones, briefing/text/audio/arrows, entity creation/removal,
+    // ped/car behavior, doors, explosions, wanted/lives and reset cleanup.
+    // A partial handler can mutate state/timer/operands; Unresolved blocks the slot.
+    virtual WorldResult execute(WorldRequest&)=0;
+    // Command-specific predicate, nullopt means unknown. See evidence table.
+    virtual std::optional<bool> predicate(const WorldRequest&)=0;
+    virtual std::int32_t score(int owner)=0;
+    // Implement 00461f20 (including multiplier, x86 wrapping and upper clamp).
+    virtual void reward(int owner,std::int32_t positiveBase)=0;
+    virtual void incrementMultiplier(int owner)=0; // uint16 addition, no cap.
+    // 004749c0/common epilogue and external scheduler pre/post work belong here.
+    virtual void postDispatch(int slot,Process&)=0;
+    virtual void diagnostic(const Diagnostic&)=0;
+};
+struct LoadReport {
+    std::vector<std::string> unsupported;
+    std::vector<Diagnostic> diagnostics;
+};
+class MissionVM {
+public:
+    explicit MissionVM(IMissionWorld& world):world_(world) {}
+    LoadReport load(const Section&);
+    // Explicit participant activation; label omitted means physical instruction zero.
+    bool start(int slot,std::optional<std::int32_t> label=std::nullopt);
+    void tick();
+    const std::array<Process,32>& processes() const {return processes_;}
+    const std::vector<Instruction>& instructions() const {return instructions_;}
+    const std::map<std::int32_t,Entity>& entities() const {return entities_;}
+    std::size_t indexOf(std::int32_t label) const;
+private:
+    IMissionWorld& world_;
+    std::array<Process,32> processes_{};
+    std::vector<Instruction> instructions_;
+    std::vector<std::size_t> lines_;
+    std::map<std::int32_t,std::size_t> labels_;
+    std::map<std::int32_t,Entity> entities_;
+    // Raw entity-record indices, separate from declaration-ID lookup.
+    struct Bookkeeping { int type=-1; std::array<int,4> cells{{-1,-1,-1,-1}}; };
+    std::map<int,Bookkeeping> bookkeeping_;
+    std::map<int,int> childRecords_;
+    int epilogueSlot_=-1;
+    bool phoneRing_=false;
+    std::array<bool,4> phoneMission_{};
+    struct Trigger { int state=1,target=0,radius=0; bool preserve=false; int type=12; };
+    std::map<int,Trigger> triggers_;
+    bool valid_=true;
+    void step(int slot);
+    void branch(int slot,std::int32_t target);
+    void cleanup(int slot);
+    void issue(std::string code,std::string detail,int slot=-1);
+    void block(int slot,const std::string& detail);
+    int owner(int slot) const;
+    void pay(int slot,const Instruction&);
+    bool wait(int slot,const Instruction&);
+    bool predicate(int slot,Instruction&,bool&);
+    WorldResult execute(int slot,Instruction&);
+};
+}
diff --git a/src/mission/OriginalWeapons.h b/src/mission/OriginalWeapons.h
new file mode 100755
index 0000000..ff8d036
--- /dev/null
+++ b/src/mission/OriginalWeapons.h
@@ -0,0 +1,71 @@
+#pragma once
+#include <array>
+#include <cstdint>
+namespace gta {
+// Recovered participant fields: 0074f2a0..b2, f2f4/f2f6.
+// Original order is fists,pistol,machinegun,rocket,flame (not engine order).
+struct OriginalWeapons {
+ std::array<std::uint8_t,5> ammo{};
+ int selected=0;
+ std::uint8_t machine=0,flame=0;
+ std::uint16_t timer=0;
+ std::int16_t kfTimer=-1;
+ bool active() const {
+  for(int i=1;i<=4;++i) if(ammo[i]==100) return true;
+  return false;
+ }
+ bool collect(int type,int value) {
+  if(type<1 || type>4) return false;
+  // 0046a560 gates before removing the world object.
+  if(value<100 && ammo[type]==99) return false;
+  if(value>=100) {
+   if(kfTimer!=-1 || active()) return false;
+   savedSelected=selected; savedAmmo=ammo[selected];
+   savedMachine=machine; savedFlame=flame;
+   ammo[type]=100; timer=static_cast<std::uint16_t>(value-100); selected=type;
+  } else if(ammo[type]!=100) {
+   // 00461b50: byte addition BEFORE unsigned clamp; default table stride8.
+   constexpr int defaults[]={0,20,20,5,10};
+   const auto sum=static_cast<std::uint8_t>(ammo[type]+(value==0?defaults[type]:value));
+   ammo[type]=sum>99?99:sum;
+   if(type==2) machine=5;
+   if(type==4) flame=5;
+   if(ammo[selected]!=100) selected=type;
+  }
+  return true;
+ }
+ void next() { // 004619f0, fists terminates search; no wrap past fists.
+  if(ammo[selected]==100) return;
+  do {if(++selected==5) {selected=0;return;}} while(ammo[selected]==0);
+ }
+ void previous() { // 00461a50
+  if(ammo[selected]==100) return;
+  if(selected==0) selected=5;
+  do {if(--selected==0) return;} while(ammo[selected]==0);
+ }
+ void fire() { // 00461d40 called only after original shot dispatch.
+  if(selected==0 || ammo[selected]==100) return;
+  if(ammo[selected]) {
+   bool consume=true;
+   if(selected==2) {machine=static_cast<std::uint8_t>(machine-1);consume=machine==0;if(consume)machine=5;}
+   if(selected==4) {flame=static_cast<std::uint8_t>(flame-1);consume=flame==0;if(consume)flame=5;}
+   if(consume) --ammo[selected];
+  }
+  if(ammo[selected]==0) selected=ammo[1]?1:0;
+ }
+ void stop() { // 00461c70 restores only saved SELECTED ammo, not whole inventory.
+  for(int i=1;i<=4;++i) if(ammo[i]==100) {
+   ammo[i]=0; timer=0; selected=savedSelected;
+   ammo[selected]=savedAmmo; machine=savedMachine;flame=savedFlame;
+   if(selected!=0 && ammo[selected]==0) previous();
+  }
+ }
+ void tick() { // 00464880: update counters, not dt seconds; zero never expires.
+  if(timer && --timer==0) stop();
+  if(kfTimer>=0) --kfTimer;
+ }
+private:
+ int savedSelected=0;
+ std::uint8_t savedAmmo=0,savedMachine=0,savedFlame=0;
+};
+}
