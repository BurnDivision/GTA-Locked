diff --git a/src/FrontendProfile.h b/src/FrontendProfile.h
new file mode 100755
index 0000000..62f8076
--- /dev/null
+++ b/src/FrontendProfile.h
@@ -0,0 +1,150 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <iomanip>
+#include <istream>
+#include <ostream>
+#include <sstream>
+#include <string>
+namespace frontend {
+// 0042b4a0 / 0042b260: eight 0x50-byte records, first score 0,
+// remaining scores -1. 00427630 derives chapter availability from scores.
+struct Profile {std::string name;std::array<int,6> scores{{0,-1,-1,-1,-1,-1}};};
+struct HighScore {int score=0;std::string name;};
+struct Profiles {
+ std::array<std::array<HighScore,3>,6> highScores;
+ // Preserve settings and still-unmapped original fields on import/export.
+ std::array<unsigned char,0x414> originalBytes{};
+ bool hasOriginalBytes=false;
+ int selected=1;
+ std::array<Profile,8> players;
+ Profiles() {
+  for(int i=0;i<8;++i)players[i].name=defaultName(i);
+  for(auto& table:highScores) {table[0]={1,"BILLY"};table[1]={2,"PAUL"};table[2]={3,"STEVE"};}
+ }
+ static const char* defaultName(int i) {
+  const char* names[]={"Ulrika","Travis","Katie","Mikki","Divine","Bubba","Troy","Kivlov"};
+  return names[i];
+ }
+ static bool validName(const std::string& s) {
+  if(s.empty() || s.size()>14)return false;
+  for(unsigned char c:s)if(c<32 || c>126)return false;
+  return true;
+ }
+ bool unlocked(int chapter) const {
+  return selected>=0 && selected<8 && chapter>=0 && chapter<6 && players[selected].scores[chapter]>=0;
+ }
+ // Call only after a verified single-player chapter-complete outcome, never
+ // MISSION_END (which ends an individual phone job). 00427030 state 13.
+ bool complete(int chapter,int score) {return recordResult(chapter,score,true);}
+ bool recordResult(int chapter,int score,bool success) {
+  if(!unlocked(chapter) || score<0)return false;
+  auto& s=players[selected].scores;s[chapter]=std::max(s[chapter],score);
+  if(success && chapter<5 && s[chapter+1]==-1)s[chapter+1]=0;
+  auto& table=highScores[chapter];
+  for(int i=2;i>=0;--i)if(score>table[i].score) {
+   for(int j=0;j<i;++j)table[j]=table[j+1];
+   table[i]={score,players[selected].name};break;
+  }
+  return true;
+ }
+ bool rename(const std::string& name) {
+  if(!validName(name))return false;
+  players[selected].name=name;return true;
+ }
+ void reset() {
+  players[selected]=Profile{};players[selected].name=defaultName(selected);
+  // 0042b260: four remembered menu integers and six cutscene flags.
+  const int o=0x180+selected*0x50;
+  std::fill(originalBytes.begin()+o+40,originalBytes.begin()+o+80,0);
+ }
+ std::string encode() const {
+  std::ostringstream out;out<<"C3DPROFILES1 "<<selected;
+  for(const auto& p:players) {out<<' '<<std::quoted(p.name);for(int s:p.scores)out<<' '<<s;}
+  for(const auto& table:highScores)for(const auto& h:table)out<<' '<<h.score<<' '<<std::quoted(h.name);
+  return out.str();
+ }
+ bool decode(const std::string& data) {
+  if(data.size()>4096)return false;
+  Profiles next;std::istringstream in(data);std::string magic;
+  if(!(in>>magic>>next.selected) || magic!="C3DPROFILES1" || next.selected<0 || next.selected>7)return false;
+  for(auto& p:next.players) {
+   if(!(in>>std::quoted(p.name)) || !validName(p.name))return false;
+   for(int& s:p.scores)if(!(in>>s) || s< -1)return false;
+   if(p.scores[0]<0)return false;
+  }
+  for(auto& table:next.highScores)for(auto& h:table)
+   if(!(in>>h.score>>std::quoted(h.name)) || h.score<0 || !validName(h.name))return false;
+  in>>std::ws;if(!in.eof())return false;
+  *this=next;return true;
+ }
+ // 0042b4a0/00427030: raw 0x414-byte little-endian PLAYER_A.DAT.
+ // Only recovered profile fields are changed; imported opaque bytes survive.
+ bool exportOriginal(std::ostream& out) const {
+  Profiles checked;if(!checked.decode(encode()))return false;
+  auto bytes=originalBytes;
+  auto integer=[&](int o,std::int32_t value) {
+   auto n=static_cast<std::uint32_t>(value);
+   for(int j=0;j<4;++j)bytes[o+j]=static_cast<unsigned char>(n>>(j*8));
+  };
+  auto name=[&](int o,const std::string& value) {
+   // Keep bytes beyond the terminating NUL, as the original strcpy does.
+   std::copy(value.begin(),value.end(),bytes.begin()+o);bytes[o+value.size()]=0;
+  };
+  if(!hasOriginalBytes) {
+   bytes[0]=4;bytes[1]=6;bytes[2]=2;bytes[7]=1;
+   integer(0xc,100000);integer(0x10,10);integer(0x14,-1);
+   name(0x401,"GTA Game");
+  }
+  bytes[0x400]=static_cast<unsigned char>(selected);
+  for(int i=0;i<8;++i) {
+   const int o=0x180+i*0x50;name(o,players[i].name);
+   for(int j=0;j<6;++j)integer(o+16+j*4,players[i].scores[j]);
+  }
+  for(int c=0;c<6;++c)for(int r=0;r<3;++r) {
+   const int o=0x18+c*60+r*20;
+   integer(o,highScores[c][r].score);name(o+4,highScores[c][r].name);
+  }
+  out.write(reinterpret_cast<const char*>(bytes.data()),bytes.size());
+  return bool(out);
+ }
+ bool importOriginal(std::istream& in) {
+  std::array<unsigned char,0x414> bytes{};
+  if(!in.read(reinterpret_cast<char*>(bytes.data()),bytes.size()))return false;
+  auto integer=[&](int o)->std::int64_t {
+   std::uint32_t n=std::uint32_t(bytes[o]) | (std::uint32_t(bytes[o+1])<<8) |
+    (std::uint32_t(bytes[o+2])<<16) | (std::uint32_t(bytes[o+3])<<24);
+   return n<=0x7fffffffU?n:std::int64_t(n)-0x100000000LL;
+  };
+  Profiles next;next.selected=bytes[0x400];if(next.selected>7)return false;
+  for(int i=0;i<8;++i) {
+   int o=0x180+i*0x50;std::string name;
+   for(int j=0;j<16 && bytes[o+j];++j)name+=char(bytes[o+j]);
+   if(!validName(name))return false;
+   next.players[i].name=name;
+   for(int j=0;j<6;++j) {
+    auto n=integer(o+16+j*4);if(n< -1)return false;
+    next.players[i].scores[j]=int(n);
+   }
+   if(next.players[i].scores[0]<0)return false;
+  }
+  for(int chapter=0;chapter<6;++chapter)for(int rank=0;rank<3;++rank) {
+   const int o=0x18+chapter*60+rank*20;auto& h=next.highScores[chapter][rank];
+   const auto value=integer(o);if(value<0)return false;h.score=int(value);
+   std::string name;for(int j=0;j<16 && bytes[o+4+j];++j)name+=char(bytes[o+4+j]);
+   if(!validName(name))return false;
+   h.name=name;
+  }
+  next.originalBytes=bytes;next.hasOriginalBytes=true;
+  *this=next;return true;
+ }
+};
+// 00482140 and 00486430: one/two/three pixels at 25 Hz.
+inline int textPixelsPerTick(int speed) {return std::max(1,std::min(3,speed));}
+// 00481d40: (integer(4 / {1,2,4}) * (strlen + 25)) / 2 ticks.
+inline float messageSeconds(std::size_t length,int speed) {
+ const int divisors[]={1,1,2,4};speed=std::max(1,std::min(3,speed));
+ return ((4/divisors[speed])*(int(std::min<std::size_t>(length,65535))+25)/2)/25.0f;
+}
+}
