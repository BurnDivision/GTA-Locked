+#pragma once
+#include <algorithm>
+#include "FrontendProfile.h"
+#include <array>
+#include <vector>
+#include <string>
+#include <istream>
+#include <cmath>
+
+// Original executable evidence: FUN_00428ee0, FUN_004277c0, FUN_00429180.
+// Rendering and selection deliberately have no engine/platform dependencies.
+namespace frontend {
+inline std::string mapFromMetadata(const std::string& line) {
+    const auto a=line.find(','); if(a==std::string::npos)return {};
+    const auto b=line.find(',',a+1);if(b==std::string::npos)return {};
+    const auto c=line.find(',',b+1);if(c==std::string::npos)return {};
+    const auto name=line.substr(b+1,c-b-1);
+    const auto first=name.find_first_not_of(" \t\r\n"),last=name.find_last_not_of(" \t\r\n");
+    return first==std::string::npos?std::string{}:name.substr(first,last-first+1);
+}
+enum class Page {Main,Profiles,Name,Reset,Cities,Options,Quit};
+enum class Action {Up,Down,Left,Right,Accept,Back,Rename,Reset,Erase};
+struct Menu {
+    bool exitRequested=false;
+    Profiles profiles;
+    std::string nameEntry;
+    void character(unsigned int c) {
+        if(page==Page::Name && c>=32 && c<=126 && nameEntry.size()<14)nameEntry+=char(c);
+    }
+    int lastCity() const {int n=0;for(int i=0;i<3;++i)if(profiles.unlocked(i*2))n=i;return n;}
+    int lastChapter() const {return profiles.unlocked(city*2+1)?1:0;}
+    Page page=Page::Main; int row=0,city=0,chapter=0;
+    std::array<int,5> options{{3,3,2,0,1}}, saved=options;
+    void act(Action a) {
+        const int d=a==Action::Up || a==Action::Left ? -1 : 1;
+        if(page==Page::Main) {
+            if(a==Action::Up || a==Action::Down) row=(row+2+d)%2;
+            if(a==Action::Back) page=Page::Quit;
+            if(a==Action::Accept) {page=row?Page::Options:Page::Profiles; saved=options;row=0;}
+        } else if(page==Page::Profiles) {
+            if(a==Action::Left || a==Action::Right)profiles.selected=(profiles.selected+8+d)%8;
+            if(a==Action::Accept) {page=Page::Cities;city=chapter=0;}
+            if(a==Action::Back) {page=Page::Main;row=0;}
+            if(a==Action::Rename) {page=Page::Name;nameEntry.clear();}
+            if(a==Action::Reset) {page=Page::Reset;row=0;}
+        } else if(page==Page::Name) {
+            if(a==Action::Erase && !nameEntry.empty())nameEntry.pop_back();
+            if(a==Action::Accept) {
+                profiles.rename(nameEntry.empty()?Profiles::defaultName(profiles.selected):nameEntry);
+                page=Page::Profiles;
+            }
+            if(a==Action::Back)page=Page::Profiles;
+        } else if(page==Page::Reset) {
+            if(a==Action::Up || a==Action::Down)row=1-row;
+            if(a==Action::Accept) {if(row==1)profiles.reset();page=Page::Profiles;}
+            if(a==Action::Back)page=Page::Profiles;
+        } else if(page==Page::Cities) {
+            if(a==Action::Left || a==Action::Right) {city=(city+lastCity()+1+d)%(lastCity()+1);chapter=0;}
+            if(a==Action::Up || a==Action::Down) chapter=(chapter+lastChapter()+1+d)%(lastChapter()+1);
+            if(a==Action::Back) {page=Page::Profiles;row=0;}
+        } else if(page==Page::Options) {
+            if(a==Action::Up || a==Action::Down) row=(row+5+d)%5;
+            if(a==Action::Left || a==Action::Right) {
+                if(row<2) options[row]=std::max(0,std::min(7,options[row]+d));
+                else if(row==2) options[row]=1+(options[row]-1+3+d)%3;
+                else options[row]=!options[row];
+            }
+            if(a==Action::Back || a==Action::Accept) {
+                if(a==Action::Back) options=saved;
+                page=Page::Main;row=1;
+            }
+        } else if(a==Action::Back || a==Action::Accept) exitRequested=true;
+    }
+    int section() const {const int ids[3][2]={{1,2},{102,103},{202,203}};return ids[city][chapter];}
+};
+struct Image {
+    int width=0,height=0;
+    std::vector<unsigned char> pixels;
+    void blit(const Image& src,int x,int y) {
+        for(int yy=0;yy<src.height;++yy)for(int xx=0;xx<src.width;++xx) {
+            const int dx=x+xx,dy=y+yy;
+            if(dx>=0 && dy>=0 && dx<width && dy<height)
+                std::copy_n(&src.pixels[(yy*src.width+xx)*4],4,&pixels[(dy*width+dx)*4]);
+        }
+    }
+    bool load(std::istream& in,int w,int h) {
+        pixels.clear(); width=height=0;
+        if(w<=0 || h<=0 || w>2048 || h>2048) return false;
+        std::vector<unsigned char> bgr(w*h*3);
+        if(!in.read(reinterpret_cast<char*>(bgr.data()),bgr.size())) return false;
+        pixels.resize(w*h*4);
+        for(int i=0;i<w*h;++i) {
+            pixels[i*4]=bgr[i*3+2];pixels[i*4+1]=bgr[i*3+1];pixels[i*4+2]=bgr[i*3];pixels[i*4+3]=255;
+        }
+        width=w;height=h;return true;
+    }
+};
+struct Font {
+    int height=0,base=33;
+    std::vector<int> widths;
+    std::vector<std::vector<unsigned char>> glyphs;
+    std::array<unsigned char,768> palette{};
+    bool load(std::istream& in,int first) {
+        height=0;glyphs.clear();widths.clear();
+        unsigned char n,h;
+        if(!in.read(reinterpret_cast<char*>(&n),1) || !in.read(reinterpret_cast<char*>(&h),1) || !n || !h) return false;
+        std::vector<std::vector<unsigned char>> data(n);std::vector<int> ws(n);
+        for(int i=0;i<n;++i) {
+            unsigned char w;
+            if(!in.read(reinterpret_cast<char*>(&w),1)) return false;
+            ws[i]=w;data[i].resize(int(w)*h);
+            if(!in.read(reinterpret_cast<char*>(data[i].data()),data[i].size())) return false;
+        }
+        if(!in.read(reinterpret_cast<char*>(palette.data()),palette.size())) return false;
+        glyphs=std::move(data);widths=std::move(ws);height=h;base=first;return true;
+    }
+    int index(unsigned char c) const {
+        // Original uses the width of 'n' for a space (FUN_00430850).
+        int i=(c==' ' && base==33?'n':c)-base;
+        return i<0 || i>=int(glyphs.size()) ? 0:i;
+    }
+    int measure(const std::string& s) const {
+        int w=0; if(glyphs.empty())return 0;
+        for(unsigned char c:s) w+=widths[index(c)];
+        return w;
+    }
+    void draw(Image& dst,const std::string& s,int x,int y,int minY=0) const {
+        if(glyphs.empty())return;
+        for(unsigned char c:s) {
+            int i=index(c),w=widths[i];
+            if(c!=' ' || base!=33) for(int yy=0;yy<height;++yy)for(int xx=0;xx<w;++xx) {
+                int px=x+xx,py=y+yy;unsigned char k=glyphs[i][yy*w+xx];
+                if(!k || px<0 || py<minY || px>=dst.width || py>=dst.height)continue;
+                auto* p=&dst.pixels[(py*dst.width+px)*4];
+                p[0]=palette[k*3];p[1]=palette[k*3+1];p[2]=palette[k*3+2];p[3]=255;
+            }
+            x+=w;
+        }
+    }
+};
+struct View {
+    float scale,x,y;
+    View(int w,int h):scale(std::min(w/640.0f,h/480.0f)),x((w-640*scale)/2),y((h-480*scale)/2) {}
+    bool point(int px,int py,int& ox,int& oy) const {
+        if(scale<=0)return false;
+        ox=int(std::floor((px-x)/scale));oy=int(std::floor((py-y)/scale));
+        return ox>=0&&ox<640&&oy>=0&&oy<480;
+    }
+};
+}
