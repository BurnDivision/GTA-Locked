diff --git a/src/mission/CarnageMissionWorld.cpp b/src/mission/CarnageMissionWorld.cpp
new file mode 100755
index 0000000..913c5cf
--- /dev/null
+++ b/src/mission/CarnageMissionWorld.cpp
@@ -0,0 +1,835 @@
+#include "../stdafx.h"
+#include "CarnageMissionWorld.h"
+#include "../GameObjectsManager.h"
+#include "../GameMapManager.h"
+#include "../CarnageGame.h"
+#include "../HumanPlayer.h"
+#include "../Convert.h"
+#include "../Decoration.h"
+#include "PhoneRules.h"
+#include "../GameTextsManager.h"
+#include "../AudioManager.h"
+#include "../PhysicsBody.h"
+#include <cmath>
+#include <sstream>
+#include <limits>
+
+namespace mission {
+namespace {
+bool integer(const std::string& s,int& value) {
+    try {std::size_t n; long long v=std::stoll(s,&n);
+        if(n!=s.size() || v<INT32_MIN || v>INT32_MAX) return false;
+        value=static_cast<int>(v); return true;
+    } catch(const std::exception&) {return false;}
+}
+HumanPlayer* player(int owner) {
+    return owner>=0 && owner<4 ? gCarnageGame.mHumanPlayers[owner] : nullptr;
+}
+}
+CarnageMissionWorld::~CarnageMissionWorld() {Reset();}
+bool CarnageMissionWorld::OwnerValid(int owner) const {return owner>=0 && owner<4;}
+void CarnageMissionWorld::Once(const std::string& key,const std::string& text) {
+    if(logged_.insert(key).second)
+        gConsole.LogMessage(eLogMessage_Warning,"Mission: %s",text.c_str());
+}
+void CarnageMissionWorld::diagnostic(const Diagnostic& d) {
+    // Deduplicate scheduler notices, including repeated partial-process messages.
+    Once(d.code+":"+d.detail+":"+std::to_string(d.line),
+         d.code+" line "+std::to_string(d.line)+" slot "+std::to_string(d.slot)+": "+d.detail);
+}
+std::optional<glm::vec3> CarnageMissionWorld::ScriptPosition(int x,int y,int z) {
+    if(x<0 || y<0 || z<0 || x>=MAP_DIMENSIONS*64 || y>=MAP_DIMENSIONS*64 || z>=MAP_LAYERS_COUNT*64)
+        return {};
+    // Engine Y is vertical; GTA script Y is map south. No height snapping.
+    return Convert::MapUnitsToMeters(glm::vec3(x/64.0f,z/64.0f,y/64.0f));
+}
+std::optional<glm::vec3> CarnageMissionWorld::DeclarationPosition(const Record& r) {
+    // Only tuple-bearing declarations have map-cell coordinates. Never apply
+    // this transform to POWERUP_ON fixed point, runtime handles or operands.
+    std::string text=r.coordinates;
+    for(char& c:text) if(c=='(' || c==')' || c==',') c=' ';
+    std::istringstream in(text); int x,y,z; std::string extra;
+    if(!(in>>x>>y>>z) || (in>>extra) || x<0 || x>=MAP_DIMENSIONS ||
+       y<0 || y>=MAP_DIMENSIONS || z<0 || z>=MAP_LAYERS_COUNT) return {};
+    return ScriptPosition(x*64,y*64,z*64);
+}
+void CarnageMissionWorld::Prepare(const Section& section) {
+    Reset();
+    // 00445800 case3 consumes 00412a70/00412a90 in declaration order.
+    // Single-player enumeration is0 then-1. Reuse the registered engine ped;
+    // original PLAYER spawn/placement is deliberately outside this projection.
+    for(const auto& r:section.declarations) if(r.token=="PLAYER") {
+        int id=0;
+        if(integer(r.label,id)) if(auto* human=player(0)) if(human->mCharacter)
+            playerBindings_.emplace(id,human->mCharacter->mObjectID);
+        break;
+    }
+    PrepareDoors(section);
+    for(const auto& r:section.declarations) if(r.token=="TELEPHONE") {
+        int id=0; auto pos=DeclarationPosition(r);
+        if(!integer(r.label,id) || !pos) {Once("bad-phone","Invalid telephone declaration"); continue;}
+        int facing=0;
+        if(r.operands.size()>1) integer(r.operands[1],facing);
+        Phone phone{*pos,facing,0};
+        // Existing gta_objects.json identifies style object #40 as phone.
+        if(gGameMap.IsLoaded() && gGameMap.mStyleData.IsLoaded())
+            for(auto& desc:gGameMap.mStyleData.mObjects) if(desc.mObjectType==40) {
+                if(auto* object=gGameObjectsManager.CreateDecoration(*pos,
+                    -Convert::Fix16ToAngle(static_cast<unsigned short>(facing)),&desc)) {
+                    object->SetLifeDuration(0); phone.object=object->mObjectID;
+                    if(!desc.mAnimationData.mFrames.empty()) phone.baseSprite=desc.mAnimationData.mFrames.front().mSprite;
+                    object->SetStaticSprite(phone.baseSprite);
+                    ownedObjects_.insert(phone.object);
+                }
+                break;
+            }
+        if(!phone.object) Once("phone-style","Phone style object #40 unavailable; anchor retained");
+        phones_.emplace(id,phone);
+    }
+
+}
+void CarnageMissionWorld::Reset() {
+    for(const auto& entry:doors_) {
+        const auto& d=entry.second; int x=d.x+(d.direction==1),y=d.y+(d.direction==3),z=INVERT_MAP_LAYER(d.z);
+        int a=d.direction<2?0:2;
+        gGameMap.ClearRuntimeFace(x,y,z,static_cast<eBlockFace>(a));
+        gGameMap.ClearRuntimeFace(x,y,z,static_cast<eBlockFace>(a+1));
+    }
+    for(const auto& saved:savedDoorBlocks_) {
+        auto [x,y,z]=saved.first; gGameMap.SetBlockInfo(x,y,z,saved.second);
+    }
+    enabledDoors_.clear(); animatingDoors_.clear(); doors_.clear(); doorOrder_.clear(); savedDoorBlocks_.clear(); rectangles_={};
+    for(auto id:ownedObjects_) if(auto* object=gGameObjectsManager.GetGameObjectByID(id)) object->MarkForDeletion();
+    playerBindings_.clear(); pickups_={}; ownedObjects_.clear(); missionEntities_.clear(); phones_.clear(); soundPhones_.fill(-1); arrows_={}; logged_.clear();
+}
+void CarnageMissionWorld::Update(float dt) {
+    if(!std::isfinite(dt) || dt<0) return;
+    UpdateDoors();
+    // MissionSession dispatches this at25Hz. 00464880 decrements once/update.
+    for(int owner=0;owner<4;++owner) if(auto* h=player(owner)) if(auto* ped=h->mCharacter)
+        if(ped->mOriginalWeaponsEnabled) {
+            ped->mOriginalWeapons.tick(); ped->SyncOriginalWeapons();
+        }
+    UpdatePickups();
+    // Original combo/VM timers are update counts, not seconds.
+    for(int i=0;i<4;++i) if(player(i)) economy_.tickCombo(i);
+}
+void CarnageMissionWorld::UpdatePickups() {
+    if(std::none_of(pickups_.begin(),pickups_.end(),[](const Pickup& p){return p.object!=0;})) return;
+    // Unknown scene objects could win the original spatial-list arbitration.
+    // The bounded adapter handles its phones/pickups and engine peds/cars only.
+    for(auto* o:gGameObjectsManager.mAllObjects) {
+        if(o->IsMarkedForDeletion() || o->mClassID==eGameObjectClass_Pedestrian || o->mClassID==eGameObjectClass_Car) continue;
+        bool known=false;
+        for(const auto& p:phones_) if(p.second.object==o->mObjectID) known=true;
+        for(const auto& p:pickups_) if(p.object==o->mObjectID) known=true;
+        if(!known) {Once("pickup-scene","Unresolved pickup collision arbitration with untracked world objects");return;}
+    }
+    // 00464440 enumerates participants by registered ped handle, not ped AI type.
+    // Stable standing/walking and seated driver are engine state projections.
+    // Entry/exit, falling and passenger modes have no proved original mapping.
+    for(int owner=0;owner<4;++owner) {
+        auto* human=player(owner); auto* ped=human?human->mCharacter:nullptr;
+        if(!ped || ped->IsMarkedForDeletion() || ped->IsDead()) continue;
+        if(ped->IsEnteringOrExitingCar()) {
+            if(std::any_of(pickups_.begin(),pickups_.end(),[](const Pickup& p){return p.object!=0;}))
+                Once("pickup-transition","Unresolved pickup participant mapping during vehicle transition");
+            continue;
+        }
+        GameObject* participant=ped; int w=4,d=4,a=0;
+        if(ped->mCurrentCar) {
+            if(!ped->IsCarDriver() || ped->mCurrentCar->GetCarDriver()!=ped) {
+                Once("pickup-passenger","Unresolved pickup participant mode for passengers"); continue;
+            }
+            auto* car=ped->mCurrentCar;
+            if(car->IsMarkedForDeletion() || car->IsWrecked()) continue;
+            if(car->mPhysicsBody && (car->mPhysicsBody->GetLinearVelocity()!=glm::vec2(0) ||
+               car->mPhysicsBody->GetAngularVelocity().to_degrees()!=0)) {
+                Once("pickup-car-motion","Unresolved original vehicle predicted contact transform while moving"); continue;
+            }
+            participant=car;
+            w=Convert::MetersToPixels(car->mCarInfo->mDimensions.x)/2;
+            d=Convert::MetersToPixels(car->mCarInfo->mDimensions.z)/2;
+            a=static_cast<int>(std::lround((90-car->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+        } else if(!ped->IsStanding() && !ped->IsWalking()) continue;
+        auto pos=participant->mTransform.mPosition;
+        if(!std::isfinite(pos.x) || !std::isfinite(pos.y) || !std::isfinite(pos.z)) continue;
+        auto x=std::llround(Convert::MetersToMapUnits(pos.x)*pickup::cell);
+        auto y=std::llround(Convert::MetersToMapUnits(pos.z)*pickup::cell);
+        auto z=std::llround((5.0-Convert::MetersToMapUnits(pos.y))*pickup::cell);
+        if(x<0 || y<0 || x>=256*pickup::cell || y>=256*pickup::cell || z<0 || z>5*pickup::cell) continue;
+        const auto query=pickup::box(x,y,z,w,d,a);
+        if(participant==ped) {
+            // 0045a3b0 gives vehicle contacts priority over the object query.
+            bool carContact=false;
+            for(auto* car:gGameObjectsManager.mVehiclesList) {
+                if(car->IsMarkedForDeletion()) continue;
+                const auto& at=car->mTransform.mPosition;
+                if(!std::isfinite(at.x) || !std::isfinite(at.y) || !std::isfinite(at.z)) {carContact=true;break;}
+                auto cx=std::llround(Convert::MetersToMapUnits(at.x)*pickup::cell);
+                auto cy=std::llround(Convert::MetersToMapUnits(at.z)*pickup::cell);
+                auto cz=std::llround((5.0-Convert::MetersToMapUnits(at.y))*pickup::cell);
+                int cw=Convert::MetersToPixels(car->mCarInfo->mDimensions.x)/2;
+                int cd=Convert::MetersToPixels(car->mCarInfo->mDimensions.z)/2;
+                int ca=static_cast<int>(std::lround((90-car->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+                if(pickup::contact(query,pickup::box(cx,cy,cz,cw,cd,ca),cd)) {carContact=true;break;}
+            }
+            if(carContact) continue;
+            int count=0;
+            for(const auto& candidate:pickups_) if(candidate.object)
+                if(auto* o=gGameObjectsManager.GetGameObjectByID(candidate.object))
+                    if(!o->IsMarkedForDeletion() && pickup::contact(query,candidate.shape,candidate.depth)) ++count;
+            if(count>1) {Once("pickup-order","Unresolved original object ordering for overlapping ped pickups");continue;}
+        }
+        for(auto& entry:pickups_) {
+            auto* object=gGameObjectsManager.GetGameObjectByID(entry.object);
+            if(!entry.object || !object || object->IsMarkedForDeletion()) continue;
+            if(!pickup::contact(query,entry.shape,entry.depth)) continue;
+            // 0046a560: a held jail-free card rejects collection BEFORE removal.
+            if(entry.type==12 && economy_.state(owner).skipPenaltyOnce) continue;
+            std::string key;
+            switch(entry.type) {
+            case 1: case 2: case 3: case 4: {
+                ped->EnableOriginalWeapons();
+                if(!ped->mOriginalWeapons.collect(entry.type,entry.help)) continue;
+                ped->SyncOriginalWeapons();
+                static const char* keys[]={"","pistol","machine-gun","rocket","flame"};
+                key=keys[entry.type];
+                if(entry.help>=100) Once("frenzy-midi","Unresolved original MIDI cue3; not a level sample index");
+                break;
+            }
+            case 10:
+                if(ped->mArmorHitPoints==3) continue;
+                ped->mArmorHitPoints=3; key="armour"; break;
+            case 9:
+                // Associated participants share this ped, not every local owner.
+                for(int other=0;other<4;++other) if(auto* h=player(other))
+                    if(h->mCharacter==ped) {economy_.clearWanted(other); h->SetWantedLevel(0);}
+                key="bribe"; break;
+            case 15:
+                economy_.addLife(owner); key="life+";
+                Once("life-midi","Unresolved original MIDI cue11; not a level sample index"); break;
+            case 11: economy_.incrementMultiplier(owner); key="multiplier+"; break;
+            case 12: economy_.state(owner).skipPenaltyOnce=true; key="jail-free"; break;
+            case 13: economy_.addLife(owner); key="life+"; break;
+            case 14: key="help"+std::to_string(entry.help); break;
+            default:
+                Once("pickup-effect","Unresolved pickup effect; object retained"); continue;
+            }
+            human->mHUD.ShowMissionText(gGameTexts.GetText(key));
+            // 0046a560: odd nonweapon types use3, even types use4.
+            gAudioManager.StartSound(eSfxSampleType_Level,(entry.type>=1 && entry.type<=4)?2:((entry.type&1)?3:4),SfxFlags_None,object->mTransform.mPosition);
+            object->MarkForDeletion();
+            missionEntities_.erase(entry.object); ownedObjects_.erase(entry.object);
+            entry=Pickup{};
+            if(participant==ped) break; // car contact list can collect multiple objects
+        }
+    }
+}
