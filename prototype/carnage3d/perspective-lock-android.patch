diff --git a/src/mission/PickupRules.h b/src/mission/PickupRules.h
new file mode 100755
index 0000000..c317fdd
--- /dev/null
+++ b/src/mission/PickupRules.h
@@ -0,0 +1,75 @@
+#pragma once
+#include "PickupMath.inc"
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+namespace mission {
+namespace pickup {
+using I=std::int64_t; // bounded map coordinates; widen intermediate arithmetic
+constexpr I unit=65536, cell=64*unit;
+struct Point { I x,y; };
+struct Box {std::array<Point,5> p; I z; int angle;};
+// 00434300: corners followed by center; special cardinal cases are intentional.
+inline Box box(I x,I y,I z,int w,int d,int angle) {
+    Box b{{},z,angle&1023}; auto& p=b.p;
+    const int a=b.angle;
+    if(a==0) p={{{x+w*unit,y+d*unit},{x-w*unit,y+d*unit},{x+w*unit,y-d*unit},{x-w*unit,y-d*unit},{x,y}}};
+    else if(a==256) p={{{x+d*unit,y-w*unit},{x+d*unit,y+w*unit},{x-d*unit,y-w*unit},{x-d*unit,y+w*unit},{x,y}}};
+    else if(a==512) p={{{x-w*unit,y-d*unit},{x+w*unit,y-d*unit},{x-w*unit,y+d*unit},{x+w*unit,y+d*unit},{x,y}}};
+    else if(a==768) p={{{x-d*unit,y+w*unit},{x-d*unit,y-w*unit},{x+d*unit,y+w*unit},{x+d*unit,y-w*unit},{x,y}}};
+    else {
+        I sx=pickup_math::sine[a]*I(d), sy=pickup_math::sine[a+256]*I(d);
+        I wx=pickup_math::sine[(a+256)&1023]*I(w), wy=pickup_math::sine[((a+256)&1023)+256]*I(w);
+        p={{{x+sx+wx,y+sy+wy},{x+sx-wx,y+sy-wy},{x-sx+wx,y-sy+wy},{x-sx-wx,y-sy-wy},{x,y}}};
+    }
+    return b;
+}
+// x86 SAR16, also for negative fractions.
+inline I sar16(I v) {return v>=0?v/unit:-((-v+unit-1)/unit);}
+// 004899ee / 0048997c, including lower-bound search and 255 saturation.
+inline int angle(I dy,I dx) {
+    I sy=sar16(dy),sx=sar16(dx);
+    if(sx==0) return dy<0?512:0;
+    if(sy==0) return sx<0?768:256;
+    I ratio=std::abs(dy/sx);
+    int lo=0,hi=255,mid=0;
+    while(lo<=hi) {
+        mid=(lo+hi)/2;
+        if(ratio<pickup_math::tangent[mid]) hi=mid-1;
+        else if(ratio==pickup_math::tangent[mid]) {lo=mid;break;}
+        else lo=mid+1;
+    }
+    if(mid==1 && ratio<pickup_math::tangent[1]) lo=0;
+    if(mid==255 && ratio>pickup_math::tangent[255]) lo=255;
+    if(sy<0) return sx<0?768-lo:256+lo;
+    return sx>=0?256-lo:(lo==256?0:lo+768);
+}
+// 0040e5f0 broad-phase, not a replacement proximity collector.
+inline bool broad(const Box& q,const Box& object,int radius) {
+    const auto c=object.p[4];
+    for(auto p:q.p) {
+        I dx=sar16(p.x)-sar16(c.x),dy=sar16(p.y)-sar16(c.y);
+        if(dx*dx+dy*dy<I(radius)*radius) return true;
+    }
+    I left=q.p[0].x,right=left,top=q.p[0].y,bottom=top;
+    for(int n=1;n<4;++n) {left=std::min(left,q.p[n].x);right=std::max(right,q.p[n].x);top=std::min(top,q.p[n].y);bottom=std::max(bottom,q.p[n].y);}
+    for(auto p:std::array<Point,5>{{{c.x-radius*unit,c.y-radius*unit},{c.x+radius*unit,c.y-radius*unit},{c.x-radius*unit,c.y+radius*unit},{c.x+radius*unit,c.y+radius*unit},c}})
+        if(left<p.x && p.x<right && top<p.y && p.y<bottom) return true;
+    return false;
+}
+// 00434690 checks five vertices/center in BOTH directions, not generic SAT.
+inline bool inside(Point p,const Box& b) {
+    int a=(angle(p.y-b.p[1].y,p.x-b.p[1].x)-b.angle)&1023;
+    int c=(angle(p.y-b.p[2].y,p.x-b.p[2].x)-b.angle)&1023;
+    return 256<=a && a<=512 && 768<=c && c<=1024;
+}
+inline bool contact(const Box& q,const Box& object,int objectDepth) {
+    if(std::abs(sar16(object.z)-sar16(q.z))>63 || !broad(q,object,objectDepth*2)) return false;
+    if(q.z>=object.z+32*unit || q.z<=object.z-32*unit) return false;
+    for(auto p:object.p) if(inside(p,q)) return true;
+    for(auto p:q.p) if(inside(p,object)) return true;
+    return false;
+}
+}
+}
