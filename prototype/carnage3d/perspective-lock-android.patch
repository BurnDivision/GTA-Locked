+        // point it at the linked trigger. Ranking and network exit are not
+        // used by the recovered single-participant WAIT predicate.
+        human->mHUD.ShowMissionText(gGameTexts.GetText(i.D==0x13?"1st_over_checkpoint":"win_race"));
+        gAudioManager.StartSound(eSfxSampleType_Level,i.D==0x13?15:4,SfxFlags_None,human->mCharacter->mTransform.mPosition);
+        arrows_[0]=next;
+        return WorldResult::Done;
+    }
+    if(token=="PHONE_START" || token=="PHONE_ANSWER_START" || token=="PHONE_RING" || token=="PHONE_STOP") {
+        auto phone=phones_.find(i.A);
+        if(phone==phones_.end() || !phone->second.object) return WorldResult::Unresolved;
+        auto* object=gGameObjectsManager.GetGameObjectByID(phone->second.object);
+        if(!object || object->IsMarkedForDeletion()) return WorldResult::Unresolved;
+        auto& ph=phone->second;
+        if(token=="PHONE_STOP") {
+            ph.mode=1; object->StopGameObjectSounds();
+            for(auto& handle:soundPhones_) if(handle==i.A) handle=-1;
+        } else if(token=="PHONE_START" || token=="PHONE_ANSWER_START") {
+            ph.mode=token=="PHONE_START"?3:2;
+            bool registered=false;
+            for(int handle:soundPhones_) if(handle==i.A) registered=true;
+            if(!registered) for(auto& handle:soundPhones_) if(handle==-1) {
+                handle=i.A; registered=true;
+                // Candidate28 is known; original mixer/retrigger cadence is not.
+                object->StartGameObjectSound(0,eSfxSampleType_Level,28,SfxFlags_None);
+                break;
+            }
+            if(!registered) Once("phone-sound-full","Four phone sources occupied; original replacement visibility helper unresolved");
+            Once("phone-audio","Sample28 emitted once per registration; original mixer loop/retrigger unresolved");
+        } else if(ph.mode==2 || ph.mode==3) ph.mode=5-ph.mode;
