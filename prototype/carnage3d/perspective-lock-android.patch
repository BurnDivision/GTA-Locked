@@ -0,0 +1,29 @@
+#pragma once
+
+namespace TrafficGap
+{
+enum class Decision { Clear, Slow, Stop };
+
+// All distances use meters. side is absolute lateral distance; priority is the
+// existing fixed tie-break for mutually approaching crossing traffic.
+inline Decision Evaluate(float along, float side, float distance,
+    float halfLengthSum, float margin, float mapUnitMeters,
+    float otherAlong, bool priority, bool ignoreCrossing)
+{
+    if (along <= 0.0f) return Decision::Clear;
+    if (side > 0.6f * mapUnitMeters)
+    {
+        if (ignoreCrossing) return Decision::Clear;
+        if (along < distance * 0.7f ||
+            distance > halfLengthSum + margin + 0.5f * mapUnitMeters)
+            return Decision::Clear;
+        if (otherAlong > distance * 0.7f && priority)
+            return Decision::Clear;
+        return Decision::Stop;
+    }
+    const float clearDistance = along - halfLengthSum;
+    if (clearDistance < margin) return Decision::Stop;
+    if (clearDistance < margin + mapUnitMeters) return Decision::Slow;
+    return Decision::Clear;
+}
+}
