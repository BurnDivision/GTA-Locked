+        {'U', {0x11,0x11,0x11,0x11,0x11,0x11,0x0E}}, {'W', {0x11,0x11,0x11,0x15,0x15,0x15,0x0A}},
+        {'1', {0x04,0x0C,0x04,0x04,0x04,0x04,0x0E}}, {'3', {0x1F,0x02,0x04,0x02,0x01,0x11,0x0E}},
+        {'4', {0x02,0x06,0x0A,0x12,0x1F,0x02,0x02}}, {'6', {0x06,0x08,0x10,0x1E,0x11,0x11,0x0E}},
+        {'9', {0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C}}, {':', {0x00,0x0C,0x0C,0x00,0x0C,0x0C,0x00}},
+        {'T', {0x1F,0x04,0x04,0x04,0x04,0x04,0x04}},
+    };
+
+    static std::vector<float> gVerts; // x,y,r,g,b,a
+    static GLuint gProgram = 0, gVao = 0, gVbo = 0;
+    static GLint gLocScreen = -1;
+
+    static void Tri(float x0, float y0, float x1, float y1, float x2, float y2, float r, float g, float b, float a)
+    {
+        const float v[] = { x0,y0,r,g,b,a, x1,y1,r,g,b,a, x2,y2,r,g,b,a };
+        gVerts.insert(gVerts.end(), v, v + 18);
+    }
+    static void Quad(float x, float y, float w, float h, float r, float g, float b, float a)
+    {
+        Tri(x, y, x + w, y, x + w, y + h, r, g, b, a);
+        Tri(x, y, x + w, y + h, x, y + h, r, g, b, a);
+    }
+    static void Disc(float cx, float cy, float rad, float r, float g, float b, float a)
+    {
+        const int N = 32;
+        for (int i = 0; i < N; ++i)
+        {
+            float a0 = 6.2831853f * i / N, a1 = 6.2831853f * (i + 1) / N;
+            Tri(cx, cy, cx + cosf(a0) * rad, cy + sinf(a0) * rad, cx + cosf(a1) * rad, cy + sinf(a1) * rad, r, g, b, a);
+        }
+    }
+    static void Ring(float cx, float cy, float rad, float th, float r, float g, float b, float a)
+    {
+        const int N = 40;
+        for (int i = 0; i < N; ++i)
+        {
+            float a0 = 6.2831853f * i / N, a1 = 6.2831853f * (i + 1) / N;
+            float ix0 = cx + cosf(a0) * (rad - th), iy0 = cy + sinf(a0) * (rad - th);
+            float ox0 = cx + cosf(a0) * rad, oy0 = cy + sinf(a0) * rad;
+            float ix1 = cx + cosf(a1) * (rad - th), iy1 = cy + sinf(a1) * (rad - th);
+            float ox1 = cx + cosf(a1) * rad, oy1 = cy + sinf(a1) * rad;
+            Tri(ix0, iy0, ox0, oy0, ox1, oy1, r, g, b, a);
+            Tri(ix0, iy0, ox1, oy1, ix1, iy1, r, g, b, a);
+        }
+    }
+    static void Text(const char* s, float cx, float cy, float px, float a)
+    {
+        int n = (int)strlen(s);
+        float w = (n * 6 - 1) * px, h = 7 * px;
+        float x0 = cx - w * 0.5f, y0 = cy - h * 0.5f;
+        for (int i = 0; i < n; ++i)
+        {
+            const Glyph* gl = nullptr;
+            for (const Glyph& g : gFont) if (g.c == s[i]) { gl = &g; break; }
+            if (!gl) continue;
+            for (int row = 0; row < 7; ++row)
+                for (int col = 0; col < 5; ++col)
+                    if (gl->rows[row] & (0x10 >> col))
+                        Quad(x0 + (i * 6 + col) * px, y0 + row * px, px, px, 1, 1, 1, a);
+        }
+    }
+
+    static GLuint Compile(GLenum type, const char* src)
+    {
+        GLuint s = glCreateShader(type);
+        glShaderSource(s, 1, &src, nullptr);
+        glCompileShader(s);
+        GLint ok = 0;
+        glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+        if (!ok)
+        {
+            char log[512]; glGetShaderInfoLog(s, 512, nullptr, log);
+            SDL_Log("[shim] overlay shader error: %s", log);
+        }
+        return s;
+    }
+
+    static bool InitGL()
+    {
+        const char* vs =
+            "#version 300 es\n"
+            "layout(location=0) in vec2 inPos;\n"
+            "layout(location=1) in vec4 inCol;\n"
+            "uniform vec2 uScreen;\n"
+            "out vec4 vCol;\n"
+            "void main(){ vCol = inCol; gl_Position = vec4(inPos.x / uScreen.x * 2.0 - 1.0, 1.0 - inPos.y / uScreen.y * 2.0, 0.0, 1.0); }\n";
+        const char* fs =
+            "#version 300 es\n"
+            "precision mediump float;\n"
+            "in vec4 vCol; out vec4 outCol;\n"
+            "void main(){ outCol = vCol; }\n";
+        GLuint v = Compile(GL_VERTEX_SHADER, vs), f = Compile(GL_FRAGMENT_SHADER, fs);
+        gProgram = glCreateProgram();
+        glAttachShader(gProgram, v); glAttachShader(gProgram, f);
+        glLinkProgram(gProgram);
+        glDeleteShader(v); glDeleteShader(f);
+        GLint ok = 0; glGetProgramiv(gProgram, GL_LINK_STATUS, &ok);
+        if (!ok) { SDL_Log("[shim] overlay program link failed"); return false; }
+        gLocScreen = glGetUniformLocation(gProgram, "uScreen");
+
+        GLint prevVao = 0, prevBuf = 0;
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuf);
+        glGenVertexArrays(1, &gVao);
+        glGenBuffers(1, &gVbo);
+        glBindVertexArray(gVao);
+        glBindBuffer(GL_ARRAY_BUFFER, gVbo);
+        glEnableVertexAttribArray(0);
+        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 6 * sizeof(float), (void*)0);
+        glEnableVertexAttribArray(1);
+        glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, 6 * sizeof(float), (void*)(2 * sizeof(float)));
+        glBindVertexArray((GLuint)prevVao);
+        glBindBuffer(GL_ARRAY_BUFFER, (GLuint)prevBuf);
+        return true;
+    }
+
+    static void Build()
+    {
+        gVerts.clear();
+        if (gMode == 3)
+        {
+            const touch_sticks::Vector values[] = {gLeftStick.value, gRightStick.value};
+            const float centers[] = {gDPadX, gRightX};
+            for (int i = 0; i < 2; ++i)
+            {
+                Disc(centers[i], gDPadY, gDPadR, 0, 0, 0, .22f);
+                Ring(centers[i], gDPadY, gDPadR, gDPadR*.06f, 1, 1, 1, .45f);
+                if (i == 1) Ring(centers[i], gDPadY, gDPadR*.6f, gDPadR*.025f, 1, .4f, .4f, .5f);
+                Disc(centers[i] + values[i].x*gDPadR*.8f, gDPadY + values[i].y*gDPadR*.8f,
+                    gDPadR*.28f, 1, 1, 1, .5f);
+            }
+        }
+        else
+        {
+            // d-pad
+            Disc(gDPadX, gDPadY, gDPadR, 0, 0, 0, 0.22f);
+            Ring(gDPadX, gDPadY, gDPadR, gDPadR * 0.06f, 1, 1, 1, 0.45f);
+            float s = gDPadR * 0.22f, o = gDPadR * 0.62f;
+            float aU = gKeyState[K_UP] ? 0.9f : 0.5f, aD = gKeyState[K_DOWN] ? 0.9f : 0.5f;
+            float aL = gKeyState[K_LEFT] ? 0.9f : 0.5f, aR = gKeyState[K_RIGHT] ? 0.9f : 0.5f;
+            Tri(gDPadX, gDPadY - o - s, gDPadX - s, gDPadY - o + s * 0.6f, gDPadX + s, gDPadY - o + s * 0.6f, 1, 1, 1, aU);
+            Tri(gDPadX, gDPadY + o + s, gDPadX + s, gDPadY + o - s * 0.6f, gDPadX - s, gDPadY + o - s * 0.6f, 1, 1, 1, aD);
+            Tri(gDPadX - o - s, gDPadY, gDPadX - o + s * 0.6f, gDPadY + s, gDPadX - o + s * 0.6f, gDPadY - s, 1, 1, 1, aL);
+            Tri(gDPadX + o + s, gDPadY, gDPadX + o - s * 0.6f, gDPadY - s, gDPadX + o - s * 0.6f, gDPadY + s, 1, 1, 1, aR);
+            // finger knob on d-pad
+            for (const Finger& f : gFingers)
+            {
+                if (f.control != Control_DPad) continue;
+                float dx = f.x - gDPadX, dy = f.y - gDPadY;
+                float len = sqrtf(dx * dx + dy * dy), mx = gDPadR * 0.8f;
+                if (len > mx) { dx *= mx / len; dy *= mx / len; }
+                Disc(gDPadX + dx, gDPadY + dy, gDPadR * 0.28f, 1, 1, 1, 0.35f);
+            }
+        }
+        // buttons
+        for (int i = Control_Fire; i < Control_COUNT; ++i)
+        {
+            if (gMode == 3 && i == Control_Fire) continue;
+            const Button& b = gButtons[i];
+            bool down = gKeyState[b.key];
+            Disc(b.x, b.y, b.r, b.cr, b.cg, b.cb, down ? 0.70f : 0.38f);
+            Ring(b.x, b.y, b.r, b.r * 0.08f, 1, 1, 1, 0.55f);
+            float px = (b.r * 1.3f) / (strlen(b.label) * 6.0f);
+            if (px > b.r * 0.13f) px = b.r * 0.13f;
+            Text(b.label, b.x, b.y, px, 0.9f);
+        }
+    }
+
+    static void Draw(int w, int h)
+    {
+        if (gtaFrontendActive() || !gVisible || gMode == 2) return;
+        if (w != gScreenW || h != gScreenH) Layout(w, h);
+        if (!gProgram && !InitGL()) { gVisible = false; return; }
+        Build();
+        if (gVerts.empty()) return;
+
+        // save state touched by the overlay
+        GLint prevProg = 0, prevVao = 0, prevBuf = 0, vp[4], sc[4];
+        GLint bSrcRGB, bDstRGB, bSrcA, bDstA, bEqRGB, bEqA;
+        GLboolean blend = glIsEnabled(GL_BLEND), depth = glIsEnabled(GL_DEPTH_TEST);
+        GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST), cull = glIsEnabled(GL_CULL_FACE);
+        GLboolean depthMask = GL_TRUE;
+        glGetBooleanv(GL_DEPTH_WRITEMASK, &depthMask);
+        glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuf);
+        glGetIntegerv(GL_VIEWPORT, vp);
+        glGetIntegerv(GL_SCISSOR_BOX, sc);
+        glGetIntegerv(GL_BLEND_SRC_RGB, &bSrcRGB); glGetIntegerv(GL_BLEND_DST_RGB, &bDstRGB);
+        glGetIntegerv(GL_BLEND_SRC_ALPHA, &bSrcA); glGetIntegerv(GL_BLEND_DST_ALPHA, &bDstA);
+        glGetIntegerv(GL_BLEND_EQUATION_RGB, &bEqRGB); glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &bEqA);
+
+        glViewport(0, 0, w, h);
+        glDisable(GL_SCISSOR_TEST);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_CULL_FACE);
+        glDepthMask(GL_FALSE);
+        glEnable(GL_BLEND);
+        glBlendEquation(GL_FUNC_ADD);
+        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+        glUseProgram(gProgram);
+        glUniform2f(gLocScreen, (float)w, (float)h);
+        glBindVertexArray(gVao);
+        glBindBuffer(GL_ARRAY_BUFFER, gVbo);
+        glBufferData(GL_ARRAY_BUFFER, gVerts.size() * sizeof(float), gVerts.data(), GL_STREAM_DRAW);
+        glDrawArrays(GL_TRIANGLES, 0, (GLsizei)(gVerts.size() / 6));
+
+        // restore
+        glBindVertexArray((GLuint)prevVao);
+        glBindBuffer(GL_ARRAY_BUFFER, (GLuint)prevBuf);
+        glUseProgram((GLuint)prevProg);
+        glViewport(vp[0], vp[1], vp[2], vp[3]);
+        glScissor(sc[0], sc[1], sc[2], sc[3]);
+        glBlendEquationSeparate(bEqRGB, bEqA);
+        glBlendFuncSeparate(bSrcRGB, bDstRGB, bSrcA, bDstA);
+        glDepthMask(depthMask);
+        if (blend) glEnable(GL_BLEND); else glDisable(GL_BLEND);
+        if (depth) glEnable(GL_DEPTH_TEST); else glDisable(GL_DEPTH_TEST);
+        if (scissor) glEnable(GL_SCISSOR_TEST); else glDisable(GL_SCISSOR_TEST);
+        if (cull) glEnable(GL_CULL_FACE); else glDisable(GL_CULL_FACE);
+    }
+} // namespace touch
+
+//////////////////////////////////////////////////////////////////////////
+// GLFW API
+
+int glfwInit(void)
+{
+    SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
+    SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, "0");
+    SDL_SetHint(SDL_HINT_MOUSE_TOUCH_EVENTS, "0");
+    SDL_SetHint(SDL_HINT_ANDROID_TRAP_BACK_BUTTON, "1");
+    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER | SDL_INIT_EVENTS) != 0)
+    {
+        ReportError("SDL_Init");
+        return GLFW_FALSE;
+    }
+    gTimeStart = SDL_GetPerformanceCounter();
+    return GLFW_TRUE;
+}
+
+void glfwTerminate(void)
+{
+    for (SDL_GameController*& p : gPads)
+    {
+        if (p) SDL_GameControllerClose(p);
+        p = nullptr;
+    }
+    SDL_Quit();
+}
+
+const char* glfwGetVersionString(void) { return "GLFW-on-SDL2 shim (Android)"; }
+GLFWerrorfun glfwSetErrorCallback(GLFWerrorfun cb) { GLFWerrorfun p = gErrorCb; gErrorCb = cb; return p; }
+void glfwWindowHint(int, int) {}
+GLFWmonitor* glfwGetPrimaryMonitor(void) { return &gMonitor; }
+
+GLFWwindow* glfwCreateWindow(int width, int height, const char* title, GLFWmonitor*, GLFWwindow*)
+{
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+    SDL_GL_SetAttribute(SDL_GL_RED_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_ALPHA_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+
+    gWindow.mSdlWindow = SDL_CreateWindow(title, SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, width, height,
+        SDL_WINDOW_OPENGL | SDL_WINDOW_FULLSCREEN | SDL_WINDOW_ALLOW_HIGHDPI);
+    if (!gWindow.mSdlWindow)
+    {
+        ReportError("SDL_CreateWindow");
+        return nullptr;
+    }
+    gWindow.mContext = SDL_GL_CreateContext(gWindow.mSdlWindow);
+    if (!gWindow.mContext)
+    {
+        // some devices refuse a 24-bit depth buffer
+        SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 16);
+        gWindow.mContext = SDL_GL_CreateContext(gWindow.mSdlWindow);
+    }
+    if (!gWindow.mContext)
+    {
+        ReportError("SDL_GL_CreateContext");
+        SDL_DestroyWindow(gWindow.mSdlWindow);
+        gWindow.mSdlWindow = nullptr;
+        return nullptr;
+    }
+    gWindow.mShouldClose = false;
+    int w = 0, h = 0;
+    SDL_GL_GetDrawableSize(gWindow.mSdlWindow, &w, &h);
+    touch::Layout(w, h);
+    SDL_Log("[shim] window %dx%d, GL %s", w, h, (const char*)glGetString(GL_VERSION));
+    return &gWindow;
+}
+
+void glfwDestroyWindow(GLFWwindow* window)
+{
+    if (!window) return;
+    if (window->mContext) SDL_GL_DeleteContext(window->mContext);
+    if (window->mSdlWindow) SDL_DestroyWindow(window->mSdlWindow);
+    window->mContext = nullptr;
+    window->mSdlWindow = nullptr;
+}
+
+void glfwMakeContextCurrent(GLFWwindow* window)
+{
+    if (window && window->mSdlWindow) SDL_GL_MakeCurrent(window->mSdlWindow, window->mContext);
+}
+
+void glfwSwapBuffers(GLFWwindow* window)
+{
+    if (!window || !window->mSdlWindow) return;
+    int w = 0, h = 0;
+    SDL_GL_GetDrawableSize(window->mSdlWindow, &w, &h);
+    touch::Draw(w, h);
+    SDL_GL_SwapWindow(window->mSdlWindow);
+}
+
+void glfwSwapInterval(int interval) { SDL_GL_SetSwapInterval(interval); }
+
+static void DiscoverPads();
+static bool gReportedPads[GLFW_JOYSTICK_LAST + 1] = {};
+
+void glfwPollEvents(void)
+{
+    DiscoverPads();
+    const int mode = gRequestedTouchMode.load();
+    if (mode != touch::gMode)
+    {
+        touch::ReleaseAll();
+        touch::gMode = mode;
+        touch::gVisible = mode != 2;
+        int w = 0, h = 0;
+        if (gWindow.mSdlWindow) SDL_GL_GetDrawableSize(gWindow.mSdlWindow, &w, &h);
+        touch::Layout(w, h);
+    }
+    SDL_Event e;
+    while (SDL_PollEvent(&e))
+    {
+        switch (e.type)
+        {
+            case SDL_QUIT:
+                gWindow.mShouldClose = true;
+                break;
+            case SDL_WINDOWEVENT:
+                if (e.window.event == SDL_WINDOWEVENT_FOCUS_LOST || e.window.event == SDL_WINDOWEVENT_SIZE_CHANGED)
+                    touch::ReleaseAll();
+                break;
+            case SDL_APP_WILLENTERBACKGROUND:
+                touch::ReleaseAll();
+                break;
+            case SDL_KEYDOWN:
+            case SDL_KEYUP:
+                if (e.key.repeat) break;
+                if (e.key.keysym.sym == SDLK_AC_BACK) {
+                    if (gtaFrontendActive()) EmitKey(GLFW_KEY_ESCAPE,e.type == SDL_KEYDOWN);
+                    break;
+                }
+                EmitKey(SdlKeyToGlfw(e.key.keysym.sym), e.type == SDL_KEYDOWN);
+                break;
+            case SDL_TEXTINPUT:
+                if (gCharCb)
+                    for (const char* p = e.text.text; *p; ++p)
+                        if ((unsigned char)*p < 128) gCharCb(&gWindow, (unsigned int)*p);
+                break;
+            case SDL_MOUSEMOTION:
+                if (e.motion.which == SDL_TOUCH_MOUSEID) break;
+                if (gCursorCb) gCursorCb(&gWindow, e.motion.x, e.motion.y);
+                break;
+            case SDL_MOUSEBUTTONDOWN:
+            case SDL_MOUSEBUTTONUP:
+            {
+                if (e.button.which == SDL_TOUCH_MOUSEID) break;
+                int b = (e.button.button == SDL_BUTTON_LEFT) ? GLFW_MOUSE_BUTTON_LEFT :
+                        (e.button.button == SDL_BUTTON_RIGHT) ? GLFW_MOUSE_BUTTON_RIGHT : GLFW_MOUSE_BUTTON_MIDDLE;
+                if (gMouseButtonCb) gMouseButtonCb(&gWindow, b, e.type == SDL_MOUSEBUTTONDOWN ? GLFW_PRESS : GLFW_RELEASE, 0);
+                break;
+            }
+            case SDL_MOUSEWHEEL:
+                if (gScrollCb) gScrollCb(&gWindow, e.wheel.x, e.wheel.y);
+                break;
+            case SDL_FINGERDOWN:
+            case SDL_FINGERUP:
+            case SDL_FINGERMOTION:
+                if (gtaFrontendActive())
+                {
+                    // Menu taps use the ordinary engine cursor/button dispatch.
+                    int w=0,h=0;
+                    SDL_GL_GetDrawableSize(gWindow.mSdlWindow,&w,&h);
+                    if (gCursorCb) gCursorCb(&gWindow,e.tfinger.x*w,e.tfinger.y*h);
+                    if (gMouseButtonCb && e.type != SDL_FINGERMOTION)
+                        gMouseButtonCb(&gWindow,GLFW_MOUSE_BUTTON_LEFT,
+                            e.type == SDL_FINGERDOWN ? GLFW_PRESS : GLFW_RELEASE,0);
+                }
+                else touch::OnFinger(e.tfinger, e.type);
+                break;
+            case SDL_CONTROLLERDEVICEADDED:
+            {
+                DiscoverPads();
+                if (touch::gMode == 0 && AnyRealPad()) touch::gVisible = false;
+                break;
+            }
+            case SDL_CONTROLLERBUTTONDOWN:
+            case SDL_CONTROLLERBUTTONUP:
+                if (e.type == SDL_CONTROLLERBUTTONDOWN && touch::gMode == 0) touch::gVisible = false;
+                // Back / View / Select toggles the perspective lock (F9)
+                if (e.cbutton.button == SDL_CONTROLLER_BUTTON_BACK) EmitKey(GLFW_KEY_F9, e.type == SDL_CONTROLLERBUTTONDOWN);
+                break;
+            case SDL_CONTROLLERAXISMOTION:
+                if (touch::gMode == 0 && (e.caxis.value > 16000 || e.caxis.value < -16000)) touch::gVisible = false;
+                break;
+            case SDL_CONTROLLERDEVICEREMOVED:
+            {
+                for (int i = 0; i <= GLFW_JOYSTICK_LAST; ++i)
+                {
+                    if (gPads[i] && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(gPads[i])) == e.cdevice.which)
+                    {
+                        SDL_GameControllerClose(gPads[i]);
+                        gPads[i] = nullptr;
+                        touch::gVisible = (touch::gMode != 2);
+                        // The virtual pad may take this slot back immediately.
+                    }
+                }
+                break;
+            }
+            default:
+                break;
+        }
+    }
+    for (int i = 0; i <= GLFW_JOYSTICK_LAST; ++i)
+    {
+        const bool present = gPads[i] || (i == GLFW_JOYSTICK_1 && touch::VirtualPad());
+        if (present != gReportedPads[i])
+        {
+            gReportedPads[i] = present;
+            if (gJoystickCb) gJoystickCb(i, present ? GLFW_CONNECTED : GLFW_DISCONNECTED);
+        }
+    }
+}
+
+int glfwWindowShouldClose(GLFWwindow* window) { return (window && window->mShouldClose) ? GLFW_TRUE : GLFW_FALSE; }
+void glfwSetWindowMonitor(GLFWwindow*, GLFWmonitor*, int, int, int, int, int) {}
+
+double glfwGetTime(void)
+{
+    return (double)(SDL_GetPerformanceCounter() - gTimeStart) / (double)SDL_GetPerformanceFrequency();
+}
+
+GLFWmousebuttonfun glfwSetMouseButtonCallback(GLFWwindow*, GLFWmousebuttonfun cb) { GLFWmousebuttonfun p = gMouseButtonCb; gMouseButtonCb = cb; return p; }
+GLFWkeyfun glfwSetKeyCallback(GLFWwindow*, GLFWkeyfun cb) { GLFWkeyfun p = gKeyCb; gKeyCb = cb; return p; }
+GLFWcharfun glfwSetCharCallback(GLFWwindow*, GLFWcharfun cb) { GLFWcharfun p = gCharCb; gCharCb = cb; return p; }
+GLFWscrollfun glfwSetScrollCallback(GLFWwindow*, GLFWscrollfun cb) { GLFWscrollfun p = gScrollCb; gScrollCb = cb; return p; }
+GLFWcursorposfun glfwSetCursorPosCallback(GLFWwindow*, GLFWcursorposfun cb) { GLFWcursorposfun p = gCursorCb; gCursorCb = cb; return p; }
+GLFWjoystickfun glfwSetJoystickCallback(GLFWjoystickfun cb) { GLFWjoystickfun p = gJoystickCb; gJoystickCb = cb; return p; }
+
+// Discover all real pads before exposing slot 1 as a virtual controller.
+static void DiscoverPads()
+{
+    for (int idx = 0; idx < SDL_NumJoysticks(); ++idx)
+    {
+        if (!SDL_IsGameController(idx)) continue;
+        const SDL_JoystickID id = SDL_JoystickGetDeviceInstanceID(idx);
+        bool opened = false;
+        for (auto* pad : gPads)
+            if (pad && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(pad)) == id) opened = true;
+        if (opened) continue;
+        for (int slot = 0; slot <= GLFW_JOYSTICK_LAST; ++slot)
+            if (!gPads[slot])
+            {
+                gPads[slot] = SDL_GameControllerOpen(idx);
+                if (gPads[slot]) touch::ReleaseAll();
+                break;
+            }
+    }
+}
+
+int glfwJoystickPresent(int jid)
+{
+    if (jid < 0 || jid > GLFW_JOYSTICK_LAST) return GLFW_FALSE;
+    DiscoverPads();
+    return gPads[jid] || (jid == GLFW_JOYSTICK_1 && touch::VirtualPad()) ? GLFW_TRUE : GLFW_FALSE;
+}
+
+int glfwJoystickIsGamepad(int jid) { return glfwJoystickPresent(jid); }
+
+int glfwGetGamepadState(int jid, GLFWgamepadstate* state)
+{
+    if (!state || !glfwJoystickPresent(jid)) return GLFW_FALSE;
+    if (jid == GLFW_JOYSTICK_1 && touch::VirtualPad())
+    {
+        memset(state, 0, sizeof(*state));
+        state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] = touch::gLeftStick.value.x;
+        state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] = touch::gLeftStick.value.y;
+        state->axes[GLFW_GAMEPAD_AXIS_RIGHT_X] = touch::gRightStick.value.x;
+        state->axes[GLFW_GAMEPAD_AXIS_RIGHT_Y] = touch::gRightStick.value.y;
+        state->axes[GLFW_GAMEPAD_AXIS_LEFT_TRIGGER] = -1;
+        state->axes[GLFW_GAMEPAD_AXIS_RIGHT_TRIGGER] = touch_sticks::Firing(touch::gRightStick.value) ? 1 : -1;
+        // Preserve the shim's stick-as-d-pad fallback for vehicle driving.
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_UP] = touch::gLeftStick.value.y < -.5f;
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_DOWN] = touch::gLeftStick.value.y > .5f;
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_LEFT] = touch::gLeftStick.value.x < -.5f;
+        state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_RIGHT] = touch::gLeftStick.value.x > .5f;
+        return GLFW_TRUE;
+    }
+    SDL_GameController* c = gPads[jid];
+    static const SDL_GameControllerButton map[15] = {
+        SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_B, SDL_CONTROLLER_BUTTON_X, SDL_CONTROLLER_BUTTON_Y,
+        SDL_CONTROLLER_BUTTON_LEFTSHOULDER, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, SDL_CONTROLLER_BUTTON_BACK,
+        SDL_CONTROLLER_BUTTON_START, SDL_CONTROLLER_BUTTON_GUIDE, SDL_CONTROLLER_BUTTON_LEFTSTICK,
+        SDL_CONTROLLER_BUTTON_RIGHTSTICK, SDL_CONTROLLER_BUTTON_DPAD_UP, SDL_CONTROLLER_BUTTON_DPAD_RIGHT,
+        SDL_CONTROLLER_BUTTON_DPAD_DOWN, SDL_CONTROLLER_BUTTON_DPAD_LEFT };
+    memset(state, 0, sizeof(*state));
+    for (int i = 0; i < 15; ++i)
+        state->buttons[i] = SDL_GameControllerGetButton(c, map[i]) ? GLFW_PRESS : GLFW_RELEASE;
+
+    const float k = 1.0f / 32767.0f;
+    state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTX) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTY) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_RIGHT_X] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_RIGHTX) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_RIGHT_Y] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_RIGHTY) * k;
+    state->axes[GLFW_GAMEPAD_AXIS_LEFT_TRIGGER] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERLEFT) * k * 2.0f - 1.0f;
+    state->axes[GLFW_GAMEPAD_AXIS_RIGHT_TRIGGER] = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) * k * 2.0f - 1.0f;
+
+    // left analog stick also drives the d-pad (the game uses digital steering)
+    const float t = 0.5f;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] < -t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_UP] = GLFW_PRESS;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_Y] > t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_DOWN] = GLFW_PRESS;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] < -t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_LEFT] = GLFW_PRESS;
+    if (state->axes[GLFW_GAMEPAD_AXIS_LEFT_X] > t) state->buttons[GLFW_GAMEPAD_BUTTON_DPAD_RIGHT] = GLFW_PRESS;
+    return GLFW_TRUE;
+}
+
+void glfwShimGetDisplaySize(int* width, int* height)
+{
+    int w = 0, h = 0;
+    if (gWindow.mSdlWindow) SDL_GL_GetDrawableSize(gWindow.mSdlWindow, &w, &h);
+    if (width) *width = w;
+    if (height) *height = h;
+}
+
+const char* glfwShimInternalStoragePath(void) { return SDL_AndroidGetInternalStoragePath(); }
+const char* glfwShimExternalStoragePath(void) { return SDL_AndroidGetExternalStoragePath(); }
+
+void glfwShimSetAspectLabel(const char* label)
+{
+    if (!label) return;
+    SDL_strlcpy(touch::gAspectLabel, label, sizeof(touch::gAspectLabel));
+}
+
+void glfwShimSetLockLabel(const char* label)
+{
+    if (!label) return;
+    strncpy(touch::gLockLabel, label, sizeof(touch::gLockLabel) - 1);
+    touch::gLockLabel[sizeof(touch::gLockLabel) - 1] = 0;
+}
+
+void glfwShimSetGameViewRect(int x, int y, int w, int h)
+{
+    if (x == touch::gViewX && y == touch::gViewY && w == touch::gViewW && h == touch::gViewH) return;
+    touch::ReleaseAll();
+    touch::gViewX = x; touch::gViewY = y; touch::gViewW = w; touch::gViewH = h;
+    touch::gScreenW = 0; // force a touch layout refresh on the next frame
+}
+
+// Launcher maps touch_controls="twinstick" to mode 3; apply on the SDL thread.
+// 0 auto, 1 always, 2 off, 3 twin-stick
+#include <jni.h>
+extern "C" JNIEXPORT void JNICALL Java_com_burndivision_gtaperspectivelock_GameActivity_nativeSetTouchMode(JNIEnv*, jclass, jint mode)
+{
+    gRequestedTouchMode.store((mode >= 0 && mode <= 3) ? (int)mode : 0);
+}
