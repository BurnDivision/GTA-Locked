+// Windows reads controllers through SDL2 instead of GLFW: SDL talks to Switch,
+// PlayStation and other Bluetooth controllers directly, which plain Windows
+// controller input does not deliver for all of them.
+#include <SDL.h>
+static int sSlotJoystick[eGamepadID_COUNT] = { -1, -1, -1, -1 };
+static bool sSlotMapped[eGamepadID_COUNT] = {};
+static bool sGamepadSlotsDirty = true;
+static SDL_GameController* sSdlPads[eGamepadID_COUNT] = {};
+static bool sSdlReady = false;
+static int sGamepadLogBudget = 120;
+
+static void LoadGamepadMappings()
+{
+    SDL_SetMainReady();
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+    SDL_SetHint(SDL_HINT_GAMECONTROLLER_USE_BUTTON_LABELS, "0"); // layout by button position
+    if (SDL_Init(SDL_INIT_GAMECONTROLLER) != 0)
+    {
+        gConsole.LogMessage(eLogMessage_Warning, "Controller input failed to start: %s", SDL_GetError());
+        return;
+    }
+    sSdlReady = true;
+    std::string path = gFiles.mExecutableDirectory + "/gamecontrollerdb.txt";
+    int layouts = SDL_GameControllerAddMappingsFromFile(path.c_str());
+    SDL_version version;
+    SDL_GetVersion(&version);
+    gConsole.LogMessage(eLogMessage_Info, "Controller input: SDL %d.%d.%d, %d extra layouts", version.major, version.minor, version.patch, layouts < 0 ? 0 : layouts);
+}
+
+static void RefreshGamepadSlots()
+{
+    sGamepadSlotsDirty = true; // polled every frame: SDL reports connects and disconnects here
+    if (!sSdlReady)
+        return;
+    SDL_PumpEvents();
+    SDL_FlushEvents(SDL_FIRSTEVENT, SDL_LASTEVENT);
+    for (int slot = 0; slot < eGamepadID_COUNT; ++slot)
+    {
+        if (sSdlPads[slot] && SDL_GameControllerGetAttached(sSdlPads[slot]) != SDL_TRUE)
+        {
+            SDL_GameControllerClose(sSdlPads[slot]);
+            sSdlPads[slot] = nullptr;
+            sSlotJoystick[slot] = -1;
+            gInputs.SetGamepadPresent(slot, false);
+            gConsole.LogMessage(eLogMessage_Info, "Gamepad%d disconnected", slot + 1);
+        }
+    }
+    static int openFailures = 0;
+    int count = SDL_NumJoysticks();
+    for (int index = 0; index < count; ++index)
+    {
+        if (SDL_IsGameController(index) != SDL_TRUE)
+            continue;
+        SDL_JoystickID instance = SDL_JoystickGetDeviceInstanceID(index);
+        int freeSlot = -1;
+        bool alreadyOpen = false;
+        for (int slot = 0; slot < eGamepadID_COUNT; ++slot)
+        {
+            if (sSdlPads[slot] == nullptr)
+            {
+                if (freeSlot < 0) freeSlot = slot;
+            }
+            else if (SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(sSdlPads[slot])) == instance)
+            {
+                alreadyOpen = true;
+            }
+        }
+        if (alreadyOpen || freeSlot < 0)
+            continue;
+        SDL_GameController* pad = SDL_GameControllerOpen(index);
+        if (pad == nullptr)
+        {
+            if (openFailures++ < 5)
+                gConsole.LogMessage(eLogMessage_Warning, "Controller could not be opened: %s", SDL_GetError());
+            continue;
+        }
+        sSdlPads[freeSlot] = pad;
+        sSlotJoystick[freeSlot] = freeSlot;
+        sSlotMapped[freeSlot] = true;
+        gInputs.SetGamepadPresent(freeSlot, true);
+        const char* name = SDL_GameControllerName(pad);
+        gConsole.LogMessage(eLogMessage_Info, "Gamepad%d: %s", freeSlot + 1, name ? name : "?");
+    }
+}
+
+static bool ReadGamepad(int slot, bool, float axes[6], bool buttons[eGamepadButton_COUNT])
+{
+    SDL_GameController* pad = sSdlPads[slot];
+    if (pad == nullptr)
+        return false;
+    static const SDL_GameControllerAxis stickAxes[4] = {
+        SDL_CONTROLLER_AXIS_LEFTX, SDL_CONTROLLER_AXIS_LEFTY, SDL_CONTROLLER_AXIS_RIGHTX, SDL_CONTROLLER_AXIS_RIGHTY };
+    for (int iaxis = 0; iaxis < 4; ++iaxis)
+    {
+        float value = SDL_GameControllerGetAxis(pad, stickAxes[iaxis]) / 32767.0f;
+        axes[iaxis] = value < -1.0f ? -1.0f : value;
+    }
+    axes[4] = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERLEFT) / 32767.0f;
+    axes[5] = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) / 32767.0f;
+    static const struct { SDL_GameControllerButton from; eGamepadButton to; } map[] = {
+        { SDL_CONTROLLER_BUTTON_A, eGamepadButton_A }, { SDL_CONTROLLER_BUTTON_B, eGamepadButton_B },
+        { SDL_CONTROLLER_BUTTON_X, eGamepadButton_X }, { SDL_CONTROLLER_BUTTON_Y, eGamepadButton_Y },
+        { SDL_CONTROLLER_BUTTON_LEFTSHOULDER, eGamepadButton_LeftBumper }, { SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, eGamepadButton_RightBumper },
+        { SDL_CONTROLLER_BUTTON_BACK, eGamepadButton_Back }, { SDL_CONTROLLER_BUTTON_START, eGamepadButton_Start },
+        { SDL_CONTROLLER_BUTTON_GUIDE, eGamepadButton_Guide },
+        { SDL_CONTROLLER_BUTTON_LEFTSTICK, eGamepadButton_LeftThumb }, { SDL_CONTROLLER_BUTTON_RIGHTSTICK, eGamepadButton_RightThumb },
+        { SDL_CONTROLLER_BUTTON_DPAD_UP, eGamepadButton_DPAD_Up }, { SDL_CONTROLLER_BUTTON_DPAD_RIGHT, eGamepadButton_DPAD_Right },
+        { SDL_CONTROLLER_BUTTON_DPAD_DOWN, eGamepadButton_DPAD_Down }, { SDL_CONTROLLER_BUTTON_DPAD_LEFT, eGamepadButton_DPAD_Left } };
+    for (const auto& entry: map)
+        buttons[entry.to] = SDL_GameControllerGetButton(pad, entry.from) != 0;
+    buttons[eGamepadButton_LeftTrigger] = axes[4] > 0.5f;
+    buttons[eGamepadButton_RightTrigger] = axes[5] > 0.5f;
+    return true;
+}
+
+static void LogRawGamepadChanges(int slot, int)
+{
+    static const char* names[6] = { "left stick X", "left stick Y", "right stick X", "right stick Y", "left trigger", "right trigger" };
+    static const SDL_GameControllerAxis sdlAxes[6] = { SDL_CONTROLLER_AXIS_LEFTX, SDL_CONTROLLER_AXIS_LEFTY, SDL_CONTROLLER_AXIS_RIGHTX,
+        SDL_CONTROLLER_AXIS_RIGHTY, SDL_CONTROLLER_AXIS_TRIGGERLEFT, SDL_CONTROLLER_AXIS_TRIGGERRIGHT };
+    static float previous[eGamepadID_COUNT][6];
+    static bool described[eGamepadID_COUNT];
+    SDL_GameController* pad = sSdlPads[slot];
+    if (pad == nullptr || sGamepadLogBudget <= 0)
+        return;
+    if (!described[slot])
+    {
+        described[slot] = true;
+        char* mapping = SDL_GameControllerMapping(pad);
+        gConsole.LogMessage(eLogMessage_Info, "Gamepad%d layout: %s", slot + 1, mapping ? mapping : "?");
+        if (mapping) SDL_free(mapping);
+    }
+    for (int iaxis = 0; iaxis < 6 && sGamepadLogBudget > 0; ++iaxis)
+    {
+        float value = SDL_GameControllerGetAxis(pad, sdlAxes[iaxis]) / 32767.0f;
+        if (fabsf(value - previous[slot][iaxis]) < 0.6f)
+            continue;
+        previous[slot][iaxis] = value;
+        --sGamepadLogBudget;
+        gConsole.LogMessage(eLogMessage_Info, "Gamepad%d %s = %.2f", slot + 1, names[iaxis], value);
+    }
+}
