+    const std::map<int,DoorState>& Doors() const {return doors_;}
+    const std::map<unsigned int,PedMotion>& ScriptPeds() const {return scriptPeds_;}
+    // Mission car object -> declaring record ID (diagnostics and tests).
+    const std::map<unsigned int,int>& CarRecords() const {return carRecords_;}
+    // Only a recovered original-camera record can establish this rectangle.
+    // Engine perspective camera bounds are not an equivalent source.
+    bool SetOriginalView(int owner,const OriginalView& view);
+    // Explicit engine creation primitives. Callers must prove declaration/type/AI policy.
+    Pedestrian* SpawnPedestrian(const glm::vec3& position,int remap);
+    Vehicle* SpawnVehicle(const glm::vec3& position,int model,int heading);
+    // GTA declaration tuples are map cells. Resolved opcode XYZ are 1/64 cells.
+    static std::optional<glm::vec3> DeclarationPosition(const Record&);
+    static std::optional<glm::vec3> ParseDeclarationPosition(const Record&);
+    static std::optional<glm::vec3> ScriptPosition(int x,int y,int z);
+    // Original 1/64-cell XYZ to engine metres. Engine height is inverted
+    // relative to original Z, exactly as the map's startup objects are placed.
+    static std::optional<glm::vec3> EnginePosition(int x,int y,int z);
+private:
+    std::array<Pickup,256> pickups_{};
+    void UpdatePickups();
+    std::vector<glm::vec2> pickupObstacles_; // scratch, reused every update
+    void PrepareDoors(const Section&);
