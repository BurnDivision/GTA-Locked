+// Platform-free gamepad rules. Button{} means unassigned; groups are independent.
+namespace controls {
+template<class Button,class Group,std::size_t N>
+bool assign(std::array<Button,N>& buttons,const std::array<Group,N>& groups,
+            std::size_t action,Button button) {
+    if(action>=N || button==Button{} || buttons[action]==button)return false;
+    const Button old=buttons[action];
+    for(std::size_t i=0;i<N;++i)
+        if(i!=action && groups[i]==groups[action] && buttons[i]==button)
+            buttons[i]=old;
+    buttons[action]=button;
+    return true;
+}
+template<class Button,std::size_t N>
+void restore(std::array<Button,N>& buttons,const std::array<Button,N>& defaults) {
+    buttons=defaults;
+}
+struct Capture {
+    bool active=false;
+    int gamepad=0;
+    std::vector<bool> blocked;
+    template<std::size_t N> void begin(int pad,const std::array<bool,N>& held) {
+        gamepad=pad;blocked.assign(held.begin(),held.end());active=true;
+    }
+    void cancel() {active=false;}
+    void release(int pad,int button) {
+        if(pad==gamepad && button>0 && button<int(blocked.size()))blocked[button]=false;
+    }
+    bool press(int pad,int button) {
+        if(!active || pad!=gamepad || button<=0 || button>=int(blocked.size()) || blocked[button])return false;
+        active=false;return true;
+    }
+};
+}
