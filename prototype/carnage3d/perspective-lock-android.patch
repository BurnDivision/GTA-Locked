+namespace touch
+{
+    enum Control
+    {
+        Control_None = -1,
+        Control_DPad = 0,
+        Control_Fire,
+        Control_Car,
+        Control_Jump,
+        Control_Weapon,
+        Control_Horn,
+        Control_Lock,
+        Control_Aspect,
+        Control_COUNT
+    };
+
+    struct Button
+    {
+        float x, y, r;
+        int key;
+        const char* label;
+        float cr, cg, cb;
+    };
+
+    static Button gButtons[Control_COUNT];
+    static float gDPadX = 0, gDPadY = 0, gDPadR = 0;
+    static int gScreenW = 0, gScreenH = 0;
+
+    struct Finger
+    {
+        SDL_FingerID id;
+        int control;
+        float x, y; // pixels
+    };
+    static std::vector<Finger> gFingers;
+
+    // current key state produced by touch
+    enum { K_UP, K_DOWN, K_LEFT, K_RIGHT, K_FIRE, K_CAR, K_JUMP, K_WPN, K_HORN, K_LOCK, K_ASPECT, K_COUNT };
+    static const int gKeyMap[K_COUNT] = {
+        GLFW_KEY_UP, GLFW_KEY_DOWN, GLFW_KEY_LEFT, GLFW_KEY_RIGHT, GLFW_KEY_LEFT_CONTROL,
+        GLFW_KEY_ENTER, GLFW_KEY_SPACE, GLFW_KEY_X, GLFW_KEY_TAB, GLFW_KEY_F9, GLFW_KEY_F7 };
+    static char gAspectLabel[8] = "AUTO"; // set by the engine
+    static char gLockLabel[8] = "LOCK"; // camera mode, set by the engine
+    static int gViewX = 0, gViewY = 0, gViewW = 0, gViewH = 0; // game view rect, set by the engine
+    static bool gKeyState[K_COUNT] = {};
+    static bool gVisible = true;
+    static int gMode = 0; // 0 auto, 1 always, 2 off, 3 twin-stick
+    static touch_sticks::Stick gLeftStick, gRightStick;
+    static float gRightX = 0, gRightY = 0;
+    static bool VirtualPad() { return gMode == 3 && !AnyRealPad(); }
+
+    static void Layout(int w, int h)
+    {
+        gScreenW = w; gScreenH = h;
+        float u = (float)((w < h) ? w : h); // short side
+        float W = (float)w, H = (float)h;
+        // portrait with the game view near the top: size the controls to the space below it
+        if (gViewH > 0 && h > w)
+        {
+            const float bottomBar = (float)(h - (gViewY + gViewH));
+            if (bottomBar > 0.2f * u && bottomBar < 0.42f * u) u = bottomBar / 0.42f;
+        }
+        gDPadR = 0.17f * u;
+        gDPadX = 0.06f * u + gDPadR;
+        gDPadY = H - 0.06f * u - gDPadR;
+
+        float br = 0.075f * u;
+        gButtons[Control_Fire]   = { W - 0.15f * u, H - 0.15f * u, 0.095f * u, K_FIRE, "FIRE", 0.85f, 0.20f, 0.20f };
+        gButtons[Control_Car]    = { W - 0.38f * u, H - 0.12f * u, br, K_CAR,  "CAR",  0.20f, 0.45f, 0.90f };
+        gButtons[Control_Jump]   = { W - 0.15f * u, H - 0.40f * u, br, K_JUMP, "JUMP", 0.20f, 0.75f, 0.30f };
+        gButtons[Control_Weapon] = { W - 0.36f * u, H - 0.34f * u, br * 0.85f, K_WPN, "WPN", 0.90f, 0.75f, 0.15f };
+        gButtons[Control_Horn]   = { W - 0.58f * u, H - 0.10f * u, br * 0.75f, K_HORN, "HORN", 0.60f, 0.60f, 0.60f };
+        gButtons[Control_Lock]   = { W - 0.09f * u, 0.17f * u, br * 0.65f, K_LOCK, gLockLabel, 0.75f, 0.40f, 0.90f };
+        gButtons[Control_Aspect] = { W - 0.09f * u, 0.33f * u, br * 0.65f, K_ASPECT, gAspectLabel, 0.25f, 0.65f, 0.80f };
+
+        // letterboxed view (bars above/below, little room at the sides): put the small
+        // LOCK / aspect buttons in the top bar so they don't cover the HUD
+        const float topBar = (float)gViewY;
+        const float rightBar = (float)(w - (gViewX + gViewW));
+        if (gViewH > 0 && topBar >= 0.05f * u && rightBar < 0.12f * u)
+        {
+            float r = br * 0.65f;
+            if (r > topBar * 0.45f) r = topBar * 0.45f;
+            const float cy = topBar * 0.5f;
+            gButtons[Control_Lock].x = W - 0.04f * u - r;
+            gButtons[Control_Lock].y = cy;
+            gButtons[Control_Lock].r = r;
+            gButtons[Control_Aspect].x = gButtons[Control_Lock].x - 2.6f * r;
+            gButtons[Control_Aspect].y = cy;
+            gButtons[Control_Aspect].r = r;
+        }
+        if (gMode == 3)
+        {
+            // Reserve the lower right for aim, with action buttons above the stick.
+            gRightX = W - gDPadX; gRightY = gDPadY;
+            gButtons[Control_Car].x = W - .10f * u;
+            gButtons[Control_Car].y = H - .51f * u;
+            gButtons[Control_Jump].x = W - .29f * u;
+            gButtons[Control_Jump].y = H - .60f * u;
+            gButtons[Control_Weapon].x = W - .48f * u;
+            gButtons[Control_Weapon].y = H - .51f * u;
+            gButtons[Control_Horn].x = W - .55f * u;
+            gButtons[Control_Horn].y = H - .30f * u;
+        }
+        gButtons[Control_DPad]   = { gDPadX, gDPadY, gDPadR, -1, "", 1, 1, 1 };
+    }
+
+    static int HitTest(float x, float y)
+    {
+        float dx = x - gDPadX, dy = y - gDPadY;
+        if (gMode != 3 && dx * dx + dy * dy <= (gDPadR * 1.6f) * (gDPadR * 1.6f)) return Control_DPad;
+        for (int i = Control_Fire; i < Control_COUNT; ++i)
+        {
+            if (gMode == 3 && i == Control_Fire) continue;
+            const Button& b = gButtons[i];
+            float bx = x - b.x, by = y - b.y;
+            float rr = b.r * 1.35f;
+            if (bx * bx + by * by <= rr * rr) return i;
+        }
+        return Control_None;
+    }
+
+    static void Recompute()
+    {
+        bool desired[K_COUNT] = {};
+        for (const Finger& f : gFingers)
+        {
+            if (f.control == Control_DPad)
+            {
+                float dx = f.x - gDPadX, dy = f.y - gDPadY;
+                float t = gDPadR * 0.35f;
+                if (dy < -t) desired[K_UP] = true;
+                if (dy > t) desired[K_DOWN] = true;
+                if (dx < -t) desired[K_LEFT] = true;
+                if (dx > t) desired[K_RIGHT] = true;
+            }
+            else if (f.control > Control_DPad)
+            {
+                desired[gButtons[f.control].key] = true;
+            }
+        }
+        for (int k = 0; k < K_COUNT; ++k)
+        {
+            if (desired[k] != gKeyState[k])
+            {
+                gKeyState[k] = desired[k];
+                EmitKey(gKeyMap[k], desired[k]);
+            }
+        }
+    }
+
+    static void OnFinger(const SDL_TouchFingerEvent& e, Uint32 type)
+    {
+        if (gMode == 2) return; // on-screen controls switched off
+        if (gScreenW <= 0 || gScreenH <= 0)
+        {
+            int w = 0, h = 0;
+            if (gWindow.mSdlWindow) SDL_GL_GetDrawableSize(gWindow.mSdlWindow, &w, &h);
+            Layout(w, h);
+        }
+        gVisible = true;
+        float x = e.x * gScreenW, y = e.y * gScreenH;
+        if (type == SDL_FINGERDOWN)
+        {
+            // A finger is captured on down and keeps its control until up.
+            for (const Finger& f : gFingers) if (f.id == e.fingerId) return;
+            if ((gLeftStick.active && gLeftStick.owner == e.fingerId) ||
+                (gRightStick.active && gRightStick.owner == e.fingerId)) return;
+            int c = HitTest(x, y);
+            if (gMode == 3 && c == Control_None && VirtualPad())
+            {
+                float dx = x - gDPadX, dy = y - gDPadY;
+                float rx = x - gRightX, ry = y - gRightY;
+                // Acquisition stays inside each disc: no stealing nearby action buttons.
+                if (dx*dx + dy*dy <= gDPadR*gDPadR)
+                    gLeftStick.Begin(e.fingerId, x, y, gDPadX, gDPadY, gDPadR);
+                else if (rx*rx + ry*ry <= gDPadR*gDPadR)
+                    gRightStick.Begin(e.fingerId, x, y, gRightX, gRightY, gDPadR);
+            }
+            if (c != Control_None) gFingers.push_back({ e.fingerId, c, x, y });
+        }
+        else
+        {
+            if (type == SDL_FINGERUP) { gLeftStick.End(e.fingerId); gRightStick.End(e.fingerId); }
+            else {
+                gLeftStick.Move(e.fingerId, x, y, gDPadX, gDPadY, gDPadR);
+                gRightStick.Move(e.fingerId, x, y, gRightX, gRightY, gDPadR);
+            }
+            for (size_t i = 0; i < gFingers.size(); ++i)
+            {
+                if (gFingers[i].id != e.fingerId) continue;
+                if (type == SDL_FINGERUP) gFingers.erase(gFingers.begin() + i);
+                else { gFingers[i].x = x; gFingers[i].y = y; }
+                break;
+            }
+        }
+        Recompute();
+    }
+
+    static void ReleaseAll()
+    {
+        gFingers.clear();
+        gLeftStick.Reset(); gRightStick.Reset();
+        Recompute();
+    }
