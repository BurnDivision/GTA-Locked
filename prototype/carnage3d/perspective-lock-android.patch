diff --git a/src/mission/ConstructionRules.h b/src/mission/ConstructionRules.h
new file mode 100755
index 0000000..4398432
--- /dev/null
+++ b/src/mission/ConstructionRules.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <optional>
+namespace mission {
+// 004544e0 after its air-layer search, in original integer pixels. The
+// high bit of type_map gates slope lookup, including the special slope0.
+inline std::optional<int> carGroundZ(int x,int y,int layer,bool flat,int slope) {
+    if(x<0 || y<0 || x>=16384 || y>=16384 || layer<0 || layer>4) return {};
+    if(!flat) return layer*64+63;
+    const int px=x%64,py=y%64,top=(layer+1)*64;
+    switch(slope) {
+    case 0:return top-63;
+    case 1:return top-31+py/2;
+    case 2:return top-63+py/2;
+    case 3:return top-py/2;
+    case 4:return top-32-py/2;
+    case 5:return top-31+px/2;
+    case 6:return top-63+px/2;
+    case 7:return top-px/2;
+    case 8:return top-32-px/2;
+    case 0x29:return top-63+py;
+    case 0x2a:return top-py;
+    case 0x2b:return top-63+px;
+    case 0x2c:return top-px;
+    default:break;
+    }
+    static constexpr int positive[]={9,15,23,31,39,47,55,63};
+    static constexpr int negative[]={2,8,16,24,32,40,48,56};
+    if(slope>=9 && slope<=16) return top-positive[slope-9]+py/8;
+    if(slope>=17 && slope<=24) return top-negative[slope-17]-py/8;
+    if(slope>=25 && slope<=32) return top-positive[slope-25]+px/8;
+    if(slope>=33 && slope<=40) return top-negative[slope-33]-px/8;
+    return {}; // original diagnostic fallback is not a proved spawn
+}
+}
diff --git a/src/mission/DoorRules.h b/src/mission/DoorRules.h
new file mode 100755
index 0000000..4a1a6cf
--- /dev/null
+++ b/src/mission/DoorRules.h
@@ -0,0 +1,70 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+namespace mission {
+// 004740f0, 00474800/40, 00402390/440, 00402580 and callbacks.
+// One tick is the original 25Hz update, not a render or physics frame.
+struct DoorState {
+    int x=0,y=0,z=0,direction=0,frames=0,base=0,roof=0,radius=2;
+    int state=1,frame=0,counter=0;
+    int kind=0,model=-1; // 00773240 opening rule; 00773242 model for kind3
+    // kind 2 (00474710): 00773242 car binding, 00773244 colour (0xffff = any).
+    // carBound: `car` is a mission record number whose runtime car is the
+    // binding (set by ENABLE); otherwise it is the raw constructor value,
+    // which the original compares with the car pool index.
+    int car=-1,color=0xffff,carRecord=-1; bool carBound=false;
+    bool disabled=true,solid=true;
+    bool permanent=false; // declared with a prefix: 004745c0 leaves it alone
+    bool enable(bool on) {
+        if(state==2 || state==3) return false;
+        disabled=!on; return true;
+    }
+    void animate(bool open) {
+        state=open?2:3; frame=counter=0; solid=!open;
+    }
+    int texture() const {return base+(state==1?0:state==0?frames-1:state==3?frames-1-frame:frame);}
+    bool tick() {
+        if(state!=2 && state!=3) return false;
+        if(++counter!=15) return false;
+        counter=0; ++frame;
+        if(frame==frames-1) {
+            // Callback runs before the final texture copy.
+            state=state==2?0:1;
+        }
+        return true;
+    }
+    bool obstructs(int px,int py) const {
+        switch(direction) {
+        case 0:return py==y && x<=px && px<=x+3;
+        case 1:return py==y && x-3<=px && px<=x;
+        case 2:return px==x && y<=py && py<=y+3;
+        case 3:return px==x && y-3<=py && py<=y;
+        default:return false;
+        }
+    }
+};
+// 0043ca30 writes the participant rectangle from the ORIGINAL camera record.
+// Inputs are signed script units (1/64 cell), not engine camera metres/FOV.
+struct OriginalView {int height=0,x=0,y=0,zoom=0;};
+struct ScreenRectangle {
+    std::int64_t xmin,xmax,ymin,ymax;
+    std::int64_t half=0; // unclamped half-width (rectangle word 4)
+    bool contains(int x,int y) const {return xmin<=x && x<=xmax && ymin<=y && y<=ymax;}
+    // 0040acd0: the car test widens every side by the half-width.
+    bool nearScreen(int x,int y) const {return xmin-half<=x && x<=xmax+half && ymin-half<=y && y<=ymax+half;}
+};
+inline std::optional<ScreenRectangle> originalRectangle(const OriginalView& c) {
+    // Outside recovered normal camera range, preserve Unresolved instead of
+    // pretending int64 arithmetic reproduces overflowing x86 operations.
+    auto product=(std::int64_t(c.height)+384)*160;
+    if(c.zoom<=0 || product<0 || product>INT32_MAX) return {};
+    auto w=product/c.zoom;
+    if(w>INT32_MAX/3) return {};
+    auto h=w*3/4;
+    if(std::int64_t(c.x)+w>INT32_MAX || std::int64_t(c.x)-w<INT32_MIN ||
+       std::int64_t(c.y)+h>INT32_MAX || std::int64_t(c.y)-h<INT32_MIN) return {};
+    auto clamp=[](std::int64_t n){return std::max<std::int64_t>(0,n);};
+    return ScreenRectangle{clamp(c.x-w),clamp(c.x+w),clamp(c.y-h),clamp(c.y+h),w};
+}
+}
diff --git a/src/mission/GameEconomy.cpp b/src/mission/GameEconomy.cpp
new file mode 100755
index 0000000..cff4b2c
--- /dev/null
+++ b/src/mission/GameEconomy.cpp
@@ -0,0 +1,176 @@
+#include "GameEconomy.h"
+#include <stdexcept>
+
+namespace gta {
+namespace {
+// Portable signed reinterpretation; avoid implementation-defined unsigned casts.
+std::int32_t s32(std::uint32_t u) {
+    return u<=0x7fffffffu ? static_cast<std::int32_t>(u)
+        : -1-static_cast<std::int32_t>(0xffffffffu-u);
+}
+std::int16_t s16(std::uint16_t u) {
+    return static_cast<std::int16_t>(u<=0x7fffu ? static_cast<int>(u)
+        : -1-static_cast<int>(0xffffu-u));
+}
+// Complete numeric event factors from switch00462000; names intentionally unknown.
+// SPEC_SCORE.md:47-73. Exceptional 24/26/default handled before Q multiplication.
+std::uint32_t factor(std::int32_t id) {
+    switch(id) {
+    case 1:case 3:case 4:case 7:case 8:case 9:case 14:case 15:
+    case 20:case 27:case 28:case 30:case 33:case 38:case 39:return 100;
+    case 2:case 21:case 37:case 45:return 1000;
+    case 5:case 13:return 500;
+    case 6:case 18:case 36:return 150;
+    case 10:case 11:case 25:return 10000;
+    case 12:return 5000;
+    case 16:case 17:return 10;
+    case 22:case 23:return 0;
+    case 29:case 31:return 50;
+    case 32:case 35:return 250;
+    case 34:return 200;
+    case 40:case 41:case 42:return 300;
+    case 43:return 500000;
+    default:return 100;
+    }
+}
+std::uint32_t methodFactor(int method) {
+    // 00462000 entry switch; SPEC_SCORE.md:42.
+    switch(method) {
+    case 2:return 3;
+    case 3:case 7:case 8:return 10;
+    case 4:return 7;
+    case 5:case 6:return 2;
+    default:return 1;
+    }
+}
+}
+EconomyState& GameEconomy::state(int owner) {
+    if(owner<0) throw std::out_of_range("negative economy owner");
+    return players_.at(static_cast<std::size_t>(owner));
+}
+const EconomyState& GameEconomy::state(int owner) const {
+    if(owner<0) throw std::out_of_range("negative economy owner");
+    return players_.at(static_cast<std::size_t>(owner));
+}
+std::int32_t GameEconomy::score(int owner) const {return state(owner).score;}
+std::int32_t GameEconomy::reward(int owner,std::int32_t base) {
+    auto& p=state(owner);
+    const auto amount=static_cast<std::uint32_t>(base)*p.multiplier;
+    p.score=s32(static_cast<std::uint32_t>(p.score)+amount);
+    // 00461f20: signed comparison AFTER x86 wrapping; no lower clamp.
+    if(p.score>999999999) p.score=999999999;
+    return s32(amount);
+}
+void GameEconomy::deduct(int owner,std::int32_t cost) {
+    auto& p=state(owner);
+    p.score=s32(static_cast<std::uint32_t>(p.score)-static_cast<std::uint32_t>(cost));
+    if(p.score<0) p.score=0; // 00461f90; cost is not multiplied
+}
+void GameEconomy::incrementMultiplier(int owner) {
+    ++state(owner).multiplier; // 00463070 uint16 addition, no cap
+}
+void GameEconomy::halveMultiplier(int owner) {
+    auto& m=state(owner).multiplier;
+    m>>=1; if(m==0) m=1; // 00464be0
+}
+void GameEconomy::missionEnd(int owner,std::int32_t e) {
+    if(e>0) reward(owner,e); // 0043e450; old multiplier first
+    incrementMultiplier(owner); // 0044a569, even when E<=0
+}
+EventAward GameEconomy::event(int owner,std::int32_t id,int method) {
+    auto& p=state(owner);
+    if(p.previousEvent==id) ++p.run;
+    else {p.previousEvent=id; p.run=1;}
+    p.expiry=13; // 00462000; update-count expiry, 00464880
+    const auto run=s16(p.run); // raw00462000 sign-extends run
+    auto q=static_cast<std::uint32_t>(static_cast<std::int32_t>(run));
+    auto t=methodFactor(method);
+    if(id==1) q*=t;
+    else {
+        // Raw00462000 doubles only while signed(run)-1>0. Unsigned
+        // multiply deliberately emulates x86 overflow, including V<=1 fallback.
+        for(int i=1;i<run;++i) t*=2;
+        if(s32(t)>1) q=t;
+    }
+    std::uint32_t base;
+    if(id==24) base=static_cast<std::uint32_t>(static_cast<std::int32_t>(p.event24Value))*10; // 00462000
+    else if(id==26) base=20; // 00462000, independent of Q
+    else if(id<1 || id>45 || id==19 || id==44) base=100; // default00462000
+    else base=q*factor(id);
+    EventAward result;
+    result.primary=reward(owner,s32(base));
+    if(id==7 && run==7) { // 00462000, text key004b221c
+        result.bonusTriggered=true;
+        result.bonus=reward(owner,12300); // 0x300c; separate award/clamp
+    }
+    return result;
+}
+void GameEconomy::tickCombo(int owner) {
+    auto& p=state(owner);
+    // 00464880 signed short countdown; clear at expiry<1.
+    if(s16(p.expiry)>0) --p.expiry;
+    if(s16(p.expiry)<1) {p.previousEvent=0; p.run=0;}
+}
+void GameEconomy::addLife(int owner) {
+    auto& n=state(owner).lives;
+    if(n!=99 && n!=255) ++n; // 004630b0; -1 sentinel is raw0xff
+}
+bool GameEconomy::consumeLife(int owner) {
+    auto& n=state(owner).lives;
+    // 00463100 signed byte tail: all negative bytes except -1 fail unchanged.
+    if(n==0 || n>=128) return n==255;
+    --n; return true;
+}
+void GameEconomy::resetState2(int owner) {
+    auto& p=state(owner);
+    if(!p.skipPenaltyOnce) halveMultiplier(owner); // 00464880/00464be0
+    p.skipPenaltyOnce=false;
+    clearWanted(owner); // 00464880, independent of exemption
+}
+void GameEconomy::addWantedPoints(int owner,std::int32_t delta) {
+    auto& n=state(owner).wantedPoints;
+    n=s16(static_cast<std::uint16_t>(static_cast<std::uint32_t>(n)+static_cast<std::uint16_t>(delta)));
+    if(n>2000) n=2000; // 004617e0 signed16 post-wrap cap; no lower clamp
+}
+void GameEconomy::clearWanted(int owner) {
+    auto& p=state(owner); p.wantedPoints=0; p.wantedLevel=0; // 004617a0/00461890
+}
+void GameEconomy::setWantedLevel(int owner,std::int32_t level) {
+    state(owner).wantedLevel=level; // 00461910 no clamp
+}
+int GameEconomy::classifyWanted(std::int16_t points,bool forceZero) {
+    // 004133c0; forceZero represents unresolved global00503184.
+    if(forceZero || points<151) return 0;
+    if(points<251) return 1;
+    if(points<351) return 2;
+    return 3+(points>500);
+}
+void GameEconomy::classifyWantedNow(int owner,bool forceZero) {
+    auto& p=state(owner); p.wantedLevel=classifyWanted(p.wantedPoints,forceZero);
+}
+void GameEconomy::classifyWantedInSection(int owner,int section,bool forceZero) {
+    auto& p=state(owner);
+    const int points=p.wantedPoints;
+    if(section==1 || section==2) {classifyWantedNow(owner,forceZero); return;}
+    // 004134d0/004135e0, SPEC_POLICE_2; no real-time cadence inferred.
+    if(forceZero || points<101) {p.wantedLevel=0; return;}
+    if(section==102 || section==103)
+        p.wantedLevel=points<201?1:points<251?2:points<376?3:4;
+    else p.wantedLevel=points<176?1:points<251?2:points<351?3:4;
+}
+bool GameEconomy::acceptedCrime(int owner,int crime) {
+    // 004136c0; SPEC_POLICE_LIVES.md:41-48. Record minimum3/6
+    // is deliberately NOT assigned to player wantedLevel.
+    static constexpr int deltas[]={2,50,10,15,50,1,100,100};
+    if(crime<2 || crime>9) return false;
+    addWantedPoints(owner,deltas[crime-2]); return true;
+}
+void GameEconomy::bankRobbery(int owner) {
+    addWantedPoints(owner,1000); setWantedLevel(owner,4); // opcode76/0044860f
+}
+void GameEconomy::witnessEscalation(int owner,int section) {
+    auto& p=state(owner);
+    p.wantedPoints=(section==1 || section==2)?152:102; // 004136c0 witness branch
+    if(p.wantedLevel==0) p.wantedLevel=1;
+}
+}
