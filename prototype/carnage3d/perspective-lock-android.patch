+bool GameMapManager::SetBlockInfo(int x,int y,int z,const MapBlockInfo& block) {
+    if(!IsLoaded() || !validCell(x,y,z)) return false;
+    auto& old=mMapTiles[z][y][x];
+    // Compare fields, never padding or bitfield storage bytes.
+    bool same=old.mRemap==block.mRemap && old.mGroundType==block.mGroundType &&
+        old.mLidRotation==block.mLidRotation && old.mTrafficHint==block.mTrafficHint &&
+        old.mSlopeType==block.mSlopeType && old.mUpDirection==block.mUpDirection &&
+        old.mDownDirection==block.mDownDirection && old.mLeftDirection==block.mLeftDirection &&
+        old.mRightDirection==block.mRightDirection && old.mIsFlat==block.mIsFlat &&
+        old.mFlipTopBottomFaces==block.mFlipTopBottomFaces &&
+        old.mFlipLeftRightFaces==block.mFlipLeftRightFaces && old.mIsRailway==block.mIsRailway &&
+        std::equal(std::begin(old.mFaces),std::end(old.mFaces),std::begin(block.mFaces));
+    if(same) return true;
+    if(old.mGroundType!=block.mGroundType) {
+        ++mCollisionRevision;
+        // A column fixture also depends on the four adjacent ground types.
+        for(auto offset:{std::pair<int,int>{0,0},{1,0},{-1,0},{0,1},{0,-1}}) {
+            int cx=x+offset.first,cy=y+offset.second;
+            if(validCell(cx,cy,z)) mDirtyCollisionColumns.emplace(cx,cy);
+        }
+    }
+    old=block; ++mMeshRevision; DirtyMeshCell(x,y); return true;
+}
+bool GameMapManager::SetRuntimeFace(int x,int y,int z,eBlockFace face,int texture,bool solid) {
+    if(!IsLoaded() || !validCell(x,y,z) || face<0 || face>=eBlockFace_Lid ||
+       texture<0 || texture>=mStyleData.GetBlockTexturesCount()) return false;
+    FaceKey key{x,y,z,face}; auto at=mRuntimeFaces.find(key);
+    if(at==mRuntimeFaces.end() || at->second.solid!=solid) {
+        ++mCollisionRevision;
+        if(face==eBlockFace_W || face==eBlockFace_N) mDirtyCollisionFaces.insert(key);
+    }
+    if(at==mRuntimeFaces.end() || at->second.texture!=texture) { ++mMeshRevision; DirtyMeshCell(x,y); }
+    mRuntimeFaces[key]={texture,solid}; return true;
+}
+void GameMapManager::ClearRuntimeFace(int x,int y,int z,eBlockFace face) {
+    if(mRuntimeFaces.erase(FaceKey{x,y,z,face})) {
+        ++mMeshRevision; ++mCollisionRevision; DirtyMeshCell(x,y);
+        if(face==eBlockFace_W || face==eBlockFace_N) mDirtyCollisionFaces.emplace(x,y,z,face);
+    }
+}
+int GameMapManager::FaceTexture(int x,int y,int z,eBlockFace face) const {
+    auto at=mRuntimeFaces.find(FaceKey{x,y,z,face});
+    if(at!=mRuntimeFaces.end()) return at->second.texture;
+    const auto* block=GetBlockInfo(x,y,z);
+    if(!block || !block->mFaces[face]) return -1;
+    return mStyleData.GetBlockTextureLinearIndex(face==eBlockFace_Lid?eBlockType_Lid:eBlockType_Side,block->mFaces[face]);
+}
