+// topmost solid block at map cell, or nullptr
+static const MapBlockInfo* GetTopBlock(int mapx, int mapy)
+{
+    for (int iz = (MAP_LAYERS_COUNT - 1); iz > 0; --iz)
+    {
+        const MapBlockInfo* mapBlock = gGameMap.GetBlockInfo(mapx, mapy, iz);
+        if (mapBlock->mGroundType != eGroundType_Air)
+            return mapBlock;
+    }
+    return nullptr;
+}
+
+static bool IsDrivableRoad(const MapBlockInfo* mapBlock)
+{
+    return mapBlock && (mapBlock->mGroundType == eGroundType_Road) && !mapBlock->mIsRailway;
+}
+
+// number of lane directions on a road block
+static int CountLaneDirections(const MapBlockInfo* mapBlock)
+{
+    if (!mapBlock)
+        return 0;
+    return (mapBlock->mRightDirection ? 1 : 0) + (mapBlock->mLeftDirection ? 1 : 0) +
+        (mapBlock->mDownDirection ? 1 : 0) + (mapBlock->mUpDirection ? 1 : 0);
+}
+
+bool AiCharacterController::ChooseDriveWaypoint()
+{
+    mDriveHasWaypoint = false;
+    if (!mCharacter->IsCarDriver())
+        return false;
+
+    Vehicle* car = mCharacter->mCurrentCar;
+    const glm::vec3& carPos = car->mTransform.mPosition;
+    const int mapx = (int) floorf(Convert::MetersToMapUnits(carPos.x));
+    const int mapy = (int) floorf(Convert::MetersToMapUnits(carPos.z));
+
+    const MapBlockInfo* current = GetTopBlock(mapx, mapy);
+    if (!IsDrivableRoad(current))
+        return false;
+
+    if (mDriveDirX == 0 && mDriveDirY == 0)
+    {
+        // initial lane direction from the car heading (0 deg = +x, 90 deg = +y)
+        glm::vec2 dir = car->mTransform.GetDirectionVector();
+        if (fabsf(dir.x) > fabsf(dir.y)) mDriveDirX = (dir.x > 0.0f) ? 1 : -1;
+        else mDriveDirY = (dir.y > 0.0f) ? 1 : -1;
+    }
+
+    // lane directions allowed on this block: right = +x, left = -x, down = +y, up = -y
+    struct Dir { int x, y; };
+    Dir options[4];
+    int numOptions = 0;
+    if (current->mRightDirection) options[numOptions++] = { 1, 0 };
+    if (current->mLeftDirection)  options[numOptions++] = { -1, 0 };
+    if (current->mDownDirection)  options[numOptions++] = { 0, 1 };
+    if (current->mUpDirection)    options[numOptions++] = { 0, -1 };
+
+    cxx::randomizer& random = gCarnageGame.mGameRand;
+    Dir candidates[4];
+    int numCandidates = 0;
+    bool straightAllowed = false;
+    for (int i = 0; i < numOptions; ++i)
+    {
+        if (options[i].x == -mDriveDirX && options[i].y == -mDriveDirY)
+            continue; // no U-turns
+        if (!IsDrivableRoad(GetTopBlock(mapx + options[i].x, mapy + options[i].y)))
+            continue;
+        if (options[i].x == mDriveDirX && options[i].y == mDriveDirY)
+            straightAllowed = true;
+        candidates[numCandidates++] = options[i];
+    }
+
+    Dir chosen = { mDriveDirX, mDriveDirY };
+    if (numCandidates > 0)
+    {
+        // prefer going straight, sometimes turn at junctions
+        if (!(straightAllowed && random.random_chance(70)))
+        {
+            chosen = candidates[random.generate_int(0, numCandidates - 1)];
+        }
+    }
+    else if (!IsDrivableRoad(GetTopBlock(mapx + mDriveDirX, mapy + mDriveDirY)))
+    {
+        return false; // dead end
+    }
+
+    // aim at the centre of the next block; it is "reached" as soon as the car enters it,
+    // so the target always stays ahead of the car and it can't circle around it
+    mDriveDirX = chosen.x;
+    mDriveDirY = chosen.y;
+    mDriveTargetX = mapx + chosen.x;
+    mDriveTargetY = mapy + chosen.y;
+    mDestinationPoint.x = Convert::MapUnitsToMeters(mDriveTargetX + 0.5f);
+    mDestinationPoint.y = Convert::MapUnitsToMeters(mDriveTargetY + 0.5f);
+    mDriveSegmentTime = 0.0f;
+    mDriveHasWaypoint = true;
+    return true;
+}
+
+bool AiCharacterController::ContinueDriveToWaypoint()
+{
+    if (!mDriveHasWaypoint || !mCharacter->IsCarDriver())
+        return false;
+
+    Vehicle* car = mCharacter->mCurrentCar;
+    const glm::vec2 carPos2 (car->mTransform.mPosition.x, car->mTransform.mPosition.z);
+    const int mapx = (int) floorf(Convert::MetersToMapUnits(carPos2.x));
+    const int mapy = (int) floorf(Convert::MetersToMapUnits(carPos2.y));
+    if (mapx == mDriveTargetX && mapy == mDriveTargetY)
+    {
+        mDriveHasWaypoint = false; // entered the target block, pick the next one
+        return false;
+    }
+
+    mDriveSegmentTime += gTimeManager.mGameFrameDelta;
+    if (mDriveSegmentTime > 6.0f)
+    {
+        mDriveHasWaypoint = false; // took too long (pushed off course), re-plan from here
+        return false;
+    }
+
+    // steer towards the target (positive angle difference = steer towards increasing heading)
+    const glm::vec2 toTarget = mDestinationPoint - carPos2;
+    const float desired = atan2f(toTarget.y, toTarget.x);
+    float diff = desired - car->mTransform.mOrientation.to_radians();
+    while (diff > glm::pi<float>()) diff -= glm::two_pi<float>();
+    while (diff < -glm::pi<float>()) diff += glm::two_pi<float>();
+
+    const float speed = car->GetCurrentSpeed();
+    const float cruiseSpeed = Convert::MapUnitsToMeters(1.5f); // blocks per second
+    const float slowSpeed = Convert::MapUnitsToMeters(0.8f);
+
+    // slow down while turning and before junctions, so the car can make the corner
+    float targetSpeed = cruiseSpeed;
+    if (fabsf(diff) > 0.3f || CountLaneDirections(GetTopBlock(mDriveTargetX, mDriveTargetY)) > 1)
+    {
+        targetSpeed = slowSpeed;
+    }
+
+    // keep a gap to vehicles ahead (bumper to bumper, plus a braking distance that grows with speed)
+    const glm::vec2 forward = car->mTransform.GetDirectionVector();
+    // half of the chassis length, meters (a lambda so it shares this class's friend access to Vehicle)
+    auto GetVehicleHalfLength = [](const Vehicle* vehicle)
+    {
+        glm::vec2 corners[4];
+        vehicle->GetChassisCornersLocal(corners);
+        return fabsf(corners[1].x - corners[0].x) * 0.5f;
+    };
+    const float selfHalfLength = GetVehicleHalfLength(car);
+    const float margin = Convert::MapUnitsToMeters(0.3f) + fabsf(speed) * 0.5f;
+    if (mDriveIgnoreGapTime > 0.0f)
+    {
+        mDriveIgnoreGapTime -= gTimeManager.mGameFrameDelta;
+        targetSpeed = std::min(targetSpeed, slowSpeed); // crossing override still respects vehicles directly ahead
+    }
+    for (Vehicle* other: gGameObjectsManager.mVehiclesList)
+    {
+        if (other == car || other->IsMarkedForDeletion())
+            continue;
+        const glm::vec2 toOther (other->mTransform.mPosition.x - carPos2.x, other->mTransform.mPosition.z - carPos2.y);
+        const float along = glm::dot(toOther, forward);
+        if (along <= 0.0f)
+            continue;
+        const float side = fabsf(forward.x * toOther.y - forward.y * toOther.x);
+        const float distance = glm::length(toOther);
+        const glm::vec2 otherForward = other->mTransform.GetDirectionVector();
+        const float otherAlong = glm::dot(-toOther, otherForward);
+        const TrafficGap::Decision gap = TrafficGap::Evaluate(along, side, distance,
+            selfHalfLength + GetVehicleHalfLength(other), margin,
+            Convert::MapUnitsToMeters(1.0f), otherAlong, car < other,
+            mDriveIgnoreGapTime > 0.0f);
+        if (gap == TrafficGap::Decision::Stop)
+        {
+            targetSpeed = 0.0f;
+            break;
+        }
+        if (gap == TrafficGap::Decision::Slow)
+        {
+            targetSpeed = std::min(targetSpeed, slowSpeed);
+        }
+    }
+
+    // backing away from an obstacle
+    if (mDriveReverseTime > 0.0f)
+    {
+        mDriveReverseTime -= gTimeManager.mGameFrameDelta;
+        mCtlState.Clear();
+        mCtlState.mAcceleration = -1.0f;
+        mCtlState.mSteerDirection = -glm::clamp(diff * 2.0f, -1.0f, 1.0f);
+        if (mDriveReverseTime <= 0.0f)
+        {
+            mDriveHasWaypoint = false; // re-plan from where we ended up
+            return false;
+        }
+        return true;
+    }
+
+    mCtlState.Clear();
+    mCtlState.mSteerDirection = glm::clamp(diff * 2.0f, -1.0f, 1.0f);
+    if (speed < targetSpeed) mCtlState.mAcceleration = 1.0f;
+    else if (speed > targetSpeed + 0.5f) mCtlState.mAcceleration = -1.0f; // brake
+    if (targetSpeed <= 0.0f)
+    {
+        mCtlState.mSteerDirection = 0.0f;
+        if (fabsf(speed) < 0.5f)
+        {
+            mCtlState.mAcceleration = 0.0f;
+            mCtlState.mHandBrake = true; // hold still, don't creep into the car ahead
+        }
+        mDriveSegmentTime = 0.0f; // waiting in traffic is not being stuck
+        mDriveStuckTime = 0.0f;
+        mDriveWaitTime += gTimeManager.mGameFrameDelta;
+        if (mDriveWaitTime > 5.0f)
+        {
+            mDriveWaitTime = 0.0f;
+            mDriveIgnoreGapTime = 2.0f; // relax crossing yield only; preserve the gap directly ahead
+        }
+        return true;
+    }
+
+    mDriveWaitTime = 0.0f;
+
+    // stuck against something: don't keep pushing (every contact frame damages the car,
+    // so a few seconds of pushing would set it on fire), back off and re-plan instead
+    if (fabsf(speed) < 0.3f && mCtlState.mAcceleration > 0.0f) mDriveStuckTime += gTimeManager.mGameFrameDelta;
+    else mDriveStuckTime = 0.0f;
+    if (mDriveStuckTime > 0.8f)
+    {
+        mDriveStuckTime = 0.0f;
+        mDriveReverseTime = 1.0f;
+    }
+    return true;
+}
