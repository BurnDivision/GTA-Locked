diff --git a/src/mission/DoorRules.h b/src/mission/DoorRules.h
new file mode 100755
index 0000000..4f0892f
--- /dev/null
+++ b/src/mission/DoorRules.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+namespace mission {
+// 004740f0, 00474800/40, 00402390/440, 00402580 and callbacks.
+// One tick is the original 25Hz update, not a render or physics frame.
+struct DoorState {
+    int x=0,y=0,z=0,direction=0,frames=0,base=0,roof=0,radius=2;
+    int state=1,frame=0,counter=0;
+    bool disabled=true,solid=true;
+    bool enable(bool on) {
+        if(state==2 || state==3) return false;
+        disabled=!on; return true;
+    }
+    void animate(bool open) {
+        state=open?2:3; frame=counter=0; solid=!open;
+    }
+    int texture() const {return base+(state==1?0:state==0?frames-1:state==3?frames-1-frame:frame);}
+    bool tick() {
+        if(state!=2 && state!=3) return false;
+        if(++counter!=15) return false;
+        counter=0; ++frame;
+        if(frame==frames-1) {
+            // Callback runs before the final texture copy.
+            state=state==2?0:1;
+        }
+        return true;
+    }
+    bool obstructs(int px,int py) const {
+        switch(direction) {
+        case 0:return py==y && x<=px && px<=x+3;
+        case 1:return py==y && x-3<=px && px<=x;
+        case 2:return px==x && y<=py && py<=y+3;
+        case 3:return px==x && y-3<=py && py<=y;
+        default:return false;
+        }
+    }
+};
+// 0043ca30 writes the participant rectangle from the ORIGINAL camera record.
+// Inputs are signed script units (1/64 cell), not engine camera metres/FOV.
+struct OriginalView {int height=0,x=0,y=0,zoom=0;};
+struct ScreenRectangle {
+    std::int64_t xmin,xmax,ymin,ymax;
+    bool contains(int x,int y) const {return xmin<=x && x<=xmax && ymin<=y && y<=ymax;}
+};
+inline std::optional<ScreenRectangle> originalRectangle(const OriginalView& c) {
+    // Outside recovered normal camera range, preserve Unresolved instead of
+    // pretending int64 arithmetic reproduces overflowing x86 operations.
+    auto product=(std::int64_t(c.height)+384)*160;
+    if(c.zoom<=0 || product<0 || product>INT32_MAX) return {};
+    auto w=product/c.zoom;
+    if(w>INT32_MAX/3) return {};
+    auto h=w*3/4;
+    if(std::int64_t(c.x)+w>INT32_MAX || std::int64_t(c.x)-w<INT32_MIN ||
+       std::int64_t(c.y)+h>INT32_MAX || std::int64_t(c.y)-h<INT32_MIN) return {};
+    auto clamp=[](std::int64_t n){return std::max<std::int64_t>(0,n);};
+    return ScreenRectangle{clamp(c.x-w),clamp(c.x+w),clamp(c.y-h),clamp(c.y+h)};
+}
+}
diff --git a/src/mission/GameEconomy.cpp b/src/mission/GameEconomy.cpp
new file mode 100755
index 0000000..cff4b2c
--- /dev/null
+++ b/src/mission/GameEconomy.cpp
@@ -0,0 +1,176 @@
+#include "GameEconomy.h"
+#include <stdexcept>
+
+namespace gta {
+namespace {
+// Portable signed reinterpretation; avoid implementation-defined unsigned casts.
+std::int32_t s32(std::uint32_t u) {
+    return u<=0x7fffffffu ? static_cast<std::int32_t>(u)
+        : -1-static_cast<std::int32_t>(0xffffffffu-u);
+}
+std::int16_t s16(std::uint16_t u) {
+    return static_cast<std::int16_t>(u<=0x7fffu ? static_cast<int>(u)
+        : -1-static_cast<int>(0xffffu-u));
+}
+// Complete numeric event factors from switch00462000; names intentionally unknown.
+// SPEC_SCORE.md:47-73. Exceptional 24/26/default handled before Q multiplication.
+std::uint32_t factor(std::int32_t id) {
+    switch(id) {
+    case 1:case 3:case 4:case 7:case 8:case 9:case 14:case 15:
+    case 20:case 27:case 28:case 30:case 33:case 38:case 39:return 100;
+    case 2:case 21:case 37:case 45:return 1000;
+    case 5:case 13:return 500;
+    case 6:case 18:case 36:return 150;
+    case 10:case 11:case 25:return 10000;
+    case 12:return 5000;
+    case 16:case 17:return 10;
+    case 22:case 23:return 0;
+    case 29:case 31:return 50;
+    case 32:case 35:return 250;
+    case 34:return 200;
+    case 40:case 41:case 42:return 300;
+    case 43:return 500000;
+    default:return 100;
+    }
+}
+std::uint32_t methodFactor(int method) {
+    // 00462000 entry switch; SPEC_SCORE.md:42.
+    switch(method) {
+    case 2:return 3;
+    case 3:case 7:case 8:return 10;
+    case 4:return 7;
+    case 5:case 6:return 2;
+    default:return 1;
+    }
+}
+}
+EconomyState& GameEconomy::state(int owner) {
+    if(owner<0) throw std::out_of_range("negative economy owner");
+    return players_.at(static_cast<std::size_t>(owner));
+}
+const EconomyState& GameEconomy::state(int owner) const {
+    if(owner<0) throw std::out_of_range("negative economy owner");
+    return players_.at(static_cast<std::size_t>(owner));
+}
+std::int32_t GameEconomy::score(int owner) const {return state(owner).score;}
+std::int32_t GameEconomy::reward(int owner,std::int32_t base) {
+    auto& p=state(owner);
+    const auto amount=static_cast<std::uint32_t>(base)*p.multiplier;
+    p.score=s32(static_cast<std::uint32_t>(p.score)+amount);
+    // 00461f20: signed comparison AFTER x86 wrapping; no lower clamp.
+    if(p.score>999999999) p.score=999999999;
+    return s32(amount);
+}
+void GameEconomy::deduct(int owner,std::int32_t cost) {
+    auto& p=state(owner);
+    p.score=s32(static_cast<std::uint32_t>(p.score)-static_cast<std::uint32_t>(cost));
+    if(p.score<0) p.score=0; // 00461f90; cost is not multiplied
+}
+void GameEconomy::incrementMultiplier(int owner) {
+    ++state(owner).multiplier; // 00463070 uint16 addition, no cap
+}
+void GameEconomy::halveMultiplier(int owner) {
+    auto& m=state(owner).multiplier;
+    m>>=1; if(m==0) m=1; // 00464be0
+}
+void GameEconomy::missionEnd(int owner,std::int32_t e) {
+    if(e>0) reward(owner,e); // 0043e450; old multiplier first
+    incrementMultiplier(owner); // 0044a569, even when E<=0
+}
+EventAward GameEconomy::event(int owner,std::int32_t id,int method) {
+    auto& p=state(owner);
+    if(p.previousEvent==id) ++p.run;
+    else {p.previousEvent=id; p.run=1;}
+    p.expiry=13; // 00462000; update-count expiry, 00464880
+    const auto run=s16(p.run); // raw00462000 sign-extends run
+    auto q=static_cast<std::uint32_t>(static_cast<std::int32_t>(run));
+    auto t=methodFactor(method);
+    if(id==1) q*=t;
+    else {
+        // Raw00462000 doubles only while signed(run)-1>0. Unsigned
+        // multiply deliberately emulates x86 overflow, including V<=1 fallback.
+        for(int i=1;i<run;++i) t*=2;
+        if(s32(t)>1) q=t;
+    }
+    std::uint32_t base;
+    if(id==24) base=static_cast<std::uint32_t>(static_cast<std::int32_t>(p.event24Value))*10; // 00462000
+    else if(id==26) base=20; // 00462000, independent of Q
+    else if(id<1 || id>45 || id==19 || id==44) base=100; // default00462000
+    else base=q*factor(id);
+    EventAward result;
+    result.primary=reward(owner,s32(base));
+    if(id==7 && run==7) { // 00462000, text key004b221c
+        result.bonusTriggered=true;
+        result.bonus=reward(owner,12300); // 0x300c; separate award/clamp
+    }
+    return result;
+}
+void GameEconomy::tickCombo(int owner) {
+    auto& p=state(owner);
+    // 00464880 signed short countdown; clear at expiry<1.
+    if(s16(p.expiry)>0) --p.expiry;
+    if(s16(p.expiry)<1) {p.previousEvent=0; p.run=0;}
+}
+void GameEconomy::addLife(int owner) {
+    auto& n=state(owner).lives;
+    if(n!=99 && n!=255) ++n; // 004630b0; -1 sentinel is raw0xff
+}
+bool GameEconomy::consumeLife(int owner) {
+    auto& n=state(owner).lives;
+    // 00463100 signed byte tail: all negative bytes except -1 fail unchanged.
+    if(n==0 || n>=128) return n==255;
+    --n; return true;
+}
+void GameEconomy::resetState2(int owner) {
+    auto& p=state(owner);
+    if(!p.skipPenaltyOnce) halveMultiplier(owner); // 00464880/00464be0
+    p.skipPenaltyOnce=false;
+    clearWanted(owner); // 00464880, independent of exemption
+}
+void GameEconomy::addWantedPoints(int owner,std::int32_t delta) {
+    auto& n=state(owner).wantedPoints;
+    n=s16(static_cast<std::uint16_t>(static_cast<std::uint32_t>(n)+static_cast<std::uint16_t>(delta)));
+    if(n>2000) n=2000; // 004617e0 signed16 post-wrap cap; no lower clamp
+}
+void GameEconomy::clearWanted(int owner) {
+    auto& p=state(owner); p.wantedPoints=0; p.wantedLevel=0; // 004617a0/00461890
+}
+void GameEconomy::setWantedLevel(int owner,std::int32_t level) {
+    state(owner).wantedLevel=level; // 00461910 no clamp
+}
+int GameEconomy::classifyWanted(std::int16_t points,bool forceZero) {
+    // 004133c0; forceZero represents unresolved global00503184.
+    if(forceZero || points<151) return 0;
+    if(points<251) return 1;
+    if(points<351) return 2;
+    return 3+(points>500);
+}
+void GameEconomy::classifyWantedNow(int owner,bool forceZero) {
+    auto& p=state(owner); p.wantedLevel=classifyWanted(p.wantedPoints,forceZero);
+}
+void GameEconomy::classifyWantedInSection(int owner,int section,bool forceZero) {
+    auto& p=state(owner);
+    const int points=p.wantedPoints;
+    if(section==1 || section==2) {classifyWantedNow(owner,forceZero); return;}
+    // 004134d0/004135e0, SPEC_POLICE_2; no real-time cadence inferred.
+    if(forceZero || points<101) {p.wantedLevel=0; return;}
+    if(section==102 || section==103)
+        p.wantedLevel=points<201?1:points<251?2:points<376?3:4;
+    else p.wantedLevel=points<176?1:points<251?2:points<351?3:4;
+}
+bool GameEconomy::acceptedCrime(int owner,int crime) {
+    // 004136c0; SPEC_POLICE_LIVES.md:41-48. Record minimum3/6
+    // is deliberately NOT assigned to player wantedLevel.
+    static constexpr int deltas[]={2,50,10,15,50,1,100,100};
+    if(crime<2 || crime>9) return false;
+    addWantedPoints(owner,deltas[crime-2]); return true;
+}
+void GameEconomy::bankRobbery(int owner) {
+    addWantedPoints(owner,1000); setWantedLevel(owner,4); // opcode76/0044860f
+}
+void GameEconomy::witnessEscalation(int owner,int section) {
+    auto& p=state(owner);
+    p.wantedPoints=(section==1 || section==2)?152:102; // 004136c0 witness branch
+    if(p.wantedLevel==0) p.wantedLevel=1;
+}
+}
diff --git a/src/mission/GameEconomy.h b/src/mission/GameEconomy.h
new file mode 100755
index 0000000..0f786bb
--- /dev/null
+++ b/src/mission/GameEconomy.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace gta {
+// Recovered fields; raw byte/word storage preserves executable wrapping.
+struct EconomyState {
+    std::int32_t score=0;             // 0074f23c; normal init 00463290
+    std::uint16_t multiplier=1;        // 0074f240; normal init 00463290
+    std::int32_t previousEvent=0;      // 0074f2b8; cleared by 00464880
+    std::uint16_t run=0, expiry=0;      // 0074f2bc/0074f2b4
+    std::int16_t event24Value=0;        // 0074f2c8; caller-owned input
+    std::int16_t wantedPoints=0;       // 0074f298; 004617e0
+    std::int32_t wantedLevel=0;        // 0074f29c; 00461910
+    std::uint8_t lives=4;              // 0074f2df; normal-mode init 00463290
+    bool skipPenaltyOnce=false;        // 0074f242; 00464880
+};
+struct EventAward {
+    std::int32_t primary=0, bonus=0; // display amounts BEFORE score clamp
+    bool bonusTriggered=false;      // text key 004b221c, event7/run7
+};
+class GameEconomy {
+public:
+    // One record per explicitly participating player; no guessed maximum.
+    explicit GameEconomy(std::size_t participants): players_(participants) {}
+    EconomyState& state(int owner);
+    const EconomyState& state(int owner) const;
+    std::int32_t score(int owner) const;
+    // VM-compatible calls. reward implements primitive even for negative bases;
+    // VM is responsible for only paying positive E on decoded reward paths.
+    std::int32_t reward(int owner,std::int32_t base);
+    void deduct(int owner,std::int32_t cost);
+    void incrementMultiplier(int owner);
+    void halveMultiplier(int owner);
+    void missionEnd(int owner,std::int32_t e);
+    EventAward event(int owner,std::int32_t eventID,int methodID);
+    void tickCombo(int owner); // update count; NOT seconds
+    void addLife(int owner);
+    bool consumeLife(int owner); // life-counter tail only, no inventory cleanup
+    void resetState2(int owner); // economy subset; caller proves state2 entered
+    void addWantedPoints(int owner,std::int32_t delta);
+    void clearWanted(int owner);
+    void setWantedLevel(int owner,std::int32_t level);
+    static int classifyWanted(std::int16_t points,bool forceZero=false);
+    void classifyWantedNow(int owner,bool forceZero=false);
+    void classifyWantedInSection(int owner,int section,bool forceZero=false);
+    // Caller MUST first apply original ownership/witness/duplicate gates.
+    // Only points, not score or police-record mutations. Unknown ID -> false.
+    bool acceptedCrime(int owner,int crimeID);
+    void bankRobbery(int owner); // opcode76 direct effect; crime9 separately gated
+    void witnessEscalation(int owner,int section); // caller proves witness branch
+    static constexpr bool hasUnresolvedRules=true;
+    // TODO-evidence:004136c0 gates/vehicle mapping;00464880 reset entry;
+    // 004133c0 classifier cadence;004601a0/00460500 fees/respawn;
+    // 00462000 local audio/frenzy effects; natural wanted decay untraced.
+private:
+    std::vector<EconomyState> players_;
+};
+}
diff --git a/src/mission/MissionScript.cpp b/src/mission/MissionScript.cpp
new file mode 100755
index 0000000..1d41912
--- /dev/null
+++ b/src/mission/MissionScript.cpp
@@ -0,0 +1,86 @@
+#include "MissionScript.h"
+#include <regex>
+#include <sstream>
+#include <stdexcept>
+#include <utility>
+
+namespace mission {
+namespace {
+std::string trim(const std::string& s) {
+    const auto first = s.find_first_not_of(" \t\r\n");
+    if (first == std::string::npos) return {};
+    return s.substr(first, s.find_last_not_of(" \t\r\n") - first + 1);
+}
+void tally(Inventory& inventory, const std::string& token, std::size_t line) {
+    auto& entry = inventory[token];
+    if (entry.count == 0) entry.firstLine = line;
+    ++entry.count;
+}
+std::vector<std::string> words(const std::string& text) {
+    std::istringstream input(text);
+    std::vector<std::string> result;
+    for (std::string word; input >> word;) result.push_back(word);
+    return result;
+}
+}
+MissionScript MissionScript::parse(std::istream& input) {
+    const std::regex header(R"(^\[([^\[\]]+)\]$)");
+    const std::regex declaration(R"(^([0-9]+)\s+(?:([+-]?[0-9]+)\s*)?(\([^()]*\))\s+([A-Z_][A-Z_0-9]*)(\s.*)?$)");
+    const std::regex instruction(R"(^([0-9]+)\s+([A-Z_][A-Z_0-9]*)(\s.*)?$)");
+    const std::regex title(R"(^[^,]+,\s*[0-9]+,\s*[^,\s]+\.[cC][mM][pP],\s*[+-]?[0-9]+,\s*$)");
+    const std::regex config(R"(^[0-9]+(?:\s+[0-9]+){5}$)");
+    // A fused terminator/header is retained as a marker, not silently repaired.
+    const std::regex marker(R"(^-1(?:\[[^\[\]]+\])?$)");
+    MissionScript result;
+    for (std::string raw; std::getline(input, raw);) {
+        const auto line = ++result.lineCount;
+        auto text = trim(raw);
+        if (text.empty()) continue;
+        if (text == std::string(1, '\x1a')) {
+            if (!result.sections.empty()) result.sections.back().markers.push_back({line, raw});
+            else result.unparsed.push_back({line, raw});
+            continue;
+        }
+        std::smatch match;
+        if (std::regex_match(text, match, header)) {
+            Section section;
+            section.line = line; section.raw = raw; section.name = match[1].str();
+            result.sections.push_back(std::move(section));
+            continue;
+        }
+        if (result.sections.empty()) { result.unparsed.push_back({line, raw}); continue; }
+        auto& section = result.sections.back();
+        // Match against left-trimmed input to keep trailing operand whitespace exact.
+        auto body = raw.substr(raw.find_first_not_of(" \t"));
+        if (!body.empty() && body.back() == '\r') body.pop_back();
+        bool isDeclaration = std::regex_match(body, match, declaration);
+        if (isDeclaration || std::regex_match(body, match, instruction)) {
+            Record record;
+            record.line = line; record.raw = raw; record.label = match[1].str();
+            if (isDeclaration) {
+                record.prefix = match[2].str(); record.coordinates = match[3].str();
+                record.token = match[4].str(); record.rawOperands = match[5].str();
+            } else { record.token = match[2].str(); record.rawOperands = match[3].str(); }
+            record.operands = words(record.rawOperands);
+            tally(section.tokens, record.token, line); tally(result.tokens, record.token, line);
+            if (isDeclaration) section.declarations.push_back(std::move(record));
+            else {
+                section.instructionsByLabel[record.label].push_back(section.instructions.size());
+                section.instructions.push_back(std::move(record));
+            }
+        } else if (std::regex_match(text, marker)) section.markers.push_back({line, raw});
+        else if (std::regex_match(text, title) || std::regex_match(text, config)) section.metadata.push_back({line, raw});
+        else result.unparsed.push_back({line, raw});
+    }
+    if (input.bad() || (input.fail() && !input.eof())) throw std::runtime_error("MISSION input read failure");
+    return result;
+}
+void writeUnsupportedReport(const MissionScript& script, std::ostream& out) {
+    for (const auto& section : script.sections) {
+        out << "## [" << section.name << "]\n\nToken | Count | First line | Execution\n--- | ---: | ---: | ---\n";
+        for (const auto& item : section.tokens)
+            out << item.first << " | " << item.second.count << " | " << item.second.firstLine << " | unsupported\n";
+        out << '\n';
+    }
+}
+}
diff --git a/src/mission/MissionScript.h b/src/mission/MissionScript.h
new file mode 100755
index 0000000..6c8003b
--- /dev/null
+++ b/src/mission/MissionScript.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstddef>
+#include <istream>
+#include <map>
+#include <ostream>
+#include <string>
+#include <vector>
+
+namespace mission {
+struct SourceLine { std::size_t line = 0; std::string raw; };
+struct Record : SourceLine {
+    std::string label;
+    std::string token;
+    std::vector<std::string> operands;
+    std::string rawOperands;
+    // Empty for instructions. Preserved, never converted or interpreted.
+    std::string coordinates;
+    std::string prefix; // Optional integer between declaration label and tuple.
+};
+struct TokenCount { std::size_t count = 0; std::size_t firstLine = 0; };
+using Inventory = std::map<std::string, TokenCount>;
+struct Section : SourceLine {
+    std::string name;
+    std::vector<Record> declarations;
+    std::vector<Record> instructions;
+    // Lexical label -> all indices in instructions (duplicates retained).
+    std::map<std::string, std::vector<std::size_t>> instructionsByLabel;
+    Inventory tokens;
+    std::vector<SourceLine> metadata;
+    std::vector<SourceLine> markers;
+};
+struct MissionScript {
+    std::vector<Section> sections;
+    Inventory tokens;
+    std::vector<SourceLine> unparsed;
+    std::size_t lineCount = 0;
+    static MissionScript parse(std::istream& input);
+};
+// No execution support exists: all observed tokens are reported unsupported.
+void writeUnsupportedReport(const MissionScript&, std::ostream&);
+}
