+        if(!ped || !entity || entity->declaration.token!="DOOR" || !doors_.count(i.A)) return WorldResult::Unresolved;
+        if(!ped->mCurrentCar && (ped->IsStanding() || ped->IsWalking())) return WorldResult::Hold;
+        Once("park-control","Unresolved PARK004407c0: original AI99, vehicle control/predicted box and forced participant movement/cleanup mappings; E is not awarded");
+        return WorldResult::Unresolved;
+    }
+    // Guarded effects with known VM failure contracts; do not guess engine health.
+    if((token=="KILL_DROP" || token=="REMAP_PED" || token=="CLOSE_DOOR") &&
+       (!entity || !entity->value || *entity->value<0)) return WorldResult::Failure;
+    if(token=="KILL_PED" && (!entity || entity->type!=99 || !entity->value || *entity->value<0))
+        return WorldResult::Failure;
+    // No broad success fallback: VM blocks unresolved commands after one dispatch.
+    Once("execute:"+token,"Unsupported world command "+token+" ("+r.evidence+")");
+    return WorldResult::Unresolved;
+}
+std::optional<bool> CarnageMissionWorld::predicate(const WorldRequest& r) {
+    if(r.token=="IS_POWERUP_DONE") {
+        const auto at=r.entities.find(r.instruction.A);
+        if(at==r.entities.end() || at->second.declaration.token!="POWERUP") return {};
+        auto pos=DeclarationPosition(at->second.declaration); if(!pos)return {};
+        const auto x=std::llround(Convert::MetersToMapUnits(pos->x)*pickup::cell);
+        const auto y=std::llround(Convert::MetersToMapUnits(pos->z)*pickup::cell);
+        for(const auto& entry:pickups_) if(entry.object && entry.shape.p[4].x==x && entry.shape.p[4].y==y) return false;
+        return true;
+    }
+    if(r.token=="DOOR_ON" || r.token=="DOOR_OFF") {
+        auto at=doors_.find(r.instruction.A);
+        auto entity=r.entities.find(r.instruction.A);
+        if(at==doors_.end() || entity==r.entities.end() || entity->second.declaration.token!="DOOR") return {};
+        if(!at->second.enable(r.token=="DOOR_ON")) return false;
+        enabledDoors_.clear();
+        for(int id:doorOrder_) if(!doors_.at(id).disabled) enabledDoors_.push_back(&doors_.at(id));
+        return true;
+    }
+    if(r.token=="GENERAL_ONSCREEN") {
+        if(!OwnerValid(r.owner) || !rectangles_[r.owner]) {
+            Once("original-rectangle","Unresolved GENERAL_ONSCREEN: original camera height/centre/zoom record is unavailable; no culling-bound substitution");
+            return {};
+        }
+        auto at=r.entities.find(r.instruction.A); if(at==r.entities.end()) return {};
+        int x=0,y=0;
+        if(at->second.declaration.token=="TARGET") {
+            std::string text=at->second.declaration.coordinates;
+            for(char& c:text) if(c=='(' || c==')' || c==',') c=' ';
+            std::istringstream input(text); int z; std::string extra;
+            if(!(input>>x>>y>>z) || (input>>extra)) return {};
+        } else {
+            auto pos=ResolvePosition(at->second); if(!pos) return {};
+            x=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos->x)*64));
+            y=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos->z)*64));
+        }
+        return rectangles_[r.owner]->contains(x,y);
+    }
+    if(r.token=="AREA_TRIGGER") {
+        auto at=r.entities.find(r.instruction.A); auto* human=player(r.owner);
+        if(at==r.entities.end() || at->second.declaration.token!="TRIGGER" || !human || !human->mCharacter)
+            return {};
+        auto* ped=human->mCharacter;
+        if(ped->IsMarkedForDeletion() || ped->IsEnteringOrExitingCar()) return {};
+        // 0047a3a0 type4 accepts modes0/2 and ignores Z. Mode1 skips.
+        // Stable foot and driver are the proved engine projections only.
+        GameObject* participant=ped;
+        if(ped->IsCarDriver() && ped->mCurrentCar && ped->mCurrentCar->GetCarDriver()==ped)
+            participant=ped->mCurrentCar;
+        else if(ped->mCurrentCar || (!ped->IsStanding() && !ped->IsWalking())) return {};
+        auto target=DeclarationPosition(at->second.declaration); if(!target) return {};
+        const auto& pos=participant->mTransform.mPosition;
+        if(!std::isfinite(pos.x) || !std::isfinite(pos.z)) return {};
+        const double x=std::floor(Convert::MetersToMapUnits(pos.x));
+        const double y=std::floor(Convert::MetersToMapUnits(pos.z));
+        const double tx=Convert::MetersToMapUnits(target->x), ty=Convert::MetersToMapUnits(target->z);
+        const double d=r.instruction.D;
+        return tx-d<=x && x<=tx+d && ty-d<=y && y<=ty+d;
+    }
+    if(r.token=="IS_PED_IN_CAR") {
+        auto at=r.entities.find(r.instruction.A);
+        auto binding=playerBindings_.find(r.instruction.A);
+        auto* human=player(0);
+        if(at==r.entities.end() || at->second.declaration.token!="PLAYER" ||
+           binding==playerBindings_.end() || !human || !human->mCharacter ||
+           human->mCharacter->mObjectID!=binding->second) return {};
+        auto* ped=human->mCharacter;
+        if(ped->IsMarkedForDeletion() || ped->IsEnteringOrExitingCar()) return {};
+        // 00449884 accepts ped state6 OR7; no health check. D<0 means any
+        // model, otherwise compare full D to the signed-short car model.
+        if(ped->IsCarDriver() || ped->IsCarPassenger()) {
+            auto* car=ped->mCurrentCar;
+            if(!car || car->IsMarkedForDeletion()) return {};
+            return r.instruction.D<0 || r.instruction.D==int(car->mCarInfo->mModelID);
+        }
+        if(!ped->mCurrentCar && (ped->IsStanding() || ped->IsWalking())) return false;
+        return {};
+    }
+    if(r.token=="CHECK_CAR") {
+        auto at=r.entities.find(r.instruction.A);
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        if(at==r.entities.end() || at->second.type!=0 || !ped) return {};
+        auto* object=ResolveObject(at->second);
+        if(!object || object->mClassID!=eGameObjectClass_Car || ped->IsEnteringOrExitingCar()) return {};
+        if(ped->IsCarDriver()) {
+            auto* car=ped->mCurrentCar;
+            if(!car || car->GetCarDriver()!=ped) return {};
+            // 00448a10 mode0 and exact associated handle. Nonnegative D
+            // compares car byte+0x24c (NOT model+0x22); mapping is unresolved.
+            if(car!=object) return false;
+            if(r.instruction.D>=0) return {};
+            return true;
+        }
+        if(ped->IsCarPassenger()) return {}; // original participant mode not proved
+        if(!ped->mCurrentCar && (ped->IsStanding() || ped->IsWalking())) return false;
+        return {};
+    }
+    if(r.token=="PHONE_NEAR" || r.token=="PHONE_RANGE" || r.token=="PHONE_ON_FOOT" ||
+       r.token=="PHONE_ELIGIBLE" || r.token=="MPHONES_TRIGGER") {
+        auto* human=player(r.owner);
+        if(!human || !human->mCharacter) return false;
+        auto* ped=human->mCharacter;
+        if(r.token=="PHONE_ON_FOOT") {
+            // 0044fa70 cases0x22/0x87 attach the ped to a car and set
+            // states7/6; IS_PED_IN_CAR also explicitly tests both. The
+            // stable engine seated state therefore fails the answer gate.
+            // Entry/exit timing and other original states remain unresolved.
+            if(!ped->IsEnteringOrExitingCar()) {
+                if(ped->IsCarPassenger() || ped->IsCarDriver()) return false;
+                if(!ped->mCurrentCar && (ped->IsStanding() || ped->IsWalking())) return true;
+            }
+            Once("phone-state","Original ped state6/7 projection unresolved outside stable walking/seated states");
+            return {};
+        }
+        if(r.token=="PHONE_ELIGIBLE") {
+            auto e=r.entities.find(r.instruction.A); if(e==r.entities.end()) return {};
+            int requested=e->second.aux-1;
+            if(requested==2) return false; // helper returns2, caller requires exactly1
+            if(requested==0 || requested==1) {
+                Once("phone-classification","Engine association/driver projection used; original vehicle ID range/sentinel lifecycle unresolved");
+                return phoneEligibility(requested,ped->mCurrentCar!=nullptr,
+                    ped->mCurrentCar && ped->mCurrentCar->GetCarDriver()==ped,false)==1;
+            }
+            return requested==-1;
+        }
+        auto current=ped->mTransform.mPosition;
+        if(r.token=="PHONE_RANGE" || r.token=="MPHONES_TRIGGER")
+            if(ped->mCurrentCar) current=ped->mCurrentCar->mTransform.mPosition;
+        int px=static_cast<int>(std::floor(Convert::MetersToMapUnits(current.x)*64));
+        int py=static_cast<int>(std::floor(Convert::MetersToMapUnits(current.z)*64));
+        auto at=r.entities.find(r.instruction.A); if(at==r.entities.end()) return {};
+        auto target=DeclarationPosition(at->second.declaration); if(!target) return {};
+        int x=static_cast<int>(std::lround(Convert::MetersToMapUnits(target->x)*64));
+        int y=static_cast<int>(std::lround(Convert::MetersToMapUnits(target->z)*64));
+        if(r.token=="PHONE_NEAR") return phoneNear(px,py,x,y);
+        if(r.token=="MPHONES_TRIGGER") {
+            if(ped->mCurrentCar && static_cast<int>(ped->mCurrentCar->mCarInfo->mModelID)==47) return false;
+            if(ped->IsEnteringOrExitingCar()) {
+                Once("trigger-mode","Original player mode mapping during vehicle transition unresolved"); return {};
+            }
+        }
+        return phoneArea(px,py,x/64,y/64,r.token=="PHONE_RANGE"?15:r.instruction.D);
+    }
+    if(r.token=="STEAL") {
+        auto at=r.entities.find(r.instruction.A);
+        auto* human=player(r.owner); auto* ped=human?human->mCharacter:nullptr;
+        if(at==r.entities.end() || at->second.type!=0 || !ped) return {};
+        auto* object=ResolveObject(at->second);
+        if(!object || object->mClassID!=eGameObjectClass_Car) return {};
+        if(ped->IsEnteringOrExitingCar()) return {};
+        // 00476020: associated driver handle, state6/7, health>0,
+        // and original animation0 or >126. Stable seated engine driver only.
+        if(ped->IsDead()) return false;
+        // IsCarPassenger includes the driver in Carnage3D; test driver first.
+        if(ped->IsCarDriver()) return ped->mCurrentCar==object &&
+            static_cast<Vehicle*>(object)->GetCarDriver()==ped;
+        if(ped->IsStanding() || ped->IsWalking() || ped->IsCarPassenger()) return false;
+        return {};
+    }
+    if(r.token=="IS_GOAL_DEAD") {
+        // 00449c6d -> 0043e870: car model==-1 or clamped health==0.
+        // The positive-D killer filter is exclusively for original type99.
+        // Engine damage units differ; only stable pristine/wrecked states are
+        // projected here. Missing/deleted handles are not proof of death.
+        auto at=r.entities.find(r.instruction.A);
+        if(at!=r.entities.end() && at->second.type==0) {
+            auto* object=ResolveObject(at->second);
+            if(object && object->mClassID==eGameObjectClass_Car) {
+                auto* car=static_cast<Vehicle*>(object);
+                if(car->IsWrecked()) return true;
+                if(car->GetCurrentDamage()==0) return false;
+            }
+        }
+        Once("goal-health", "IS_GOAL_DEAD requires a trusted pristine/wrecked mission car; other health/killer mappings unresolved");
+        return {};
+    }
+    if(r.token=="PHONE_VALID") {
+        auto phone=phones_.find(r.instruction.A);
+        if(phone==phones_.end() || !phone->second.object) return false;
+        auto* object=gGameObjectsManager.GetGameObjectByID(phone->second.object);
+        return object && !object->IsMarkedForDeletion();
+    }
+    if(r.token=="GOTO") {
+        auto at=r.entities.find(r.instruction.A); auto* p=player(r.owner);
+        if(at!=r.entities.end() && p && p->mCharacter) if(auto target=ResolvePosition(at->second)) {
+            const auto current=Convert::MetersToMapUnits(glm::vec2(p->mCharacter->mTransform.mPosition.x,p->mCharacter->mTransform.mPosition.z));
+            const auto goal=Convert::MetersToMapUnits(glm::vec2(target->x,target->z));
+            return std::floor(current.x)==std::floor(goal.x) && std::floor(current.y)==std::floor(goal.y);
+        }
+    }
+    Once("predicate:"+r.token,"Unsupported mission predicate "+r.token+"; engine health/state is not original script health/state");
+    return {};
+}
+
+bool CarnageMissionWorld::SetOriginalView(int owner,const OriginalView& view) {
+    if(!OwnerValid(owner)) return false;
+    rectangles_[owner]=originalRectangle(view); return rectangles_[owner].has_value();
+}
+void CarnageMissionWorld::PrepareDoors(const Section& section) {
+    if(!gGameMap.IsLoaded()) return;
+    for(const auto& r:section.declarations) if(r.token=="DOOR") {
+        int id=0,direction=0,base=0,roof=0;
+        auto pos=DeclarationPosition(r);
+        if(!integer(r.label,id) || !pos || r.operands.size()!=3 ||
+           !integer(r.operands[0],direction) || !integer(r.operands[1],base) ||
+           !integer(r.operands[2],roof) || direction<0 || direction>3 ||
+           base<0 || base+8>gGameMap.mStyleData.GetBlockTexturesCount(eBlockType_Aux) ||
+           roof<0 || roof>=gGameMap.mStyleData.GetBlockTexturesCount(eBlockType_Lid)) {
+            Once("door-declaration","Unresolved DOOR constructor variant"); continue;
+        }
+        DoorState d; d.x=static_cast<int>(Convert::MetersToMapUnits(pos->x));
+        d.y=static_cast<int>(Convert::MetersToMapUnits(pos->z));
+        d.z=static_cast<int>(Convert::MetersToMapUnits(pos->y));
+        d.direction=direction; d.frames=8; d.base=base; d.roof=roof;
+        int x=d.x+(direction==1),y=d.y+(direction==3),z=INVERT_MAP_LAYER(d.z);
+        if(x>=MAP_DIMENSIONS || y>=MAP_DIMENSIONS ||
+           (roof && (d.z+1>=MAP_LAYERS_COUNT || (direction<2?(d.y<1 || d.y>=255):(d.x<1 || d.x>=255))))) continue;
+        // Reject overlaps rather than corrupt another door's dynamic texture.
+        if(savedDoorBlocks_.count({d.x,d.y,z}) || savedDoorBlocks_.count({x,y,z})) {
+            Once("door-overlap","Unresolved overlapping door constructors"); continue;
+        }
+        auto save=[&](int bx,int by) {
+            savedDoorBlocks_.emplace(std::make_tuple(bx,by,z),*gGameMap.GetBlockInfo(bx,by,z));
+        };
+        save(d.x,d.y); save(x,y);
+        auto block=*gGameMap.GetBlockInfo(d.x,d.y,z);
+        // 004740f0:1/3 erase the old east/south face and flatten both cells.
+        if(direction==1 || direction==3) {
+            block.mFaces[direction]=0; block.mIsFlat=true;
+            gGameMap.SetBlockInfo(d.x,d.y,z,block);
+        }
+        block=*gGameMap.GetBlockInfo(x,y,z); block.mIsFlat=true;
+        gGameMap.SetBlockInfo(x,y,z,block);
+        if(roof) for(int offset=-1;offset<=1;++offset) {
+            int rx=d.x+(direction>=2?offset:0), ry=d.y+(direction<2?offset:0), rz=INVERT_MAP_LAYER(d.z+1);
+            savedDoorBlocks_.emplace(std::make_tuple(rx,ry,rz),*gGameMap.GetBlockInfo(rx,ry,rz));
+            auto lid=*gGameMap.GetBlockInfo(rx,ry,rz); lid.mFaces[eBlockFace_Lid]=roof;
+            gGameMap.SetBlockInfo(rx,ry,rz,lid);
+        }
+        doors_.emplace(id,d); doorOrder_.push_back(id); CopyDoorFrame(d);
+    }
+}
+void CarnageMissionWorld::CopyDoorFrame(const DoorState& d) {
+    int x=d.x+(d.direction==1),y=d.y+(d.direction==3),z=INVERT_MAP_LAYER(d.z);
+    int face=d.direction<2?0:2;
+    int texture=gGameMap.mStyleData.GetBlockTextureLinearIndex(eBlockType_Aux,d.texture());
+    // Both faces use one dynamic slot in the exe. Per-cell linear overrides
+    // preserve that identity without exhausting/reusing global side bytes.
+    gGameMap.SetRuntimeFace(x,y,z,static_cast<eBlockFace>(face),texture,d.solid);
+    gGameMap.SetRuntimeFace(x,y,z,static_cast<eBlockFace>(face+1),texture,d.solid);
+}
+void CarnageMissionWorld::AnimateDoor(DoorState& d,bool open) {
+    d.animate(open);
+    // Rebuild scheduling only on a state transition, preserving declaration
+    // order even when doors started animating in a different order.
+    animatingDoors_.clear();
+    for(int id:doorOrder_) {
+        auto& door=doors_.at(id);
+        if(door.state==2 || door.state==3) animatingDoors_.push_back(&door);
+    }
+    if(open) {
+        int z=INVERT_MAP_LAYER(d.z); auto block=*gGameMap.GetBlockInfo(d.x,d.y,z);
+        block.mGroundType=eGroundType_Field; //00437cb0(...,0x40), not collision removal callback
+        gGameMap.SetBlockInfo(d.x,d.y,z,block);
+    }
+    CopyDoorFrame(d);
+}
+void CarnageMissionWorld::UpdateDoors() {
+    // Original00430c00: animation tick BEFORE scheduler00479e00/00479f00.
+    if(enabledDoors_.empty() && animatingDoors_.empty()) return;
+    for(auto* door:animatingDoors_) {
+        auto& d=*door;
+        if(d.tick()) {
+            if(d.state<2) {
+                //00404810 ->004046b0 ->004728d0 is positional sample38.
+                auto at=Convert::MapUnitsToMeters(glm::vec3(d.x,INVERT_MAP_LAYER(d.z),d.y));
+                gAudioManager.StartSound(eSfxSampleType_Level,38,SfxFlags_None,at);
+                Once("door-audio","Door sample38 emitted; original three-channel arbitration/attenuation unresolved");
+            }
+            CopyDoorFrame(d);
+        }
+    }
+    animatingDoors_.erase(std::remove_if(animatingDoors_.begin(),animatingDoors_.end(),
+        [](const DoorState* d){return d->state!=2 && d->state!=3;}),animatingDoors_.end());
+    // Preserve original ascending participant decisions, including multiple
+    // participants starting another animation during the same enumeration.
+    for(auto* door:enabledDoors_) {
+        auto& d=*door; if(d.state!=0 && d.state!=1) continue;
+        for(int owner=0;owner<4;++owner) {
+            auto* human=player(owner); auto* ped=human?human->mCharacter:nullptr;
+            if(!ped || ped->IsMarkedForDeletion()) continue;
+            if(ped->IsEnteringOrExitingCar()) {
+                Once("door-participant","Unresolved automatic door participant mode during vehicle transition"); continue;
+            }
+            GameObject* participant=ped; bool mode0=false;
+            if(ped->IsCarDriver() && ped->mCurrentCar && ped->mCurrentCar->GetCarDriver()==ped) {
+                participant=ped->mCurrentCar; mode0=true;
+            } else if(ped->mCurrentCar || (!ped->IsStanding() && !ped->IsWalking())) continue;
+            const auto& pos=participant->mTransform.mPosition;
+            if(!std::isfinite(pos.x) || !std::isfinite(pos.z)) continue;
+            int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos.x)));
+            int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(pos.z)));
+            if(d.x-d.radius<=x && x<=d.x+d.radius && d.y-d.radius<=y && y<=d.y+d.radius) {
+                if(d.state==1 && mode0) AnimateDoor(d,true);
+            } else if(d.state==0) {
+                bool obstructed=false,unknown=false;
+                for(int other=0;other<4;++other) {
+                    auto* h=player(other); auto* p=h?h->mCharacter:nullptr;
+                    if(!p || p->IsMarkedForDeletion()) continue;
+                    if(p->IsEnteringOrExitingCar() || (p->mCurrentCar && !p->IsCarDriver())) {unknown=true;break;}
+                    GameObject* o=p->mCurrentCar?static_cast<GameObject*>(p->mCurrentCar):p;
+                    auto at=o->mTransform.mPosition;
+                    if(!std::isfinite(at.x) || !std::isfinite(at.z)) {unknown=true;break;}
+                    if(d.obstructs(static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x))),
+                                   static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z))))) obstructed=true;
+                }
+                if(!unknown && !obstructed) AnimateDoor(d,false);
+            }
+        }
+    }
+}
+}
