+namespace mission {
+namespace {
+bool integer(const std::string& s,int& value) {
+    try {std::size_t n; long long v=std::stoll(s,&n);
+        if(n!=s.size() || v<INT32_MIN || v>INT32_MAX) return false;
+        value=static_cast<int>(v); return true;
+    } catch(const std::exception&) {return false;}
+}
+HumanPlayer* player(int owner) {
+    return owner>=0 && owner<4 ? gCarnageGame.mHumanPlayers[owner] : nullptr;
+}
+}
+CarnageMissionWorld::~CarnageMissionWorld() {Reset();}
+bool CarnageMissionWorld::OwnerValid(int owner) const {return owner>=0 && owner<4;}
+void CarnageMissionWorld::Once(const std::string& key,const std::string& text) {
+    if(logged_.insert(key).second)
+        gConsole.LogMessage(eLogMessage_Warning,"Mission: %s",text.c_str());
+}
+void CarnageMissionWorld::diagnostic(const Diagnostic& d) {
+    // Deduplicate scheduler notices, including repeated partial-process messages.
+    Once(d.code+":"+d.detail+":"+std::to_string(d.line),
+         d.code+" line "+std::to_string(d.line)+" slot "+std::to_string(d.slot)+": "+d.detail);
+}
+std::optional<glm::vec3> CarnageMissionWorld::ScriptPosition(int x,int y,int z) {
+    if(x<0 || y<0 || z<0 || x>=MAP_DIMENSIONS*64 || y>=MAP_DIMENSIONS*64 || z>=MAP_LAYERS_COUNT*64)
+        return {};
+    // Engine Y is vertical; GTA script Y is map south. No height snapping.
+    return Convert::MapUnitsToMeters(glm::vec3(x/64.0f,z/64.0f,y/64.0f));
+}
+std::optional<glm::vec3> CarnageMissionWorld::DeclarationPosition(const Record& r) {
+    // Triggers ask for this every update; parse each tuple text once.
+    static std::unordered_map<std::string,std::optional<glm::vec3>> cache;
+    auto known=cache.find(r.coordinates);
+    if(known!=cache.end()) return known->second;
+    return cache.emplace(r.coordinates,ParseDeclarationPosition(r)).first->second;
+}
+std::optional<glm::vec3> CarnageMissionWorld::ParseDeclarationPosition(const Record& r) {
+    // Only tuple-bearing declarations have map-cell coordinates. Never apply
+    // this transform to POWERUP_ON fixed point, runtime handles or operands.
+    std::string text=r.coordinates;
+    for(char& c:text) if(c=='(' || c==')' || c==',') c=' ';
+    std::istringstream in(text); int x,y,z; std::string extra;
+    if(!(in>>x>>y>>z) || (in>>extra) || x<0 || x>=MAP_DIMENSIONS ||
+       y<0 || y>=MAP_DIMENSIONS || z<0 || z>=MAP_LAYERS_COUNT) return {};
+    return ScriptPosition(x*64,y*64,z*64);
+}
+std::optional<glm::vec3> CarnageMissionWorld::EnginePosition(int x,int y,int z) {
+    // Original Z runs downwards in 1/64 cells. An object resting on a flat
+    // ground cell L has z=L*64+63 (004544e0) and the engine stands it at
+    // the ground block's layer index 5-L, so height=(383-z)/64.
+    if(x<0 || y<0 || z<0 || x>=MAP_DIMENSIONS*64 || y>=MAP_DIMENSIONS*64 || z>MAP_LAYERS_COUNT*64-1)
+        return {};
+    return Convert::MapUnitsToMeters(glm::vec3(x/64.0f,(MAP_LAYERS_COUNT*64-1-z)/64.0f,y/64.0f));
+}
+bool CarnageMissionWorld::Tuple(const Record& r,int& x,int& y,int& z) {
+    std::string text=r.coordinates;
+    for(char& c:text) if(c=='(' || c==')' || c==',') c=' ';
+    std::istringstream in(text); std::string extra;
+    return (in>>x>>y>>z) && !(in>>extra);
+}
+std::optional<std::array<int,3>> CarnageMissionWorld::OriginalPosition(const Entity& e,int id) const {
+    int x=0,y=0,z=0;
+    auto object=[](GameObject* o)->std::optional<std::array<int,3>> {
+        if(!o || o->IsMarkedForDeletion()) return {};
+        const auto& at=o->mTransform.mPosition;
+        if(!std::isfinite(at.x) || !std::isfinite(at.y) || !std::isfinite(at.z)) return {};
+        return std::array<int,3>{{
+            static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x)*64)),
+            static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z)*64)),
+            static_cast<int>(std::floor(MAP_LAYERS_COUNT*64-1-Convert::MetersToMapUnits(at.y)*64))}};
+    };
+    switch(e.type) {
+    case 0: case 5: case 6: case 0x12: case 0x15: case 0x16: case 0x1b: // car handle
+    case 2: // object handle
+        return object(ResolveObject(e));
+    case 0x1c: case 0x40: // DRIVER_PARK / PARKED_PIXELS must first become cars
+        return {};
+    case 1: case 3: case 99: { // ped handle (unconstructed PED stays unresolved)
+        auto binding=playerBindings_.find(id);
+        if(binding!=playerBindings_.end()) return object(gGameObjectsManager.GetGameObjectByID(binding->second));
+        return object(ResolveObject(e));
+    }
+    case 8: case 9: case 0xf: case 0x10: case 0x14: case 0x1d: case 0x28: case 0x2a: case 0x2b:
+    case 0x2c: case 0x33: case 0x38: case 0x3b: case 0x3f: case 0x47: // tuple is in cells
+        if(!Tuple(e.declaration,x,y,z)) return {};
+        return std::array<int,3>{{x*64,y*64,z*64}};
+    case 7: case 0x32: // 0043d3c0 / loader case 0x32 rewrite the tuple to the cell centre
+        if(!Tuple(e.declaration,x,y,z)) return {};
+        return std::array<int,3>{{x*64+32,y*64+32,z*64}};
+    case 0x3d: case -1: return {}; // PEDCAR_TRIG stores operands there; unknown record
+    default: // tuple is already in 1/64 cells
+        if(!Tuple(e.declaration,x,y,z)) return {};
+        return std::array<int,3>{{x,y,z}};
+    }
+}
+void CarnageMissionWorld::Prepare(const Section& section) {
+    Reset();
+    // 00445800 case3 consumes 00412a70/00412a90 in declaration order.
+    // Single-player enumeration is0 then-1. Reuse the registered engine ped;
+    // original PLAYER spawn/placement is deliberately outside this projection.
+    for(const auto& r:section.declarations) if(r.token=="PLAYER") {
+        int id=0;
+        if(integer(r.label,id)) if(auto* human=player(0)) if(human->mCharacter) {
+            playerBindings_.emplace(id,human->mCharacter->mObjectID);
+            // 00475a20: the ped stands at the cell centre, one pixel above
+            // the declared layer boundary, facing the second operand.
+            int cellX=0,cellY=0,cellZ=0,heading=0;
+            if(r.operands.size()>1) integer(r.operands[1],heading);
+            if(Tuple(r,cellX,cellY,cellZ) && DeclarationPosition(r))
+                if(auto start=EnginePosition(cellX*64+32,cellY*64+32,cellZ*64-1))
+                    human->mCharacter->SetTransform(*start,-Convert::Fix16ToAngle(static_cast<unsigned short>(heading)));
+        }
+        break;
+    }
+    for(auto& camera:cameras_) camera.reset(0); // 0043c5d0 at level start
+    PrepareDoors(section);
+    for(const auto& r:section.declarations) if(r.token=="TELEPHONE") {
+        int id=0,cellX=0,cellY=0,cellZ=0; std::optional<glm::vec3> pos;
+        // 0043d3c0: the phone object stands at the cell centre.
+        if(Tuple(r,cellX,cellY,cellZ) && DeclarationPosition(r))
+            pos=EnginePosition(cellX*64+32,cellY*64+32,cellZ*64-1); // 00478790: (z<<16)-1
+        if(!integer(r.label,id) || !pos) {Once("bad-phone","Invalid telephone declaration"); continue;}
+        int facing=0;
+        if(r.operands.size()>1) integer(r.operands[1],facing);
+        Phone phone{*pos,facing,0};
+        // Existing gta_objects.json identifies style object #40 as phone.
+        if(gGameMap.IsLoaded() && gGameMap.mStyleData.IsLoaded())
+            for(auto& desc:gGameMap.mStyleData.mObjects) if(desc.mObjectType==40) {
+                if(auto* object=gGameObjectsManager.CreateDecoration(*pos,
+                    -Convert::Fix16ToAngle(static_cast<unsigned short>(facing)),&desc)) {
+                    object->SetLifeDuration(0); phone.object=object->mObjectID;
+                    if(!desc.mAnimationData.mFrames.empty()) phone.baseSprite=desc.mAnimationData.mFrames.front().mSprite;
+                    object->SetStaticSprite(phone.baseSprite);
+                    ownedObjects_.insert(phone.object);
+                }
+                break;
+            }
+        if(!phone.object) Once("phone-style","Phone style object #40 unavailable; anchor retained");
+        phones_.emplace(id,phone);
+    }
+
+}
+void CarnageMissionWorld::Reset() {
+    for(const auto& entry:doors_) {
+        const auto& d=entry.second; int x=d.x+(d.direction==1),y=d.y+(d.direction==3),z=INVERT_MAP_LAYER(d.z);
+        int a=d.direction<2?0:2;
+        gGameMap.ClearRuntimeFace(x,y,z,static_cast<eBlockFace>(a));
+        gGameMap.ClearRuntimeFace(x,y,z,static_cast<eBlockFace>(a+1));
+    }
+    for(const auto& saved:savedDoorBlocks_) {
+        auto [x,y,z]=saved.first; gGameMap.SetBlockInfo(x,y,z,saved.second);
+    }
+    enabledDoors_.clear(); animatingDoors_.clear(); doors_.clear(); doorOrder_.clear(); doorSlots_.clear(); savedDoorBlocks_.clear(); rectangles_={};
+    for(auto id:ownedObjects_) if(auto* object=gGameObjectsManager.GetGameObjectByID(id)) object->MarkForDeletion();
+    parkCars_={}; parkRemovals_.clear(); bombs_.clear(); pedOffscreen_.clear(); kfLockedCars_.clear(); pedControllers_.clear(); aimCounter_=aimSide_=0; scriptPeds_.clear(); doorUpdateUnresolved_=false;
+    for(int owner=0;owner<4;++owner) if(auto* human=player(owner)) human->mEnterExitFrozen=false;
+    playerBindings_.clear(); carRecords_.clear(); carRemaps_.clear(); briefKeys_={}; pickups_={}; ownedObjects_.clear(); missionEntities_.clear(); phones_.clear(); soundPhones_.fill(-1); arrows_={}; logged_.clear();
+}
+void CarnageMissionWorld::Update(float dt) {
+    if(!std::isfinite(dt) || dt<0) return;
+    UpdateScriptPeds();
+    UpdateDoors();
+    UpdateCameras();
+    UpdateBombs();
+    UpdatePedOffscreen();
+    // 00401280 -> 00445580 -> 0040b660: a parked car leaves the world when
+    // its timer runs out.
+    for(auto it=parkRemovals_.begin();it!=parkRemovals_.end();) {
+        if(--it->second>0) {++it; continue;}
+        if(auto* object=gGameObjectsManager.GetGameObjectByID(it->first)) if(!object->IsMarkedForDeletion()) {
+            if(object->mClassID==eGameObjectClass_Car)
+                for(auto* occupant:static_cast<Vehicle*>(object)->mPassengers) if(occupant && !occupant->IsHumanPlayerCharacter()) occupant->MarkForDeletion();
+            object->MarkForDeletion();
+        }
+        ownedObjects_.erase(it->first); missionEntities_.erase(it->first);
+        it=parkRemovals_.erase(it);
+    }
+    // MissionSession dispatches this at25Hz. 00464880 decrements once/update.
+    for(int owner=0;owner<4;++owner) if(auto* h=player(owner)) if(auto* ped=h->mCharacter)
+        if(ped->mOriginalWeaponsEnabled) {
+            ped->mOriginalWeapons.tick(); ped->SyncOriginalWeapons();
+        }
+    UpdatePickups();
+    // Original combo/VM timers are update counts, not seconds.
+    for(int i=0;i<4;++i) if(player(i)) economy_.tickCombo(i);
+}
+bool CarnageMissionWorld::CleanupScriptWorld() {
+    // Script cars and objects of records without a prefix leave the world
+    // unless a participant's original screen holds them: cars within the
+    // rectangle widened by its half-width (0040acd0), objects inside it and
+    // away from the map edge (0044c2f0). Survivors stay listed for the next
+    // cleanup.
+    bool resolved=true;
+    for(auto it=missionEntities_.begin();it!=missionEntities_.end();) {
+        auto* object=gGameObjectsManager.GetGameObjectByID(*it);
+        if(!object || object->IsMarkedForDeletion()) {ownedObjects_.erase(*it); it=missionEntities_.erase(it); continue;}
+        const auto& at=object->mTransform.mPosition;
+        const bool car=object->mClassID==eGameObjectClass_Car;
+        if(object->mClassID==eGameObjectClass_Pedestrian || !std::isfinite(at.x) || !std::isfinite(at.z)) {
+            // 0043cfe0: unless it has been off screen for 30 checks the ped
+            // simply stops being a script ped and joins the ambient crowd.
+            if(object->mClassID==eGameObjectClass_Pedestrian && std::isfinite(at.x) && std::isfinite(at.z)) {
+                // 0043cfe0: a ped 00453540 still counts as seen becomes an ordinary
+                // ped (objective 0x19, state 1); otherwise 00477320 removes it.
+                auto* ped=static_cast<Pedestrian*>(object);
+                if(ped->IsDead() || ped->IsDies()) {it=missionEntities_.erase(it); continue;} // 00477320 keeps states 0xc/0x17
+                if(ped->mCurrentCar || ped->IsEnteringOrExitingCar()) {
+                    Once("cleanup-ped-car","UNRESOLVED script ped cleanup for a seated ped (00477320 car states 6/7)");
+                    resolved=false; ++it; continue;
+                }
+                bool known=true;
+                const bool seen=PedOnScreen(*ped,known);
+                if(!known) {resolved=false; ++it; continue;}
+                // The counter grows by one or two per update; RESET adds one and
+                // compares with 30, so it is certain only outside 15..28 unseen updates.
+                const int unseen=seen?0:pedOffscreen_[ped->mObjectID];
+                const bool nearEdge=Convert::MetersToMapUnits(at.x)*64<0x10 || Convert::MetersToMapUnits(at.z)*64<0x10 ||
+                                    Convert::MetersToMapUnits(at.x)*64>=0x3ff0 || Convert::MetersToMapUnits(at.z)*64>=0x3ff0;
+                if(!nearEdge && unseen>=15 && unseen<=28) {
+                    Once("cleanup-ped-count","UNRESOLVED script ped cleanup: off-screen count between 15 and 28 updates");
+                    resolved=false; ++it; continue;
+                }
+                if(nearEdge || unseen>=29) ped->MarkForDeletion();
+                else {
+                    ped->mObjectFlags=(ped->mObjectFlags | GameObjectFlags_Traffic);
+                    ped->mMissionMoveEnabled=false;
+                    scriptPeds_.erase(ped->mObjectID);
+                }
+                pedOffscreen_.erase(ped->mObjectID);
+                ownedObjects_.erase(*it); it=missionEntities_.erase(it); continue;
+            }
+            if(object->mClassID==eGameObjectClass_Pedestrian) {resolved=false; ++it; continue;}
+            object->mObjectFlags=(object->mObjectFlags | GameObjectFlags_Traffic);
+            ownedObjects_.erase(*it); it=missionEntities_.erase(it); continue;
+        }
+        const int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x)*64));
+        const int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z)*64));
+        bool keep=false;
+        for(int owner=0;owner<4;++owner) {
+            auto* human=player(owner);
+            if(!human || !human->mCharacter) continue;
+            if(!rectangles_[owner]) {resolved=false; keep=true; continue;}
+            const auto& screen=*rectangles_[owner];
+            if(car?screen.nearScreen(x,y):(screen.contains(x,y) && x>0xf && y>0xf && x<0x3ff1 && y<0x3ff1)) keep=true;
+        }
+        if(keep) {++it; continue;}
+        if(car) {
+            // 004773a0 also keeps a car with word +0xfe set or flag +0x244;
+            // neither has an engine source, and a participant's own car is
+            // always inside the widened rectangle.
+            auto* vehicle=static_cast<Vehicle*>(object);
+            bool human=false;
+            for(auto* occupant:vehicle->mPassengers) if(occupant && occupant->IsHumanPlayerCharacter()) human=true;
+            if(human) {++it; continue;}
+            for(auto* occupant:vehicle->mPassengers) if(occupant) occupant->MarkForDeletion();
+            carRecords_.erase(vehicle->mObjectID);
+        }
+        object->MarkForDeletion();
+        ownedObjects_.erase(*it); it=missionEntities_.erase(it);
+    }
+    // 004745c0: doors of records without a prefix are shut and switched off.
+    bool doorsChanged=false;
+    for(int id:doorOrder_) {
+        auto& door=doors_.at(id);
+        if(door.permanent) continue;
+        if(door.state!=1 || !door.disabled || !door.solid) doorsChanged=true;
+        door.state=1; door.frame=door.counter=0; door.solid=true; door.disabled=true;
+        CopyDoorFrame(door);
+    }
+    if(doorsChanged) {
+        enabledDoors_.clear(); animatingDoors_.clear();
+        for(int id:doorOrder_) {
+            auto& d=doors_.at(id);
+            if(!d.disabled) enabledDoors_.push_back(&d);
+            if(d.state==2 || d.state==3) animatingDoors_.push_back(&d);
+        }
+    }
+    arrows_={}; // 00481a00
+    if(!resolved) Once("cleanup-view","Script world cleanup incomplete: an entity has no recovered rule");
+    return resolved;
+}
+bool CarnageMissionWorld::PedOnScreen(const GameObject& ped, bool& known) const {
+    // 00453540: the ped's pixel position inside a player's screen rectangle, away from the map edge.
+    known=true;
+    const auto& at=ped.mTransform.mPosition;
+    const int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x)*64));
+    const int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z)*64));
+    for(int owner=0;owner<4;++owner) {
+        auto* human=player(owner);
+        if(!human || !human->mCharacter) continue;
+        if(!rectangles_[owner]) {known=false; continue;}
+        if(rectangles_[owner]->contains(x,y) && x>0xf && y>0xf && x<0x3ff1 && y<0x3ff1) return true;
+    }
+    return false;
+}
+void CarnageMissionWorld::UpdatePedOffscreen() {
+    // The ped update (0045a3b0) calls 00453540 once, sometimes twice, per update:
+    // a visible ped resets the counter, an unseen one counts up.
+    for(auto id:missionEntities_) {
+        auto* object=gGameObjectsManager.GetGameObjectByID(id);
+        if(!object || object->IsMarkedForDeletion() || object->mClassID!=eGameObjectClass_Pedestrian) continue;
+        bool known=true;
+        int& count=pedOffscreen_[id];
+        if(PedOnScreen(*object,known)) count=0;
+        else if(count<1000) ++count;
+    }
+}
+void CarnageMissionWorld::UpdateBombs() {
+    // 0040adc0: only an active car advances its bomb. A car is active when a
+    // player's widened screen rectangle holds it or it is in use (state+4);
+    // the flags +0xec, +0x116 and +0xca are not represented.
+    for(auto it=bombs_.begin();it!=bombs_.end();) {
+        auto* object=gGameObjectsManager.GetGameObjectByID(it->first);
+        if(!object || object->IsMarkedForDeletion() || !object->IsVehicleClass()) {it=bombs_.erase(it); continue;}
+        auto* car=static_cast<Vehicle*>(object);
+        const auto at=car->mTransform.mPosition;
+        const int x=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x)*64));
+        const int y=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z)*64));
+        bool active=car->GetCarDriver()!=nullptr;
+        for(int owner=0;owner<4 && !active;++owner) {
+            auto* human=player(owner);
+            if(!human || !human->mCharacter || !rectangles_[owner]) continue;
+            active=rectangles_[owner]->nearScreen(x,y);
+        }
+        if(!active || it->second.mode!=2) {++it; continue;}
+        // Mode 2: the old timer is compared with 0, then decremented; the
+        // first step to 124 announces the bomb (00478b00, text bomb_set).
+        const int old=it->second.timer--;
+        if(old==0) {
+            // 00425480: an explosion at the car and one at each corner, 8 pixels higher.
+            const float angle=car->mTransform.mOrientation.to_radians();
+            const glm::vec3 forward(std::cos(angle),0.0f,std::sin(angle)),side(-forward.z,0.0f,forward.x);
+            const float length=car->mCarInfo->mDimensions.z*0.5f,width=car->mCarInfo->mDimensions.x*0.5f;
+            gGameObjectsManager.CreateExplosion(nullptr,nullptr,eExplosionType_Rocket,at);
+            for(int corner=0;corner<4;++corner) {
+                glm::vec3 point=at+forward*((corner&1)?length:-length)+side*((corner&2)?width:-width);
+                point.y+=Convert::MapUnitsToMeters(8.0f/64.0f);
+                gGameObjectsManager.CreateExplosion(nullptr,nullptr,eExplosionType_Rocket,point);
+            }
+            Once("bomb-corners","Car bomb corner blasts use the engine car rectangle (00434300 not recovered); killer credit not represented");
+            it=bombs_.erase(it); continue;
+        }
+        if(it->second.timer==0x7c) {
+            if(auto* human=player(0)) human->mHUD.ShowMissionText(gGameTexts.GetText("bomb_set"), hud::briefingArea("ARMEDMESS"));
+            Once("bomb-set-text","bomb_set text is shown without its seconds value (0047d9a0 formatting not recovered)");
+        }
+        ++it;
+    }
+}
+void CarnageMissionWorld::UpdateCameras() {
+    for(int owner=0;owner<4;++owner) {
+        auto* human=player(owner); auto* ped=human?human->mCharacter:nullptr;
+        if(!ped || ped->IsMarkedForDeletion()) {rectangles_[owner].reset(); continue;}
+        // 00462ef0: a seated participant is located by the car.
+        const GameObject* subject=ped;
+        if(ped->mCurrentCar) subject=ped->mCurrentCar;
+        const auto& at=subject->mTransform.mPosition;
+        if(!std::isfinite(at.x) || !std::isfinite(at.y) || !std::isfinite(at.z)) continue;
+        OriginalCamera::Subject s;
+        s.x=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.x)*64));
+        s.y=static_cast<int>(std::floor(Convert::MetersToMapUnits(at.z)*64));
+        s.z=static_cast<int>(std::lround(MAP_LAYERS_COUNT*64-1-Convert::MetersToMapUnits(at.y)*64));
+        s.onFoot=ped->mCurrentCar==nullptr;
+        if(!s.onFoot) {
+            // The follow reads the car's speed word. Its unit is taken as
+            // pixels per 25 Hz update (the scripted PARK speeds 5 and 10 are
+            // a slow roll at that scale); the engine speed is converted
+            // accordingly. On foot the follow floors the word at 8, which
+            // makes the walking case exact.
+            auto* car=ped->mCurrentCar;
+            const float cellsPerSecond=Convert::MetersToMapUnits(car->GetCurrentSpeed());
+            s.speed=static_cast<int>(std::lround(cellsPerSecond*64/25));
+            s.heading=static_cast<int>(std::lround((90-car->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+            Once("camera-speed","Original camera: car speed word projected from engine speed; 00405920 triple-speed cars and held states unmapped");
+        }
+        cameras_[owner].update(s);
+        rectangles_[owner]=originalRectangle(cameras_[owner].view());
+    }
+}
+void CarnageMissionWorld::UpdatePickups() {
+    if(std::none_of(pickups_.begin(),pickups_.end(),[](const Pickup& p){return p.object!=0;})) return;
+    // Other scene objects only matter to the original contact arbitration
+    // when they touch the participant too. Collect the map obstacles once;
+    // a participant within a cell of one is skipped for this update.
+    auto& obstacles=pickupObstacles_; obstacles.clear();
+    for(auto* o:gGameObjectsManager.mAllObjects) {
+        if(o->IsMarkedForDeletion() || o->mClassID!=eGameObjectClass_Obstacle || ownedObjects_.count(o->mObjectID)) continue;
+        obstacles.emplace_back(Convert::MetersToMapUnits(o->mTransform.mPosition.x),Convert::MetersToMapUnits(o->mTransform.mPosition.z));
+    }
+    // 00464440 enumerates participants by registered ped handle, not ped AI type.
+    // Stable standing/walking and seated driver are engine state projections.
+    // Entry/exit, falling and passenger modes have no proved original mapping.
+    for(int owner=0;owner<4;++owner) {
+        auto* human=player(owner); auto* ped=human?human->mCharacter:nullptr;
+        if(!ped || ped->IsMarkedForDeletion() || ped->IsDead()) continue;
+        if(ped->IsEnteringOrExitingCar()) {
+            if(std::any_of(pickups_.begin(),pickups_.end(),[](const Pickup& p){return p.object!=0;}))
+                Once("pickup-transition","Unresolved pickup participant mapping during vehicle transition");
+            continue;
+        }
+        GameObject* participant=ped; int w=4,d=4,a=0;
+        if(ped->mCurrentCar) {
+            if(!ped->IsCarDriver() || ped->mCurrentCar->GetCarDriver()!=ped) {
+                Once("pickup-passenger","Unresolved pickup participant mode for passengers"); continue;
+            }
+            auto* car=ped->mCurrentCar;
+            if(car->IsMarkedForDeletion() || car->IsWrecked()) continue;
+            if(car->mPhysicsBody && (car->mPhysicsBody->GetLinearVelocity()!=glm::vec2(0) ||
+               car->mPhysicsBody->GetAngularVelocity().to_degrees()!=0)) {
+                Once("pickup-car-motion","Unresolved original vehicle predicted contact transform while moving"); continue;
+            }
+            participant=car;
+            w=Convert::MetersToPixels(car->mCarInfo->mDimensions.x)/2;
+            d=Convert::MetersToPixels(car->mCarInfo->mDimensions.z)/2;
+            a=static_cast<int>(std::lround((90-car->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+        } else if(!ped->IsStanding() && !ped->IsWalking()) continue;
+        auto pos=participant->mTransform.mPosition;
+        if(!std::isfinite(pos.x) || !std::isfinite(pos.y) || !std::isfinite(pos.z)) continue;
+        {
+            const glm::vec2 here(Convert::MetersToMapUnits(pos.x),Convert::MetersToMapUnits(pos.z));
+            bool crowded=false;
+            for(const auto& obstacle:obstacles) if(std::abs(obstacle.x-here.x)<1.0f && std::abs(obstacle.y-here.y)<1.0f) crowded=true;
+            if(crowded) {Once("pickup-scene","Pickup contact next to a map obstacle: original object arbitration unresolved");continue;}
+        }
+        auto x=std::llround(Convert::MetersToMapUnits(pos.x)*pickup::cell);
+        auto y=std::llround(Convert::MetersToMapUnits(pos.z)*pickup::cell);
+        auto z=std::llround((MAP_LAYERS_COUNT-1.0/64-Convert::MetersToMapUnits(pos.y))*pickup::cell);
+        if(x<0 || y<0 || x>=256*pickup::cell || y>=256*pickup::cell || z<0 || z>MAP_LAYERS_COUNT*pickup::cell) continue;
+        const auto query=pickup::box(x,y,z,w,d,a);
+        // Pickups several cells away cannot be in contact.
+        auto distant=[&](const pickup::Box& shape) {
+            return std::llabs(shape.p[4].x-x)>4*pickup::cell || std::llabs(shape.p[4].y-y)>4*pickup::cell;
+        };
+        if(participant==ped) {
+            // 0045a3b0 gives vehicle contacts priority over the object query.
+            bool carContact=false;
+            for(auto* car:gGameObjectsManager.mVehiclesList) {
+                if(car->IsMarkedForDeletion()) continue;
+                const auto& at=car->mTransform.mPosition;
+                if(!std::isfinite(at.x) || !std::isfinite(at.y) || !std::isfinite(at.z)) {carContact=true;break;}
+                // Far cars cannot touch: skip their box arithmetic.
+                if(std::abs(at.x-pos.x)>Convert::MapUnitsToMeters(4.0f) || std::abs(at.z-pos.z)>Convert::MapUnitsToMeters(4.0f)) continue;
+                auto cx=std::llround(Convert::MetersToMapUnits(at.x)*pickup::cell);
+                auto cy=std::llround(Convert::MetersToMapUnits(at.z)*pickup::cell);
+                auto cz=std::llround((MAP_LAYERS_COUNT-1.0/64-Convert::MetersToMapUnits(at.y))*pickup::cell);
+                int cw=Convert::MetersToPixels(car->mCarInfo->mDimensions.x)/2;
+                int cd=Convert::MetersToPixels(car->mCarInfo->mDimensions.z)/2;
+                int ca=static_cast<int>(std::lround((90-car->mTransform.mOrientation.to_degrees())*1024/360))&1023;
+                if(pickup::contact(query,pickup::box(cx,cy,cz,cw,cd,ca),cd)) {carContact=true;break;}
+            }
+            if(carContact) continue;
+            int count=0;
+            for(const auto& candidate:pickups_) if(candidate.object)
+                if(auto* o=gGameObjectsManager.GetGameObjectByID(candidate.object))
+                    if(!o->IsMarkedForDeletion() && !distant(candidate.shape) && pickup::contact(query,candidate.shape,candidate.depth)) ++count;
+            if(count>1) {Once("pickup-order","Unresolved original object ordering for overlapping ped pickups");continue;}
+        }
+        for(auto& entry:pickups_) {
+            auto* object=gGameObjectsManager.GetGameObjectByID(entry.object);
+            if(!entry.object || !object || object->IsMarkedForDeletion()) continue;
+            if(distant(entry.shape) || !pickup::contact(query,entry.shape,entry.depth)) continue;
+            // 0046a560: a held jail-free card rejects collection BEFORE removal.
+            if(entry.type==12 && economy_.state(owner).skipPenaltyOnce) continue;
+            std::string key;
+            switch(entry.type) {
+            case 1: case 2: case 3: case 4: {
+                ped->EnableOriginalWeapons();
+                if(!ped->mOriginalWeapons.collect(entry.type,entry.help)) continue;
+                ped->SyncOriginalWeapons();
+                static const char* keys[]={"","pistol","machine-gun","rocket","flame"};
+                key=keys[entry.type];
+                if(entry.help>=100) Once("frenzy-midi","Unresolved original MIDI cue3; not a level sample index");
+                break;
+            }
+            case 10:
+                if(ped->mArmorHitPoints==3) continue;
+                ped->mArmorHitPoints=3; key="armour"; break;
+            case 9:
+                // Associated participants share this ped, not every local owner.
+                for(int other=0;other<4;++other) if(auto* h=player(other))
+                    if(h->mCharacter==ped) {economy_.clearWanted(other); h->SetWantedLevel(0);}
+                key="bribe"; break;
+            case 15:
+                economy_.addLife(owner); key="life+";
+                Once("life-midi","Unresolved original MIDI cue11; not a level sample index"); break;
+            case 11: economy_.incrementMultiplier(owner); key="multiplier+"; break;
+            case 12: economy_.state(owner).skipPenaltyOnce=true; key="jail-free"; break;
+            case 13: economy_.addLife(owner); key="life+"; break;
+            case 14: key="help"+std::to_string(entry.help); break;
+            case 6: case 7: case 8:
+                // 0046a560: car_speed (0040c0c0) or on-foot speed (0044ef60, 375 updates).
+                Once("pickup-speed","Unresolved speed pickup effect; object retained"); continue;
+            default: break; // 0046a560: every other type is only removed, with its sound
+            }
+            if(!key.empty()) {
+                if(entry.type==14) human->mHUD.PushHelpMessage(gGameTexts.GetText(key));
+                else human->mHUD.ShowMissionText(gGameTexts.GetText(key));
+            }
+            // 0046a560: odd nonweapon types use3, even types use4.
+            gAudioManager.StartSound(eSfxSampleType_Level,(entry.type>=1 && entry.type<=4)?2:((entry.type&1)?3:4),SfxFlags_None,object->mTransform.mPosition);
+            object->MarkForDeletion();
+            missionEntities_.erase(entry.object); ownedObjects_.erase(entry.object);
+            entry=Pickup{};
+            if(participant==ped) break; // car contact list can collect multiple objects
+        }
+    }
+}
+void CarnageMissionWorld::postDispatch(int,Process&) {
+    // No fabricated death/arrest/global END or original 004749c0 transition.
+}
