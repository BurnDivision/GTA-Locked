+
+struct GLFWwindow
+{
+    SDL_Window* mSdlWindow = nullptr;
+    SDL_GLContext mContext = nullptr;
+    bool mShouldClose = false;
+};
+struct GLFWmonitor
+{
+    int mDummy = 0;
+};
+
+static GLFWwindow gWindow;
+static GLFWmonitor gMonitor;
+static GLFWerrorfun gErrorCb = nullptr;
+static GLFWmousebuttonfun gMouseButtonCb = nullptr;
+static GLFWkeyfun gKeyCb = nullptr;
+static GLFWcharfun gCharCb = nullptr;
+static GLFWscrollfun gScrollCb = nullptr;
+static GLFWcursorposfun gCursorCb = nullptr;
+static GLFWjoystickfun gJoystickCb = nullptr;
+static SDL_GameController* gPads[GLFW_JOYSTICK_LAST + 1] = {};
+static Uint64 gTimeStart = 0;
+
+static void ReportError(const char* what)
+{
+    SDL_Log("[shim] %s: %s", what, SDL_GetError());
+    if (gErrorCb) gErrorCb(0, SDL_GetError());
+}
+
+//////////////////////////////////////////////////////////////////////////
+// keyboard mapping
+
+static int SdlKeyToGlfw(SDL_Keycode k)
+{
+    if (k >= SDLK_a && k <= SDLK_z) return GLFW_KEY_A + (int)(k - SDLK_a);
+    if (k >= SDLK_0 && k <= SDLK_9) return GLFW_KEY_0 + (int)(k - SDLK_0);
+    if (k >= SDLK_F1 && k <= SDLK_F12) return GLFW_KEY_F1 + (int)(k - SDLK_F1);
+    switch (k)
+    {
+        case SDLK_SPACE: return GLFW_KEY_SPACE;
+        case SDLK_BACKQUOTE: return GLFW_KEY_GRAVE_ACCENT;
+        case SDLK_ESCAPE: return GLFW_KEY_ESCAPE;
+        case SDLK_RETURN: return GLFW_KEY_ENTER;
+        case SDLK_KP_ENTER: return GLFW_KEY_ENTER;
+        case SDLK_TAB: return GLFW_KEY_TAB;
+        case SDLK_BACKSPACE: return GLFW_KEY_BACKSPACE;
+        case SDLK_INSERT: return GLFW_KEY_INSERT;
+        case SDLK_DELETE: return GLFW_KEY_DELETE;
+        case SDLK_RIGHT: return GLFW_KEY_RIGHT;
+        case SDLK_LEFT: return GLFW_KEY_LEFT;
+        case SDLK_DOWN: return GLFW_KEY_DOWN;
+        case SDLK_UP: return GLFW_KEY_UP;
+        case SDLK_PAGEUP: return GLFW_KEY_PAGE_UP;
+        case SDLK_PAGEDOWN: return GLFW_KEY_PAGE_DOWN;
+        case SDLK_HOME: return GLFW_KEY_HOME;
+        case SDLK_END: return GLFW_KEY_END;
+        case SDLK_LSHIFT: return GLFW_KEY_LEFT_SHIFT;
+        case SDLK_RSHIFT: return GLFW_KEY_RIGHT_SHIFT;
+        case SDLK_LCTRL: return GLFW_KEY_LEFT_CONTROL;
+        case SDLK_RCTRL: return GLFW_KEY_RIGHT_CONTROL;
+        default: break;
+    }
+    return -1;
+}
+
+static void EmitKey(int glfwKey, bool pressed)
+{
+    if (gKeyCb && glfwKey >= 0)
+        gKeyCb(&gWindow, glfwKey, 0, pressed ? GLFW_PRESS : GLFW_RELEASE, 0);
+}
+
+//////////////////////////////////////////////////////////////////////////
+// touch controls
+
+namespace touch
+{
+    enum Control
+    {
+        Control_None = -1,
+        Control_DPad = 0,
+        Control_Fire,
+        Control_Car,
+        Control_Jump,
+        Control_Weapon,
+        Control_Horn,
+        Control_Lock,
+        Control_Aspect,
+        Control_COUNT
+    };
+
+    struct Button
+    {
+        float x, y, r;
+        int key;
+        const char* label;
+        float cr, cg, cb;
+    };
+
+    static Button gButtons[Control_COUNT];
+    static float gDPadX = 0, gDPadY = 0, gDPadR = 0;
+    static int gScreenW = 0, gScreenH = 0;
+
+    struct Finger
+    {
+        SDL_FingerID id;
+        int control;
+        float x, y; // pixels
+    };
+    static std::vector<Finger> gFingers;
+
+    // current key state produced by touch
+    enum { K_UP, K_DOWN, K_LEFT, K_RIGHT, K_FIRE, K_CAR, K_JUMP, K_WPN, K_HORN, K_LOCK, K_ASPECT, K_COUNT };
+    static const int gKeyMap[K_COUNT] = {
+        GLFW_KEY_UP, GLFW_KEY_DOWN, GLFW_KEY_LEFT, GLFW_KEY_RIGHT, GLFW_KEY_LEFT_CONTROL,
+        GLFW_KEY_ENTER, GLFW_KEY_SPACE, GLFW_KEY_X, GLFW_KEY_TAB, GLFW_KEY_F9, GLFW_KEY_F7 };
+    static char gAspectLabel[8] = "AUTO"; // set by the engine
+    static char gLockLabel[8] = "LOCK"; // camera mode, set by the engine
+    static int gViewX = 0, gViewY = 0, gViewW = 0, gViewH = 0; // game view rect, set by the engine
+    static bool gKeyState[K_COUNT] = {};
+    static bool gVisible = true;
+    static int gMode = 0; // 0 auto (hidden while a controller is used), 1 always, 2 off
+
+    static void Layout(int w, int h)
+    {
+        gScreenW = w; gScreenH = h;
+        float u = (float)((w < h) ? w : h); // short side
+        float W = (float)w, H = (float)h;
+        // portrait with the game view near the top: size the controls to the space below it
+        if (gViewH > 0 && h > w)
+        {
+            const float bottomBar = (float)(h - (gViewY + gViewH));
+            if (bottomBar > 0.2f * u && bottomBar < 0.42f * u) u = bottomBar / 0.42f;
+        }
+        gDPadR = 0.17f * u;
+        gDPadX = 0.06f * u + gDPadR;
+        gDPadY = H - 0.06f * u - gDPadR;
+
+        float br = 0.075f * u;
+        gButtons[Control_Fire]   = { W - 0.15f * u, H - 0.15f * u, 0.095f * u, K_FIRE, "FIRE", 0.85f, 0.20f, 0.20f };
+        gButtons[Control_Car]    = { W - 0.38f * u, H - 0.12f * u, br, K_CAR,  "CAR",  0.20f, 0.45f, 0.90f };
+        gButtons[Control_Jump]   = { W - 0.15f * u, H - 0.40f * u, br, K_JUMP, "JUMP", 0.20f, 0.75f, 0.30f };
+        gButtons[Control_Weapon] = { W - 0.36f * u, H - 0.34f * u, br * 0.85f, K_WPN, "WPN", 0.90f, 0.75f, 0.15f };
+        gButtons[Control_Horn]   = { W - 0.58f * u, H - 0.10f * u, br * 0.75f, K_HORN, "HORN", 0.60f, 0.60f, 0.60f };
+        gButtons[Control_Lock]   = { W - 0.09f * u, 0.09f * u, br * 0.65f, K_LOCK, gLockLabel, 0.75f, 0.40f, 0.90f };
+        gButtons[Control_Aspect] = { W - 0.09f * u, 0.25f * u, br * 0.65f, K_ASPECT, gAspectLabel, 0.25f, 0.65f, 0.80f };
+
+        // letterboxed view (bars above/below, little room at the sides): put the small
+        // LOCK / aspect buttons in the top bar so they don't cover the HUD
+        const float topBar = (float)gViewY;
+        const float rightBar = (float)(w - (gViewX + gViewW));
+        if (gViewH > 0 && topBar >= 0.05f * u && rightBar < 0.12f * u)
+        {
+            float r = br * 0.65f;
+            if (r > topBar * 0.45f) r = topBar * 0.45f;
+            const float cy = topBar * 0.5f;
+            gButtons[Control_Lock].x = W - 0.04f * u - r;
+            gButtons[Control_Lock].y = cy;
+            gButtons[Control_Lock].r = r;
+            gButtons[Control_Aspect].x = gButtons[Control_Lock].x - 2.6f * r;
+            gButtons[Control_Aspect].y = cy;
+            gButtons[Control_Aspect].r = r;
+        }
+        gButtons[Control_DPad]   = { gDPadX, gDPadY, gDPadR, -1, "", 1, 1, 1 };
+    }
+
+    static int HitTest(float x, float y)
+    {
+        float dx = x - gDPadX, dy = y - gDPadY;
+        if (dx * dx + dy * dy <= (gDPadR * 1.6f) * (gDPadR * 1.6f)) return Control_DPad;
+        for (int i = Control_Fire; i < Control_COUNT; ++i)
+        {
+            const Button& b = gButtons[i];
+            float bx = x - b.x, by = y - b.y;
+            float rr = b.r * 1.35f;
+            if (bx * bx + by * by <= rr * rr) return i;
+        }
+        return Control_None;
+    }
+
+    static void Recompute()
+    {
+        bool desired[K_COUNT] = {};
+        for (const Finger& f : gFingers)
+        {
+            if (f.control == Control_DPad)
+            {
+                float dx = f.x - gDPadX, dy = f.y - gDPadY;
+                float t = gDPadR * 0.35f;
+                if (dy < -t) desired[K_UP] = true;
+                if (dy > t) desired[K_DOWN] = true;
+                if (dx < -t) desired[K_LEFT] = true;
+                if (dx > t) desired[K_RIGHT] = true;
+            }
+            else if (f.control > Control_DPad)
+            {
+                desired[gButtons[f.control].key] = true;
+            }
+        }
+        for (int k = 0; k < K_COUNT; ++k)
+        {
+            if (desired[k] != gKeyState[k])
+            {
+                gKeyState[k] = desired[k];
+                EmitKey(gKeyMap[k], desired[k]);
+            }
+        }
+    }
+
+    static void OnFinger(const SDL_TouchFingerEvent& e, Uint32 type)
+    {
+        if (gMode == 2) return; // on-screen controls switched off
+        gVisible = true;
+        float x = e.x * gScreenW, y = e.y * gScreenH;
+        if (type == SDL_FINGERDOWN)
+        {
+            int c = HitTest(x, y);
+            if (c != Control_None) gFingers.push_back({ e.fingerId, c, x, y });
+        }
+        else
+        {
+            for (size_t i = 0; i < gFingers.size(); ++i)
+            {
+                if (gFingers[i].id != e.fingerId) continue;
+                if (type == SDL_FINGERUP) gFingers.erase(gFingers.begin() + i);
+                else { gFingers[i].x = x; gFingers[i].y = y; }
+                break;
+            }
+        }
+        Recompute();
+    }
+
+    static void ReleaseAll()
+    {
+        gFingers.clear();
+        Recompute();
+    }
+
+    //////////////////////////////////////////////////////////////////////
+    // rendering
+
+    // 5x7 glyphs for the labels used above
+    struct Glyph { char c; unsigned char rows[7]; };
+    static const Glyph gFont[] = {
+        {'A', {0x0E,0x11,0x11,0x1F,0x11,0x11,0x11}}, {'C', {0x0E,0x11,0x10,0x10,0x10,0x11,0x0E}},
+        {'E', {0x1F,0x10,0x10,0x1E,0x10,0x10,0x1F}}, {'F', {0x1F,0x10,0x10,0x1E,0x10,0x10,0x10}},
+        {'H', {0x11,0x11,0x11,0x1F,0x11,0x11,0x11}}, {'I', {0x0E,0x04,0x04,0x04,0x04,0x04,0x0E}},
+        {'J', {0x07,0x02,0x02,0x02,0x02,0x12,0x0C}}, {'K', {0x11,0x12,0x14,0x18,0x14,0x12,0x11}},
+        {'L', {0x10,0x10,0x10,0x10,0x10,0x10,0x1F}}, {'M', {0x11,0x1B,0x15,0x15,0x11,0x11,0x11}},
+        {'N', {0x11,0x11,0x19,0x15,0x13,0x11,0x11}}, {'O', {0x0E,0x11,0x11,0x11,0x11,0x11,0x0E}},
+        {'P', {0x1E,0x11,0x11,0x1E,0x10,0x10,0x10}}, {'R', {0x1E,0x11,0x11,0x1E,0x14,0x12,0x11}},
+        {'U', {0x11,0x11,0x11,0x11,0x11,0x11,0x0E}}, {'W', {0x11,0x11,0x11,0x15,0x15,0x15,0x0A}},
+        {'1', {0x04,0x0C,0x04,0x04,0x04,0x04,0x0E}}, {'3', {0x1F,0x02,0x04,0x02,0x01,0x11,0x0E}},
+        {'4', {0x02,0x06,0x0A,0x12,0x1F,0x02,0x02}}, {'6', {0x06,0x08,0x10,0x1E,0x11,0x11,0x0E}},
+        {'9', {0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C}}, {':', {0x00,0x0C,0x0C,0x00,0x0C,0x0C,0x00}},
+        {'T', {0x1F,0x04,0x04,0x04,0x04,0x04,0x04}},
+    };
+
+    static std::vector<float> gVerts; // x,y,r,g,b,a
+    static GLuint gProgram = 0, gVao = 0, gVbo = 0;
+    static GLint gLocScreen = -1;
+
+    static void Tri(float x0, float y0, float x1, float y1, float x2, float y2, float r, float g, float b, float a)
+    {
+        const float v[] = { x0,y0,r,g,b,a, x1,y1,r,g,b,a, x2,y2,r,g,b,a };
+        gVerts.insert(gVerts.end(), v, v + 18);
+    }
+    static void Quad(float x, float y, float w, float h, float r, float g, float b, float a)
+    {
+        Tri(x, y, x + w, y, x + w, y + h, r, g, b, a);
+        Tri(x, y, x + w, y + h, x, y + h, r, g, b, a);
+    }
+    static void Disc(float cx, float cy, float rad, float r, float g, float b, float a)
+    {
+        const int N = 32;
+        for (int i = 0; i < N; ++i)
+        {
+            float a0 = 6.2831853f * i / N, a1 = 6.2831853f * (i + 1) / N;
+            Tri(cx, cy, cx + cosf(a0) * rad, cy + sinf(a0) * rad, cx + cosf(a1) * rad, cy + sinf(a1) * rad, r, g, b, a);
+        }
+    }
+    static void Ring(float cx, float cy, float rad, float th, float r, float g, float b, float a)
+    {
+        const int N = 40;
+        for (int i = 0; i < N; ++i)
+        {
+            float a0 = 6.2831853f * i / N, a1 = 6.2831853f * (i + 1) / N;
+            float ix0 = cx + cosf(a0) * (rad - th), iy0 = cy + sinf(a0) * (rad - th);
+            float ox0 = cx + cosf(a0) * rad, oy0 = cy + sinf(a0) * rad;
+            float ix1 = cx + cosf(a1) * (rad - th), iy1 = cy + sinf(a1) * (rad - th);
+            float ox1 = cx + cosf(a1) * rad, oy1 = cy + sinf(a1) * rad;
+            Tri(ix0, iy0, ox0, oy0, ox1, oy1, r, g, b, a);
+            Tri(ix0, iy0, ox1, oy1, ix1, iy1, r, g, b, a);
+        }
+    }
+    static void Text(const char* s, float cx, float cy, float px, float a)
+    {
+        int n = (int)strlen(s);
+        float w = (n * 6 - 1) * px, h = 7 * px;
+        float x0 = cx - w * 0.5f, y0 = cy - h * 0.5f;
+        for (int i = 0; i < n; ++i)
+        {
+            const Glyph* gl = nullptr;
+            for (const Glyph& g : gFont) if (g.c == s[i]) { gl = &g; break; }
+            if (!gl) continue;
+            for (int row = 0; row < 7; ++row)
+                for (int col = 0; col < 5; ++col)
+                    if (gl->rows[row] & (0x10 >> col))
+                        Quad(x0 + (i * 6 + col) * px, y0 + row * px, px, px, 1, 1, 1, a);
+        }
+    }
+
+    static GLuint Compile(GLenum type, const char* src)
+    {
+        GLuint s = glCreateShader(type);
+        glShaderSource(s, 1, &src, nullptr);
+        glCompileShader(s);
+        GLint ok = 0;
+        glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+        if (!ok)
+        {
+            char log[512]; glGetShaderInfoLog(s, 512, nullptr, log);
+            SDL_Log("[shim] overlay shader error: %s", log);
+        }
+        return s;
+    }
+
+    static bool InitGL()
+    {
+        const char* vs =
+            "#version 300 es\n"
+            "layout(location=0) in vec2 inPos;\n"
+            "layout(location=1) in vec4 inCol;\n"
+            "uniform vec2 uScreen;\n"
+            "out vec4 vCol;\n"
+            "void main(){ vCol = inCol; gl_Position = vec4(inPos.x / uScreen.x * 2.0 - 1.0, 1.0 - inPos.y / uScreen.y * 2.0, 0.0, 1.0); }\n";
+        const char* fs =
+            "#version 300 es\n"
+            "precision mediump float;\n"
+            "in vec4 vCol; out vec4 outCol;\n"
+            "void main(){ outCol = vCol; }\n";
+        GLuint v = Compile(GL_VERTEX_SHADER, vs), f = Compile(GL_FRAGMENT_SHADER, fs);
+        gProgram = glCreateProgram();
+        glAttachShader(gProgram, v); glAttachShader(gProgram, f);
+        glLinkProgram(gProgram);
+        glDeleteShader(v); glDeleteShader(f);
+        GLint ok = 0; glGetProgramiv(gProgram, GL_LINK_STATUS, &ok);
+        if (!ok) { SDL_Log("[shim] overlay program link failed"); return false; }
+        gLocScreen = glGetUniformLocation(gProgram, "uScreen");
+
+        GLint prevVao = 0, prevBuf = 0;
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuf);
+        glGenVertexArrays(1, &gVao);
+        glGenBuffers(1, &gVbo);
+        glBindVertexArray(gVao);
+        glBindBuffer(GL_ARRAY_BUFFER, gVbo);
+        glEnableVertexAttribArray(0);
+        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 6 * sizeof(float), (void*)0);
+        glEnableVertexAttribArray(1);
+        glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, 6 * sizeof(float), (void*)(2 * sizeof(float)));
+        glBindVertexArray((GLuint)prevVao);
+        glBindBuffer(GL_ARRAY_BUFFER, (GLuint)prevBuf);
+        return true;
+    }
+
+    static void Build()
+    {
+        gVerts.clear();
+        // d-pad
+        Disc(gDPadX, gDPadY, gDPadR, 0, 0, 0, 0.22f);
+        Ring(gDPadX, gDPadY, gDPadR, gDPadR * 0.06f, 1, 1, 1, 0.45f);
+        float s = gDPadR * 0.22f, o = gDPadR * 0.62f;
+        float aU = gKeyState[K_UP] ? 0.9f : 0.5f, aD = gKeyState[K_DOWN] ? 0.9f : 0.5f;
+        float aL = gKeyState[K_LEFT] ? 0.9f : 0.5f, aR = gKeyState[K_RIGHT] ? 0.9f : 0.5f;
+        Tri(gDPadX, gDPadY - o - s, gDPadX - s, gDPadY - o + s * 0.6f, gDPadX + s, gDPadY - o + s * 0.6f, 1, 1, 1, aU);
+        Tri(gDPadX, gDPadY + o + s, gDPadX + s, gDPadY + o - s * 0.6f, gDPadX - s, gDPadY + o - s * 0.6f, 1, 1, 1, aD);
+        Tri(gDPadX - o - s, gDPadY, gDPadX - o + s * 0.6f, gDPadY + s, gDPadX - o + s * 0.6f, gDPadY - s, 1, 1, 1, aL);
+        Tri(gDPadX + o + s, gDPadY, gDPadX + o - s * 0.6f, gDPadY - s, gDPadX + o - s * 0.6f, gDPadY + s, 1, 1, 1, aR);
+        // finger knob on d-pad
+        for (const Finger& f : gFingers)
+        {
+            if (f.control != Control_DPad) continue;
+            float dx = f.x - gDPadX, dy = f.y - gDPadY;
+            float len = sqrtf(dx * dx + dy * dy), mx = gDPadR * 0.8f;
+            if (len > mx) { dx *= mx / len; dy *= mx / len; }
+            Disc(gDPadX + dx, gDPadY + dy, gDPadR * 0.28f, 1, 1, 1, 0.35f);
+        }
+        // buttons
+        for (int i = Control_Fire; i < Control_COUNT; ++i)
+        {
+            const Button& b = gButtons[i];
+            bool down = gKeyState[b.key];
+            Disc(b.x, b.y, b.r, b.cr, b.cg, b.cb, down ? 0.70f : 0.38f);
+            Ring(b.x, b.y, b.r, b.r * 0.08f, 1, 1, 1, 0.55f);
+            float px = (b.r * 1.3f) / (strlen(b.label) * 6.0f);
+            if (px > b.r * 0.13f) px = b.r * 0.13f;
+            Text(b.label, b.x, b.y, px, 0.9f);
+        }
+    }
+
+    static void Draw(int w, int h)
+    {
+        if (!gVisible || gMode == 2) return;
+        if (w != gScreenW || h != gScreenH) Layout(w, h);
+        if (!gProgram && !InitGL()) { gVisible = false; return; }
+        Build();
+        if (gVerts.empty()) return;
+
+        // save state touched by the overlay
+        GLint prevProg = 0, prevVao = 0, prevBuf = 0, vp[4], sc[4];
+        GLint bSrcRGB, bDstRGB, bSrcA, bDstA, bEqRGB, bEqA;
+        GLboolean blend = glIsEnabled(GL_BLEND), depth = glIsEnabled(GL_DEPTH_TEST);
+        GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST), cull = glIsEnabled(GL_CULL_FACE);
+        GLboolean depthMask = GL_TRUE;
+        glGetBooleanv(GL_DEPTH_WRITEMASK, &depthMask);
+        glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuf);
+        glGetIntegerv(GL_VIEWPORT, vp);
+        glGetIntegerv(GL_SCISSOR_BOX, sc);
+        glGetIntegerv(GL_BLEND_SRC_RGB, &bSrcRGB); glGetIntegerv(GL_BLEND_DST_RGB, &bDstRGB);
+        glGetIntegerv(GL_BLEND_SRC_ALPHA, &bSrcA); glGetIntegerv(GL_BLEND_DST_ALPHA, &bDstA);
+        glGetIntegerv(GL_BLEND_EQUATION_RGB, &bEqRGB); glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &bEqA);
+
+        glViewport(0, 0, w, h);
+        glDisable(GL_SCISSOR_TEST);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_CULL_FACE);
+        glDepthMask(GL_FALSE);
+        glEnable(GL_BLEND);
+        glBlendEquation(GL_FUNC_ADD);
+        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+        glUseProgram(gProgram);
+        glUniform2f(gLocScreen, (float)w, (float)h);
+        glBindVertexArray(gVao);
+        glBindBuffer(GL_ARRAY_BUFFER, gVbo);
+        glBufferData(GL_ARRAY_BUFFER, gVerts.size() * sizeof(float), gVerts.data(), GL_STREAM_DRAW);
+        glDrawArrays(GL_TRIANGLES, 0, (GLsizei)(gVerts.size() / 6));
+
+        // restore
+        glBindVertexArray((GLuint)prevVao);
+        glBindBuffer(GL_ARRAY_BUFFER, (GLuint)prevBuf);
+        glUseProgram((GLuint)prevProg);
+        glViewport(vp[0], vp[1], vp[2], vp[3]);
+        glScissor(sc[0], sc[1], sc[2], sc[3]);
+        glBlendEquationSeparate(bEqRGB, bEqA);
+        glBlendFuncSeparate(bSrcRGB, bDstRGB, bSrcA, bDstA);
+        glDepthMask(depthMask);
+        if (blend) glEnable(GL_BLEND); else glDisable(GL_BLEND);
+        if (depth) glEnable(GL_DEPTH_TEST); else glDisable(GL_DEPTH_TEST);
+        if (scissor) glEnable(GL_SCISSOR_TEST); else glDisable(GL_SCISSOR_TEST);
+        if (cull) glEnable(GL_CULL_FACE); else glDisable(GL_CULL_FACE);
+    }
+} // namespace touch
