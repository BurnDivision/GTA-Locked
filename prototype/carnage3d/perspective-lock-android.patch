new file mode 100755
index 0000000..720f84a
--- /dev/null
+++ b/tests/check_controls.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Run native controls tests against an existing Linux CMake engine build.
+Usage: python3 tests/check_controls.py /path/to/build [dependency-prefix]
+All binaries and configuration fixtures go into an automatically removed temp dir.
+"""
+from pathlib import Path
+import os
+import shlex
+import subprocess
+import sys
+import tempfile
+
+engine = Path(__file__).resolve().parents[1]
+build = Path(sys.argv[1]).resolve()
+deps = Path(sys.argv[2] if len(sys.argv)>2 else '/home/codebox/.local/c3d-deps/root/usr')
+cxx = os.environ.get('CXX', 'g++')
+
+def run(args, **kwargs):
+    subprocess.run(list(map(str, args)), check=True, **kwargs)
+
+with tempfile.TemporaryDirectory(prefix='controls-tests-') as directory:
+    work = Path(directory)
+    flags = [cxx,'-std=c++17','-O0','-Wno-deprecated-declarations','-iquote',engine/'src',
+             '-I'+str(engine/'third_party/Box2D/include'),'-I'+str(deps/'include')]
+    run(flags+['-Wall','-Wextra','-Werror',engine/'tests/controls_rules_test.cpp','-o',work/'rules'])
+    run([work/'rules'])
+    run(flags+['-ffunction-sections','-fdata-sections',engine/'tests/input_mapping_test.cpp']+
+        [engine/'src'/name for name in ['InputActionsMapping.cpp','json_document.cpp','cJSON.cpp','enums_impl.cpp']]+
+        ['-Wl,--gc-sections','-o',work/'mapping'])
+    run([work/'mapping'])
+    run(flags+['-c',engine/'tests/controls_menu_test.cpp','-o',work/'menu.o'])
+    args=shlex.split((build/'CMakeFiles/carnage3d.dir/link.txt').read_text())
+    args=[str(work/'menu.o') if a=='CMakeFiles/carnage3d.dir/src/Main.cpp.o' else a for a in args]
+    args[args.index('-o')+1]=str(work/'menu')
+    run(args,cwd=build)
+    (work/'fixture/config').mkdir(parents=True)
+    (work/'fixture/config/inputs.json.default').write_bytes((engine/'gamedata/config/inputs.json.default').read_bytes())
+    run([work/'menu',work/'fixture'])
diff --git a/tests/controls_menu_test.cpp b/tests/controls_menu_test.cpp
new file mode 100755
index 0000000..3074f32
--- /dev/null
+++ b/tests/controls_menu_test.cpp
@@ -0,0 +1,89 @@
+#include "stdafx.h"
+#define private public
+#include "MainMenuGamestate.h"
+#include "CarnageGame.h"
+#include "HumanPlayer.h"
+#undef private
+#include "Pedestrian.h"
+#include "InputsManager.h"
+#include "HumanPlayer.h"
+#include <cassert>
+#include <filesystem>
+int main(int argc,char** argv) {
+    assert(argc==2);
+    const std::string dir=argv[1];
+    std::filesystem::create_directories(dir+"/config");
+    gFiles.mWorkingDirectoryPath=dir;
+    gFiles.mSearchPlaces={dir};
+    MainMenuGamestate menu;
+    menu.mReady=true;
+    menu.LoadControls();
+    assert(menu.mControlsWritable && menu.mDefaultsReady);
+    menu.mMenu.page=frontend::Page::Options;menu.mMenu.row=5;
+    menu.Act(frontend::Action::Accept);
+    assert(menu.mMenu.page==frontend::Page::Controls);
+    // No controller: accept gives notice without capturing.
+    menu.Act(frontend::Action::Accept);
+    assert(!menu.mCapture.active && !menu.mControlsNotice.empty());
+    gInputs.mGamepadsState[0].mPresent=true;
+    menu.Act(frontend::Action::Accept);
+    assert(menu.mCapture.active);
+    KeyInputEvent escape;escape.mKeycode=eKeycode_ESCAPE;escape.mPressed=true;
+    menu.OnGamestateInputEvent(escape);assert(!menu.mCapture.active);
+    menu.Act(frontend::Action::Up);assert(menu.mMenu.row==20);
+    menu.Act(frontend::Action::Down);assert(menu.mMenu.row==0);
+    menu.Act(frontend::Action::Accept);assert(menu.mCapture.active);
+    GamepadInputEvent back(0,eGamepadButton_B,true);menu.OnGamestateInputEvent(back);
+    assert(!menu.mCapture.active && menu.mMenu.page==frontend::Page::Controls);
+    // Jump row (third): A starts capture, its repeated press must not assign.
+    menu.mMenu.row=2;
+    GamepadInputEvent a;a.mGamepad=eGamepadID_Gamepad1;a.mButton=eGamepadButton_A;a.mPressed=true;
+    gInputs.mGamepadsState[0].mButtons[eGamepadButton_A]=true;
+    menu.OnGamestateInputEvent(a);assert(menu.mCapture.active);
+    menu.OnGamestateInputEvent(a);assert(menu.mCapture.active);
+    GamepadInputEvent trigger;trigger.mGamepad=eGamepadID_Gamepad1;
+    trigger.mButton=eGamepadButton_RightTrigger;trigger.mPressed=true;
+    menu.OnGamestateInputEvent(trigger);assert(!menu.mCapture.active);
+    assert(menu.mControlsMapping.mActionToKeys[eInputAction_Jump].mGpButton==eGamepadButton_RightTrigger);
+    assert(menu.mControlsMapping.mActionToKeys[eInputAction_Shoot].mGpButton==eGamepadButton_A);
+    assert(menu.mControlsMapping.mActionToKeys[eInputAction_Horn].mGpButton==eGamepadButton_B);
+    // Reload proves the actual menu save path, without a game restart.
+    MainMenuGamestate reloaded;reloaded.LoadControls();
+    assert(reloaded.mControlsMapping.mActionToKeys[eInputAction_Jump].mGpButton==eGamepadButton_RightTrigger);
+    menu.mMenu.row=20;menu.Act(frontend::Action::Accept);
+    assert(menu.mControlsMapping.mActionToKeys[eInputAction_Jump].mGpButton==eGamepadButton_A);
+    // Failed writes keep the running mapping unchanged.
+    gFiles.mWorkingDirectoryPath=dir+"/missing";
+    const auto before=menu.mControlsMapping;
+    auto changed=before;changed.AssignGamepadButton(eInputAction_Jump,eGamepadButton_X);
+    assert(!menu.SaveControls(changed));
+    assert(menu.mControlsMapping.mActionToKeys[eInputAction_Jump].mGpButton==eGamepadButton_A);
+    // Rebinding movement must affect the actual twin-stick control path.
+    Pedestrian pedestrian(1,ePedestrianType_Player1);
+    HumanPlayer human(nullptr);human.AssignCharacter(&pedestrian);
+    human.mActionsMapping=reloaded.mControlsMapping;
+    human.mGamepadActive=true;
+    human.mViewCamera.mUpDirection=glm::vec3(0,0,-1);human.mViewCamera.mRightDirection=glm::vec3(1,0,0);
+    std::fill_n(gInputs.mGamepadsState[0].mButtons,eGamepadButton_COUNT,false);
+    gInputs.mGamepadsState[0].mButtons[eGamepadButton_X]=true;
+    human.mActionsMapping.AssignGamepadButton(eInputAction_Run,eGamepadButton_X);
+    human.mCtlState.Clear();assert(human.ProcessTwinStick());
+    assert(human.mTestScript.mMoving);
+    gInputs.mGamepadsState[0].mButtons[eGamepadButton_X]=false;
+    gInputs.mGamepadsState[0].mButtons[eGamepadButton_DPAD_Up]=true;
+    human.mCtlState.Clear();assert(human.ProcessTwinStick());
+    assert(!human.mTestScript.mMoving);
+    // Saving updates an existing HumanPlayer immediately and clears held actions.
+    gFiles.mWorkingDirectoryPath=dir;gCarnageGame.mHumanPlayers[0]=&human;
+    assert(menu.SaveControls(changed));
+    assert(human.mActionsMapping.mActionToKeys[eInputAction_Jump].mGpButton==eGamepadButton_X);
+    gCarnageGame.mHumanPlayers[0]=nullptr;
+    human.AssignCharacter(nullptr);
+    // Invalid JSON cannot overwrite user configuration.
+    {std::ofstream broken(dir+"/config/inputs.json");broken<<"{broken";}
+    MainMenuGamestate invalid;invalid.LoadControls();
+    assert(!invalid.mControlsWritable && !invalid.SaveControls(changed));
+    {std::ifstream in(dir+"/config/inputs.json");std::string data;std::getline(in,data);assert(data=="{broken");}
+    menu.mReady=false; // no graphics/resources were created
+    std::cout<<"controls menu capture/persistence PASS\n";
+}
diff --git a/tests/controls_rules_test.cpp b/tests/controls_rules_test.cpp
new file mode 100755
index 0000000..c2dbf70
--- /dev/null
+++ b/tests/controls_rules_test.cpp
@@ -0,0 +1,47 @@
+#include "ControlsRules.h"
+#include "Frontend.h"
+#include <cassert>
+#include <iostream>
+int main() {
+    // A same-group conflict swaps; other groups using that button are untouched.
+    std::array<int,5> buttons{{1,2,0,2,3}}, groups{{0,0,0,1,1}};
+    assert(controls::assign(buttons,groups,0,2));
+    assert((buttons==std::array<int,5>{{2,1,0,2,3}}));
+    // Assign to an unused button clears the old assignment; unbound swap stays unbound.
+    assert(controls::assign(buttons,groups,0,4));
+    assert((buttons==std::array<int,5>{{4,1,0,2,3}}));
+    assert(controls::assign(buttons,groups,2,1));
+    assert((buttons==std::array<int,5>{{4,0,1,2,3}}));
+    const auto before=buttons;
+    assert(!controls::assign(buttons,groups,2,1));
+    assert(!controls::assign(buttons,groups,5,2));
+    assert(!controls::assign(buttons,groups,0,0));
+    assert(buttons==before);
+    // Defaults restore only gamepad buttons, including unassigned entries.
+    const std::array<int,5> defaults{{1,2,0,2,3}};
+    controls::restore(buttons,defaults);
+    assert(buttons==defaults);
+    // The initiating/held button cannot bind until released; other pads cannot bind.
+    controls::Capture capture;
+    std::array<bool,18> held{};held[1]=true;
+    capture.begin(0,held);
+    assert(!capture.press(0,1));
+    capture.release(0,1);
+    assert(!capture.press(1,17));
+    assert(capture.press(0,17)); // trigger button
+    assert(!capture.active);
+    capture.begin(0,held);capture.cancel();
+    assert(!capture.press(0,2));
+    // Controls is a sixth options row, returning to options without discarding edits.
+    frontend::Menu menu;
+    menu.act(frontend::Action::Down);menu.act(frontend::Action::Accept);
+    menu.options[0]=6;
+    menu.act(frontend::Action::Up);
+    assert(menu.row==5);
+    menu.act(frontend::Action::Right);assert(menu.options[4]==1);
+    menu.act(frontend::Action::Accept);
+    assert(menu.page==frontend::Page::Controls);
+    menu.act(frontend::Action::Back);
+    assert(menu.page==frontend::Page::Options && menu.row==5 && menu.options[0]==6);
+    std::cout<<"controls rules and navigation PASS\n";
+}
