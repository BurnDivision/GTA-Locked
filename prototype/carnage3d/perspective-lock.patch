 #include "Pedestrian.h"
 #include "TimeManager.h"
 
+// GTA Classic Perspective Lock:
+// The camera's screen-up vector follows the player's world heading (or the heading of the
+// car they drive), so the player always faces 12 o'clock and the world rotates around them.
+// Only the view matrix changes: world coordinates, physics, AI and collision are untouched.
+//   ScreenPosition = R(-theta) * (WorldPosition - PlayerPosition)
+
+namespace
+{
+    const float TwoPi = 6.2831853f;
+
+    // wrap angle to [-pi, pi]
+    inline float WrapPi(float a)
+    {
+        a = fmodf(a + 3.14159265f, TwoPi);
+        if (a < 0.0f) a += TwoPi;
+        return a - 3.14159265f;
+    }
+}
+
 FollowCameraController::FollowCameraController()
     : mStartupCameraHeight(32.0f)
     , mFollowPedCameraHeight(20.0f)
     , mFollowPedCameraCatchSpeed(20.0f)
     , mScrollHeightOffset()
 {
+    const char* lockEnv = getenv("C3D_LOCK");
+    if (lockEnv && lockEnv[0] == '0')
+    {
+        mHeadingLockEnabled = false;
+    }
+}
+
+float FollowCameraController::GetTargetHeading() const
+{
+    // heading in radians, world X/Z plane, direction = (cos, sin)
+    if (mFollowPedestrian->IsCarPassenger() && mFollowPedestrian->mCurrentCar)
+        return mFollowPedestrian->mCurrentCar->mTransformSmooth.mOrientation.to_radians();
+
+    return mFollowPedestrian->mTransformSmooth.mOrientation.to_radians();
+}
+
+void FollowCameraController::ApplyHeading(float headingRadians)
+{
+    const glm::vec3 front = -SceneAxisY; // looking straight down
+    glm::vec3 up;
+    if (mHeadingLockEnabled)
+    {
+        // screen-up = player's forward direction in world space
+        up = glm::vec3(cosf(headingRadians), 0.0f, sinf(headingRadians));
+    }
+    else
+    {
+        up = -SceneAxisZ; // original fixed north-up view
+    }
+    glm::vec3 right = glm::cross(front, up);
+    mCamera->SetOrientation(front, right, up);
 }
 
