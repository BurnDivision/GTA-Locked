<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure game logic: no Unity / Il2Cpp references, so it is unit-testable on any machine.
       net6.0 because MelonLoader's Il2Cpp runtime is net6. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LESurvivors.Core</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
